<?page title="Errorbox" contentType="text/html;charset=UTF-8"?>
<zk xmlns:h="native">
<div sclass="z-p-8">
    <div sclass="z-border-bottom z-text-xl z-fw-medium z-text-on-surface z-mb-8 z-pb-3">Errorbox</div>

    <div sclass="z-mb-8">
        <div sclass="z-text-md z-fw-bold z-text-uppercase z-text-secondary z-border-bottom z-pb-2 z-mb-3">Errorbox — State Gallery</div>

        <div sclass="z-d-flex z-flex-wrap z-gap-6 z-align-start z-py-4 z-mb-2">
            <!-- A real errorbox always carries all three parts: the pointer
                 beak, the warning icon, and the close button. There is no
                 "no-arrow" or "no-close" variant, so the gallery shows the one
                 canonical structure (mirrors zul.inp.Errorbox#redraw). -->
            <div sclass="z-d-flex z-flex-col z-align-center z-gap-2">
                <div sclass="z-text-xs z-fw-semibold z-text-uppercase z-text-center z-text-secondary">Pointer + icon + close</div>
                <h:div class="z-errorbox" style="position:relative;width:260px;">
                    <h:div class="z-errorbox-pointer z-errorbox-down" style="bottom:-4px;left:120px;"/>
                    <h:i class="z-errorbox-icon z-icon-triangle-alert"/>
                    <h:div class="z-errorbox-content">Value is required</h:div>
                    <h:div class="z-errorbox-close"><h:i class="z-errorbox-icon z-icon-x"/></h:div>
                </h:div>
            </div>
        </div>
    </div>

    <div sclass="z-mb-6">
        <div sclass="z-text-xs z-fw-semibold z-text-uppercase z-text-secondary z-border-bottom z-pb-2 z-mb-4">Live Constraint Validation</div>
        <div sclass="z-text-xs z-text-secondary z-mb-4">Leave the field empty and press Tab or click outside to trigger a real errorbox.</div>
        <div sclass="z-py-3 z-d-flex z-align-start z-flex-wrap z-gap-6">
            <div sclass="z-d-flex z-flex-col z-align-start z-gap-2">
                <div sclass="z-text-xs z-text-secondary">no empty</div>
                <textbox placeholder="Required field" constraint="no empty" width="200px"/>
            </div>
            <div sclass="z-d-flex z-flex-col z-align-start z-gap-2">
                <div sclass="z-text-xs z-text-secondary">regex pattern</div>
                <textbox placeholder="Email" constraint="/.+@.+\..+/: Invalid email" width="200px"/>
            </div>
            <div sclass="z-d-flex z-flex-col z-align-start z-gap-2">
                <div sclass="z-text-xs z-text-secondary">min max range</div>
                <intbox placeholder="1–100" constraint="min 1 max 100" width="200px"/>
            </div>
        </div>
        <div sclass="z-text-xs z-text-secondary z-mt-4 z-mb-2">no empty (full width — errorbox flips to the left of the field)</div>
        <hlayout hflex="1">
            <textbox value="" hflex="1" constraint="no empty"/>
        </hlayout>
    </div>
</div>
</zk>
