<?page title="Window" contentType="text/html;charset=UTF-8"?>
<zk xmlns:h="native">
<h:link rel="stylesheet" href="pv.css"/>
<div sclass="z-p-8">
    <div sclass="z-border-bottom z-fs-title-lg z-fw-medium z-text-on-surface z-mb-8 z-pb-3">Window</div>

    <div sclass="pv-section">
        <div sclass="pv-section-title">Window — State Gallery</div>

        <div sclass="pv-state-gallery pv-variant-default">
            <div sclass="pv-state-col">
                <div sclass="pv-state-label">Default</div>
                <window title="Window" border="normal" width="200px">Content</window>
            </div>
            <div sclass="pv-state-col">
                <div sclass="pv-state-label">No Border</div>
                <window title="Window" border="none" width="200px">Content</window>
            </div>
        </div>
    </div>

    <div sclass="z-mb-6">
        <div sclass="z-fs-label-sm z-fw-semibold z-text-uppercase z-text-secondary z-border-bottom z-pb-2 z-mb-4">Embedded</div>
        <div sclass="z-d-flex z-align-end z-flex-wrap z-gap-6 z-py-3">
            <div sclass="z-d-flex z-flex-col z-align-start z-gap-2">
                <window title="With Title" border="normal"
                    closable="true" sizable="true" maximizable="true" minimizable="true"
                    width="300px" height="180px">
                    Window Content
                </window>
                <div sclass="z-fs-label-sm z-text-secondary">Normal border, full controls</div>
            </div>
            <div sclass="z-d-flex z-flex-col z-align-start z-gap-2">
                <window title="With Title"
                    closable="true" sizable="true" maximizable="true" minimizable="true"
                    width="300px" height="180px">
                    Window Content
                </window>
                <div sclass="z-fs-label-sm z-text-secondary">No border, full controls</div>
            </div>
            <div sclass="z-d-flex z-flex-col z-align-start z-gap-2">
                <window border="normal" closable="true"
                    width="300px" height="180px">
                    Window Content
                </window>
                <div sclass="z-fs-label-sm z-text-secondary">Normal border, no title</div>
            </div>
            <div sclass="z-d-flex z-flex-col z-align-start z-gap-2">
                <window closable="true" width="300px" height="180px">
                    Window Content
                </window>
                <div sclass="z-fs-label-sm z-text-secondary">No border, no title</div>
            </div>
        </div>
    </div>

    <div sclass="z-mb-6">
        <div sclass="z-fs-label-sm z-fw-semibold z-text-uppercase z-text-secondary z-border-bottom z-pb-2 z-mb-4">Overlapped Mode</div>
        <div sclass="z-d-flex z-align-end z-flex-wrap z-gap-6 z-py-3">
            <div sclass="z-d-flex z-flex-col z-align-start z-gap-2">
                <window title="Overlapped" border="normal" mode="overlapped"
                    closable="true" sizable="true" maximizable="true" minimizable="true"
                    width="300px" height="180px">
                    Window Content
                </window>
                <div sclass="z-fs-label-sm z-text-secondary">Normal border, mode="overlapped"</div>
            </div>
            <div sclass="z-d-flex z-flex-col z-align-start z-gap-2">
                <window title="Overlapped" mode="overlapped"
                    closable="true" sizable="true" maximizable="true" minimizable="true"
                    width="300px" height="180px">
                    Window Content
                </window>
                <div sclass="z-fs-label-sm z-text-secondary">No border, mode="overlapped"</div>
            </div>
        </div>
    </div>

    <div sclass="z-mb-6">
        <div sclass="z-fs-label-sm z-fw-semibold z-text-uppercase z-text-secondary z-border-bottom z-pb-2 z-mb-4">Popup and Modal</div>
        <div sclass="z-d-flex z-align-end z-flex-wrap z-gap-6 z-py-3">
            <div sclass="z-d-flex z-flex-col z-align-start z-gap-2">
                <window id="popup-normal" title="Window: Popup" border="normal" mode="popup"
                    closable="true" sizable="true" maximizable="true" minimizable="true"
                    width="300px" height="180px">
                    Window Content
                </window>
                <button label="Show Popup" onClick="popup-normal.doPopup();"/>
                <div sclass="z-fs-label-sm z-text-secondary">Normal border, mode="popup"</div>
            </div>
            <div sclass="z-d-flex z-flex-col z-align-start z-gap-2">
                <window id="popup-nb" title="Window: Popup" mode="popup"
                    closable="true" sizable="true" maximizable="true" minimizable="true"
                    width="300px" height="180px">
                    Window Content
                </window>
                <button label="Show Popup" onClick="popup-nb.doPopup();"/>
                <div sclass="z-fs-label-sm z-text-secondary">No border, mode="popup"</div>
            </div>
            <div sclass="z-d-flex z-flex-col z-align-start z-gap-2">
                <window id="modal-normal" title="Window: Modal" border="normal" visible="false"
                    closable="true" sizable="true" maximizable="true" minimizable="true"
                    width="300px" height="180px">
                    <vbox>
                        <div>Window Content</div>
                        <div><button label="Close" onClick="modal-normal.visible = false;"/></div>
                    </vbox>
                </window>
                <button label="Show Modal" onClick="modal-normal.doModal();"/>
                <div sclass="z-fs-label-sm z-text-secondary">Normal border, mode="modal"</div>
            </div>
            <div sclass="z-d-flex z-flex-col z-align-start z-gap-2">
                <window id="modal-nb" title="Window: Modal" visible="false"
                    closable="true" sizable="true" maximizable="true" minimizable="true"
                    width="300px" height="180px">
                    <vbox>
                        <div>Window Content</div>
                        <div><button label="Close" onClick="modal-nb.visible = false;"/></div>
                    </vbox>
                </window>
                <button label="Show Modal" onClick="modal-nb.doModal();"/>
                <div sclass="z-fs-label-sm z-text-secondary">No border, mode="modal"</div>
            </div>
        </div>
    </div>

</div>
</zk>
