<?page title="ConfirmPopup" contentType="text/html;charset=UTF-8"?>
<zk xmlns:h="native">
<div sclass="z-p-8">
    <div sclass="z-border-bottom z-text-xl z-fw-medium z-text-on-surface z-mb-8 z-pb-3">ConfirmPopup</div>

    <div sclass="z-mb-8">
        <div sclass="z-text-md z-fw-bold z-text-uppercase z-text-secondary z-border-bottom z-pb-2 z-mb-3">ConfirmPopup — State Gallery (Severity)</div>

        <div sclass="z-d-flex z-flex-wrap z-gap-8 z-align-start z-py-4 z-mb-2">
            <div sclass="z-d-flex z-flex-col z-align-center z-gap-2">
                <div sclass="z-text-xs z-fw-semibold z-text-uppercase z-text-center z-text-secondary">Info</div>
                <h:div class="z-confirmpopup z-confirmpopup-info z-confirmpopup-placement-top" style="position:relative;">
                    <h:span class="z-confirmpopup-arrow"/>
                    <h:div class="z-confirmpopup-header">Confirm</h:div>
                    <h:div class="z-confirmpopup-body">
                        <h:i class="z-confirmpopup-icon z-icon-exclamation-triangle"/>
                        <h:div class="z-confirmpopup-message">Here is some info for you.</h:div>
                    </h:div>
                    <h:div class="z-confirmpopup-footer">
                        <h:button type="button" class="z-confirmpopup-cancel">Cancel</h:button>
                        <h:button type="button" class="z-confirmpopup-ok">OK</h:button>
                    </h:div>
                </h:div>
            </div>
            <div sclass="z-d-flex z-flex-col z-align-center z-gap-2">
                <div sclass="z-text-xs z-fw-semibold z-text-uppercase z-text-center z-text-secondary">Success</div>
                <h:div class="z-confirmpopup z-confirmpopup-success z-confirmpopup-placement-top" style="position:relative;">
                    <h:span class="z-confirmpopup-arrow"/>
                    <h:div class="z-confirmpopup-header">Confirm</h:div>
                    <h:div class="z-confirmpopup-body">
                        <h:i class="z-confirmpopup-icon z-icon-exclamation-triangle"/>
                        <h:div class="z-confirmpopup-message">The operation completed successfully.</h:div>
                    </h:div>
                    <h:div class="z-confirmpopup-footer">
                        <h:button type="button" class="z-confirmpopup-cancel">Cancel</h:button>
                        <h:button type="button" class="z-confirmpopup-ok">OK</h:button>
                    </h:div>
                </h:div>
            </div>
            <div sclass="z-d-flex z-flex-col z-align-center z-gap-2">
                <div sclass="z-text-xs z-fw-semibold z-text-uppercase z-text-center z-text-secondary">Warning</div>
                <h:div class="z-confirmpopup z-confirmpopup-warning z-confirmpopup-placement-top" style="position:relative;">
                    <h:span class="z-confirmpopup-arrow"/>
                    <h:div class="z-confirmpopup-header">Confirm</h:div>
                    <h:div class="z-confirmpopup-body">
                        <h:i class="z-confirmpopup-icon z-icon-exclamation-triangle"/>
                        <h:div class="z-confirmpopup-message">This action may have side effects.</h:div>
                    </h:div>
                    <h:div class="z-confirmpopup-footer">
                        <h:button type="button" class="z-confirmpopup-cancel">Cancel</h:button>
                        <h:button type="button" class="z-confirmpopup-ok">OK</h:button>
                    </h:div>
                </h:div>
            </div>
            <div sclass="z-d-flex z-flex-col z-align-center z-gap-2">
                <div sclass="z-text-xs z-fw-semibold z-text-uppercase z-text-center z-text-secondary">Danger</div>
                <h:div class="z-confirmpopup z-confirmpopup-danger z-confirmpopup-placement-top" style="position:relative;">
                    <h:span class="z-confirmpopup-arrow"/>
                    <h:div class="z-confirmpopup-header">Delete item?</h:div>
                    <h:div class="z-confirmpopup-body">
                        <h:i class="z-confirmpopup-icon z-icon-exclamation-triangle"/>
                        <h:div class="z-confirmpopup-message">This cannot be undone.</h:div>
                    </h:div>
                    <h:div class="z-confirmpopup-footer">
                        <h:button type="button" class="z-confirmpopup-cancel">Cancel</h:button>
                        <h:button type="button" class="z-confirmpopup-ok">OK</h:button>
                    </h:div>
                </h:div>
            </div>
            <div sclass="z-d-flex z-flex-col z-align-center z-gap-2">
                <div sclass="z-text-xs z-fw-semibold z-text-uppercase z-text-center z-text-secondary">Secondary</div>
                <h:div class="z-confirmpopup z-confirmpopup-secondary z-confirmpopup-placement-top" style="position:relative;">
                    <h:span class="z-confirmpopup-arrow"/>
                    <h:div class="z-confirmpopup-header">Confirm</h:div>
                    <h:div class="z-confirmpopup-body">
                        <h:i class="z-confirmpopup-icon z-icon-exclamation-triangle"/>
                        <h:div class="z-confirmpopup-message">Would you like to proceed?</h:div>
                    </h:div>
                    <h:div class="z-confirmpopup-footer">
                        <h:button type="button" class="z-confirmpopup-cancel">Cancel</h:button>
                        <h:button type="button" class="z-confirmpopup-ok">OK</h:button>
                    </h:div>
                </h:div>
            </div>
        </div>
    </div>

    <div sclass="z-mb-8">
        <div sclass="z-text-md z-fw-bold z-text-uppercase z-text-secondary z-border-bottom z-pb-2 z-mb-3">ConfirmPopup — State Gallery (Placement)</div>

        <div sclass="z-d-flex z-flex-wrap z-gap-8 z-align-start z-py-4 z-mb-2">
            <div sclass="z-d-flex z-flex-col z-align-center z-gap-2">
                <div sclass="z-text-xs z-fw-semibold z-text-uppercase z-text-center z-text-secondary">Top</div>
                <h:div class="z-confirmpopup z-confirmpopup-warning z-confirmpopup-placement-top" style="position:relative;">
                    <h:span class="z-confirmpopup-arrow"/>
                    <h:div class="z-confirmpopup-body">
                        <h:i class="z-confirmpopup-icon z-icon-exclamation-triangle"/>
                        <h:div class="z-confirmpopup-message">Box above trigger, arrow bottom edge.</h:div>
                    </h:div>
                    <h:div class="z-confirmpopup-footer">
                        <h:button type="button" class="z-confirmpopup-cancel">Cancel</h:button>
                        <h:button type="button" class="z-confirmpopup-ok">OK</h:button>
                    </h:div>
                </h:div>
            </div>
            <div sclass="z-d-flex z-flex-col z-align-center z-gap-2">
                <div sclass="z-text-xs z-fw-semibold z-text-uppercase z-text-center z-text-secondary">Bottom</div>
                <h:div class="z-confirmpopup z-confirmpopup-warning z-confirmpopup-placement-bottom" style="position:relative;">
                    <h:span class="z-confirmpopup-arrow"/>
                    <h:div class="z-confirmpopup-body">
                        <h:i class="z-confirmpopup-icon z-icon-exclamation-triangle"/>
                        <h:div class="z-confirmpopup-message">Box below trigger, arrow top edge.</h:div>
                    </h:div>
                    <h:div class="z-confirmpopup-footer">
                        <h:button type="button" class="z-confirmpopup-cancel">Cancel</h:button>
                        <h:button type="button" class="z-confirmpopup-ok">OK</h:button>
                    </h:div>
                </h:div>
            </div>
            <div sclass="z-d-flex z-flex-col z-align-center z-gap-2">
                <div sclass="z-text-xs z-fw-semibold z-text-uppercase z-text-center z-text-secondary">Left</div>
                <h:div class="z-confirmpopup z-confirmpopup-warning z-confirmpopup-placement-left" style="position:relative;">
                    <h:span class="z-confirmpopup-arrow"/>
                    <h:div class="z-confirmpopup-body">
                        <h:i class="z-confirmpopup-icon z-icon-exclamation-triangle"/>
                        <h:div class="z-confirmpopup-message">Box left of trigger, arrow right edge.</h:div>
                    </h:div>
                    <h:div class="z-confirmpopup-footer">
                        <h:button type="button" class="z-confirmpopup-cancel">Cancel</h:button>
                        <h:button type="button" class="z-confirmpopup-ok">OK</h:button>
                    </h:div>
                </h:div>
            </div>
            <div sclass="z-d-flex z-flex-col z-align-center z-gap-2">
                <div sclass="z-text-xs z-fw-semibold z-text-uppercase z-text-center z-text-secondary">Right</div>
                <h:div class="z-confirmpopup z-confirmpopup-warning z-confirmpopup-placement-right" style="position:relative;">
                    <h:span class="z-confirmpopup-arrow"/>
                    <h:div class="z-confirmpopup-body">
                        <h:i class="z-confirmpopup-icon z-icon-exclamation-triangle"/>
                        <h:div class="z-confirmpopup-message">Box right of trigger, arrow left edge.</h:div>
                    </h:div>
                    <h:div class="z-confirmpopup-footer">
                        <h:button type="button" class="z-confirmpopup-cancel">Cancel</h:button>
                        <h:button type="button" class="z-confirmpopup-ok">OK</h:button>
                    </h:div>
                </h:div>
            </div>
        </div>
    </div>

    <div sclass="z-mb-6">
        <div sclass="z-text-xs z-fw-semibold z-text-uppercase z-text-secondary z-border-bottom z-pb-2 z-mb-4">Live — By Severity</div>
        <div sclass="z-py-3 z-d-flex z-gap-4 z-flex-wrap">
            <button label="Info" popup="cpInfo"/>
            <button label="Success" popup="cpSuccess"/>
            <button label="Warning" popup="cpWarning"/>
            <button label="Danger" popup="cpDanger"/>
            <button label="Secondary" popup="cpSecondary"/>
        </div>
    </div>

    <div sclass="z-mb-6">
        <div sclass="z-text-xs z-fw-semibold z-text-uppercase z-text-secondary z-border-bottom z-pb-2 z-mb-4">Live — Placement</div>
        <div sclass="z-py-3 z-d-flex z-gap-4 z-flex-wrap">
            <button label="Top" popup="cpTop"/>
            <button label="Bottom" popup="cpBottom"/>
            <button label="Left" popup="cpLeft"/>
            <button label="Right" popup="cpRight"/>
        </div>
    </div>

    <div sclass="z-mb-6">
        <div sclass="z-text-xs z-fw-semibold z-text-uppercase z-text-secondary z-border-bottom z-pb-2 z-mb-4">Live — OK / Cancel Feedback</div>
        <div sclass="z-py-3 z-d-flex z-gap-4 z-flex-wrap z-align-center">
            <button label="Delete item" popup="cpDelete"/>
            <label id="deleteResult" value=""/>
        </div>
    </div>

    <confirmpopup id="cpInfo" severity="info" header="Confirm" message="Here is some info for you."/>
    <confirmpopup id="cpSuccess" severity="success" header="Confirm" message="The operation completed successfully."/>
    <confirmpopup id="cpWarning" severity="warning" header="Confirm" message="This action may have side effects."/>
    <confirmpopup id="cpDanger" severity="danger" header="Delete item?" message="This cannot be undone." defaultFocus="cancel"/>
    <confirmpopup id="cpSecondary" severity="secondary" header="Confirm" message="Would you like to proceed?"/>

    <confirmpopup id="cpTop" placement="top" message="Box above trigger, arrow bottom edge."/>
    <confirmpopup id="cpBottom" placement="bottom" message="Box below trigger, arrow top edge."/>
    <confirmpopup id="cpLeft" placement="left" message="Box left of trigger, arrow right edge."/>
    <confirmpopup id="cpRight" placement="right" message="Box right of trigger, arrow left edge."/>

    <confirmpopup id="cpDelete" severity="danger" header="Delete item?" message="This cannot be undone." defaultFocus="cancel">
        <attribute name="onOK">deleteResult.setValue("OK — item deleted.");</attribute>
        <attribute name="onCancel">deleteResult.setValue("Cancelled.");</attribute>
    </confirmpopup>
</div>
</zk>
