<?page title="Borderlayout" contentType="text/html;charset=UTF-8"?>
<zk xmlns:h="native">
<div sclass="z-p-8">
    <div sclass="z-border-bottom z-text-xl z-fw-medium z-text-on-surface z-mb-8 z-pb-3">Borderlayout</div>

    <!-- ZK layout primitives (borderlayout, vlayout, div, etc.) have NO default
         padding by design — see doc/component-dom-structures.md. Use the
         z-p-* utility classes from base/_utilities.css on the inner content
         wrapper, NOT on the layout primitive itself. -->
    <div sclass="z-mb-6">
        <div sclass="z-text-xs z-fw-semibold z-text-uppercase z-text-secondary z-border-bottom z-pb-2 z-mb-4">Basic — North / South / East / West / Center</div>
        <div sclass="z-py-3">
            <borderlayout height="400px">
                <center>
                    <div sclass="z-p-4">Center Content</div>
                </center>
                <west title="West" size="20%" splittable="true" collapsible="true">
                    <div sclass="z-p-4">West Content</div>
                </west>
                <east title="East" size="20%" splittable="true" collapsible="true">
                    <div sclass="z-p-4">East Content</div>
                </east>
                <north title="North" size="15%" splittable="true" collapsible="true">
                    North Content
                </north>
                <south title="South" size="15%" splittable="true" collapsible="true">
                    South Content
                </south>
            </borderlayout>
        </div>
    </div>

    <div sclass="z-mb-6">
        <div sclass="z-text-xs z-fw-semibold z-text-uppercase z-text-secondary z-border-bottom z-pb-2 z-mb-4">With Region Titles</div>
        <div sclass="z-py-3">
            <borderlayout height="300px">
                <center title="Center"><div sclass="z-p-4">Center Content</div></center>
                <north size="20%" title="North">North Content</north>
                <south size="20%" title="South">South Content</south>
                <east size="20%" title="East"><div sclass="z-p-4">East Content</div></east>
                <west size="20%" title="West"><div sclass="z-p-4">West Content</div></west>
            </borderlayout>
        </div>
    </div>

    <div sclass="z-mb-6">
        <div sclass="z-text-xs z-fw-semibold z-text-uppercase z-text-secondary z-border-bottom z-pb-2 z-mb-4">No Region Borders</div>
        <div sclass="z-py-3">
            <borderlayout height="300px">
                <center border="none"><div sclass="z-p-4">Center Content</div></center>
                <north size="20%" border="none">North Content</north>
                <south size="20%" border="none">South Content</south>
                <east size="20%" border="none"><div sclass="z-p-4">East Content</div></east>
                <west size="20%" border="none"><div sclass="z-p-4">West Content</div></west>
            </borderlayout>
        </div>
    </div>

    <div sclass="z-mb-6">
        <div sclass="z-text-xs z-fw-semibold z-text-uppercase z-text-secondary z-border-bottom z-pb-2 z-mb-4">Auto Scroll and Margins</div>
        <div sclass="z-d-flex z-flex-col z-gap-6 z-py-3">
            <div sclass="z-d-flex z-flex-col z-gap-2">
                <div sclass="z-text-xs z-text-secondary">autoscroll="true"</div>
                <borderlayout xmlns:ca="client/attribute" height="300px">
                    <center autoscroll="true" ca:data-embedscrollbar="true">
                        <vlayout id="box">
                            <label value="Center" />
                            <label value="Content" />
                            <label value="is" />
                            <label value="very" />
                            <label value="very" />
                            <label value="very" />
                            <label value="very" />
                            <label value="very" />
                            <label value="long" />
                            <label value="long" />
                            <label value="long" />
                        </vlayout>
                    </center>
                    <north size="20%">North Content</north>
                    <south size="20%">South Content</south>
                    <east size="20%">East Content</east>
                    <west size="20%">West Content</west>
                </borderlayout>
            </div>
            <div sclass="z-d-flex z-flex-col z-gap-2">
                <div sclass="z-text-xs z-text-secondary">center margins="10,10,10,10"</div>
                <borderlayout height="300px">
                    <center margins="10,10,10,10">Center Content</center>
                    <north size="20%">North Content</north>
                    <south size="20%">South Content</south>
                    <east size="20%">East Content</east>
                    <west size="20%">West Content</west>
                </borderlayout>
            </div>
            <div sclass="z-d-flex z-flex-col z-gap-2">
                <div sclass="z-text-xs z-text-secondary">east/west cmargins="10,10,10,10"</div>
                <borderlayout height="300px">
                    <center>Center Content</center>
                    <north size="20%">North Content</north>
                    <south size="20%">South Content</south>
                    <east title="East" size="20%" collapsible="true" cmargins="10,10,10,10">East Content</east>
                    <west title="West" size="20%" collapsible="true" cmargins="10,10,10,10">West Content</west>
                </borderlayout>
            </div>
        </div>
    </div>

</div>
</zk>
