<?page title="Fileupload" contentType="text/html;charset=UTF-8"?>
<zk xmlns:h="native">
<h:link rel="stylesheet" href="pv.css"/>
<div sclass="z-p-8">
    <div sclass="z-border-bottom z-text-xl z-fw-medium z-text-on-surface z-mb-8 z-pb-3">Fileupload</div>
    <div sclass="z-mb-6 pv-cols-2">
        <div sclass="z-text-xs z-fw-semibold z-text-uppercase z-text-secondary z-border-bottom z-pb-2 z-mb-4">States</div>
        <div sclass="pv-col-header-row z-pb-1">
            <div/>
            <div sclass="z-text-xs z-fw-semibold z-text-secondary">Default</div>
            <div sclass="z-text-xs z-fw-semibold z-text-secondary">Disabled</div>
        </div>
        <div sclass="pv-row z-py-2 z-border-bottom">
            <div sclass="z-text-sm z-text-secondary">Upload</div>
            <div>
                <fileupload label="Upload">
                    <attribute name="onUpload">
                        org.zkoss.util.media.Media media = event.getMedia();
                    </attribute>
                </fileupload>
            </div>
            <div>
                <fileupload label="Upload" disabled="true"/>
            </div>
        </div>
    </div>
</div>
</zk>
