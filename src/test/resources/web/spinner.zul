<?page title="Spinner" contentType="text/html;charset=UTF-8"?>
<zk xmlns:h="native">
<h:link rel="stylesheet" href="pv.css"/>
<div sclass="z-p-8">
    <div sclass="z-border-bottom z-fs-title-lg z-fw-medium z-text-on-surface z-mb-8 z-pb-3">Spinner</div>

    <div sclass="z-mb-6 pv-cols-5">
        <div sclass="z-fs-label-sm z-fw-semibold z-text-uppercase z-text-secondary z-border-bottom z-pb-2 z-mb-4">States — Spinner</div>
        <div sclass="pv-col-header-row z-pb-1">
            <div/>
            <div sclass="z-fs-label-sm z-fw-semibold z-text-secondary">Default</div>
            <div sclass="z-fs-label-sm z-fw-semibold z-text-secondary">Disabled</div>
            <div sclass="z-fs-label-sm z-fw-semibold z-text-secondary">Readonly</div>
            <div sclass="z-fs-label-sm z-fw-semibold z-text-secondary">Invalid</div>
        </div>
        <div sclass="pv-row z-py-2 z-border-bottom">
            <div sclass="z-fs-label-md z-text-secondary">With buttons</div>
            <div><spinner/></div>
            <div><spinner disabled="true"/></div>
            <div><spinner readonly="true"/></div>
            <div><spinner sclass="z-spinner-invalid"/></div>
        </div>
        <div sclass="pv-row z-py-2 z-border-bottom">
            <div sclass="z-fs-label-md z-text-secondary">No buttons</div>
            <div><spinner buttonVisible="false"/></div>
            <div><spinner buttonVisible="false" disabled="true"/></div>
            <div><spinner buttonVisible="false" readonly="true"/></div>
            <div><spinner buttonVisible="false" sclass="z-spinner-invalid"/></div>
        </div>
        <div sclass="pv-row z-py-2 z-border-bottom">
            <div sclass="z-fs-label-md z-text-secondary">Inplace</div>
            <div><spinner inplace="true" value="5"/></div>
            <div><spinner inplace="true" disabled="true" value="5"/></div>
            <div><spinner inplace="true" readonly="true" value="5"/></div>
            <div>—</div>
        </div>
    </div>

    <div sclass="z-mb-6 pv-cols-5 z-mt-8">
        <div sclass="z-fs-label-sm z-fw-semibold z-text-uppercase z-text-secondary z-border-bottom z-pb-2 z-mb-4">States — Doublespinner</div>
        <div sclass="pv-col-header-row z-pb-1">
            <div/>
            <div sclass="z-fs-label-sm z-fw-semibold z-text-secondary">Default</div>
            <div sclass="z-fs-label-sm z-fw-semibold z-text-secondary">Disabled</div>
            <div sclass="z-fs-label-sm z-fw-semibold z-text-secondary">Readonly</div>
            <div sclass="z-fs-label-sm z-fw-semibold z-text-secondary">Invalid</div>
        </div>
        <div sclass="pv-row z-py-2 z-border-bottom">
            <div sclass="z-fs-label-md z-text-secondary">With buttons</div>
            <div><doublespinner/></div>
            <div><doublespinner disabled="true"/></div>
            <div><doublespinner readonly="true"/></div>
            <div><doublespinner sclass="z-doublespinner-invalid"/></div>
        </div>
        <div sclass="pv-row z-py-2 z-border-bottom">
            <div sclass="z-fs-label-md z-text-secondary">No buttons</div>
            <div><doublespinner buttonVisible="false"/></div>
            <div><doublespinner buttonVisible="false" disabled="true"/></div>
            <div><doublespinner buttonVisible="false" readonly="true"/></div>
            <div>—</div>
        </div>
    </div>
</div>
</zk>
