<?page title="Tabbox Tabchildren" contentType="text/html;charset=UTF-8"?>
<zk xmlns:h="native">
<h:link rel="stylesheet" href="pv.css"/>
<div sclass="z-p-8">
    <div sclass="z-border-bottom z-fs-title-lg z-fw-medium z-text-on-surface z-mb-8 z-pb-3">Tabbox — tabscroll=false (tabchildren)</div>

    <div sclass="z-mb-6">
        <div sclass="z-fs-label-sm z-fw-semibold z-text-uppercase z-text-secondary z-border-bottom z-pb-2 z-mb-4">Horizontal tabscroll=false</div>
        <div sclass="z-py-3">
            <tabbox tabscroll="false" height="200px" width="300px">
                <tabs>
                    <tab label="Tab 1" />
                    <tab label="Tab 2" />
                    <tab label="Tab 3" />
                </tabs>
                <tabpanels>
                    <tabpanel>Tabpanel 1 Content</tabpanel>
                    <tabpanel>Tabpanel 2 Content</tabpanel>
                    <tabpanel>Tabpanel 3 Content</tabpanel>
                </tabpanels>
            </tabbox>
        </div>
    </div>

</div>
</zk>
