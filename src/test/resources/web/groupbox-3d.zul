<?page title="Groupbox 3D" contentType="text/html;charset=UTF-8"?>
<zk xmlns:h="native">
<h:link rel="stylesheet" href="pv.css"/>
<div sclass="z-p-8">
    <div sclass="z-border-bottom z-fs-title-lg z-fw-medium z-text-on-surface z-mb-8 z-pb-3">Groupbox — 3D Mold</div>

    <div sclass="z-mb-6">
        <div sclass="z-fs-label-sm z-fw-semibold z-text-uppercase z-text-secondary z-border-bottom z-pb-2 z-mb-4">Caption Variants</div>
        <div sclass="z-d-flex z-align-end z-flex-wrap z-gap-6 z-py-3">
            <div sclass="z-d-flex z-flex-col z-align-start z-gap-2">
                <groupbox width="240px" height="150px" mold="3d">
                    <caption image="~./img/volumn.gif" label="Caption" />
                    Groupbox Content
                </groupbox>
                <div sclass="z-fs-label-sm z-text-secondary">Caption + Image</div>
            </div>
            <div sclass="z-d-flex z-flex-col z-align-start z-gap-2">
                <groupbox width="240px" height="150px" mold="3d">
                    <caption label="Caption" />
                    Groupbox Content
                </groupbox>
                <div sclass="z-fs-label-sm z-text-secondary">Caption Only</div>
            </div>
            <div sclass="z-d-flex z-flex-col z-align-start z-gap-2">
                <groupbox width="240px" height="150px" mold="3d" title="Title">
                    Groupbox Content
                </groupbox>
                <div sclass="z-fs-label-sm z-text-secondary">Title Attr (no caption)</div>
            </div>
            <div sclass="z-d-flex z-flex-col z-align-start z-gap-2">
                <groupbox width="240px" height="150px" mold="3d" title="Title">
                    <caption label="Caption" />
                    Groupbox Content
                </groupbox>
                <div sclass="z-fs-label-sm z-text-secondary">Caption + Title mixed</div>
            </div>
        </div>
    </div>

    <div sclass="z-mb-6">
        <div sclass="z-fs-label-sm z-fw-semibold z-text-uppercase z-text-secondary z-border-bottom z-pb-2 z-mb-4">Edge Cases</div>
        <div sclass="z-d-flex z-align-end z-flex-wrap z-gap-6 z-py-3">
            <div sclass="z-d-flex z-flex-col z-align-start z-gap-2">
                <groupbox width="240px" height="150px" mold="3d">
                    <caption image="~./img/volumn.gif" />
                    Groupbox Content
                </groupbox>
                <div sclass="z-fs-label-sm z-text-secondary">Image only caption</div>
            </div>
            <div sclass="z-d-flex z-flex-col z-align-start z-gap-2">
                <groupbox width="240px" height="150px" mold="3d">
                    Groupbox Content
                </groupbox>
                <div sclass="z-fs-label-sm z-text-secondary">No caption</div>
            </div>
        </div>
    </div>

</div>
</zk>
