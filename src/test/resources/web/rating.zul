<?page title="Rating" contentType="text/html;charset=UTF-8"?>
<zk xmlns:h="native">
<h:link rel="stylesheet" href="pv.css"/>
<div sclass="z-p-8">
    <div sclass="z-border-bottom z-fs-title-lg z-fw-medium z-text-on-surface z-mb-8 z-pb-3">Rating</div>

    <div sclass="z-mb-6 pv-cols-2">
        <div sclass="z-fs-label-sm z-fw-semibold z-text-uppercase z-text-secondary z-border-bottom z-pb-2 z-mb-4">States</div>
        <div sclass="pv-col-header-row z-pb-1">
            <div/>
            <div sclass="z-fs-label-sm z-fw-semibold z-text-secondary">Default</div>
            <div sclass="z-fs-label-sm z-fw-semibold z-text-secondary">Disabled</div>
        </div>
        <div sclass="pv-row z-py-2 z-border-bottom">
            <div sclass="z-fs-label-md z-text-secondary">3 stars</div>
            <div><rating rating="3"/></div>
            <div><rating rating="3" disabled="true"/></div>
        </div>
        <div sclass="pv-row z-py-2 z-border-bottom">
            <div sclass="z-fs-label-md z-text-secondary">Readonly</div>
            <div><rating rating="4" readonly="true"/></div>
            <div>—</div>
        </div>
    </div>

    <div sclass="z-mb-6">
        <div sclass="z-fs-label-sm z-fw-semibold z-text-uppercase z-text-secondary z-border-bottom z-pb-2 z-mb-4">Max Stars</div>
        <div sclass="z-d-flex z-align-end z-flex-wrap z-gap-6 z-py-3">
            <div sclass="z-d-flex z-flex-col z-align-start z-gap-2">
                <rating max="3" rating="2"/>
                <div sclass="z-fs-label-sm z-text-secondary">3 max</div>
            </div>
            <div sclass="z-d-flex z-flex-col z-align-start z-gap-2">
                <rating max="5" rating="3"/>
                <div sclass="z-fs-label-sm z-text-secondary">5 max (default)</div>
            </div>
            <div sclass="z-d-flex z-flex-col z-align-start z-gap-2">
                <rating max="10" rating="7"/>
                <div sclass="z-fs-label-sm z-text-secondary">10 max</div>
            </div>
        </div>
    </div>

    <div sclass="z-mb-6">
        <div sclass="z-fs-label-sm z-fw-semibold z-text-uppercase z-text-secondary z-border-bottom z-pb-2 z-mb-4">Vertical</div>
        <div sclass="z-d-flex z-align-start z-flex-wrap z-gap-6 z-py-3">
            <div sclass="z-d-flex z-flex-col z-align-start z-gap-2">
                <rating orient="vertical" rating="3"/>
                <div sclass="z-fs-label-sm z-text-secondary">Vertical (3/5)</div>
            </div>
            <div sclass="z-d-flex z-flex-col z-align-start z-gap-2">
                <rating orient="vertical" rating="3" disabled="true"/>
                <div sclass="z-fs-label-sm z-text-secondary">Vertical disabled</div>
            </div>
            <div sclass="z-d-flex z-flex-col z-align-start z-gap-2">
                <rating orient="vertical" rating="3" readonly="true"/>
                <div sclass="z-fs-label-sm z-text-secondary">Vertical readonly</div>
            </div>
        </div>
    </div>
</div>
</zk>
