<?page title="Selectbox" contentType="text/html;charset=UTF-8"?>
<zk xmlns:h="native">
<h:link rel="stylesheet" href="pv.css"/>
<zscript>
String[] selectNames = {"Alice", "Bob", "Charlie", "David", "Eve"};
ListModelList selectModel = new ListModelList(selectNames);
</zscript>
<div sclass="z-p-8">
    <div sclass="z-border-bottom z-fs-title-lg z-fw-medium z-text-on-surface z-mb-8 z-pb-3">Selectbox</div>

    <apply templateURI="~./pv/matrix.zul" title="States"
           cols="${['Default','Disabled']}"
           rowsTemplate="selectbox-rows">
        <template name="selectbox-rows">
            <div sclass="pv-row z-py-2 z-border-bottom">
                <div sclass="z-fs-label-md z-text-secondary">Default</div>
                <div>
                    <selectbox model="${selectModel}">
                        <template name="model">${each}</template>
                    </selectbox>
                </div>
                <div>
                    <selectbox model="${selectModel}" disabled="true">
                        <template name="model">${each}</template>
                    </selectbox>
                </div>
            </div>
        </template>
    </apply>
</div>
</zk>
