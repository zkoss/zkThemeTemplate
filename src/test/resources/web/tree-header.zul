<?page title="Tree Header" contentType="text/html;charset=UTF-8"?>
<zk xmlns:h="native">
<h:link rel="stylesheet" href="pv.css"/>
<zscript>
    import zk.example.*;
    import java.util.*;

    BinaryTreeModel btm = new BinaryTreeModel(new ArrayList(new BigList(1000)));
</zscript>
<div sclass="z-p-8">
    <div sclass="z-border-bottom z-fs-title-lg z-fw-medium z-text-on-surface z-mb-8 z-pb-3">Tree Header</div>

    <div sclass="z-mb-6">
        <div sclass="z-fs-label-sm z-fw-semibold z-text-uppercase z-text-secondary z-border-bottom z-pb-2 z-mb-4">Auxhead + Treecols Combinations</div>
        <div sclass="z-py-3">
            <div style="display:flex; gap:16px; align-items:flex-start;">
                <tree width="400px">
                    <auxhead>
                        <auxheader label="A+B" colspan="2"/>
                        <auxheader label="C"/>
                    </auxhead>
                    <treecols>
                        <treecol label="Align Left" align="left"/>
                        <treecol label="Align Center" align="center"/>
                        <treecol label="Align Right" align="right"/>
                    </treecols>
                    <auxhead>
                        <auxheader label="C"/>
                        <auxheader label="D + E" colspan="2"/>
                    </auxhead>
                    <treechildren>
                        <treeitem>
                            <treerow>
                                <treecell label="AA01"/>
                                <treecell label="BB01"/>
                                <treecell label="CC01"/>
                            </treerow>
                            <treechildren>
                                <treeitem selected="true">
                                    <treerow>
                                        <treecell label="A-1"/>
                                        <treecell label="B"/>
                                        <treecell label="C"/>
                                    </treerow>
                                </treeitem>
                                <treeitem>
                                    <treerow>
                                        <treecell label="A-2"/>
                                        <treecell label="B"/>
                                        <treecell label="C"/>
                                    </treerow>
                                </treeitem>
                            </treechildren>
                        </treeitem>
                        <treeitem>
                            <treerow>
                                <treecell label="AA02"/>
                                <treecell/>
                                <treecell/>
                            </treerow>
                        </treeitem>
                    </treechildren>
                    <treefoot>
                        <treefooter label="footer 1"/>
                        <treefooter label="image" image="~./img/Centigrade-Widget-Icons/BookBlue-16x16.png"
                                    hoverImage="~./img/Centigrade-Widget-Icons/BookGreen-16x16.png"/>
                        <treefooter label="image" image="~./img/Centigrade-Widget-Icons/BookBlue-16x16.png"
                                    hoverImage="~./img/Centigrade-Widget-Icons/BookGreen-16x16.png"/>
                    </treefoot>
                </tree>

                <tree width="400px">
                    <treecols>
                        <treecol label="Align Left" align="left"/>
                        <treecol label="Align Center" align="center"/>
                        <treecol label="Align Right" align="right"/>
                    </treecols>
                    <auxhead>
                        <auxheader label="A+B" colspan="2"/>
                        <auxheader label="C"/>
                    </auxhead>
                    <auxhead>
                        <auxheader label="C"/>
                        <auxheader label="D + E" colspan="2"/>
                    </auxhead>
                    <treechildren>
                        <treeitem>
                            <treerow>
                                <treecell label="AA01"/>
                                <treecell label="BB01"/>
                                <treecell label="CC01"/>
                            </treerow>
                        </treeitem>
                        <treeitem open="false">
                            <treerow>
                                <treecell label="AA02"/>
                                <treecell/>
                                <treecell/>
                            </treerow>
                            <treechildren>
                                <treeitem>
                                    <treerow>
                                        <treecell label="A-1"/>
                                        <treecell label="B"/>
                                        <treecell label="C"/>
                                    </treerow>
                                </treeitem>
                                <treeitem>
                                    <treerow>
                                        <treecell label="A-2"/>
                                        <treecell label="B"/>
                                        <treecell label="C"/>
                                    </treerow>
                                </treeitem>
                            </treechildren>
                        </treeitem>
                    </treechildren>
                    <treefoot>
                        <treefooter label="footer 1"/>
                        <treefooter label="footer 2"/>
                        <treefooter label="footer 3"/>
                    </treefoot>
                </tree>

                <tree width="400px">
                    <auxhead>
                        <auxheader label="A+B" colspan="2"/>
                        <auxheader label="C"/>
                    </auxhead>
                    <auxhead>
                        <auxheader label="C"/>
                        <auxheader label="D + E" colspan="2"/>
                    </auxhead>
                    <treecols>
                        <treecol label="Align Left" align="left"/>
                        <treecol label="Align Center" align="center"/>
                        <treecol label="Align Right" align="right"/>
                    </treecols>
                    <treechildren>
                        <treeitem>
                            <treerow>
                                <treecell label="AA01"/>
                                <treecell label="BB01"/>
                                <treecell label="CC01"/>
                            </treerow>
                        </treeitem>
                        <treeitem>
                            <treerow>
                                <treecell label="AA02"/>
                                <treecell/>
                                <treecell/>
                            </treerow>
                        </treeitem>
                    </treechildren>
                    <treefoot>
                        <treefooter label="footer 1"/>
                        <treefooter label="footer 2"/>
                        <treefooter label="footer 3"/>
                    </treefoot>
                </tree>
            </div>
        </div>
    </div>

    <div sclass="z-mb-6">
        <div sclass="z-fs-label-sm z-fw-semibold z-text-uppercase z-text-secondary z-border-bottom z-pb-2 z-mb-4">Treecols Only and Auxhead Only</div>
        <div sclass="z-py-3">
            <div style="display:flex; gap:16px; align-items:flex-start;">
                <tree width="400px">
                    <treecols>
                        <treecol label="Align Left" align="left"/>
                        <treecol label="Align Center" align="center"/>
                        <treecol label="Align Right" align="right"/>
                    </treecols>
                    <treechildren>
                        <treeitem>
                            <treerow>
                                <treecell label="AA01"/>
                                <treecell label="BB01"/>
                                <treecell label="CC01"/>
                            </treerow>
                        </treeitem>
                    </treechildren>
                    <treefoot>
                        <treefooter label="footer 1"/>
                        <treefooter label="footer width Image" image="~./img/Centigrade-Widget-Icons/BookBlue-16x16.png"
                                    hoverImage="~./img/Centigrade-Widget-Icons/BookGreen-16x16.png"/>
                        <treefooter label="footer 3"/>
                    </treefoot>
                </tree>

                <tree width="400px">
                    <auxhead>
                        <auxheader label="A+B" colspan="2"/>
                        <auxheader label="C"/>
                    </auxhead>
                    <treechildren>
                        <treeitem>
                            <treerow>
                                <treecell label="AA01"/>
                                <treecell label="BB01"/>
                                <treecell label="CC01"/>
                            </treerow>
                        </treeitem>
                    </treechildren>
                    <treefoot>
                        <treefooter label="footer 1"/>
                        <treefooter label="footer width Image" image="~./img/Centigrade-Widget-Icons/BookBlue-16x16.png"
                                    hoverImage="~./img/Centigrade-Widget-Icons/BookGreen-16x16.png"/>
                        <treefooter label="footer 3"/>
                    </treefoot>
                </tree>

                <tree width="400px">
                    <treecols sizable="true">
                        <treecol label="Align Left" align="left"/>
                        <treecol label="Align Center" align="center"/>
                        <treecol label="Align Right" align="right"/>
                    </treecols>
                    <treechildren>
                        <treeitem>
                            <treerow>
                                <treecell label="AA01"/>
                                <treecell label="BB01"/>
                                <treecell label="CC01"/>
                            </treerow>
                        </treeitem>
                    </treechildren>
                    <treefoot>
                        <treefooter label="footer 1"/>
                        <treefooter label="footer width Image" image="~./img/Centigrade-Widget-Icons/BookBlue-16x16.png"
                                    hoverImage="~./img/Centigrade-Widget-Icons/BookGreen-16x16.png"/>
                        <treefooter label="footer 3"/>
                    </treefoot>
                </tree>
            </div>
        </div>
    </div>

    <div sclass="z-mb-6">
        <div sclass="z-fs-label-sm z-fw-semibold z-text-uppercase z-text-secondary z-border-bottom z-pb-2 z-mb-4">Static Sort Direction</div>
        <div sclass="z-py-3">
            <div style="display:flex; gap:16px; align-items:flex-start;">
                <tree width="300px">
                    <treecols>
                        <treecol label="Name (asc)" sort="auto" sortDirection="ascending"/>
                        <treecol label="Type" sort="auto"/>
                    </treecols>
                    <treechildren>
                        <treeitem>
                            <treerow>
                                <treecell label="alpha"/>
                                <treecell label="folder"/>
                            </treerow>
                        </treeitem>
                        <treeitem>
                            <treerow>
                                <treecell label="beta"/>
                                <treecell label="file"/>
                            </treerow>
                        </treeitem>
                    </treechildren>
                </tree>

                <tree width="300px">
                    <treecols>
                        <treecol label="Name" sort="auto"/>
                        <treecol label="Type (desc)" sort="auto" sortDirection="descending"/>
                    </treecols>
                    <treechildren>
                        <treeitem>
                            <treerow>
                                <treecell label="beta"/>
                                <treecell label="folder"/>
                            </treerow>
                        </treeitem>
                        <treeitem>
                            <treerow>
                                <treecell label="alpha"/>
                                <treecell label="file"/>
                            </treerow>
                        </treeitem>
                    </treechildren>
                </tree>
            </div>
        </div>
    </div>

    <div sclass="z-mb-6">
        <div sclass="z-fs-label-sm z-fw-semibold z-text-uppercase z-text-secondary z-border-bottom z-pb-2 z-mb-4">Live Data with Paging</div>
        <div sclass="z-py-3">
            <radiogroup onCheck="tree.pagingPosition = self.selectedItem.label;">
                <radio label="top"/>
                <radio label="bottom" checked="true"/>
                <radio label="both"/>
            </radiogroup>
            <button label="Change Paging Mold">
                <attribute name="onClick">
                    tree.pagingChild.mold = "os".equals(tree.pagingChild.mold) ? "default" : "os";
                </attribute>
            </button>
            <tree id="tree" model="&#36;{btm}" width="400px" mold="paging" pageSize="3">
                <treecols>
                    <treecol label="Align Left" align="left" />
                </treecols>
                <treefoot>
                    <treefooter label="footer width Image" image="~./img/Centigrade-Widget-Icons/BookBlue-16x16.png"
                                hoverImage="~./img/Centigrade-Widget-Icons/BookGreen-16x16.png"/>
                </treefoot>
            </tree>
        </div>
    </div>
</div>
</zk>
