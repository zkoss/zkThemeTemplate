    <apply templateURI="~./pv/decimalbox-content.zul"/>

    <div sclass="z-text-base z-fw-medium z-text-on-surface z-mt-6 z-mb-2">Doublebox</div>
    <apply templateURI="~./pv/doublebox-content.zul"/>

    <div sclass="z-text-base z-fw-medium z-text-on-surface z-mt-6 z-mb-2">Combobox</div>
    <apply templateURI="~./pv/combobox-content.zul"/>

    <div sclass="z-text-base z-fw-medium z-text-on-surface z-mt-6 z-mb-2">Datebox</div>
    <apply templateURI="~./pv/datebox-content.zul"/>

