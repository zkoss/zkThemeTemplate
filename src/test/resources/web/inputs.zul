    <div sclass="z-text-base z-fw-medium z-text-on-surface z-mt-6 z-mb-2">Timepicker</div>
    <apply templateURI="~./pv/timepicker-content.zul"/>

    <div sclass="z-text-base z-fw-medium z-text-on-surface z-mt-6 z-mb-2">Bandbox</div>
    <apply templateURI="~./pv/bandbox-content.zul"/>

    <div sclass="z-text-base z-fw-medium z-text-on-surface z-mt-6 z-mb-2">Spinner</div>
    <apply templateURI="~./pv/spinner-content.zul"/>

    <div sclass="z-text-base z-fw-medium z-text-on-surface z-mt-6 z-mb-2">Selectbox</div>
