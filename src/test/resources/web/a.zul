<?page title="A (Link)" contentType="text/html;charset=UTF-8"?>
<zk xmlns:h="native">
<div sclass="z-p-8">
    <div sclass="z-border-bottom z-text-xl z-fw-medium z-text-on-surface z-mb-8 z-pb-3">A (Link)</div>

    <div sclass="z-mb-6 z-d-grid z-grid-cols-auto z-overflow-x-auto z-col-gap-6 z-row-gap-2 z-align-start" style="--zk-cols:2; --zk-col-min:min-content">
        <div sclass="z-grid-col-full z-text-xs z-fw-semibold z-text-uppercase z-text-secondary z-border-bottom z-pb-2 z-mb-4">States</div>
        <div sclass="z-d-contents">
            <div/>
            <div sclass="z-text-xs z-fw-semibold z-text-secondary">Default</div>
            <div sclass="z-text-xs z-fw-semibold z-text-secondary">Disabled</div>
        </div>
        <div sclass="z-d-contents">
            <div sclass="z-text-sm z-text-secondary">Text link</div>
            <div><a href="https://www.zkoss.org" label="ZK Framework"/></div>
            <div><a href="https://www.zkoss.org" label="ZK Framework" disabled="true"/></div>
        </div>
        <div sclass="z-d-contents">
            <div sclass="z-text-sm z-text-secondary">With icon</div>
            <div><a href="https://www.zkoss.org" label="ZK" iconSclass="z-icon-external-link"/></div>
            <div><a href="https://www.zkoss.org" label="ZK" iconSclass="z-icon-external-link" disabled="true"/></div>
        </div>
    </div>
</div>
</zk>
