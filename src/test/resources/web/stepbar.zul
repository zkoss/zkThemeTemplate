<?page title="Stepbar" contentType="text/html;charset=UTF-8"?>
<zk xmlns:h="native">
<div sclass="z-p-8">
    <div sclass="z-border-bottom z-text-xl z-fw-medium z-text-on-surface z-mb-8 z-pb-3">Stepbar</div>

    <div sclass="z-mb-6">
        <div sclass="z-text-xs z-fw-semibold z-text-uppercase z-text-secondary z-border-bottom z-pb-2 z-mb-4">Basic Stepbar</div>
        <div sclass="z-d-flex z-align-start z-flex-wrap z-gap-6 z-py-3">
            <div sclass="z-d-flex z-flex-col z-align-start z-gap-2">
                <div sclass="z-text-xs z-text-secondary">Active: first step</div>
                <stepbar activeIndex="0" width="600px">
                    <step title="First Step" />
                    <step title="Second Step" />
                    <step title="Third Step"/>
                </stepbar>
            </div>
        </div>
    </div>

    <div sclass="z-mb-6">
        <div sclass="z-text-xs z-fw-semibold z-text-uppercase z-text-secondary z-border-bottom z-pb-2 z-mb-4">Active Index Variants</div>
        <div sclass="z-d-flex z-flex-col z-gap-6 z-py-3">
            <div sclass="z-d-flex z-flex-col z-align-start z-gap-2">
                <div sclass="z-text-xs z-text-secondary">Active: second step</div>
                <stepbar activeIndex="1" width="600px">
                    <step title="First Step" />
                    <step title="Second Step" />
                    <step title="Third Step"/>
                </stepbar>
            </div>
            <div sclass="z-d-flex z-flex-col z-align-start z-gap-2">
                <div sclass="z-text-xs z-text-secondary">Active: third step (complete)</div>
                <stepbar activeIndex="2" width="600px">
                    <step title="First Step" />
                    <step title="Second Step" />
                    <step title="Third Step"/>
                </stepbar>
            </div>
        </div>
    </div>

    <div sclass="z-mb-6">
        <div sclass="z-text-xs z-fw-semibold z-text-uppercase z-text-secondary z-border-bottom z-pb-2 z-mb-4">Error Step</div>
        <div sclass="z-py-3">
            <div sclass="z-d-flex z-flex-col z-align-start z-gap-2">
                <div sclass="z-text-xs z-text-secondary">Middle step in error state (step.error="true")</div>
                <stepbar activeIndex="2" width="600px">
                    <step title="First Step" />
                    <step title="Second Step" error="true"/>
                    <step title="Third Step"/>
                </stepbar>
            </div>
        </div>
    </div>

    <div sclass="z-mb-6">
        <div sclass="z-text-xs z-fw-semibold z-text-uppercase z-text-secondary z-border-bottom z-pb-2 z-mb-4">Vertical Orientation</div>
        <div sclass="z-py-3">
            <div sclass="z-d-flex z-flex-col z-align-start z-gap-2">
                <div sclass="z-text-xs z-text-secondary">orient="vertical" — connector becomes a vertical stripe</div>
                <stepbar activeIndex="1" orient="vertical">
                    <step title="First Step" />
                    <step title="Second Step" />
                    <step title="Third Step"/>
                </stepbar>
            </div>
        </div>
    </div>

    <div sclass="z-mb-6">
        <div sclass="z-text-xs z-fw-semibold z-text-uppercase z-text-secondary z-border-bottom z-pb-2 z-mb-4">Non-Linear (Clickable) Mode</div>
        <div sclass="z-py-3">
            <div sclass="z-d-flex z-flex-col z-align-start z-gap-2">
                <div sclass="z-text-xs z-text-secondary">linear="false" — steps are clickable, cursor: pointer</div>
                <stepbar activeIndex="1" linear="false" width="600px">
                    <step title="First Step" />
                    <step title="Second Step" />
                    <step title="Third Step"/>
                </stepbar>
            </div>
        </div>
    </div>

    <div sclass="z-mb-6">
        <div sclass="z-text-xs z-fw-semibold z-text-uppercase z-text-secondary z-border-bottom z-pb-2 z-mb-4">Wrapped Label</div>
        <div sclass="z-py-3">
            <div sclass="z-d-flex z-flex-col z-align-start z-gap-2">
                <div sclass="z-text-xs z-text-secondary">wrappedLabels="true" — title stacks below icon; long labels wrap</div>
                <stepbar activeIndex="1" wrappedLabels="true" width="600px">
                    <step title="Submit Order Details" />
                    <step title="Review and Confirm Your Purchase" />
                    <step title="Payment Processing" />
                    <step title="Done" />
                </stepbar>
            </div>
        </div>
    </div>

    <div sclass="z-mb-6">
        <div sclass="z-text-xs z-fw-semibold z-text-uppercase z-text-secondary z-border-bottom z-pb-2 z-mb-4">Single-Child Generation</div>
        <div sclass="z-py-3">
            <div sclass="z-d-flex z-flex-col z-align-start z-gap-2">
                <div sclass="z-text-xs z-text-secondary">Single step — no connectors rendered</div>
                <stepbar activeIndex="0" width="600px">
                    <step title="Only Step" />
                </stepbar>
            </div>
        </div>
    </div>

</div>
</zk>
