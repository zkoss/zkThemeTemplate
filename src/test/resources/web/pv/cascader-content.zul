<zk>
<zscript><![CDATA[
    import org.zkoss.zul.DefaultTreeModel;
    import org.zkoss.zul.DefaultTreeNode;
    import org.zkoss.zul.TreeNode;
    import java.util.Arrays;

    DefaultTreeNode preselectedLeaf = new DefaultTreeNode("Kyoto");
    DefaultTreeModel cascaderPreselected = new DefaultTreeModel(new DefaultTreeNode("ROOT",
        Arrays.asList(new DefaultTreeNode[]{
            new DefaultTreeNode("USA", Arrays.asList(new TreeNode[]{
                new DefaultTreeNode("New York"), new DefaultTreeNode("Los Angeles")})),
            new DefaultTreeNode("Japan", Arrays.asList(new TreeNode[]{
                new DefaultTreeNode("Tokyo"), preselectedLeaf})),
            new DefaultTreeNode("New Zealand", Arrays.asList(new TreeNode[]{
                new DefaultTreeNode("Auckland"), new DefaultTreeNode("Queenstown")}))}
        )));
    cascaderPreselected.addToSelection(preselectedLeaf);
]]></zscript>

<apply templateURI="~./pv/matrix.zul" title="States"
       cols="${['Default','Disabled']}"
       rowsTemplate="cascader-rows">
    <template name="cascader-rows">
        <div sclass="z-d-contents">
            <div sclass="z-text-sm z-text-secondary">Default</div>
            <div><cascader model="${cascaderModel}" width="200px"/></div>
            <div><cascader model="${cascaderModel}" disabled="true" width="200px"/></div>
        </div>
    </template>
</apply>

<div sclass="z-mb-6">
    <div sclass="z-text-xs z-fw-semibold z-text-uppercase z-text-secondary z-border-bottom z-pb-2 z-mb-4">Placeholder and Pre-selected Path</div>
    <div sclass="z-d-flex z-flex-wrap z-gap-6 z-py-3">
        <div sclass="z-d-flex z-flex-col z-gap-2">
            <label sclass="z-text-xs z-text-secondary">placeholder (empty)</label>
            <cascader model="${cascaderModel}" placeholder="Select a category" width="220px"/>
        </div>
        <div sclass="z-d-flex z-flex-col z-gap-2">
            <label sclass="z-text-xs z-text-secondary">Pre-selected path (Japan / Kyoto)</label>
            <cascader model="${cascaderPreselected}" width="220px"/>
        </div>
    </div>
</div>
</zk>
