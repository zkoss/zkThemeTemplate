<zk>
<apply templateURI="~./pv/matrix.zul" title="States"
       cols="${['Default','Disabled']}"
       rowsTemplate="selectbox-rows">
    <template name="selectbox-rows">
        <div sclass="z-d-contents">
            <div><label sclass="z-text-sm z-text-secondary" value="Default"/></div>
            <div>
                <selectbox model="${selectModel}">
                    <template name="model">${each}</template>
                </selectbox>
            </div>
            <div>
                <selectbox model="${selectModel}" disabled="true">
                    <template name="model">${each}</template>
                </selectbox>
            </div>
        </div>
    </template>
</apply>

<div sclass="z-mb-6">
    <div sclass="z-text-uppercase z-border-bottom z-pb-2 z-mb-4"><label sclass="z-text-xs z-fw-semibold z-text-secondary" value="Pre-selected Value"/></div>
    <div sclass="z-d-flex z-items-start z-flex-wrap z-gap-6 z-py-3">
        <div sclass="z-d-flex z-flex-col z-items-start z-gap-2">
            <div><label sclass="z-text-xs z-text-secondary" value="selectedIndex=&quot;2&quot; (shows &quot;Charlie&quot; on load)"/></div>
            <selectbox model="${selectModel}" >
                <template name="model">${each}</template>
            </selectbox>
        </div>
    </div>
</div>
</zk>
