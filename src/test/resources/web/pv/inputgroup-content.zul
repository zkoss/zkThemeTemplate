<zk>
<div sclass="z-mb-6">
    <div sclass="z-text-uppercase z-border-bottom z-pb-2 z-mb-4"><label sclass="z-text-xs z-fw-semibold z-text-secondary" value="Examples"/></div>
    <div sclass="z-d-flex z-flex-col z-items-start z-gap-4 z-py-3">
        <div sclass="z-d-flex z-flex-col z-items-start z-gap-2">
            <div><label sclass="z-text-xs z-text-secondary" value="Prefix text"/></div>
            <inputgroup>@<textbox/></inputgroup>
        </div>
        <div sclass="z-d-flex z-flex-col z-items-start z-gap-2">
            <div><label sclass="z-text-xs z-text-secondary" value="Suffix text"/></div>
            <inputgroup><textbox placeholder="Recipient's username"/>@example.com</inputgroup>
        </div>
        <div sclass="z-d-flex z-flex-col z-items-start z-gap-2">
            <div><label sclass="z-text-xs z-text-secondary" value="Both sides"/></div>
            <inputgroup>$<textbox/>.00</inputgroup>
        </div>
        <div sclass="z-d-flex z-flex-col z-items-start z-gap-2">
            <div><label sclass="z-text-xs z-text-secondary" value="Number boxes with prefix and suffix"/></div>
            <inputgroup>$<intbox value="72"/>.00</inputgroup>
            <inputgroup><decimalbox value="72.5"/>kg</inputgroup>
            <inputgroup><doublebox value="1.5"/>m</inputgroup>
            <inputgroup>#<longbox value="1234567"/></inputgroup>
        </div>
        <div sclass="z-d-flex z-flex-col z-items-start z-gap-2">
            <div><label sclass="z-text-xs z-text-secondary" value="With multiline"/></div>
            <inputgroup>
                With textarea
                <textbox multiline="true" rows="3" cols="30"/>
            </inputgroup>
        </div>
        <div sclass="z-d-flex z-flex-col z-items-start z-gap-2">
            <div><label sclass="z-text-xs z-text-secondary" value="Input + Button"/></div>
            <inputgroup>
                <textbox placeholder="Search"/>
                <button label="Go" sclass="z-button-primary"/>
            </inputgroup>
        </div>
    </div>
</div>

<div sclass="z-mb-6">
    <div sclass="z-text-uppercase z-border-bottom z-pb-2 z-mb-4"><label sclass="z-text-xs z-fw-semibold z-text-secondary" value="Disabled State"/></div>
    <div sclass="z-d-flex z-items-start z-flex-wrap z-gap-6 z-py-3">
        <div sclass="z-d-flex z-flex-col z-items-start z-gap-2">
            <div><label sclass="z-text-xs z-text-secondary" value="Prefix + disabled textbox"/></div>
            <inputgroup>@<textbox disabled="true" value="disabled@example.com"/></inputgroup>
        </div>
        <div sclass="z-d-flex z-flex-col z-items-start z-gap-2">
            <div><label sclass="z-text-xs z-text-secondary" value="Both sides + disabled textbox"/></div>
            <inputgroup>$<textbox disabled="true" value="0"/>.00</inputgroup>
        </div>
    </div>
</div>

<div sclass="z-mb-6">
    <div sclass="z-text-uppercase z-border-bottom z-pb-2 z-mb-4"><label sclass="z-text-xs z-fw-semibold z-text-secondary" value="Vertical Orientation"/></div>
    <div sclass="z-d-flex z-items-start z-flex-wrap z-gap-6 z-py-3">
        <div sclass="z-d-flex z-flex-col z-items-start z-gap-2">
            <div><label sclass="z-text-xs z-text-secondary" value="orient=&quot;vertical&quot; (rounded top/bottom corners)"/></div>
            <inputgroup orient="vertical">
                Username
                <textbox placeholder="Enter username"/>
                @example.com
            </inputgroup>
        </div>
    </div>
</div>
</zk>
