<zk>
<!-- A 2D state matrix = label column + N aligned value columns. The grid and its
     responsive behaviour come entirely from the generic framework utilities
     (z-d-grid, z-grid-cols-auto, z-overflow-x-auto) plus the zk-cols / zk-col-min
     custom properties set inline. pv.css only flattens the row wrappers into this
     single grid (see .pv-cols). On a phone the columns hold their min width and
     the table scrolls horizontally. -->
<div sclass="z-mb-6 pv-cols z-d-grid z-grid-cols-auto z-overflow-x-auto" style="--zk-cols:${arg.cols.size()}">
    <div sclass="z-text-xs z-fw-semibold z-text-uppercase z-text-secondary z-border-bottom z-pb-2 z-mb-4">${arg.title}</div>
    <div sclass="pv-col-header-row">
        <div/>
        <forEach items="${arg.cols}" var="col">
            <div sclass="z-text-xs z-fw-semibold z-text-secondary">${col}</div>
        </forEach>
    </div>
    <apply template="${arg.rowsTemplate}"/>
</div>
</zk>
