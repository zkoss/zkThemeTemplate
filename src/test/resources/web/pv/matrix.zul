<div sclass="z-mb-6 pv-cols-${arg.cols.size()}${arg.colsSuffix}">
    <div sclass="z-text-xs z-fw-semibold z-text-uppercase z-text-secondary z-border-bottom z-pb-2 z-mb-4">${arg.title}</div>
    <div sclass="pv-col-header-row z-pb-1">
        <div/>
        <forEach items="${arg.cols}" var="col">
            <div sclass="z-text-xs z-fw-semibold z-text-secondary">${col}</div>
        </forEach>
    </div>
    <apply template="${arg.rowsTemplate}"/>
</div>
