<zk>
<!-- Default-state timepickers set readonly="false" explicitly as a workaround for ZK-6122:
     a bare <timepicker/> renders readonly=true on the client (dropdown-only) even though
     isReadonly() and the docs report the default as false. -->
<div sclass="z-mb-6">
    <div sclass="z-text-xs z-fw-semibold z-text-uppercase z-text-secondary z-border-bottom z-pb-2 z-mb-4">Formats</div>
    <div sclass="z-d-flex z-align-start z-flex-wrap z-gap-6 z-py-3">
        <div sclass="z-d-flex z-flex-col z-align-start z-gap-2">
            <div sclass="z-text-xs z-text-secondary">HH:mm</div>
            <timepicker format="HH:mm" readonly="false"/>
        </div>
        <div sclass="z-d-flex z-flex-col z-align-start z-gap-2">
            <div sclass="z-text-xs z-text-secondary">HH:mm a</div>
            <timepicker format="HH:mm a" readonly="false"/>
        </div>
        <div sclass="z-d-flex z-flex-col z-align-start z-gap-2">
            <div sclass="z-text-xs z-text-secondary">HH:mm:ss</div>
            <timepicker format="HH:mm:ss" readonly="false"/>
        </div>
        <div sclass="z-d-flex z-flex-col z-align-start z-gap-2">
            <div sclass="z-text-xs z-text-secondary">hh:mm:ss a</div>
            <timepicker format="hh:mm:ss a" readonly="false"/>
        </div>
        <!-- Seeded HH:mm:ss content-fit example. ZK hardcodes the input at size="5"
             (fits HH:mm only), so without field-sizing the "10:30:00" value would clip
             (scrollWidth > clientWidth); field-sizing:content lets it hug/grow to fit.
             With the fixed widths removed above, every cell now sizes to its content —
             this seeded cell is one of the timepicker content-fit guard's targets. -->
        <div sclass="z-d-flex z-flex-col z-align-start z-gap-2">
            <div sclass="z-text-xs z-text-secondary">HH:mm:ss (seeded)</div>
            <timepicker format="HH:mm:ss" value="${sampleTime}"/>
        </div>
    </div>
</div>

<apply templateURI="~./pv/matrix.zul" title="States"
       cols="${['Default','Disabled','Readonly','Invalid','Inplace']}"
       rowsTemplate="timepicker-rows">
    <template name="timepicker-rows">
        <div sclass="z-d-contents">
            <div sclass="z-text-sm z-text-secondary">HH:mm</div>
            <div><timepicker format="HH:mm" readonly="false"/></div>
            <div><timepicker format="HH:mm" disabled="true"/></div>
            <div><timepicker format="HH:mm" readonly="true" value="${sampleTime}"/></div>
            <div><timepicker format="HH:mm" value="${sampleTime}">
                <attribute name="onCreate">self.setErrorMessage("Invalid time");</attribute>
            </timepicker></div>
            <div><timepicker format="HH:mm" inplace="true" value="${sampleTime}"/></div>
        </div>
        <div sclass="z-d-contents">
            <div sclass="z-text-sm z-text-secondary">HH:mm:ss</div>
            <div><timepicker format="HH:mm:ss" readonly="false"/></div>
            <div><timepicker format="HH:mm:ss" disabled="true"/></div>
            <div><timepicker format="HH:mm:ss" readonly="true" value="${sampleTime}"/></div>
            <div><timepicker format="HH:mm:ss" value="${sampleTime}">
                <attribute name="onCreate">self.setErrorMessage("Invalid time");</attribute>
            </timepicker></div>
            <div><timepicker format="HH:mm:ss" inplace="true" value="${sampleTime}"/></div>
        </div>
    </template>
</apply>
</zk>
