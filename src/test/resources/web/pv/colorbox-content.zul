<zk>
<apply templateURI="~./pv/matrix.zul" title="States"
       cols="${['Default','Disabled']}"
       rowsTemplate="colorbox-rows">
    <template name="colorbox-rows">
        <div sclass="pv-row z-py-2 z-border-bottom">
            <div sclass="z-fs-label-md z-text-secondary">Default (palette)</div>
            <div><colorbox/></div>
            <div><colorbox disabled="true"/></div>
        </div>
        <div sclass="pv-row z-py-2 z-border-bottom">
            <div sclass="z-fs-label-md z-text-secondary">With value</div>
            <div><colorbox color="#184dc6"/></div>
            <div><colorbox color="#184dc6" disabled="true"/></div>
        </div>
        <div sclass="pv-row z-py-2 z-border-bottom">
            <div sclass="z-fs-label-md z-text-secondary">Open swatch</div>
            <div><colorbox color="#990000"/></div>
            <div>—</div>
        </div>
    </template>
</apply>

<div sclass="z-mb-6">
    <div sclass="z-fs-label-sm z-fw-semibold z-text-uppercase z-text-secondary z-border-bottom z-pb-2 z-mb-4">Colorbox in Menu</div>
    <div sclass="z-py-3">
        <menubar>
            <menuitem label="Color" popup="colorPopup"/>
        </menubar>
        <popup id="colorPopup">
            <vbox spacing="8" style="padding:8px;">
                <label value="Pick a colour:"/>
                <colorbox/>
            </vbox>
        </popup>
    </div>
</div>
</zk>
