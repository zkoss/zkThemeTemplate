<zk>
<apply templateURI="~./pv/matrix.zul" title="States"
       cols="${['Default','Disabled']}"
       rowsTemplate="colorbox-rows">
    <template name="colorbox-rows">
        <div sclass="z-d-contents">
            <div sclass="z-text-sm z-text-secondary">Default (palette)</div>
            <div><colorbox/></div>
            <div><colorbox disabled="true"/></div>
        </div>
        <div sclass="z-d-contents">
            <div sclass="z-text-sm z-text-secondary">With value</div>
            <div><colorbox color="#184dc6"/></div>
            <div><colorbox color="#184dc6" disabled="true"/></div>
        </div>
        <div sclass="z-d-contents">
            <div sclass="z-text-sm z-text-secondary">Open swatch</div>
            <div><colorbox color="#990000"/></div>
            <div>—</div>
        </div>
    </template>
</apply>

<div sclass="z-mb-6">
    <div sclass="z-text-xs z-fw-semibold z-text-uppercase z-text-secondary z-border-bottom z-pb-2 z-mb-4">Colorbox in Menu</div>
    <div sclass="z-py-3">
        <menubar>
            <menu label="Format">
                <menupopup>
                    <menu label="Text Colour" content="#color=#184dc6"/>
                    <menu label="Fill Colour" content="#color=#990000"/>
                    <menuseparator/>
                    <menuitem label="Clear Formatting"/>
                </menupopup>
            </menu>
            <menu label="Quick Colour" content="#color=#2e7d32"/>
        </menubar>
    </div>
</div>
</zk>
