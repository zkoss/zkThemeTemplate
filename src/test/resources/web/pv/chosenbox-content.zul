<zk>
<zscript><![CDATA[
    import org.zkoss.zul.ListModelList;
    ListModelList chosenboxEmpty = new ListModelList(new String[]{
        "Apple", "Banana", "Cherry", "Date", "Elderberry"
    });
    chosenboxEmpty.setMultiple(true);
]]></zscript>

<apply templateURI="~./pv/matrix.zul" title="States"
       cols="${['Default','Disabled']}"
       rowsTemplate="chosenbox-rows">
    <template name="chosenbox-rows">
        <div sclass="z-d-contents">
            <div sclass="z-text-sm z-text-secondary">Multiple</div>
            <div><chosenbox model="${chosenModel}" width="200px"/></div>
            <div><chosenbox model="${chosenModel}" disabled="true" width="200px"/></div>
        </div>
        <div sclass="z-d-contents">
            <div sclass="z-text-sm z-text-secondary">Creatable</div>
            <div><chosenbox creatable="true" noResultsText="No results" createMessage="Add new" width="200px"/></div>
            <div>—</div>
        </div>
    </template>
</apply>

<div sclass="z-mb-6">
    <div sclass="z-text-xs z-fw-semibold z-text-uppercase z-text-secondary z-border-bottom z-pb-2 z-mb-4">Messages and Placeholder</div>
    <div sclass="z-d-flex z-flex-wrap z-gap-6 z-py-3">
        <div sclass="z-d-flex z-flex-col z-gap-2">
            <label sclass="z-text-xs z-text-secondary">emptyMessage (nothing selected)</label>
            <chosenbox model="${chosenboxEmpty}" emptyMessage="Pick one or more…" width="220px"/>
        </div>
        <div sclass="z-d-flex z-flex-col z-gap-2">
            <label sclass="z-text-xs z-text-secondary">createMessage + noResultsText</label>
            <chosenbox model="${chosenboxEmpty}" creatable="true" createMessage="Add new {0}" noResultsText="No matches found" width="220px"/>
        </div>
    </div>
</div>
</zk>
