<zk>
<div sclass="z-mb-6">
    <div sclass="z-text-xs z-fw-semibold z-text-uppercase z-text-secondary z-border-bottom z-pb-2 z-mb-4">Seeded value</div>
    <div sclass="z-d-flex z-flex-wrap z-gap-6 z-py-3">
        <div sclass="z-d-flex z-flex-col z-gap-2">
            <label sclass="z-text-xs z-text-secondary">Seeded value (content-fit)</label>
            <timebox value="${sampleTime}"/>
        </div>
    </div>
</div>

<apply templateURI="~./pv/matrix.zul" title="States"
       cols="${['Default','Disabled','Readonly','Invalid','Inplace']}"
       rowsTemplate="timebox-rows">
    <template name="timebox-rows">
        <div sclass="z-d-contents">
            <div sclass="z-text-sm z-text-secondary">With button</div>
            <div><timebox/></div>
            <div><timebox disabled="true"/></div>
            <div><timebox readonly="true"/></div>
            <div><timebox sclass="z-timebox-invalid"/></div>
            <div><timebox inplace="true" value="${sampleTime}"/></div>
        </div>
        <div sclass="z-d-contents">
            <div sclass="z-text-sm z-text-secondary">No button</div>
            <div><timebox buttonVisible="false"/></div>
            <div><timebox buttonVisible="false" disabled="true"/></div>
            <div><timebox buttonVisible="false" readonly="true"/></div>
            <div><timebox buttonVisible="false" sclass="z-timebox-invalid"/></div>
            <div><timebox buttonVisible="false" inplace="true" value="${sampleTime}"/></div>
        </div>
    </template>
</apply>
</zk>
