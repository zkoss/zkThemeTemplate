<zk>
<apply templateURI="~./pv/matrix.zul" title="Horizontal"
       cols="${['Default']}"
       rowsTemplate="slider-horizontal-rows">
    <template name="slider-horizontal-rows">
        <div sclass="z-d-contents">
            <div><label sclass="z-text-sm z-text-secondary" value="Default"/></div>
            <div><slider width="180px"/></div>
        </div>
        <div sclass="z-d-contents">
            <div><label sclass="z-text-sm z-text-secondary" value="Sphere"/></div>
            <div><slider width="180px" mold="sphere"/></div>
        </div>
        <div sclass="z-d-contents">
            <div><label sclass="z-text-sm z-text-secondary" value="Scale"/></div>
            <div><slider width="180px" mold="scale"/></div>
        </div>
    </template>
</apply>

<apply templateURI="~./pv/matrix.zul" title="Vertical"
       cols="${['Default']}"
       rowsTemplate="slider-vertical-rows">
    <template name="slider-vertical-rows">
        <div sclass="z-d-contents">
            <div><label sclass="z-text-sm z-text-secondary" value="Default"/></div>
            <div><slider orient="vertical" height="120px"/></div>
        </div>
        <div sclass="z-d-contents">
            <div><label sclass="z-text-sm z-text-secondary" value="Sphere"/></div>
            <div><slider orient="vertical" mold="sphere" height="120px"/></div>
        </div>
    </template>
</apply>

<div sclass="z-mb-6">
    <div sclass="z-text-uppercase z-border-bottom z-pb-2 z-mb-4"><label sclass="z-text-xs z-fw-semibold z-text-secondary" value="Knob Mold (PE)"/></div>
    <div sclass="z-d-flex z-items-start z-gap-6 z-py-3">
        <div sclass="z-d-flex z-flex-col z-items-center z-gap-2">
            <slider mold="knob" curpos="40"/>
            <div><label sclass="z-text-xs z-text-secondary" value="40%"/></div>
        </div>
        <div sclass="z-d-flex z-flex-col z-items-center z-gap-2">
            <slider mold="knob" curpos="75"/>
            <div><label sclass="z-text-xs z-text-secondary" value="75%"/></div>
        </div>
    </div>
</div>
</zk>
