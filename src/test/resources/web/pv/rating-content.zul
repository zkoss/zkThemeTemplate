<zk>
<apply templateURI="~./pv/matrix.zul" title="States"
       cols="${['Default','Disabled','Readonly']}"
       rowsTemplate="rating-rows">
    <template name="rating-rows">
        <div sclass="z-d-contents">
            <div><label sclass="z-text-sm z-text-secondary" value="3 stars"/></div>
            <div><rating rating="3"/></div>
            <div><rating rating="3" disabled="true"/></div>
            <div><rating rating="3" readonly="true"/></div>
        </div>
    </template>
</apply>

<div sclass="z-mb-6">
    <div sclass="z-text-uppercase z-border-bottom z-pb-2 z-mb-4"><label sclass="z-text-xs z-fw-semibold z-text-secondary" value="Max Stars"/></div>
    <div sclass="z-d-flex z-items-start z-flex-wrap z-gap-6 z-py-3">
        <div sclass="z-d-flex z-flex-col z-items-start z-gap-2">
            <div><label sclass="z-text-xs z-text-secondary" value="3 max"/></div>
            <rating max="3" rating="2"/>
        </div>
        <div sclass="z-d-flex z-flex-col z-items-start z-gap-2">
            <div><label sclass="z-text-xs z-text-secondary" value="5 max (default)"/></div>
            <rating max="5" rating="3"/>
        </div>
        <div sclass="z-d-flex z-flex-col z-items-start z-gap-2">
            <div><label sclass="z-text-xs z-text-secondary" value="10 max"/></div>
            <rating max="10" rating="7"/>
        </div>
    </div>
</div>

<div sclass="z-mb-6">
    <div sclass="z-text-uppercase z-border-bottom z-pb-2 z-mb-4"><label sclass="z-text-xs z-fw-semibold z-text-secondary" value="Custom Icon (iconSclass)"/></div>
    <div sclass="z-d-flex z-items-start z-flex-wrap z-gap-6 z-py-3">
        <div sclass="z-d-flex z-flex-col z-items-start z-gap-2">
            <div><label sclass="z-text-xs z-text-secondary" value="z-icon-bolt (3/5)"/></div>
            <rating iconSclass="z-icon-bolt" rating="3"/>
        </div>
        <div sclass="z-d-flex z-flex-col z-items-start z-gap-2">
            <div><label sclass="z-text-xs z-text-secondary" value="z-icon-gift (2/5)"/></div>
            <rating iconSclass="z-icon-gift" rating="2"/>
        </div>
    </div>
</div>

<div sclass="z-mb-6">
    <div sclass="z-text-uppercase z-border-bottom z-pb-2 z-mb-4"><label sclass="z-text-xs z-fw-semibold z-text-secondary" value="Vertical"/></div>
    <div sclass="z-d-flex z-items-start z-flex-wrap z-gap-6 z-py-3">
        <div sclass="z-d-flex z-flex-col z-items-start z-gap-2">
            <div><label sclass="z-text-xs z-text-secondary" value="Vertical (3/5)"/></div>
            <rating orient="vertical" rating="3"/>
        </div>
        <div sclass="z-d-flex z-flex-col z-items-start z-gap-2">
            <div><label sclass="z-text-xs z-text-secondary" value="Vertical disabled"/></div>
            <rating orient="vertical" rating="3" disabled="true"/>
        </div>
        <div sclass="z-d-flex z-flex-col z-items-start z-gap-2">
            <div><label sclass="z-text-xs z-text-secondary" value="Vertical readonly"/></div>
            <rating orient="vertical" rating="3" readonly="true"/>
        </div>
    </div>
</div>
</zk>
