<zk>
<div sclass="z-mb-6">
    <div sclass="z-text-xs z-fw-semibold z-text-uppercase z-text-secondary z-border-bottom z-pb-2 z-mb-4">Popup Variants</div>
    <div sclass="z-d-flex z-flex-wrap z-gap-6 z-py-3">
        <div sclass="z-d-flex z-flex-col z-gap-2">
            <label sclass="z-text-xs z-text-secondary">Seeded range</label>
            <daterangebox beginValue="${sampleBegin}" endValue="${sampleEnd}"/>
        </div>
        <div sclass="z-d-flex z-flex-col z-gap-2">
            <label sclass="z-text-xs z-text-secondary">1 month panel</label>
            <daterangebox numberOfMonths="1" beginValue="${sampleBegin}" endValue="${sampleEnd}"/>
        </div>
        <div sclass="z-d-flex z-flex-col z-gap-2">
            <label sclass="z-text-xs z-text-secondary">3 month panels</label>
            <daterangebox numberOfMonths="3" beginValue="${sampleBegin}" endValue="${sampleEnd}"/>
        </div>
        <div sclass="z-d-flex z-flex-col z-gap-2">
            <label sclass="z-text-xs z-text-secondary">Time included</label>
            <daterangebox showTime="true" beginValue="${sampleBegin}" endValue="${sampleEnd}"/>
        </div>
        <div sclass="z-d-flex z-flex-col z-gap-2">
            <label sclass="z-text-xs z-text-secondary">Today link</label>
            <daterangebox showTodayLink="true" beginValue="${sampleBegin}" endValue="${sampleEnd}"/>
        </div>
        <div sclass="z-d-flex z-flex-col z-gap-2">
            <label sclass="z-text-xs z-text-secondary">Clear button (allowEmpty=both)</label>
            <daterangebox allowEmpty="both" beginValue="${sampleBegin}" endValue="${sampleEnd}"/>
        </div>
        <div sclass="z-d-flex z-flex-col z-gap-2">
            <label sclass="z-text-xs z-text-secondary">No trigger button</label>
            <daterangebox buttonVisible="false" beginValue="${sampleBegin}" endValue="${sampleEnd}"/>
        </div>
    </div>
</div>

<!-- The State Matrix is split into two 2-column matrices because a daterangebox is wide
     (two inputs + separator + trigger) and four side-by-side columns overflow. -->
<apply templateURI="~./pv/matrix.zul" title="States — Default / Disabled"
       cols="${['Default','Disabled']}"
       rowsTemplate="dr-rows-basic">
    <template name="dr-rows-basic">
        <div sclass="z-d-contents">
            <div sclass="z-text-sm z-text-secondary">Basic</div>
            <div><daterangebox/></div>
            <div><daterangebox disabled="true"/></div>
        </div>
        <div sclass="z-d-contents">
            <div sclass="z-text-sm z-text-secondary">Seeded range</div>
            <div><daterangebox beginValue="${sampleBegin}" endValue="${sampleEnd}"/></div>
            <div><daterangebox disabled="true" beginValue="${sampleBegin}" endValue="${sampleEnd}"/></div>
        </div>
    </template>
</apply>

<!-- Invalid cells render UNSTYLED: daterangebox drops the user `sclass` (ZK-6133,
     https://zkoss.atlassian.net/browse/ZK-6133), so `.z-daterangebox-invalid` cannot be applied
     declaratively — the real invalid state only appears via an actual unparseable-input validation
     error. The invalid CSS itself is correct (verified by forcing the class in devtools). Make the
     Invalid column a live demo once ZK-6133 is fixed and `sclass` reaches the root. -->
<apply templateURI="~./pv/matrix.zul" title="States — Readonly / Invalid"
       cols="${['Readonly','Invalid']}"
       rowsTemplate="dr-rows-ro-inv">
    <template name="dr-rows-ro-inv">
        <div sclass="z-d-contents">
            <div sclass="z-text-sm z-text-secondary">Basic</div>
            <div><daterangebox readonly="true"/></div>
            <div><daterangebox/></div>
        </div>
        <div sclass="z-d-contents">
            <div sclass="z-text-sm z-text-secondary">Seeded range</div>
            <div><daterangebox readonly="true" beginValue="${sampleBegin}" endValue="${sampleEnd}"/></div>
            <div><daterangebox beginValue="${sampleBegin}" endValue="${sampleEnd}"/></div>
        </div>
    </template>
</apply>
</zk>
