<?page title="Font Awesome Icons"?>
<zk xmlns:h="native">
<style src="~./usecase/usecase.css"/>
<vlayout hflex="1" sclass="z-d-flex z-flex-col z-gap-4 z-p-4 z-bg-surface-low"
         viewModel="@id('vm')@init('zk.example.FontAwesomeIconsVM')">

    <label value="Font Awesome Icons" sclass="z-h2"/>

    <div sclass="z-card">
        <label value="The Font Awesome names ZK bundles"
               sclass="z-d-block z-text-base z-fw-medium z-text-on-surface z-mb-3"/>
        <label value="ZK bundles Font Awesome 6.4.2 under the z-icon- prefix. Every name below is read out of this theme's own compiled stylesheet, so the page always shows what the theme currently serves — not what it is supposed to."
               sclass="z-text-secondary z-text-sm z-d-block z-mb-2"/>
        <label value="Usage: iconSclass=&quot;z-icon-{name}&quot; or sclass=&quot;z-icon-{name}&quot;. Classic glyphs take z-icon-solid alongside the name to select the solid face."
               sclass="z-text-secondary z-text-xs z-d-block"/>
    </div>

    <!-- 1. Classic Solid -->
    <div sclass="z-card">
        <label value="Classic Solid"
               sclass="z-d-block z-text-base z-fw-medium z-text-on-surface"/>
        <label value="@init(vm.solidHeading)"
               sclass="z-d-block z-text-sm z-text-primary z-fw-medium z-mb-3"/>
        <h:div class="z-d-grid z-grid-fill z-grid-fill-xs z-gap-3">
            <forEach items="@init(vm.solidIcons)">
                <apply template="icon-tile" iconClass="z-icon-${each} z-icon-solid"/>
            </forEach>
        </h:div>
    </div>

    <!-- 2. Brand Icons -->
    <div sclass="z-card">
        <label value="Brand Icons"
               sclass="z-d-block z-text-base z-fw-medium z-text-on-surface"/>
        <label value="@init(vm.brandHeading)"
               sclass="z-d-block z-text-sm z-text-primary z-fw-medium z-mb-3"/>
        <h:div class="z-d-grid z-grid-fill z-grid-fill-xs z-gap-3">
            <forEach items="@init(vm.brandIcons)">
                <apply template="icon-tile" iconClass="z-icon-${each}"/>
            </forEach>
        </h:div>
    </div>

    <!-- 3. Animation -->
    <div sclass="z-card">
        <label value="Animation"
               sclass="z-d-block z-text-base z-fw-medium z-text-on-surface"/>
        <label value="@init(vm.animationHeading)"
               sclass="z-d-block z-text-sm z-text-primary z-fw-medium z-mb-2"/>
        <label value="Modifiers, applied alongside a glyph class — shown here on z-icon-0."
               sclass="z-text-secondary z-text-xs z-d-block z-mb-3"/>
        <h:div class="z-d-grid z-grid-fill z-grid-fill-xs z-gap-3">
            <forEach items="@init(vm.animations)">
                <apply template="icon-tile" iconClass="z-icon-0 z-icon-solid z-icon-${each}"/>
            </forEach>
        </h:div>
    </div>

    <!-- Native markup keeps ~2.5k catalog entries off the widget tree; .z-label would
         also override the utility typography on the name. -->
    <template name="icon-tile">
        <h:div class="z-d-flex z-flex-col z-align-center z-text-center z-gap-1">
            <h:i class="${iconClass} z-text-2xl z-text-primary"></h:i>
            <h:div class="z-text-xs z-text-muted">${each}</h:div>
        </h:div>
    </template>

</vlayout>
</zk>
