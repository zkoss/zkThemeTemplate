<?page title="Layout Utilities"?>
<zk>
<style src="~./usecase/usecase.css"/>
<vlayout hflex="1" sclass="z-d-flex z-flex-col z-gap-4 z-p-4 z-bg-surface-low">

    <label value="Layout Utilities" sclass="z-h2"/>

    <!-- Display -->
    <div sclass="z-card">
        <label value="Display  (.z-d-*)" sclass="z-d-block z-text-base z-fw-medium z-text-on-surface z-mb-3"/>
        <div sclass="z-d-flex z-gap-4 z-flex-wrap z-align-start">
            <div>
                <div class="z-bg-surface-low z-rounded z-p-3 z-border">
                    <div class="z-bg-primary-container z-rounded-xs z-py-2 z-px-3 z-text-sm z-fw-medium z-text-nowrap z-d-block" style="margin-bottom:4px">z-d-block (fills row)</div>
                    <div class="z-bg-primary-container z-rounded-xs z-py-2 z-px-3 z-text-sm z-fw-medium z-text-nowrap z-d-inline" style="margin-right:4px">z-d-inline</div>
                    <div class="z-bg-primary-container z-rounded-xs z-py-2 z-px-3 z-text-sm z-fw-medium z-text-nowrap z-d-inline">z-d-inline</div>
                </div>
                <label value=".z-d-block / .z-d-inline" sclass="z-text-muted z-text-xs z-mt-1"/>
            </div>
            <div>
                <div class="z-bg-surface-low z-rounded z-p-3 z-border">
                    <div class="z-bg-primary-container z-rounded-xs z-py-2 z-px-3 z-text-sm z-fw-medium z-text-nowrap z-d-inline-block" style="margin-right:4px">z-d-inline-block</div>
                    <div class="z-bg-primary-container z-rounded-xs z-py-2 z-px-3 z-text-sm z-fw-medium z-text-nowrap z-d-inline-block">z-d-inline-block</div>
                </div>
                <label value=".z-d-inline-block — inline flow, box sizing" sclass="z-text-muted z-text-xs z-mt-1"/>
            </div>
            <div>
                <div class="z-bg-surface-low z-rounded z-p-3 z-border z-d-flex z-gap-2">
                    <div class="z-bg-primary-container z-rounded-xs z-py-2 z-px-3 z-text-sm z-fw-medium z-text-nowrap">Item 1</div>
                    <div class="z-bg-primary-container z-rounded-xs z-py-2 z-px-3 z-text-sm z-fw-medium z-text-nowrap">Item 2</div>
                    <div class="z-bg-primary-container z-rounded-xs z-py-2 z-px-3 z-text-sm z-fw-medium z-text-nowrap">Item 3</div>
                </div>
                <label value=".z-d-flex" sclass="z-text-muted z-text-xs z-mt-1"/>
            </div>
            <div>
                <div class="z-bg-surface-low z-rounded z-p-3 z-border z-d-inline-flex z-gap-2">
                    <div class="z-bg-primary-container z-rounded-xs z-py-2 z-px-3 z-text-sm z-fw-medium z-text-nowrap">A</div>
                    <div class="z-bg-primary-container z-rounded-xs z-py-2 z-px-3 z-text-sm z-fw-medium z-text-nowrap">B</div>
                </div>
                <label value=".z-d-inline-flex — flex box that flows inline" sclass="z-text-muted z-text-xs z-mt-1"/>
            </div>
            <div>
                <div class="z-bg-surface-low z-rounded z-p-3 z-border z-d-grid z-gap-2" style="grid-template-columns:repeat(2, 1fr)">
                    <div class="z-bg-primary-container z-rounded-xs z-py-2 z-px-3 z-text-sm z-fw-medium z-text-nowrap">A</div>
                    <div class="z-bg-primary-container z-rounded-xs z-py-2 z-px-3 z-text-sm z-fw-medium z-text-nowrap">B</div>
                    <div class="z-bg-primary-container z-rounded-xs z-py-2 z-px-3 z-text-sm z-fw-medium z-text-nowrap">C</div>
                    <div class="z-bg-primary-container z-rounded-xs z-py-2 z-px-3 z-text-sm z-fw-medium z-text-nowrap">D</div>
                </div>
                <label value=".z-d-grid" sclass="z-text-muted z-text-xs z-mt-1"/>
            </div>
            <div>
                <div class="z-bg-surface-low z-rounded z-p-3 z-border z-d-flex z-gap-2 z-align-center">
                    <div class="z-bg-primary-container z-rounded-xs z-py-2 z-px-3 z-text-sm z-fw-medium z-text-nowrap z-d-none">B (hidden)</div>
                    <div class="z-bg-primary-container z-rounded-xs z-py-2 z-px-3 z-text-sm z-fw-medium z-text-nowrap">visible sibling</div>
                </div>
                <label value=".z-d-none — removed from layout (first chip hidden)" sclass="z-text-muted z-text-xs z-mt-1"/>
            </div>
        </div>
    </div>

    <!-- Grid: template columns -->
    <div sclass="z-card">
        <label value="Grid — Template Columns  (.z-grid-cols-*)" sclass="z-d-block z-text-base z-fw-medium z-text-on-surface z-mb-3"/>
        <vlayout sclass="z-gap-3">
            <div>
                <div class="z-bg-surface-low z-rounded z-p-3 z-border z-d-grid z-grid-cols-1 z-gap-2">
                    <div class="z-bg-primary-container z-rounded-xs z-py-2 z-px-3 z-text-sm z-fw-medium z-text-nowrap">1</div>
                </div>
                <label value=".z-grid-cols-1 — single full-width column" sclass="z-text-muted z-text-xs"/>
            </div>
            <div>
                <div class="z-bg-surface-low z-rounded z-p-3 z-border z-d-grid z-grid-cols-2 z-gap-2">
                    <div class="z-bg-primary-container z-rounded-xs z-py-2 z-px-3 z-text-sm z-fw-medium z-text-nowrap">1</div><div class="z-bg-primary-container z-rounded-xs z-py-2 z-px-3 z-text-sm z-fw-medium z-text-nowrap">2</div>
                </div>
                <label value=".z-grid-cols-2 — two equal columns" sclass="z-text-muted z-text-xs"/>
            </div>
            <div>
                <div class="z-bg-surface-low z-rounded z-p-3 z-border z-d-grid z-grid-cols-3 z-gap-2">
                    <div class="z-bg-primary-container z-rounded-xs z-py-2 z-px-3 z-text-sm z-fw-medium z-text-nowrap">1</div><div class="z-bg-primary-container z-rounded-xs z-py-2 z-px-3 z-text-sm z-fw-medium z-text-nowrap">2</div><div class="z-bg-primary-container z-rounded-xs z-py-2 z-px-3 z-text-sm z-fw-medium z-text-nowrap">3</div>
                </div>
                <label value=".z-grid-cols-3" sclass="z-text-muted z-text-xs"/>
            </div>
            <div>
                <div class="z-bg-surface-low z-rounded z-p-3 z-border z-d-grid z-grid-cols-4 z-gap-2">
                    <div class="z-bg-primary-container z-rounded-xs z-py-2 z-px-3 z-text-sm z-fw-medium z-text-nowrap">1</div><div class="z-bg-primary-container z-rounded-xs z-py-2 z-px-3 z-text-sm z-fw-medium z-text-nowrap">2</div><div class="z-bg-primary-container z-rounded-xs z-py-2 z-px-3 z-text-sm z-fw-medium z-text-nowrap">3</div><div class="z-bg-primary-container z-rounded-xs z-py-2 z-px-3 z-text-sm z-fw-medium z-text-nowrap">4</div>
                </div>
                <label value=".z-grid-cols-4" sclass="z-text-muted z-text-xs"/>
            </div>
            <div>
                <div class="z-bg-surface-low z-rounded z-p-3 z-border z-d-grid z-grid-cols-5 z-gap-2">
                    <div class="z-bg-primary-container z-rounded-xs z-py-2 z-px-3 z-text-sm z-fw-medium z-text-nowrap">1</div><div class="z-bg-primary-container z-rounded-xs z-py-2 z-px-3 z-text-sm z-fw-medium z-text-nowrap">2</div><div class="z-bg-primary-container z-rounded-xs z-py-2 z-px-3 z-text-sm z-fw-medium z-text-nowrap">3</div><div class="z-bg-primary-container z-rounded-xs z-py-2 z-px-3 z-text-sm z-fw-medium z-text-nowrap">4</div><div class="z-bg-primary-container z-rounded-xs z-py-2 z-px-3 z-text-sm z-fw-medium z-text-nowrap">5</div>
                </div>
                <label value=".z-grid-cols-5" sclass="z-text-muted z-text-xs"/>
            </div>
            <div>
                <div class="z-bg-surface-low z-rounded z-p-3 z-border z-d-grid z-grid-cols-6 z-gap-2">
                    <div class="z-bg-primary-container z-rounded-xs z-py-2 z-px-3 z-text-sm z-fw-medium z-text-nowrap">1</div><div class="z-bg-primary-container z-rounded-xs z-py-2 z-px-3 z-text-sm z-fw-medium z-text-nowrap">2</div><div class="z-bg-primary-container z-rounded-xs z-py-2 z-px-3 z-text-sm z-fw-medium z-text-nowrap">3</div><div class="z-bg-primary-container z-rounded-xs z-py-2 z-px-3 z-text-sm z-fw-medium z-text-nowrap">4</div><div class="z-bg-primary-container z-rounded-xs z-py-2 z-px-3 z-text-sm z-fw-medium z-text-nowrap">5</div><div class="z-bg-primary-container z-rounded-xs z-py-2 z-px-3 z-text-sm z-fw-medium z-text-nowrap">6</div>
                </div>
                <label value=".z-grid-cols-6 — repeat(N, minmax(0,1fr))" sclass="z-text-muted z-text-xs"/>
            </div>
            <div>
                <div class="z-bg-surface-low z-rounded z-p-3 z-border z-d-grid z-grid-cols-auto-1fr z-gap-2 z-align-center">
                    <div class="z-bg-secondary-container z-rounded-xs z-py-2 z-px-3 z-text-sm z-fw-medium z-text-nowrap">Label</div><div class="z-bg-primary-container z-rounded-xs z-py-2 z-px-3 z-text-sm z-fw-medium z-text-nowrap">value fills remaining width</div>
                    <div class="z-bg-secondary-container z-rounded-xs z-py-2 z-px-3 z-text-sm z-fw-medium z-text-nowrap">Longer label</div><div class="z-bg-primary-container z-rounded-xs z-py-2 z-px-3 z-text-sm z-fw-medium z-text-nowrap">value</div>
                </div>
                <label value=".z-grid-cols-auto-1fr — auto label column + 1fr value column" sclass="z-text-muted z-text-xs"/>
            </div>
            <div>
                <div class="z-bg-surface-low z-rounded z-p-3 z-border z-d-grid z-grid-cols-auto z-gap-2 z-align-center" style="--zk-cols: 4">
                    <div class="z-bg-secondary-container z-rounded-xs z-py-2 z-px-3 z-text-sm z-fw-medium z-text-nowrap">Row A</div><div class="z-bg-primary-container z-rounded-xs z-py-2 z-px-3 z-text-sm z-fw-medium z-text-nowrap z-text-center">1</div><div class="z-bg-primary-container z-rounded-xs z-py-2 z-px-3 z-text-sm z-fw-medium z-text-nowrap z-text-center">2</div><div class="z-bg-primary-container z-rounded-xs z-py-2 z-px-3 z-text-sm z-fw-medium z-text-nowrap z-text-center">3</div><div class="z-bg-primary-container z-rounded-xs z-py-2 z-px-3 z-text-sm z-fw-medium z-text-nowrap z-text-center">4</div>
                    <div class="z-bg-secondary-container z-rounded-xs z-py-2 z-px-3 z-text-sm z-fw-medium z-text-nowrap">Row B</div><div class="z-bg-primary-container z-rounded-xs z-py-2 z-px-3 z-text-sm z-fw-medium z-text-nowrap z-text-center">5</div><div class="z-bg-primary-container z-rounded-xs z-py-2 z-px-3 z-text-sm z-fw-medium z-text-nowrap z-text-center">6</div><div class="z-bg-primary-container z-rounded-xs z-py-2 z-px-3 z-text-sm z-fw-medium z-text-nowrap z-text-center">7</div><div class="z-bg-primary-container z-rounded-xs z-py-2 z-px-3 z-text-sm z-fw-medium z-text-nowrap z-text-center">8</div>
                </div>
                <label value=".z-grid-cols-auto — auto label column + N fill columns; set N via style=&quot;--zk-cols: 4&quot;" sclass="z-text-muted z-text-xs"/>
            </div>
        </vlayout>
    </div>

    <!-- Grid: auto-fit fill -->
    <div sclass="z-card">
        <label value="Grid — Auto-fit Fill  (.z-grid-fill / .z-grid-fill-*)" sclass="z-d-block z-text-base z-fw-medium z-text-on-surface z-mb-3"/>
        <vlayout sclass="z-gap-3">
            <div>
                <div class="z-bg-surface-low z-rounded z-p-3 z-border z-d-grid z-grid-fill z-grid-fill-sm z-gap-3">
                    <div class="z-bg-primary-container z-rounded-xs z-py-2 z-px-3 z-text-sm z-fw-medium z-text-nowrap z-text-center">1</div><div class="z-bg-primary-container z-rounded-xs z-py-2 z-px-3 z-text-sm z-fw-medium z-text-nowrap z-text-center">2</div><div class="z-bg-primary-container z-rounded-xs z-py-2 z-px-3 z-text-sm z-fw-medium z-text-nowrap z-text-center">3</div><div class="z-bg-primary-container z-rounded-xs z-py-2 z-px-3 z-text-sm z-fw-medium z-text-nowrap z-text-center">4</div><div class="z-bg-primary-container z-rounded-xs z-py-2 z-px-3 z-text-sm z-fw-medium z-text-nowrap z-text-center">5</div><div class="z-bg-primary-container z-rounded-xs z-py-2 z-px-3 z-text-sm z-fw-medium z-text-nowrap z-text-center">6</div><div class="z-bg-primary-container z-rounded-xs z-py-2 z-px-3 z-text-sm z-fw-medium z-text-nowrap z-text-center">7</div><div class="z-bg-primary-container z-rounded-xs z-py-2 z-px-3 z-text-sm z-fw-medium z-text-nowrap z-text-center">8</div>
                </div>
                <label value=".z-grid-fill .z-grid-fill-sm — min 140px columns, wrap to fit (resize the window)" sclass="z-text-muted z-text-xs"/>
            </div>
            <div>
                <div class="z-bg-surface-low z-rounded z-p-3 z-border z-d-grid z-grid-fill z-grid-fill-xs z-gap-3">
                    <div class="z-bg-primary-container z-rounded-xs z-py-2 z-px-3 z-text-sm z-fw-medium z-text-nowrap z-text-center">1</div><div class="z-bg-primary-container z-rounded-xs z-py-2 z-px-3 z-text-sm z-fw-medium z-text-nowrap z-text-center">2</div><div class="z-bg-primary-container z-rounded-xs z-py-2 z-px-3 z-text-sm z-fw-medium z-text-nowrap z-text-center">3</div><div class="z-bg-primary-container z-rounded-xs z-py-2 z-px-3 z-text-sm z-fw-medium z-text-nowrap z-text-center">4</div><div class="z-bg-primary-container z-rounded-xs z-py-2 z-px-3 z-text-sm z-fw-medium z-text-nowrap z-text-center">5</div><div class="z-bg-primary-container z-rounded-xs z-py-2 z-px-3 z-text-sm z-fw-medium z-text-nowrap z-text-center">6</div><div class="z-bg-primary-container z-rounded-xs z-py-2 z-px-3 z-text-sm z-fw-medium z-text-nowrap z-text-center">7</div><div class="z-bg-primary-container z-rounded-xs z-py-2 z-px-3 z-text-sm z-fw-medium z-text-nowrap z-text-center">8</div>
                </div>
                <label value=".z-grid-fill-xs — min 96px (dense gallery)" sclass="z-text-muted z-text-xs"/>
            </div>
            <div>
                <div class="z-bg-surface-low z-rounded z-p-3 z-border z-d-grid z-grid-fill z-grid-fill-lg z-gap-3">
                    <div class="z-bg-primary-container z-rounded-xs z-py-2 z-px-3 z-text-sm z-fw-medium z-text-nowrap z-text-center">Card 1</div><div class="z-bg-primary-container z-rounded-xs z-py-2 z-px-3 z-text-sm z-fw-medium z-text-nowrap z-text-center">Card 2</div><div class="z-bg-primary-container z-rounded-xs z-py-2 z-px-3 z-text-sm z-fw-medium z-text-nowrap z-text-center">Card 3</div><div class="z-bg-primary-container z-rounded-xs z-py-2 z-px-3 z-text-sm z-fw-medium z-text-nowrap z-text-center">Card 4</div>
                </div>
                <label value=".z-grid-fill-lg — min 240px (wide cards)" sclass="z-text-muted z-text-xs"/>
            </div>
            <div>
                <div class="z-bg-surface-low z-rounded z-p-3 z-border z-d-grid z-grid-fill z-grid-fill-xl z-gap-3">
                    <div class="z-bg-primary-container z-rounded-xs z-py-2 z-px-3 z-text-sm z-fw-medium z-text-nowrap z-text-center">Panel 1</div><div class="z-bg-primary-container z-rounded-xs z-py-2 z-px-3 z-text-sm z-fw-medium z-text-nowrap z-text-center">Panel 2</div><div class="z-bg-primary-container z-rounded-xs z-py-2 z-px-3 z-text-sm z-fw-medium z-text-nowrap z-text-center">Panel 3</div>
                </div>
                <label value=".z-grid-fill-xl — min 320px (large panels)" sclass="z-text-muted z-text-xs"/>
            </div>
            <div>
                <div class="z-bg-surface-low z-rounded z-p-3 z-border z-d-grid z-grid-fill z-gap-3" style="--zk-grid-min: 220px">
                    <div class="z-bg-primary-container z-rounded-xs z-py-2 z-px-3 z-text-sm z-fw-medium z-text-nowrap z-text-center">A</div><div class="z-bg-primary-container z-rounded-xs z-py-2 z-px-3 z-text-sm z-fw-medium z-text-nowrap z-text-center">B</div><div class="z-bg-primary-container z-rounded-xs z-py-2 z-px-3 z-text-sm z-fw-medium z-text-nowrap z-text-center">C</div>
                </div>
                <label value=".z-grid-fill with inline override style=&quot;--zk-grid-min: 220px&quot;" sclass="z-text-muted z-text-xs"/>
            </div>
        </vlayout>
    </div>

    <!-- Flex Direction -->
    <div sclass="z-card">
        <label value="Flex Direction  (.z-flex-row / .z-flex-col)" sclass="z-d-block z-text-base z-fw-medium z-text-on-surface z-mb-3"/>
        <div sclass="z-d-flex z-gap-6 z-flex-wrap">
            <div>
                <div class="z-bg-surface-low z-rounded z-p-3 z-border z-d-flex z-flex-row z-gap-2">
                    <div class="z-bg-primary-container z-rounded-xs z-py-2 z-px-3 z-text-sm z-fw-medium z-text-nowrap">A</div>
                    <div class="z-bg-primary-container z-rounded-xs z-py-2 z-px-3 z-text-sm z-fw-medium z-text-nowrap">B</div>
                    <div class="z-bg-primary-container z-rounded-xs z-py-2 z-px-3 z-text-sm z-fw-medium z-text-nowrap">C</div>
                </div>
                <label value=".z-flex-row" sclass="z-text-muted z-text-xs z-mt-1"/>
            </div>
            <div>
                <div class="z-bg-surface-low z-rounded z-p-3 z-border z-d-flex z-flex-col z-gap-2" style="width:80px">
                    <div class="z-bg-primary-container z-rounded-xs z-py-2 z-px-3 z-text-sm z-fw-medium z-text-nowrap z-text-center">A</div>
                    <div class="z-bg-primary-container z-rounded-xs z-py-2 z-px-3 z-text-sm z-fw-medium z-text-nowrap z-text-center">B</div>
                    <div class="z-bg-primary-container z-rounded-xs z-py-2 z-px-3 z-text-sm z-fw-medium z-text-nowrap z-text-center">C</div>
                </div>
                <label value=".z-flex-col" sclass="z-text-muted z-text-xs z-mt-1"/>
            </div>
            <div>
                <div class="z-bg-surface-low z-rounded z-p-3 z-border z-d-flex z-flex-row-reverse z-gap-2">
                    <div class="z-bg-primary-container z-rounded-xs z-py-2 z-px-3 z-text-sm z-fw-medium z-text-nowrap">A</div>
                    <div class="z-bg-primary-container z-rounded-xs z-py-2 z-px-3 z-text-sm z-fw-medium z-text-nowrap">B</div>
                    <div class="z-bg-primary-container z-rounded-xs z-py-2 z-px-3 z-text-sm z-fw-medium z-text-nowrap">C</div>
                </div>
                <label value=".z-flex-row-reverse" sclass="z-text-muted z-text-xs z-mt-1"/>
            </div>
            <div>
                <div class="z-bg-surface-low z-rounded z-p-3 z-border z-d-flex z-flex-col-reverse z-gap-2" style="width:80px">
                    <div class="z-bg-primary-container z-rounded-xs z-py-2 z-px-3 z-text-sm z-fw-medium z-text-nowrap z-text-center">A</div>
                    <div class="z-bg-primary-container z-rounded-xs z-py-2 z-px-3 z-text-sm z-fw-medium z-text-nowrap z-text-center">B</div>
                    <div class="z-bg-primary-container z-rounded-xs z-py-2 z-px-3 z-text-sm z-fw-medium z-text-nowrap z-text-center">C</div>
                </div>
                <label value=".z-flex-col-reverse" sclass="z-text-muted z-text-xs z-mt-1"/>
            </div>
        </div>
    </div>

    <!-- Justify Content -->
    <div sclass="z-card">
        <label value="Justify Content  (.z-justify-*)" sclass="z-d-block z-text-base z-fw-medium z-text-on-surface z-mb-3"/>
        <vlayout sclass="z-gap-3">
            <div>
                <div class="z-bg-surface-low z-rounded z-p-3 z-border z-d-flex z-justify-start z-gap-2">
                    <div class="z-bg-primary-container z-rounded-xs z-py-2 z-px-3 z-text-sm z-fw-medium z-text-nowrap">A</div><div class="z-bg-primary-container z-rounded-xs z-py-2 z-px-3 z-text-sm z-fw-medium z-text-nowrap">B</div><div class="z-bg-primary-container z-rounded-xs z-py-2 z-px-3 z-text-sm z-fw-medium z-text-nowrap">C</div>
                </div>
                <label value=".z-justify-start" sclass="z-text-muted z-text-xs"/>
            </div>
            <div>
                <div class="z-bg-surface-low z-rounded z-p-3 z-border z-d-flex z-justify-center z-gap-2">
                    <div class="z-bg-primary-container z-rounded-xs z-py-2 z-px-3 z-text-sm z-fw-medium z-text-nowrap">A</div><div class="z-bg-primary-container z-rounded-xs z-py-2 z-px-3 z-text-sm z-fw-medium z-text-nowrap">B</div><div class="z-bg-primary-container z-rounded-xs z-py-2 z-px-3 z-text-sm z-fw-medium z-text-nowrap">C</div>
                </div>
                <label value=".z-justify-center" sclass="z-text-muted z-text-xs"/>
            </div>
            <div>
                <div class="z-bg-surface-low z-rounded z-p-3 z-border z-d-flex z-justify-end z-gap-2">
                    <div class="z-bg-primary-container z-rounded-xs z-py-2 z-px-3 z-text-sm z-fw-medium z-text-nowrap">A</div><div class="z-bg-primary-container z-rounded-xs z-py-2 z-px-3 z-text-sm z-fw-medium z-text-nowrap">B</div><div class="z-bg-primary-container z-rounded-xs z-py-2 z-px-3 z-text-sm z-fw-medium z-text-nowrap">C</div>
                </div>
                <label value=".z-justify-end" sclass="z-text-muted z-text-xs"/>
            </div>
            <div>
