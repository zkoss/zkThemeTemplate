                <div class="z-bg-surface-low z-rounded z-p-3 z-border z-d-flex z-flex-col z-gap-2" style="width:320px">
                    <div class="z-bg-primary-container z-rounded-xs z-py-2 z-px-3 z-text-sm z-fw-medium z-text-nowrap z-w-25">z-w-25</div>
                    <div class="z-bg-primary-container z-rounded-xs z-py-2 z-px-3 z-text-sm z-fw-medium z-text-nowrap z-w-50">z-w-50</div>
                    <div class="z-bg-primary-container z-rounded-xs z-py-2 z-px-3 z-text-sm z-fw-medium z-text-nowrap z-w-75">z-w-75</div>
                    <div class="z-bg-primary-container z-rounded-xs z-py-2 z-px-3 z-text-sm z-fw-medium z-text-nowrap z-w-full">z-w-full</div>
                    <div class="z-bg-primary-container z-rounded-xs z-py-2 z-px-3 z-text-sm z-fw-medium z-text-nowrap z-w-auto">z-w-auto (content)</div>
                </div>
                <label value=".z-w-25 / 50 / 75 / full / auto — % of a 320px parent" sclass="z-text-muted z-text-xs"/>
            </div>
            <div>
                <div class="z-bg-surface-low z-rounded z-p-3 z-border z-d-flex z-align-end z-gap-2" style="height:140px">
                    <div class="z-bg-primary-container z-rounded-xs z-px-3 z-text-sm z-fw-medium z-text-nowrap z-h-25 z-d-flex z-align-center">25</div>
                    <div class="z-bg-primary-container z-rounded-xs z-px-3 z-text-sm z-fw-medium z-text-nowrap z-h-50 z-d-flex z-align-center">50</div>
                    <div class="z-bg-primary-container z-rounded-xs z-px-3 z-text-sm z-fw-medium z-text-nowrap z-h-75 z-d-flex z-align-center">75</div>
                    <div class="z-bg-primary-container z-rounded-xs z-px-3 z-text-sm z-fw-medium z-text-nowrap z-h-full z-d-flex z-align-center">full</div>
                    <div class="z-bg-primary-container z-rounded-xs z-py-2 z-px-3 z-text-sm z-fw-medium z-text-nowrap z-h-auto z-d-flex z-align-center">auto</div>
                </div>
                <label value=".z-h-25 / 50 / 75 / full / auto — % of a 140px parent" sclass="z-text-muted z-text-xs"/>
            </div>
            <div>
                <div class="z-bg-surface-low z-rounded z-p-3 z-border z-d-flex z-gap-2 z-align-center" style="width:260px">
                    <div class="z-bg-secondary-container z-rounded-xs z-py-2 z-px-3 z-text-sm z-fw-medium z-text-nowrap z-flex-shrink-0">icon</div>
                    <div class="z-bg-primary-container z-rounded-xs z-py-2 z-px-3 z-text-sm z-fw-medium z-text-truncate z-flex-1 z-min-w-0">z-min-w-0 lets this long label truncate instead of overflowing</div>
                </div>
                <label value=".z-min-w-0 — allows a flex child to shrink below content width (enables truncation)" sclass="z-text-muted z-text-xs"/>
            </div>
            <div>
                <div class="z-bg-surface-low z-rounded z-p-2 z-border z-d-flex z-flex-col" style="height:120px">
                    <div class="z-bg-secondary-container z-rounded-xs z-py-1 z-px-2 z-text-xs z-fw-medium z-text-nowrap z-flex-none">fixed header</div>
                    <div class="z-overflow-y-auto z-flex-1 z-min-h-0 z-mt-1">
                        <div class="z-bg-primary-container z-rounded-xs z-p-2 z-text-sm z-fw-medium" style="height:220px">z-min-h-0 lets this flex child shrink and scroll</div>
                    </div>
                </div>
                <label value=".z-min-h-0 — allows a flex child to shrink below content height (enables inner scroll)" sclass="z-text-muted z-text-xs"/>
            </div>
        </div>
    </div>

    <!-- Overflow -->
    <div sclass="z-card">
        <label value="Overflow  (.z-overflow-* / .z-overflow-x-* / .z-overflow-y-*)" sclass="z-d-block z-text-base z-fw-medium z-text-on-surface z-mb-3"/>
        <div sclass="z-d-flex z-gap-6 z-flex-wrap">
            <div>
                <div class="z-bg-surface-low z-rounded z-border z-overflow-auto z-p-2" style="width:140px;height:90px">
                    <div class="z-bg-primary-container z-rounded-xs z-p-3 z-text-sm z-fw-medium" style="width:240px;height:160px">scrolls both ways</div>
                </div>
                <label value=".z-overflow-auto — scrollbars appear when needed" sclass="z-text-muted z-text-xs"/>
            </div>
            <div>
                <div class="z-bg-surface-low z-rounded z-border z-overflow-hidden z-p-2" style="width:140px;height:90px">
                    <div class="z-bg-primary-container z-rounded-xs z-p-3 z-text-sm z-fw-medium" style="width:240px;height:160px">clipped</div>
                </div>
                <label value=".z-overflow-hidden — content clipped, no scroll" sclass="z-text-muted z-text-xs"/>
            </div>
            <div>
                <div class="z-bg-surface-low z-rounded z-border z-overflow-scroll z-p-2" style="width:140px;height:90px">
                    <div class="z-bg-primary-container z-rounded-xs z-p-3 z-text-sm z-fw-medium" style="width:240px;height:160px">always scroll</div>
                </div>
                <label value=".z-overflow-scroll — scrollbars always shown" sclass="z-text-muted z-text-xs"/>
            </div>
            <div>
                <div class="z-bg-surface-low z-rounded z-border z-overflow-x-auto z-overflow-y-hidden z-p-2" style="width:140px;height:64px">
                    <div class="z-bg-primary-container z-rounded-xs z-p-3 z-text-sm z-fw-medium z-text-nowrap" style="width:280px">horizontal only</div>
                </div>
                <label value=".z-overflow-x-auto + .z-overflow-y-hidden" sclass="z-text-muted z-text-xs"/>
            </div>
            <div>
                <div class="z-bg-surface-low z-rounded z-border z-overflow-y-auto z-overflow-x-hidden z-p-2" style="width:140px;height:90px">
                    <div class="z-bg-primary-container z-rounded-xs z-p-3 z-text-sm z-fw-medium" style="height:180px">vertical only</div>
                </div>
                <label value=".z-overflow-y-auto + .z-overflow-x-hidden" sclass="z-text-muted z-text-xs"/>
            </div>
            <div>
                <div class="z-bg-surface-low z-rounded z-border z-overflow-visible z-p-2" style="width:140px;height:64px">
                    <div class="z-bg-primary-container z-rounded-xs z-p-2 z-text-sm z-fw-medium z-text-nowrap">content spills outside the box</div>
                </div>
                <label value=".z-overflow-visible — content renders outside the box (default)" sclass="z-text-muted z-text-xs"/>
            </div>
        </div>
    </div>

    <!-- Position -->
    <div sclass="z-card">
        <label value="Position  (.z-position-* / .z-top-0 / .z-bottom-0 / .z-start-0 / .z-end-0)" sclass="z-d-block z-text-base z-fw-medium z-text-on-surface z-mb-3"/>
        <div sclass="z-d-flex z-gap-6 z-flex-wrap">
            <div>
                <div class="z-bg-surface-low z-rounded z-border z-position-relative" style="width:240px;height:140px">
                    <div class="z-bg-primary-container z-rounded-xs z-py-1 z-px-2 z-text-xs z-fw-medium z-text-nowrap z-position-absolute z-top-0 z-start-0" style="margin:6px">top-0 start-0</div>
                    <div class="z-bg-primary-container z-rounded-xs z-py-1 z-px-2 z-text-xs z-fw-medium z-text-nowrap z-position-absolute z-top-0 z-end-0" style="margin:6px">top-0 end-0</div>
                    <div class="z-bg-primary-container z-rounded-xs z-py-1 z-px-2 z-text-xs z-fw-medium z-text-nowrap z-position-absolute z-bottom-0 z-start-0" style="margin:6px">bottom-0 start-0</div>
                    <div class="z-bg-primary-container z-rounded-xs z-py-1 z-px-2 z-text-xs z-fw-medium z-text-nowrap z-position-absolute z-bottom-0 z-end-0" style="margin:6px">bottom-0 end-0</div>
                </div>
                <label value=".z-position-relative parent + .z-position-absolute children pinned with .z-top-0 / .z-bottom-0 / .z-start-0 / .z-end-0" sclass="z-text-muted z-text-xs"/>
            </div>
            <div>
                <div class="z-bg-surface-low z-rounded z-p-3 z-border z-d-flex z-flex-col z-gap-2" style="width:200px">
                    <div class="z-bg-primary-container z-rounded-xs z-py-2 z-px-3 z-text-sm z-fw-medium z-text-nowrap z-position-static">z-position-static</div>
                    <label value=".z-position-static — default flow (no offset)" sclass="z-text-muted z-text-xs"/>
                    <label value=".z-position-fixed — pins to the viewport; .z-position-sticky — sticks within its scroll container. Not shown live (they escape this card)." sclass="z-text-muted z-text-xs"/>
                </div>
            </div>
        </div>
        <label value="Float  (.z-float-start / .z-float-end / .z-float-none / .z-clearfix)" sclass="z-d-block z-text-base z-fw-medium z-text-on-surface z-mt-4 z-mb-3"/>
        <div class="z-bg-surface-low z-rounded z-p-3 z-border z-clearfix" style="max-width:420px">
            <div class="z-bg-primary-container z-rounded-xs z-py-2 z-px-3 z-text-sm z-fw-medium z-text-nowrap z-float-start" style="margin-right:8px">z-float-start</div>
            <div class="z-bg-secondary-container z-rounded-xs z-py-2 z-px-3 z-text-sm z-fw-medium z-text-nowrap z-float-end" style="margin-left:8px">z-float-end</div>
            <div class="z-text-sm z-text-on-surface">Text flows around the floated chips. The container uses .z-clearfix so its height contains the floats instead of collapsing.</div>
        </div>
        <label value=".z-float-start / .z-float-end — float to the inline edges; .z-clearfix on the parent contains them. .z-float-none cancels a float." sclass="z-text-muted z-text-xs z-mt-1"/>
    </div>

    <!-- Truncation & Accessibility -->
    <div sclass="z-card">
        <label value="Truncation &amp; Accessibility  (.z-text-truncate / .z-sr-only)" sclass="z-d-block z-text-base z-fw-medium z-text-on-surface z-mb-3"/>
        <div sclass="z-d-flex z-gap-6 z-flex-wrap z-align-start">
            <div style="max-width:320px">
                <div class="z-bg-surface-low z-rounded z-p-3 z-border">
                    <div class="z-bg-primary-container z-rounded-xs z-py-2 z-px-3 z-text-sm z-fw-medium z-text-truncate">This is a very long single line of text that will be cut off with an ellipsis when it overflows the box</div>
                </div>
                <label value=".z-text-truncate — single line, clipped with an ellipsis" sclass="z-text-muted z-text-xs z-mt-1"/>
            </div>
            <div style="max-width:320px">
                <div class="z-bg-surface-low z-rounded z-p-3 z-border">
                    <div class="z-bg-primary-container z-rounded-xs z-py-2 z-px-3 z-text-sm z-fw-medium z-text-nowrap z-d-inline-flex z-align-center z-gap-1">
                        <span class="z-sr-only">Download report (</span>
                        <span>3 MB</span>
                        <span class="z-sr-only">)</span>
                    </div>
                </div>
                <label value=".z-sr-only / .z-visually-hidden — extra context for screen readers, visually removed (here: 'Download report (3 MB)')" sclass="z-text-muted z-text-xs z-mt-1"/>
            </div>
        </div>
    </div>

</vlayout>
</zk>
