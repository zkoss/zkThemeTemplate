<?page title="Color Utilities"?>
<zk>
<style src="~./usecase/usecase.css"/>
<vlayout hflex="1" sclass="z-d-flex z-flex-col z-gap-4 z-p-4 z-bg-surface-low">

    <label value="Color Utilities" sclass="z-h2"/>

    <!-- Text Colors -->
    <div sclass="z-card">
        <label value="Text Colors" sclass="z-d-block z-text-base z-fw-medium z-text-on-surface z-mb-3"/>
        <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:8px">
            <div sclass="z-d-flex z-align-center z-gap-2">
                <label value="Sample Text" sclass="z-text-primary z-fw-medium"/>
                <label value=".z-text-primary" sclass="z-text-secondary z-text-sm"/>
            </div>
            <div sclass="z-d-flex z-align-center z-gap-2">
                <label value="Sample Text" sclass="z-text-secondary z-fw-medium"/>
                <label value=".z-text-secondary" sclass="z-text-secondary z-text-sm"/>
            </div>
            <div sclass="z-d-flex z-align-center z-gap-2">
                <label value="Sample Text" sclass="z-text-muted z-fw-medium"/>
                <label value=".z-text-muted" sclass="z-text-secondary z-text-sm"/>
            </div>
            <div sclass="z-d-flex z-align-center z-gap-2">
                <label value="Sample Text" sclass="z-text-success z-fw-medium"/>
                <label value=".z-text-success" sclass="z-text-secondary z-text-sm"/>
            </div>
            <div sclass="z-d-flex z-align-center z-gap-2">
                <label value="Sample Text" sclass="z-text-warning z-fw-medium"/>
                <label value=".z-text-warning" sclass="z-text-secondary z-text-sm"/>
            </div>
            <div sclass="z-d-flex z-align-center z-gap-2">
                <label value="Sample Text" sclass="z-text-error z-fw-medium"/>
                <label value=".z-text-error" sclass="z-text-secondary z-text-sm"/>
            </div>
            <div sclass="z-d-flex z-align-center z-gap-2">
                <label value="Sample Text" sclass="z-text-info z-fw-medium"/>
                <label value=".z-text-info" sclass="z-text-secondary z-text-sm"/>
            </div>
            <div sclass="z-d-flex z-align-center z-gap-2">
                <label value="Sample Text" sclass="z-text-neutral z-fw-medium"/>
                <label value=".z-text-neutral" sclass="z-text-secondary z-text-sm"/>
            </div>
            <div sclass="z-d-flex z-align-center z-gap-2">
                <label value="Sample Text" sclass="z-text-disabled z-fw-medium"/>
                <label value=".z-text-disabled" sclass="z-text-secondary z-text-sm"/>
            </div>
            <div sclass="z-d-flex z-align-center z-gap-2">
                <label value="Sample Text" sclass="z-text-on-surface z-fw-medium"/>
                <label value=".z-text-on-surface" sclass="z-text-secondary z-text-sm"/>
            </div>
        </div>
    </div>

    <!-- Background Colors -->
    <div sclass="z-card">
        <label value="Background Colors" sclass="z-d-block z-text-base z-fw-medium z-text-on-surface z-mb-3"/>
        <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(180px,1fr));gap:12px">
            <div sclass="z-bg-primary z-p-3 z-rounded-md z-text-center">
                <label value=".z-bg-primary" sclass="z-fw-medium"/>
            </div>
            <div sclass="z-bg-primary-container z-p-3 z-rounded-md z-text-center">
                <label value=".z-bg-primary-container" sclass="z-fw-medium"/>
            </div>
            <div sclass="z-bg-secondary z-p-3 z-rounded-md z-text-center">
                <label value=".z-bg-secondary" sclass="z-fw-medium"/>
            </div>
            <div sclass="z-bg-secondary-container z-p-3 z-rounded-md z-text-center">
                <label value=".z-bg-secondary-container" sclass="z-fw-medium"/>
            </div>
            <div sclass="z-bg-error z-p-3 z-rounded-md z-text-center">
                <label value=".z-bg-error" sclass="z-fw-medium"/>
            </div>
            <div sclass="z-bg-error-container z-p-3 z-rounded-md z-text-center">
                <label value=".z-bg-error-container" sclass="z-fw-medium"/>
            </div>
            <div sclass="z-bg-success z-p-3 z-rounded-md z-text-center">
                <label value=".z-bg-success" sclass="z-fw-medium"/>
            </div>
            <div sclass="z-bg-warning z-p-3 z-rounded-md z-text-center">
                <label value=".z-bg-warning" sclass="z-fw-medium"/>
            </div>
            <div sclass="z-bg-info z-p-3 z-rounded-md z-text-center">
                <label value=".z-bg-info" sclass="z-fw-medium"/>
            </div>
            <div sclass="z-bg-surface z-p-3 z-rounded-md z-text-center z-border">
                <label value=".z-bg-surface" sclass="z-fw-medium"/>
            </div>
            <div sclass="z-bg-surface-variant z-p-3 z-rounded-md z-text-center">
                <label value=".z-bg-surface-variant" sclass="z-fw-medium"/>
            </div>
            <div sclass="z-bg-surface-container z-p-3 z-rounded-md z-text-center">
                <label value=".z-bg-surface-container" sclass="z-fw-medium"/>
            </div>
            <div sclass="z-bg-surface-low z-p-3 z-rounded-md z-text-center z-border">
                <label value=".z-bg-surface-low" sclass="z-fw-medium"/>
            </div>
            <div sclass="z-bg-transparent z-p-3 z-rounded-md z-text-center z-border">
                <label value=".z-bg-transparent" sclass="z-fw-medium"/>
            </div>
        </div>
    </div>

    <!-- Inverse text on dark background -->
    <div sclass="z-card">
        <label value="Inverse Text" sclass="z-d-block z-text-base z-fw-medium z-text-on-surface z-mb-3"/>
        <div sclass="z-bg-primary z-p-4 z-rounded-md z-d-inline-block">
            <label value=".z-text-inverse — readable on dark backgrounds" sclass="z-text-inverse z-fw-medium"/>
        </div>
        <div sclass="z-bg-primary z-p-4 z-rounded-md z-d-inline-block z-ms-3">
            <label value=".z-text-on-primary — paired with primary background" sclass="z-text-on-primary z-fw-medium"/>
        </div>
    </div>

</vlayout>
</zk>
