<?page title="Cropper" contentType="text/html;charset=UTF-8"?>
<zk xmlns:h="native">
<div sclass="z-p-8">
    <div sclass="z-border-bottom z-text-xl z-fw-medium z-text-on-surface z-mb-8 z-pb-3">Cropper</div>
    <div sclass="z-mb-6">
        <div sclass="z-text-xs z-fw-semibold z-text-uppercase z-text-secondary z-border-bottom z-pb-2 z-mb-4">Image Cropper</div>
        <!-- single child: no flex wrapper — column-flex stretch would blow the inline-block
             root to full width (M7 dead space), same class of bug as an oversized width attr -->
        <div sclass="z-py-3">
            <!-- width MUST be set (onSize → resizeImage feeds the ROOT size back into the Jcrop
                 holder — an unsized shrink-wrapped root collapses to 0) and MUST NOT exceed the
                 image's natural width (300×400 — ZK never upscales, excess width = dead space, M7) -->
            <cropper x="50" y="100" w="100" h="100" onCrop="img.setContent(event.getMedia())"
                     width="300px" toolbarVisible="true" src="~./img/sun.jpg"/>
        </div>
    </div>
    <div sclass="z-mb-6">
        <div sclass="z-text-xs z-fw-semibold z-text-uppercase z-text-secondary z-border-bottom z-pb-2 z-mb-4">Cropped Result</div>
        <div sclass="z-py-3">
            <image id="img"/>
        </div>
    </div>
</div>
</zk>
