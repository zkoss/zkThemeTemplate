<?page title="Anchornav" contentType="text/html;charset=UTF-8"?>
<zk xmlns:h="native" xmlns:ca="client/attribute">
<div sclass="z-p-8">
    <div sclass="z-border-bottom z-text-xl z-fw-medium z-text-on-surface z-mb-8 z-pb-3">Anchor Navigation</div>

    <div sclass="z-mb-6">
        <div sclass="z-text-xs z-fw-semibold z-text-uppercase z-text-secondary z-border-bottom z-pb-2 z-mb-4">Anchornav with Sections</div>
        <div sclass="z-py-3">
            <anchornav>
                <listbox sizedByContent="true" hflex="min">
                    <listitem><listcell><a ca:data-anchornav-target="$win1">First Window</a></listcell></listitem>
                    <listitem><listcell><a ca:data-anchornav-target="$win2">Second Window</a></listcell></listitem>
                    <listitem><listcell><a ca:data-anchornav-target="$win3">Third Window</a></listcell></listitem>
                </listbox>
            </anchornav>
            <div id="win1" sclass="z-mt-6 z-p-4 z-border z-rounded" style="height:200px;background:skyblue">
                <div sclass="z-fw-medium z-mb-2">1. First Section</div>
                Hello world.
            </div>
            <div id="win2" sclass="z-mt-6 z-p-4 z-border z-rounded" style="height:200px;background:coral">
                <div sclass="z-fw-medium z-mb-2">2. Second Section</div>
                Welcome to ZK world.
            </div>
            <div id="win3" sclass="z-mt-6 z-p-4 z-border z-rounded" style="height:200px;background:bisque">
                <div sclass="z-fw-medium z-mb-2">3. Third Section</div>
                Welcome to ZK world.
            </div>
        </div>
    </div>

</div>
</zk>
