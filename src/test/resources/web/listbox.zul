<?page title="Listbox" contentType="text/html;charset=UTF-8"?>
<zk xmlns:h="native">
<h:link rel="stylesheet" href="pv.css"/>
<div sclass="z-p-8">
    <div sclass="z-border-bottom z-fs-title-lg z-fw-medium z-text-on-surface z-mb-8 z-pb-3">Listbox</div>

    <div sclass="pv-section">
        <div sclass="pv-section-title">Listbox — State Gallery</div>

        <div sclass="pv-state-gallery pv-variant-default">
            <div sclass="pv-state-col">
                <div sclass="pv-state-label">Row States</div>
                <listbox width="280px">
                    <listhead><listheader label="Name"/><listheader label="Role"/></listhead>
                    <listitem>
                        <listcell label="Default Row"/><listcell label="Normal"/>
                    </listitem>
                    <listitem selected="true">
                        <listcell label="Selected Row"/><listcell label="Active"/>
                    </listitem>
                    <listitem disabled="true">
                        <listcell label="Disabled Row"/><listcell label="N/A"/>
                    </listitem>
                    <listitem>
                        <listcell label="Odd Stripe Row"/><listcell label="Normal"/>
                    </listitem>
                </listbox>
            </div>
        </div>

        <div sclass="pv-state-gallery pv-variant-checkmark">
            <div sclass="pv-state-col">
                <div sclass="pv-state-label">Checkmark</div>
                <listbox width="280px" multiple="true" checkmark="true">
                    <listhead><listheader label="Name"/><listheader label="Role"/></listhead>
                    <listitem>
                        <listcell label="Default Row"/><listcell label="Normal"/>
                    </listitem>
                    <listitem selected="true">
                        <listcell label="Selected Row"/><listcell label="Active"/>
                    </listitem>
                    <listitem disabled="true">
                        <listcell label="Disabled Row"/><listcell label="N/A"/>
                    </listitem>
                    <listitem>
                        <listcell label="Odd Stripe Row"/><listcell label="Normal"/>
                    </listitem>
                </listbox>
            </div>
        </div>
    </div>

    <div sclass="z-mb-6">
        <div sclass="z-fs-label-sm z-fw-semibold z-text-uppercase z-text-secondary z-border-bottom z-pb-2 z-mb-4">Standard</div>
        <div sclass="z-py-3">
            <listbox>
                <listhead sizable="true">
                    <listheader label="Name" sort="auto"/>
                    <listheader label="Gender" sort="client"/>
                    <listheader label="Age" sort="auto"/>
                    <listheader label="Description"/>
                </listhead>
                <listitem>
                    <listcell label="Mary"/>
                    <listcell label="Female"/>
                    <listcell label="18"/>
                    <listcell label="A young lady."/>
                </listitem>
                <listitem>
                    <listcell label="John"/>
                    <listcell label="Male"/>
                    <listcell label="20"/>
                    <listcell label="A college student."/>
                </listitem>
                <listitem disabled="true">
                    <listcell label="Jane"/>
                    <listcell label="Female"/>
                    <listcell label="32"/>
                    <listcell label="A remarkable artist."/>
                </listitem>
            </listbox>
        </div>
    </div>

    <div sclass="z-mb-6">
        <div sclass="z-fs-label-sm z-fw-semibold z-text-uppercase z-text-secondary z-border-bottom z-pb-2 z-mb-4">Checkmarks</div>
        <div sclass="z-py-3">
            <listbox multiple="true" checkmark="true">
                <listhead menupopup="auto">
                    <listheader label="Name"/>
                    <listheader label="Role"/>
                </listhead>
                <listitem>
                    <listcell label="Alice"/>
                    <listcell label="Admin"/>
                </listitem>
                <listitem>
                    <listcell label="Bob"/>
                    <listcell label="Editor"/>
                </listitem>
                <listitem>
                    <listcell label="Charlie"/>
                    <listcell label="Viewer"/>
                </listitem>
            </listbox>
        </div>
    </div>

    <div sclass="z-mb-6">
        <div sclass="z-fs-label-sm z-fw-semibold z-text-uppercase z-text-secondary z-border-bottom z-pb-2 z-mb-4">Select Mold</div>
        <div sclass="z-py-3">
            <listbox rows="1" mold="select">
                <listitem label="Inbox"/>
                <listitem label="Received"/>
                <listitem label="Draft"/>
                <listitem label="Sent"/>
            </listbox>
        </div>
    </div>

    <div sclass="z-mb-6">
        <div sclass="z-fs-label-sm z-fw-semibold z-text-uppercase z-text-secondary z-border-bottom z-pb-2 z-mb-4">Frozen Columns</div>
        <div sclass="z-py-3">
            <listbox>
                <frozen columns="2"/>
                <listhead>
                    <listheader label="Col A" width="200px"/>
                    <listheader label="Col B" width="200px"/>
                    <listheader label="Col C" width="200px"/>
                    <listheader label="Col D" width="200px"/>
                    <listheader label="Col E" width="200px"/>
                </listhead>
                <listitem><listcell>A1</listcell><listcell>B1</listcell><listcell>C1</listcell><listcell>D1</listcell><listcell>E1</listcell></listitem>
                <listitem><listcell>A2</listcell><listcell>B2</listcell><listcell>C2</listcell><listcell>D2</listcell><listcell>E2</listcell></listitem>
                <listitem><listcell>A3</listcell><listcell>B3</listcell><listcell>C3</listcell><listcell>D3</listcell><listcell>E3</listcell></listitem>
            </listbox>
        </div>
    </div>

    <div sclass="z-mb-6">
        <div sclass="z-fs-label-sm z-fw-semibold z-text-uppercase z-text-secondary z-border-bottom z-pb-2 z-mb-4">Empty State</div>
        <div sclass="z-py-3">
            <listbox emptyMessage="This listbox is empty.">
                <listhead><listheader label="Name"/></listhead>
            </listbox>
        </div>
    </div>
</div>
</zk>
