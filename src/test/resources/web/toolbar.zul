<?page title="Toolbar" contentType="text/html;charset=UTF-8"?>
<zk xmlns:h="native">
<h:link rel="stylesheet" href="pv.css"/>
<div sclass="z-p-8">
    <div sclass="z-border-bottom z-fs-title-lg z-fw-medium z-text-on-surface z-mb-8 z-pb-3">Toolbar</div>

    <div sclass="z-mb-6">
        <div sclass="z-fs-label-sm z-fw-semibold z-text-uppercase z-text-secondary z-border-bottom z-pb-2 z-mb-4">With Icons</div>
        <div sclass="z-d-flex z-align-end z-flex-wrap z-gap-6 z-py-3">
            <div sclass="z-d-flex z-flex-col z-align-start z-gap-2">
                <toolbar>
                    <toolbarbutton label="Button 1" iconSclass="z-icon-volume-2"/>
                    <toolbarbutton label="Button 2" mode="toggle" checked="true" image="~./img/network.gif"/>
                    <a href="http://www.zkoss.org">ZK</a>
                </toolbar>
                <div sclass="z-fs-label-sm z-text-secondary">Mixed (icon + image + link)</div>
            </div>
            <div sclass="z-d-flex z-flex-col z-align-start z-gap-2">
                <toolbar>
                    <toolbarbutton label="Button 1" image="~./img/volumn.gif"/>
                    <toolbarbutton label="Button 2" mode="toggle" checked="true" image="~./img/network.gif"/>
                </toolbar>
                <div sclass="z-fs-label-sm z-text-secondary">With images</div>
            </div>
        </div>
    </div>

    <div sclass="z-mb-6">
        <div sclass="z-fs-label-sm z-fw-semibold z-text-uppercase z-text-secondary z-border-bottom z-pb-2 z-mb-4">Text Only</div>
        <div sclass="z-d-flex z-align-end z-flex-wrap z-gap-6 z-py-3">
            <div sclass="z-d-flex z-flex-col z-align-start z-gap-2">
                <toolbar>
                    <toolbarbutton label="Button 1" />
                    <toolbarbutton label="Button 2" mode="toggle" checked="true" />
                    <toolbarbutton label="Button 3" disabled="true" />
                    <toolbarbutton label="Button 4" mode="toggle" checked="true" disabled="true" />
                </toolbar>
                <div sclass="z-fs-label-sm z-text-secondary">Default, checked, disabled, checked+disabled</div>
            </div>
        </div>
    </div>

    <div sclass="z-mb-6">
        <div sclass="z-fs-label-sm z-fw-semibold z-text-uppercase z-text-secondary z-border-bottom z-pb-2 z-mb-4">Icon Only</div>
        <div sclass="z-d-flex z-align-end z-flex-wrap z-gap-6 z-py-3">
            <div sclass="z-d-flex z-flex-col z-align-start z-gap-2">
                <toolbar>
                    <toolbarbutton iconSclass="z-icon-search" tooltiptext="Search"/>
                    <toolbarbutton iconSclass="z-icon-edit" tooltiptext="Edit"/>
                    <toolbarbutton iconSclass="z-icon-star" mode="toggle" checked="true" tooltiptext="Starred"/>
                    <toolbarbutton iconSclass="z-icon-trash-2" disabled="true" tooltiptext="Delete (disabled)"/>
                </toolbar>
                <div sclass="z-fs-label-sm z-text-secondary">Icon-only: default, default, checked, disabled</div>
            </div>
        </div>
    </div>

    <div sclass="z-mb-6">
        <div sclass="z-fs-label-sm z-fw-semibold z-text-uppercase z-text-secondary z-border-bottom z-pb-2 z-mb-4">With Separator</div>
        <div sclass="z-d-flex z-align-end z-flex-wrap z-gap-6 z-py-3">
            <div sclass="z-d-flex z-flex-col z-align-start z-gap-2">
                <toolbar>
                    <toolbarbutton label="New" iconSclass="z-icon-file"/>
                    <toolbarbutton label="Open" iconSclass="z-icon-folder-open"/>
                    <toolbarseparator/>
                    <toolbarbutton label="Cut" iconSclass="z-icon-scissors"/>
                    <toolbarbutton label="Copy" iconSclass="z-icon-copy"/>
                    <toolbarbutton label="Paste" iconSclass="z-icon-clipboard"/>
                    <separator/>
                    <toolbarbutton label="Help" iconSclass="z-icon-help-circle"/>
                </toolbar>
                <div sclass="z-fs-label-sm z-text-secondary">Toolbarseparator (divider) + separator (spacer)</div>
            </div>
        </div>
    </div>

    <div sclass="z-mb-6">
        <div sclass="z-fs-label-sm z-fw-semibold z-text-uppercase z-text-secondary z-border-bottom z-pb-2 z-mb-4">Panel Mold</div>
        <div sclass="z-d-flex z-align-end z-flex-wrap z-gap-6 z-py-3">
            <div sclass="z-d-flex z-flex-col z-align-start z-gap-2">
                <toolbar mold="panel">
                    <toolbarbutton label="Button 1" image="~./img/volumn.gif"/>
                    <toolbarbutton label="Button 2" mode="toggle" checked="true" image="~./img/network.gif"/>
                </toolbar>
                <div sclass="z-fs-label-sm z-text-secondary">Panel mold with images</div>
            </div>
            <div sclass="z-d-flex z-flex-col z-align-start z-gap-2">
                <toolbar mold="panel">
                    <toolbarbutton label="Button 1" />
                    <toolbarbutton label="Button 2" mode="toggle" checked="true" />
                </toolbar>
                <div sclass="z-fs-label-sm z-text-secondary">Panel mold text only</div>
            </div>
        </div>
    </div>

</div>
</zk>
