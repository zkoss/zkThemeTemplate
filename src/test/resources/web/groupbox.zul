<?page title="Groupbox" contentType="text/html;charset=UTF-8"?>
<zk xmlns:h="native">
<div sclass="z-p-8">
    <div sclass="z-border-bottom z-text-xl z-fw-medium z-text-on-surface z-mb-8 z-pb-3">Groupbox</div>

    <div sclass="z-mb-6 z-d-grid z-grid-cols-auto z-overflow-x-auto z-col-gap-6 z-row-gap-2 z-align-start" style="--zk-cols:2; --zk-col-min:min-content">
        <div sclass="z-grid-col-full z-text-xs z-fw-semibold z-text-uppercase z-text-secondary z-border-bottom z-pb-2 z-mb-4">Default Mold</div>
        <div sclass="z-d-contents">
            <div/>
            <div sclass="z-text-xs z-fw-semibold z-text-secondary">Caption + Image</div>
            <div sclass="z-text-xs z-fw-semibold z-text-secondary">Caption Only</div>
        </div>
        <div sclass="z-d-contents">
            <div sclass="z-text-sm z-text-secondary">Default</div>
            <div>
                <groupbox width="240px">
                    <caption image="~./img/volumn.gif" label="Caption" />
                    Groupbox Content
                </groupbox>
            </div>
            <div>
                <groupbox width="240px">
                    <caption label="Caption" />
                    Groupbox Content
                </groupbox>
            </div>
        </div>
        <div sclass="z-d-contents">
            <div sclass="z-text-sm z-text-secondary">Title Attr</div>
            <div>
                <groupbox width="240px" title="Title" height="200px">
                    Groupbox Content (title attr, no caption)
                </groupbox>
            </div>
            <div>
                <groupbox width="240px" title="Title" height="200px">
                    <caption label="Caption" />
                    Groupbox Content (caption + title)
                </groupbox>
            </div>
        </div>
        <div sclass="z-d-contents">
            <div sclass="z-text-sm z-text-secondary">Image Only</div>
            <div>
                <groupbox width="240px">
                    <caption image="~./img/volumn.gif" />
                    Groupbox Content
                </groupbox>
            </div>
            <div>
                <groupbox width="240px">
                    Groupbox Content (no caption)
                </groupbox>
            </div>
        </div>
        <div sclass="z-d-contents">
            <div sclass="z-text-sm z-text-secondary">Collapsed</div>
            <div>
                <groupbox width="240px" open="false">
                    <caption image="~./img/volumn.gif" label="Caption" />
                    Groupbox Content
                </groupbox>
            </div>
            <div>
                <groupbox width="240px" open="false">
                    <caption label="Caption" />
                    Groupbox Content
                </groupbox>
            </div>
        </div>
    </div>

    <div sclass="z-mb-6">
        <div sclass="z-text-xs z-fw-semibold z-text-uppercase z-text-secondary z-border-bottom z-pb-2 z-mb-4">3D Mold — Caption Variants</div>
        <div sclass="z-d-flex z-align-start z-flex-wrap z-gap-6 z-py-3">
            <div sclass="z-d-flex z-flex-col z-align-start z-gap-2">
                <div sclass="z-text-xs z-text-secondary">Caption + Image</div>
                <groupbox width="240px" mold="3d">
                    <caption image="~./img/volumn.gif" label="Caption" />
                    Groupbox Content
                </groupbox>
            </div>
            <div sclass="z-d-flex z-flex-col z-align-start z-gap-2">
                <div sclass="z-text-xs z-text-secondary">Caption Only</div>
                <groupbox width="240px" mold="3d">
                    <caption label="Caption" />
                    Groupbox Content
                </groupbox>
            </div>
            <div sclass="z-d-flex z-flex-col z-align-start z-gap-2">
                <div sclass="z-text-xs z-text-secondary">Title Attr (no caption)</div>
                <groupbox width="240px" mold="3d" title="Title">
                    Groupbox Content
                </groupbox>
            </div>
            <div sclass="z-d-flex z-flex-col z-align-start z-gap-2">
                <div sclass="z-text-xs z-text-secondary">Caption + Title mixed</div>
                <groupbox width="240px" mold="3d" title="Title">
                    <caption label="Caption" />
                    Groupbox Content
                </groupbox>
            </div>
        </div>
    </div>

    <div sclass="z-mb-6">
        <div sclass="z-text-xs z-fw-semibold z-text-uppercase z-text-secondary z-border-bottom z-pb-2 z-mb-4">3D Mold — Edge Cases</div>
        <div sclass="z-d-flex z-align-start z-flex-wrap z-gap-6 z-py-3">
            <div sclass="z-d-flex z-flex-col z-align-start z-gap-2">
                <div sclass="z-text-xs z-text-secondary">Image only caption</div>
                <groupbox width="240px" mold="3d">
                    <caption image="~./img/volumn.gif" />
                    Groupbox Content
                </groupbox>
            </div>
            <div sclass="z-d-flex z-flex-col z-align-start z-gap-2">
                <div sclass="z-text-xs z-text-secondary">No caption</div>
                <groupbox width="240px" mold="3d">
                    Groupbox Content
                </groupbox>
            </div>
        </div>
    </div>

</div>
</zk>
