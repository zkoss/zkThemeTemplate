<?page title="Checkbox" contentType="text/html;charset=UTF-8"?>
<zk xmlns:h="native">
<div sclass="z-p-8">
    <div sclass="z-border-bottom z-mb-8 z-pb-3"><label sclass="z-text-2xl z-fw-medium z-text-on-surface" value="Checkbox"/></div>

    <div sclass="z-mb-6 z-d-grid z-grid-cols-auto z-overflow-x-auto z-gap-x-6 z-gap-y-2 z-items-start" style="--zk-cols:4; --zk-col-min:min-content">
        <div sclass="z-grid-col-full z-text-uppercase z-border-bottom z-pb-2 z-mb-4"><label sclass="z-text-xs z-fw-semibold z-text-secondary" value="States"/></div>
        <div sclass="z-d-contents">
            <div/>
            <div><label sclass="z-text-xs z-fw-semibold z-text-secondary" value="Default"/></div>
            <div><label sclass="z-text-xs z-fw-semibold z-text-secondary" value="Checked"/></div>
            <div><label sclass="z-text-xs z-fw-semibold z-text-secondary" value="Disabled"/></div>
            <div><label sclass="z-text-xs z-fw-semibold z-text-secondary" value="Disabled + Checked"/></div>
        </div>
        <div sclass="z-d-contents">
            <div><label sclass="z-text-sm z-text-secondary" value="No label"/></div>
            <div><checkbox/></div>
            <div><checkbox checked="true"/></div>
            <div><checkbox disabled="true"/></div>
            <div><checkbox disabled="true" checked="true"/></div>
        </div>
        <div sclass="z-d-contents">
            <div><label sclass="z-text-sm z-text-secondary" value="With label"/></div>
            <div><checkbox label="Checkbox"/></div>
            <div><checkbox label="Checkbox" checked="true"/></div>
            <div><checkbox label="Checkbox" disabled="true"/></div>
            <div><checkbox label="Checkbox" disabled="true" checked="true"/></div>
        </div>
        <div sclass="z-d-contents">
            <div><label sclass="z-text-sm z-text-secondary" value="Indeterminate"/></div>
            <div><checkbox label="Checkbox" indeterminate="true"/></div>
            <div/>
            <div><checkbox label="Checkbox" indeterminate="true" disabled="true"/></div>
            <div/>
        </div>
        <div sclass="z-d-contents">
            <div><label sclass="z-text-sm z-text-secondary" value="Toggle"/></div>
            <div><checkbox mold="toggle" label="Off"/></div>
            <div><checkbox mold="toggle" label="On" checked="true"/></div>
            <div><checkbox mold="toggle" label="Disabled" disabled="true"/></div>
            <div><checkbox mold="toggle" label="Dis+On" disabled="true" checked="true"/></div>
        </div>
    </div>

    <div sclass="z-mb-6">
        <div sclass="z-text-uppercase z-border-bottom z-pb-2 z-mb-4"><label sclass="z-text-xs z-fw-semibold z-text-secondary" value="Switch"/></div>
        <div sclass="z-d-flex z-items-start z-flex-wrap z-gap-6 z-py-3">
            <checkbox mold="switch" label="Off"/>
            <checkbox mold="switch" label="On" checked="true"/>
            <checkbox mold="switch" label="Disabled" disabled="true"/>
            <checkbox mold="switch" label="Dis+On" disabled="true" checked="true"/>
        </div>
    </div>

    <div sclass="z-mb-6">
        <div sclass="z-text-uppercase z-border-bottom z-pb-2 z-mb-4"><label sclass="z-text-xs z-fw-semibold z-text-secondary" value="Tristate Mold"/></div>
        <div sclass="z-d-flex z-items-start z-flex-wrap z-gap-6 z-py-3">
            <div sclass="z-d-flex z-flex-col z-items-start z-gap-2">
                <div><label sclass="z-text-xs z-text-secondary" value="mold=&quot;tristate&quot; (unchecked)"/></div>
                <checkbox mold="tristate" label="Tristate"/>
            </div>
            <div sclass="z-d-flex z-flex-col z-items-start z-gap-2">
                <div><label sclass="z-text-xs z-text-secondary" value="mold=&quot;tristate&quot; checked"/></div>
                <checkbox mold="tristate" label="Tristate" checked="true"/>
            </div>
            <div sclass="z-d-flex z-flex-col z-items-start z-gap-2">
                <div><label sclass="z-text-xs z-text-secondary" value="mold=&quot;tristate&quot; indeterminate"/></div>
                <checkbox mold="tristate" label="Tristate" indeterminate="true"/>
            </div>
        </div>
    </div>
</div>
</zk>
