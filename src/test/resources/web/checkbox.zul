<?page title="Checkbox" contentType="text/html;charset=UTF-8"?>
<zk xmlns:h="native">
<h:link rel="stylesheet" href="pv.css"/>
<div sclass="z-p-8">
    <div sclass="z-border-bottom z-fs-title-lg z-fw-medium z-text-on-surface z-mb-8 z-pb-3">Checkbox</div>

    <div sclass="z-mb-6 pv-cols-4">
        <div sclass="z-fs-label-sm z-fw-semibold z-text-uppercase z-text-secondary z-border-bottom z-pb-2 z-mb-4">States</div>
        <div sclass="pv-col-header-row z-pb-1">
            <div/>
            <div sclass="z-fs-label-sm z-fw-semibold z-text-secondary">Default</div>
            <div sclass="z-fs-label-sm z-fw-semibold z-text-secondary">Checked</div>
            <div sclass="z-fs-label-sm z-fw-semibold z-text-secondary">Disabled</div>
            <div sclass="z-fs-label-sm z-fw-semibold z-text-secondary">Disabled + Checked</div>
        </div>
        <div sclass="pv-row z-py-2 z-border-bottom">
            <div sclass="z-fs-label-md z-text-secondary">No label</div>
            <div><checkbox/></div>
            <div><checkbox checked="true"/></div>
            <div><checkbox disabled="true"/></div>
            <div><checkbox disabled="true" checked="true"/></div>
        </div>
        <div sclass="pv-row z-py-2 z-border-bottom">
            <div sclass="z-fs-label-md z-text-secondary">With label</div>
            <div><checkbox label="Checkbox"/></div>
            <div><checkbox label="Checkbox" checked="true"/></div>
            <div><checkbox label="Checkbox" disabled="true"/></div>
            <div><checkbox label="Checkbox" disabled="true" checked="true"/></div>
        </div>
        <div sclass="pv-row z-py-2 z-border-bottom">
            <div sclass="z-fs-label-md z-text-secondary">Indeterminate</div>
            <div><checkbox label="Checkbox" indeterminate="true"/></div>
            <div/>
            <div><checkbox label="Checkbox" indeterminate="true" disabled="true"/></div>
            <div/>
        </div>
    </div>
</div>
</zk>
