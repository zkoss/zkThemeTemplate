<?page title="Popup" contentType="text/html;charset=UTF-8"?>
<zk xmlns:h="native">
<div sclass="z-p-8">
    <div sclass="z-border-bottom z-mb-8 z-pb-3"><label sclass="z-text-2xl z-fw-medium z-text-on-surface" value="Popup"/></div>

    <div sclass="z-mb-6">
        <div sclass="z-text-uppercase z-border-bottom z-pb-2 z-mb-4"><label sclass="z-text-xs z-fw-semibold z-text-secondary" value="Popup (popup attribute)"/></div>
        <div sclass="z-py-3">
            <button label="Show Popup" popup="p1" />
            <button label="Show Popup (fixed size)" popup="p2" />
        </div>
    </div>

    <div sclass="z-mb-6">
        <div sclass="z-text-uppercase z-border-bottom z-pb-2 z-mb-4"><label sclass="z-text-xs z-fw-semibold z-text-secondary" value="Tooltip (mouse over)"/></div>
        <div sclass="z-py-3">
            <div tooltip="p1" style="display:inline-block; border:1px solid var(--zk-color-outline); padding:8px 16px; border-radius:4px; cursor:default;">
                <label value="Hover me — tooltip uses Popup" />
            </div>
        </div>
    </div>

    <div sclass="z-mb-6">
        <div sclass="z-text-uppercase z-border-bottom z-pb-2 z-mb-4"><label sclass="z-text-xs z-fw-semibold z-text-secondary" value="Context Menu (right click)"/></div>
        <div sclass="z-py-3">
            <div context="p1" style="display:inline-block; border:1px solid var(--zk-color-outline); padding:8px 16px; border-radius:4px; cursor:default;">
                <label value="Right-click me — context uses Popup" />
            </div>
        </div>
    </div>

    <div sclass="z-mb-6">
        <div sclass="z-text-uppercase z-border-bottom z-pb-2 z-mb-4"><label sclass="z-text-xs z-fw-semibold z-text-secondary" value="Tooltiptext (native tooltip)"/></div>
        <div sclass="z-py-3">
            <div tooltiptext="Native browser tooltip message" style="display:inline-block; border:1px solid var(--zk-color-outline); padding:8px 16px; border-radius:4px; cursor:default;">
                <label value="Hover me — tooltiptext (not a Popup)" />
            </div>
        </div>
    </div>

    <div sclass="z-mb-6">
        <div sclass="z-text-uppercase z-border-bottom z-pb-2 z-mb-4"><label sclass="z-text-xs z-fw-semibold z-text-secondary" value="Dark tooltip (z-popup-tooltip)"/></div>
        <div sclass="z-py-3">
            <button label="Click" sclass="z-button-outlined" popup="tt" />
        </div>
    </div>

    <popup id="tt" sclass="z-popup-tooltip">
        <label value="Tooltip text" />
    </popup>
    <popup id="p1">
        <div>Popup Content</div>
        <div>Second Line</div>
    </popup>
    <popup id="p2" width="200px" height="200px">
        <div>Popup Content (fixed size)</div>
        <div>Second Line</div>
    </popup>
</div>
</zk>
