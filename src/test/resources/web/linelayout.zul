<?page title="Linelayout" contentType="text/html;charset=UTF-8"?>
<zk xmlns:h="native">
<zscript>
    ListModel model4LineLayout = new ListModelList(new String[] {
        "2019-Q1",
        "2019-Q2",
        "2019-Q3",
        "2019-Q4"
    });
</zscript>
<div sclass="z-p-8">
    <div sclass="z-border-bottom z-mb-8 z-pb-3"><label sclass="z-text-2xl z-fw-medium z-text-on-surface" value="Linelayout"/></div>

    <div sclass="z-mb-6">
        <div sclass="z-text-uppercase z-border-bottom z-pb-2 z-mb-4"><label sclass="z-text-xs z-fw-semibold z-text-secondary" value="Timeline with Model"/></div>
        <div sclass="z-mb-2"><label sclass="z-text-xs z-text-secondary" value="Quarterly milestones — no width set, fills the full page width"/></div>
        <div sclass="z-py-3">
            <linelayout model="${model4LineLayout}" height="200px">
                <template name="model">
                    <lineitem>
                        <button label="${each}"/>
                    </lineitem>
                </template>
            </linelayout>
        </div>
    </div>

    <div sclass="z-mb-6">
        <div sclass="z-text-uppercase z-border-bottom z-pb-2 z-mb-4"><label sclass="z-text-xs z-fw-semibold z-text-secondary" value="Orientation: Horizontal (orient)"/></div>
        <div sclass="z-py-3">
            <linelayout orient="horizontal" height="160px">
                <lineitem>
                    <label value="8 am"/>
                    <button label="good morning"/>
                </lineitem>
                <lineitem opposite="true">
                    <label value="12 pm"/>
                    <button label="lunch time"/>
                </lineitem>
                <lineitem>
                    <label value="6 pm"/>
                    <button label="dinner time"/>
                </lineitem>
                <lineitem opposite="true">
                    <label value="10 pm"/>
                    <button label="good night"/>
                </lineitem>
            </linelayout>
        </div>
    </div>

    <div sclass="z-mb-6">
        <div sclass="z-text-uppercase z-border-bottom z-pb-2 z-mb-4"><label sclass="z-text-xs z-fw-semibold z-text-secondary" value="Alternating Sides (opposite)"/></div>
        <div sclass="z-py-3">
            <linelayout width="440px" height="280px">
                <lineitem>
                    <button label="Order placed"/>
                </lineitem>
                <lineitem opposite="true">
                    <button label="Payment confirmed"/>
                </lineitem>
                <lineitem>
                    <button label="Shipped"/>
                </lineitem>
                <lineitem opposite="true">
                    <button label="Delivered"/>
                </lineitem>
            </linelayout>
        </div>
    </div>

    <div sclass="z-mb-6">
        <div sclass="z-text-uppercase z-border-bottom z-pb-2 z-mb-4"><label sclass="z-text-xs z-fw-semibold z-text-secondary" value="Point Variations (pointIconSclass / pointImageSrc / pointVisible)"/></div>
        <div sclass="z-py-3">
            <linelayout width="440px" height="300px">
                <lineitem>
                    <button label="Default point"/>
                </lineitem>
                <lineitem pointIconSclass="z-icon-star">
                    <button label="Icon point (star)"/>
                </lineitem>
                <lineitem pointIconSclass="z-icon-flag">
                    <button label="Icon point (flag)"/>
                </lineitem>
                <lineitem pointImageSrc="~./img/earth.png">
                    <button label="Image point"/>
                </lineitem>
                <lineitem pointVisible="false">
                    <button label="Hidden point"/>
                </lineitem>
            </linelayout>
        </div>
    </div>

    <div sclass="z-mb-6">
        <div sclass="z-text-uppercase z-border-bottom z-pb-2 z-mb-4"><label sclass="z-text-xs z-fw-semibold z-text-secondary" value="Line Position (firstScale / lastScale)"/></div>
        <div sclass="z-d-flex z-items-start z-flex-wrap z-gap-6 z-py-3">
            <div sclass="z-d-flex z-flex-col z-items-start z-gap-2">
                <div><label sclass="z-text-xs z-text-secondary" value="firstScale=1 lastScale=3 — line shifts left"/></div>
                <linelayout width="280px" height="200px" firstScale="1" lastScale="3">
                    <lineitem>
                        <button label="A"/>
                    </lineitem>
                    <lineitem>
                        <button label="B"/>
                    </lineitem>
                    <lineitem>
                        <button label="C"/>
                    </lineitem>
                </linelayout>
            </div>
            <div sclass="z-d-flex z-flex-col z-items-start z-gap-2">
                <div><label sclass="z-text-xs z-text-secondary" value="firstScale=3 lastScale=1 — line shifts right"/></div>
                <linelayout width="280px" height="200px" firstScale="3" lastScale="1">
                    <lineitem opposite="true">
                        <button label="A"/>
                    </lineitem>
                    <lineitem opposite="true">
                        <button label="B"/>
                    </lineitem>
                    <lineitem opposite="true">
                        <button label="C"/>
                    </lineitem>
                </linelayout>
            </div>
        </div>
    </div>

    <div sclass="z-mb-6">
        <div sclass="z-text-uppercase z-border-bottom z-pb-2 z-mb-4"><label sclass="z-text-xs z-fw-semibold z-text-secondary" value="Item Spacing (frontSpace / backSpace)"/></div>
        <div sclass="z-py-3">
            <linelayout height="320px">
                <lineitem>
                    <button label="Step 1"/>
                </lineitem>
                <lineitem frontSpace="48px">
                    <button label="Step 2 (frontSpace=48px)"/>
                </lineitem>
                <lineitem backSpace="48px">
                    <button label="Step 3 (backSpace=48px)"/>
                </lineitem>
                <lineitem>
                    <button label="Step 4"/>
                </lineitem>
            </linelayout>
        </div>
    </div>

</div>
</zk>
