<?page title="Linelayout" contentType="text/html;charset=UTF-8"?>
<zk xmlns:h="native">
<h:link rel="stylesheet" href="pv.css"/>
<zscript>
    ListModel model4LineLayout = new ListModelList(new String[] {
        "2019-Q1",
        "2019-Q2",
        "2019-Q3",
        "2019-Q4"
    });
</zscript>
<div sclass="z-p-8">
    <div sclass="z-border-bottom z-fs-title-lg z-fw-medium z-text-on-surface z-mb-8 z-pb-3">Linelayout</div>

    <div sclass="z-mb-6">
        <div sclass="z-fs-label-sm z-fw-semibold z-text-uppercase z-text-secondary z-border-bottom z-pb-2 z-mb-4">Timeline with Model</div>
        <div sclass="z-d-flex z-align-start z-flex-wrap z-gap-6 z-py-3">
            <div sclass="z-d-flex z-flex-col z-align-start z-gap-2">
                <div sclass="z-fs-label-sm z-text-secondary">Quarterly milestones</div>
                <linelayout model="${model4LineLayout}" height="200px">
                    <template name="model">
                        <lineitem>
                            <button label="${each}"/>
                        </lineitem>
                    </template>
                </linelayout>
            </div>
        </div>
    </div>

</div>
</zk>
