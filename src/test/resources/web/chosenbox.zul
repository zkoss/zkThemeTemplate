<?page title="Chosenbox" contentType="text/html;charset=UTF-8"?>
<zk xmlns:h="native">
<h:link rel="stylesheet" href="pv.css"/>
<zscript><![CDATA[
ListModelList chosenModel = new ListModelList(new String[]{
    "Apple", "Banana", "Cherry", "Date", "Elderberry", "Fig", "Grape"
});
chosenModel.setMultiple(true);
chosenModel.addToSelection(chosenModel.get(0));
chosenModel.addToSelection(chosenModel.get(1));
]]></zscript>
<div sclass="z-p-8">
    <div sclass="z-border-bottom z-fs-title-lg z-fw-medium z-text-on-surface z-mb-8 z-pb-3">Chosenbox</div>

    <div sclass="z-mb-6 pv-cols-2">
        <div sclass="z-fs-label-sm z-fw-semibold z-text-uppercase z-text-secondary z-border-bottom z-pb-2 z-mb-4">States</div>
        <div sclass="pv-col-header-row z-pb-1">
            <div/>
            <div sclass="z-fs-label-sm z-fw-semibold z-text-secondary">Default</div>
            <div sclass="z-fs-label-sm z-fw-semibold z-text-secondary">Disabled</div>
        </div>
        <div sclass="pv-row z-py-2 z-border-bottom">
            <div sclass="z-fs-label-md z-text-secondary">Multiple</div>
            <div><chosenbox model="${chosenModel}" width="240px"/></div>
            <div><chosenbox model="${chosenModel}" disabled="true" width="240px"/></div>
        </div>
        <div sclass="pv-row z-py-2 z-border-bottom">
            <div sclass="z-fs-label-md z-text-secondary">Creatable</div>
            <div><chosenbox creatable="true" noResultsText="No results" createMessage="Add new" width="240px"/></div>
            <div>—</div>
        </div>
    </div>
</div>
</zk>
