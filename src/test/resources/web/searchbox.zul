<?page title="Searchbox" contentType="text/html;charset=UTF-8"?>
<zk xmlns:h="native">
<h:link rel="stylesheet" href="pv.css"/>
<zscript>
ListModel searchModel = new ListModelArray(new String[]{
    "North America", "South America", "Europe", "Asia", "Africa", "Oceania", "Antarctica"
});
</zscript>
<div sclass="z-p-8">
    <div sclass="z-border-bottom z-fs-title-lg z-fw-medium z-text-on-surface z-mb-8 z-pb-3">Searchbox</div>

    <div sclass="z-mb-6 pv-cols-2">
        <div sclass="z-fs-label-sm z-fw-semibold z-text-uppercase z-text-secondary z-border-bottom z-pb-2 z-mb-4">States</div>
        <div sclass="pv-col-header-row z-pb-1">
            <div/>
            <div sclass="z-fs-label-sm z-fw-semibold z-text-secondary">Default</div>
            <div sclass="z-fs-label-sm z-fw-semibold z-text-secondary">Disabled</div>
        </div>
        <div sclass="pv-row z-py-2 z-border-bottom">
            <div sclass="z-fs-label-md z-text-secondary">Default</div>
            <div>
                <searchbox model="${searchModel}" placeholder="Search regions..." autoclose="true">
                    <template name="model"><html><![CDATA[<i class="z-icon-globe"></i> ${each}]]></html></template>
                </searchbox>
            </div>
            <div>
                <searchbox model="${searchModel}" placeholder="Search regions..." disabled="true"/>
            </div>
        </div>
    </div>
</div>
</zk>
