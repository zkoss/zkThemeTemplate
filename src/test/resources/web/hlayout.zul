<?page title="Hlayout" contentType="text/html;charset=UTF-8"?>
<zk xmlns:h="native">
<h:link rel="stylesheet" href="pv.css"/>
<div sclass="z-p-8">
    <div sclass="z-border-bottom z-fs-title-lg z-fw-medium z-text-on-surface z-mb-8 z-pb-3">Hlayout</div>

    <div sclass="z-mb-6">
        <div sclass="z-fs-label-sm z-fw-semibold z-text-uppercase z-text-secondary z-border-bottom z-pb-2 z-mb-4">Basic Horizontal Layout</div>
        <div sclass="z-d-flex z-align-end z-flex-wrap z-gap-6 z-py-3">
            <div sclass="z-d-flex z-flex-col z-align-start z-gap-2">
                <hlayout>
                    <button label="Button 1"/>
                    <button label="Button 2"/>
                    <button label="Button 3"/>
                </hlayout>
                <div sclass="z-fs-label-sm z-text-secondary">Default spacing</div>
            </div>
        </div>
    </div>

    <div sclass="z-mb-6">
        <div sclass="z-fs-label-sm z-fw-semibold z-text-uppercase z-text-secondary z-border-bottom z-pb-2 z-mb-4">Spacing Variants</div>
        <div sclass="z-d-flex z-align-end z-flex-wrap z-gap-6 z-py-3">
            <div sclass="z-d-flex z-flex-col z-align-start z-gap-2">
                <hlayout spacing="0">
                    <button label="A"/>
                    <button label="B"/>
                    <button label="C"/>
                </hlayout>
                <div sclass="z-fs-label-sm z-text-secondary">spacing="0"</div>
            </div>
            <div sclass="z-d-flex z-flex-col z-align-start z-gap-2">
                <hlayout spacing="16px">
                    <button label="A"/>
                    <button label="B"/>
                    <button label="C"/>
                </hlayout>
                <div sclass="z-fs-label-sm z-text-secondary">spacing="16px"</div>
            </div>
        </div>
    </div>

    <div sclass="z-mb-6">
        <div sclass="z-fs-label-sm z-fw-semibold z-text-uppercase z-text-secondary z-border-bottom z-pb-2 z-mb-4">Mixed Children</div>
        <div sclass="z-d-flex z-align-end z-flex-wrap z-gap-6 z-py-3">
            <div sclass="z-d-flex z-flex-col z-align-start z-gap-2">
                <hlayout>
                    <label value="Label"/>
                    <textbox value="Text"/>
                    <button label="Submit"/>
                </hlayout>
                <div sclass="z-fs-label-sm z-text-secondary">Label + Textbox + Button</div>
            </div>
        </div>
    </div>

</div>
</zk>
