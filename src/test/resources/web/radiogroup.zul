<?page title="Radiogroup" contentType="text/html;charset=UTF-8"?>
<zk xmlns:h="native">
<div sclass="z-p-8">
    <div sclass="z-border-bottom z-text-xl z-fw-medium z-text-on-surface z-mb-8 z-pb-3">Radio</div>

    <div sclass="z-mb-6 z-d-grid z-grid-cols-auto z-overflow-x-auto z-col-gap-6 z-row-gap-2 z-align-start" style="--zk-cols:4; --zk-col-min:min-content">
        <div sclass="z-grid-col-full z-text-xs z-fw-semibold z-text-uppercase z-text-secondary z-border-bottom z-pb-2 z-mb-4">States</div>
        <div sclass="z-d-contents">
            <div/>
            <div sclass="z-text-xs z-fw-semibold z-text-secondary">Default</div>
            <div sclass="z-text-xs z-fw-semibold z-text-secondary">Checked</div>
            <div sclass="z-text-xs z-fw-semibold z-text-secondary">Disabled</div>
            <div sclass="z-text-xs z-fw-semibold z-text-secondary">Disabled + Checked</div>
        </div>
        <div sclass="z-d-contents">
            <div sclass="z-text-sm z-text-secondary">No label</div>
            <div><radiogroup><radio/></radiogroup></div>
            <div><radiogroup><radio checked="true"/></radiogroup></div>
            <div><radiogroup><radio disabled="true"/></radiogroup></div>
            <div><radiogroup><radio disabled="true" checked="true"/></radiogroup></div>
        </div>
        <div sclass="z-d-contents">
            <div sclass="z-text-sm z-text-secondary">With label</div>
            <div><radiogroup><radio label="Radio"/></radiogroup></div>
            <div><radiogroup><radio label="Radio" checked="true"/></radiogroup></div>
            <div><radiogroup><radio label="Radio" disabled="true"/></radiogroup></div>
            <div><radiogroup><radio label="Radio" disabled="true" checked="true"/></radiogroup></div>
        </div>
    </div>

    <div sclass="z-mb-6">
        <div sclass="z-text-xs z-fw-semibold z-text-uppercase z-text-secondary z-border-bottom z-pb-2 z-mb-4">Group</div>
        <div sclass="z-d-flex z-align-start z-flex-wrap z-gap-6 z-py-3">
            <div sclass="z-d-flex z-flex-col z-align-start z-gap-2">
                <div sclass="z-text-xs z-text-secondary">Default</div>
                <radiogroup>
                    <radio label="Apple"/>
                    <radio label="Orange"/>
                    <radio label="Banana"/>
                </radiogroup>
            </div>
            <div sclass="z-d-flex z-flex-col z-align-start z-gap-2">
                <div sclass="z-text-xs z-text-secondary">With selection + disabled</div>
                <radiogroup>
                    <radio label="Apple" checked="true"/>
                    <radio label="Orange"/>
                    <radio label="Banana" disabled="true"/>
                </radiogroup>
            </div>
        </div>
    </div>
</div>
</zk>
