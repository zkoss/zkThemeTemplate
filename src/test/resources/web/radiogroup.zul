<?page title="Radiogroup" contentType="text/html;charset=UTF-8"?>
<zk xmlns:h="native">
<div sclass="z-p-8">
    <div sclass="z-border-bottom z-mb-8 z-pb-3"><label sclass="z-text-2xl z-fw-medium z-text-on-surface" value="Radio"/></div>

    <div sclass="z-mb-6 z-d-grid z-grid-cols-auto z-overflow-x-auto z-gap-x-6 z-gap-y-2 z-items-start" style="--zk-cols:4; --zk-col-min:min-content">
        <div sclass="z-grid-col-full z-text-uppercase z-border-bottom z-pb-2 z-mb-4"><label sclass="z-text-xs z-fw-semibold z-text-secondary" value="States"/></div>
        <div sclass="z-d-contents">
            <div/>
            <div><label sclass="z-text-xs z-fw-semibold z-text-secondary" value="Default"/></div>
            <div><label sclass="z-text-xs z-fw-semibold z-text-secondary" value="Checked"/></div>
            <div><label sclass="z-text-xs z-fw-semibold z-text-secondary" value="Disabled"/></div>
            <div><label sclass="z-text-xs z-fw-semibold z-text-secondary" value="Disabled + Checked"/></div>
        </div>
        <div sclass="z-d-contents">
            <div><label sclass="z-text-sm z-text-secondary" value="No label"/></div>
            <div><radiogroup><radio/></radiogroup></div>
            <div><radiogroup><radio checked="true"/></radiogroup></div>
            <div><radiogroup><radio disabled="true"/></radiogroup></div>
            <div><radiogroup><radio disabled="true" checked="true"/></radiogroup></div>
        </div>
        <div sclass="z-d-contents">
            <div><label sclass="z-text-sm z-text-secondary" value="With label"/></div>
            <div><radiogroup><radio label="Radio"/></radiogroup></div>
            <div><radiogroup><radio label="Radio" checked="true"/></radiogroup></div>
            <div><radiogroup><radio label="Radio" disabled="true"/></radiogroup></div>
            <div><radiogroup><radio label="Radio" disabled="true" checked="true"/></radiogroup></div>
        </div>
    </div>

    <div sclass="z-mb-6">
        <div sclass="z-text-uppercase z-border-bottom z-pb-2 z-mb-4"><label sclass="z-text-xs z-fw-semibold z-text-secondary" value="Group"/></div>
        <div sclass="z-d-flex z-items-start z-flex-wrap z-gap-6 z-py-3">
            <div sclass="z-d-flex z-flex-col z-items-start z-gap-2">
                <div><label sclass="z-text-xs z-text-secondary" value="Default"/></div>
                <radiogroup>
                    <radio label="Apple"/>
                    <radio label="Orange"/>
                    <radio label="Banana"/>
                </radiogroup>
            </div>
            <div sclass="z-d-flex z-flex-col z-items-start z-gap-2">
                <div><label sclass="z-text-xs z-text-secondary" value="With selection + disabled"/></div>
                <radiogroup>
                    <radio label="Apple" checked="true"/>
                    <radio label="Orange"/>
                    <radio label="Banana" disabled="true"/>
                </radiogroup>
            </div>
        </div>
    </div>
</div>
</zk>
