                    <div style="display:flex;flex-direction:column;align-items:center;gap:4px;width:80px;"><span class="z-icon-phone" style="font-size:24px;color:#376fd0;"/><label value="phone" style="font-size:10px;color:#757575;"/></div>
                    <div style="display:flex;flex-direction:column;align-items:center;gap:4px;width:80px;"><span class="z-icon-power-off" style="font-size:24px;color:#376fd0;"/><label value="power-off" style="font-size:10px;color:#757575;"/></div>
                    <div style="display:flex;flex-direction:column;align-items:center;gap:4px;width:80px;"><span class="z-icon-refresh" style="font-size:24px;color:#376fd0;"/><label value="refresh" style="font-size:10px;color:#757575;"/></div>
                    <div style="display:flex;flex-direction:column;align-items:center;gap:4px;width:80px;"><span class="z-icon-save" style="font-size:24px;color:#376fd0;"/><label value="save" style="font-size:10px;color:#757575;"/></div>
                    <div style="display:flex;flex-direction:column;align-items:center;gap:4px;width:80px;"><span class="z-icon-scissors" style="font-size:24px;color:#376fd0;"/><label value="scissors" style="font-size:10px;color:#757575;"/></div>
                    <div style="display:flex;flex-direction:column;align-items:center;gap:4px;width:80px;"><span class="z-icon-search-minus" style="font-size:24px;color:#376fd0;"/><label value="search-minus" style="font-size:10px;color:#757575;"/></div>
                    <div style="display:flex;flex-direction:column;align-items:center;gap:4px;width:80px;"><span class="z-icon-search-plus" style="font-size:24px;color:#376fd0;"/><label value="search-plus" style="font-size:10px;color:#757575;"/></div>
                    <div style="display:flex;flex-direction:column;align-items:center;gap:4px;width:80px;"><span class="z-icon-share-alt" style="font-size:24px;color:#376fd0;"/><label value="share-alt" style="font-size:10px;color:#757575;"/></div>
                    <div style="display:flex;flex-direction:column;align-items:center;gap:4px;width:80px;"><span class="z-icon-shopping-cart" style="font-size:24px;color:#376fd0;"/><label value="shopping-cart" style="font-size:10px;color:#757575;"/></div>
                    <div style="display:flex;flex-direction:column;align-items:center;gap:4px;width:80px;"><span class="z-icon-star" style="font-size:24px;color:#376fd0;"/><label value="star" style="font-size:10px;color:#757575;"/></div>
