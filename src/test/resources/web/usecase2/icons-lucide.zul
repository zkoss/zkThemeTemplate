<div sclass="m-main">
            <div sclass="m-page-header">
                <label sclass="m-page-title" value="Lucide Icons"/>
            </div>
            <div sclass="m-card">
                <label sclass="m-card__title" value="Lucide Icons"/>
                <label value="43 icons mapped via CSS mask-image — no font files required." style="color:#757575;font-size:13px;display:block;margin-bottom:16px;"/>
                <div style="display:flex;flex-wrap:wrap;gap:16px;">
                    <div style="display:flex;flex-direction:column;align-items:center;gap:4px;width:80px;"><span class="z-icon-bar-chart" style="font-size:24px;color:#376fd0;"/><label value="bar-chart" style="font-size:10px;color:#757575;"/></div>
                    <div style="display:flex;flex-direction:column;align-items:center;gap:4px;width:80px;"><span class="z-icon-bell" style="font-size:24px;color:#376fd0;"/><label value="bell" style="font-size:10px;color:#757575;"/></div>
                    <div style="display:flex;flex-direction:column;align-items:center;gap:4px;width:80px;"><span class="z-icon-book" style="font-size:24px;color:#376fd0;"/><label value="book" style="font-size:10px;color:#757575;"/></div>
                    <div style="display:flex;flex-direction:column;align-items:center;gap:4px;width:80px;"><span class="z-icon-calendar" style="font-size:24px;color:#376fd0;"/><label value="calendar" style="font-size:10px;color:#757575;"/></div>
                    <div style="display:flex;flex-direction:column;align-items:center;gap:4px;width:80px;"><span class="z-icon-check-circle" style="font-size:24px;color:#376fd0;"/><label value="check-circle" style="font-size:10px;color:#757575;"/></div>
                    <div style="display:flex;flex-direction:column;align-items:center;gap:4px;width:80px;"><span class="z-icon-check-square-o" style="font-size:24px;color:#376fd0;"/><label value="check-square-o" style="font-size:10px;color:#757575;"/></div>
                    <div style="display:flex;flex-direction:column;align-items:center;gap:4px;width:80px;"><span class="z-icon-clipboard" style="font-size:24px;color:#376fd0;"/><label value="clipboard" style="font-size:10px;color:#757575;"/></div>
                    <div style="display:flex;flex-direction:column;align-items:center;gap:4px;width:80px;"><span class="z-icon-cog" style="font-size:24px;color:#376fd0;"/><label value="cog" style="font-size:10px;color:#757575;"/></div>
                    <div style="display:flex;flex-direction:column;align-items:center;gap:4px;width:80px;"><span class="z-icon-copy" style="font-size:24px;color:#376fd0;"/><label value="copy" style="font-size:10px;color:#757575;"/></div>
                    <div style="display:flex;flex-direction:column;align-items:center;gap:4px;width:80px;"><span class="z-icon-cube" style="font-size:24px;color:#376fd0;"/><label value="cube" style="font-size:10px;color:#757575;"/></div>
                    <div style="display:flex;flex-direction:column;align-items:center;gap:4px;width:80px;"><span class="z-icon-download" style="font-size:24px;color:#376fd0;"/><label value="download" style="font-size:10px;color:#757575;"/></div>
                    <div style="display:flex;flex-direction:column;align-items:center;gap:4px;width:80px;"><span class="z-icon-envelope" style="font-size:24px;color:#376fd0;"/><label value="envelope" style="font-size:10px;color:#757575;"/></div>
                    <div style="display:flex;flex-direction:column;align-items:center;gap:4px;width:80px;"><span class="z-icon-exclamation-triangle" style="font-size:24px;color:#376fd0;"/><label value="exclamation-triangle" style="font-size:10px;color:#757575;"/></div>
                    <div style="display:flex;flex-direction:column;align-items:center;gap:4px;width:80px;"><span class="z-icon-expand" style="font-size:24px;color:#376fd0;"/><label value="expand" style="font-size:10px;color:#757575;"/></div>
                    <div style="display:flex;flex-direction:column;align-items:center;gap:4px;width:80px;"><span class="z-icon-eye" style="font-size:24px;color:#376fd0;"/><label value="eye" style="font-size:10px;color:#757575;"/></div>
                    <div style="display:flex;flex-direction:column;align-items:center;gap:4px;width:80px;"><span class="z-icon-file" style="font-size:24px;color:#376fd0;"/><label value="file" style="font-size:10px;color:#757575;"/></div>
                    <div style="display:flex;flex-direction:column;align-items:center;gap:4px;width:80px;"><span class="z-icon-file-o" style="font-size:24px;color:#376fd0;"/><label value="file-o" style="font-size:10px;color:#757575;"/></div>
                    <div style="display:flex;flex-direction:column;align-items:center;gap:4px;width:80px;"><span class="z-icon-file-text-o" style="font-size:24px;color:#376fd0;"/><label value="file-text-o" style="font-size:10px;color:#757575;"/></div>
