                    <div style="display:flex;flex-direction:column;align-items:center;gap:4px;width:80px;"><span class="z-icon-heart-o" style="font-size:24px;color:#376fd0;"/><label value="heart-o" style="font-size:10px;color:#757575;"/></div>
                    <div style="display:flex;flex-direction:column;align-items:center;gap:4px;width:80px;"><span class="z-icon-info-circle" style="font-size:24px;color:#376fd0;"/><label value="info-circle" style="font-size:10px;color:#757575;"/></div>
