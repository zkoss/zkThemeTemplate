<div sclass="m-main">
    <div sclass="m-page-header">
        <label sclass="m-page-title" value="Tooltips"/>
    </div>

    <!-- 1. Simple Tooltips — tooltiptext attribute -->
    <div sclass="m-card" style="margin-bottom:24px;">
        <label sclass="m-card__title" value="Simple Tooltips"/>
        <label value="Tooltips display informative text when users hover over, focus on, or tap an element."
               style="font-size:13px;color:var(--md-sys-color-on-surface-variant);display:block;padding:8px 0 16px;"/>
        <div style="display:flex;gap:12px;flex-wrap:wrap;">
            <button label="Delete" iconSclass="z-icon-trash-2" sclass="z-button-outlined"
                    tooltiptext="Delete this item"/>
            <button label="Add" iconSclass="z-icon-plus" sclass="z-button-outlined"
                    tooltiptext="Add new item"/>
        </div>
    </div>

    <!-- 2. Triggerable Tooltips — hover (tooltip attr), click (popup attr) -->
    <div sclass="m-card" style="margin-bottom:24px;">
        <label sclass="m-card__title" value="Triggerable Tooltips"/>
        <label value="You can define the types of events that cause a tooltip to show."
               style="font-size:13px;color:var(--md-sys-color-on-surface-variant);display:block;padding:8px 0 16px;"/>
        <div style="display:flex;gap:12px;flex-wrap:wrap;">
            <popup id="ttHover1" sclass="z-popup-tooltip">
                <label value="Hover or touch"/>
            </popup>
            <button label="Hover or touch" sclass="z-button-outlined" tooltip="ttHover1"/>

            <popup id="ttFocus" sclass="z-popup-tooltip">
                <label value="Focus or touch"/>
            </popup>
            <button label="Focus or touch" sclass="z-button-outlined" tooltip="ttFocus"/>

            <button label="Hover" sclass="z-button-outlined" tooltiptext="Hover tooltip"/>

            <popup id="ttClick" sclass="z-popup-tooltip">
                <label value="Click tooltip"/>
            </popup>
            <button label="Click" sclass="z-button-outlined" popup="ttClick"/>
        </div>
    </div>

    <!-- 3. Positioned Tooltips — 12-position grid -->
    <div sclass="m-card" style="margin-bottom:24px;">
        <label sclass="m-card__title" value="Positioned Tooltips"/>
        <div style="padding-top:16px;">

            <!-- Single shared popup for all 12 position buttons -->
            <popup id="posTooltip" sclass="z-popup-tooltip"><label value="Tooltip"/></popup>

            <div style="display:grid;grid-template-columns:repeat(5,1fr);gap:8px;max-width:520px;margin:0 auto;">
                <!-- Row 1: top -->
                <div/>
                <button label="before_start"  sclass="z-button-outlined" tooltip="posTooltip, position=before_start"/>
                <button label="before_center" sclass="z-button-outlined" tooltip="posTooltip, position=before_center"/>
                <button label="before_end"    sclass="z-button-outlined" tooltip="posTooltip, position=before_end"/>
                <div/>
                <!-- Row 2 -->
                <button label="start_before"  sclass="z-button-outlined" tooltip="posTooltip, position=start_before"/>
                <div/><div/><div/>
                <button label="end_before"    sclass="z-button-outlined" tooltip="posTooltip, position=end_before"/>
                <!-- Row 3 -->
                <button label="start_center"  sclass="z-button-outlined" tooltip="posTooltip, position=start_center"/>
                <div/><div/><div/>
                <button label="end_center"    sclass="z-button-outlined" tooltip="posTooltip, position=end_center"/>
                <!-- Row 4 -->
                <button label="start_after"   sclass="z-button-outlined" tooltip="posTooltip, position=start_after"/>
                <div/><div/><div/>
                <button label="end_after"     sclass="z-button-outlined" tooltip="posTooltip, position=end_after"/>
                <!-- Row 5: bottom -->
                <div/>
                <button label="after_start"   sclass="z-button-outlined" tooltip="posTooltip, position=after_start"/>
                <button label="after_center"  sclass="z-button-outlined" tooltip="posTooltip, position=after_center"/>
                <button label="after_end"     sclass="z-button-outlined" tooltip="posTooltip, position=after_end"/>
                <div/>
            </div>
        </div>
    </div>

    <!-- 4. Animated Tooltips — z-popup-anim-* utility classes -->
    <div sclass="m-card">
        <label sclass="m-card__title" value="Animated Tooltips"/>
        <div style="display:flex;gap:12px;flex-wrap:wrap;padding-top:16px;">
            <popup id="ttFade" sclass="z-popup-tooltip z-popup-anim-fade">
                <label value="Fade animation"/>
            </popup>
            <button label="Fade" sclass="z-button-outlined" tooltip="ttFade"/>

            <popup id="ttZoom" sclass="z-popup-tooltip z-popup-anim-zoom">
                <label value="Zoom animation"/>
            </popup>
            <button label="Zoom" sclass="z-button-outlined" tooltip="ttZoom"/>

            <popup id="ttGrow" sclass="z-popup-tooltip z-popup-anim-grow">
                <label value="Grow animation"/>
            </popup>
            <button label="Grow" sclass="z-button-outlined" tooltip="ttGrow"/>
        </div>
    </div>

</div>
