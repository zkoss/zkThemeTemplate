<div sclass="m-main">
            <div sclass="m-page-header">
                <label sclass="m-page-title" value="Chips"/>
            </div>

            <div sclass="z-card">
                <label sclass="z-card__title" value="Filled Chips"/>
                <hlayout spacing="8px" style="flex-wrap:wrap;">
                    <div sclass="z-chip z-chip-primary">Today</div>
                    <div sclass="z-chip z-chip-success">Active</div>
                    <div sclass="z-chip z-chip-warning">Pending</div>
                    <div sclass="z-chip z-chip-error">Expired</div>
                </hlayout>

                <separator/>

                <label sclass="z-card__title" value="Period Chips"/>
                <hlayout spacing="8px">
                    <div sclass="z-chip z-chip-primary">Today</div>
                    <div sclass="z-chip z-chip-primary">Annual</div>
                    <div sclass="z-chip z-chip-primary">Monthly</div>
                    <div sclass="z-chip z-chip-primary">Weekly</div>
                </hlayout>
            </div>
        </div>
