<div sclass="m-main">
            <div sclass="m-page-header">
                <label sclass="m-page-title" value="Data Grid"/>
            </div>
            <div sclass="m-card">
                <label sclass="m-card__title" value="Data Grid"/>
                <grid mold="default">
                    <columns>
                        <column label="SKU" width="100px"/>
                        <column label="Product Name"/>
                        <column label="Category" width="140px"/>
                        <column label="Price" width="100px"/>
                        <column label="Stock" width="90px"/>
                        <column label="Rating" width="90px"/>
                        <column label="Status" width="110px"/>
                    </columns>
                    <rows>
                        <row>
