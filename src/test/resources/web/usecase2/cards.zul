<div sclass="m-main">
            <div sclass="m-page-header">
                <label sclass="m-page-title" value="Cards"/>
            </div>

            <hlayout spacing="16px" style="flex-wrap:wrap;align-items:flex-start;">

                <!-- Basic card -->
                <div sclass="m-card" style="width:300px;">
                    <div sclass="m-card__header">
                        <label sclass="m-card__title" value="Basic Card"/>
                    </div>
                    <div sclass="m-card__body">
                        <label value="This is a basic card with a header, body, and optional footer section."/>
                    </div>
                    <div sclass="m-card__footer">
                        <button label="Action" sclass="z-button-primary"/>
                    </div>
                </div>

                <!-- Card with image -->
                <div sclass="m-card" style="width:300px;padding:0;overflow:hidden;">
                    <div style="background:var(--md-sys-color-primary-container,#d6e4ff);height:120px;display:flex;align-items:center;justify-content:center;">
                        <label value="Image Placeholder" style="color:var(--md-sys-color-primary,#376fd0);"/>
                    </div>
                    <div sclass="m-card__body" style="padding:16px;">
                        <label sclass="m-card__title" value="Card with Image"/>
                        <label value="Cards can contain images, media, and rich content." style="font-size:13px;color:#666;"/>
                    </div>
                </div>

                <!-- KPI card sample -->
                <div sclass="m-card m-kpi-card" style="width:220px;">
                    <div sclass="m-kpi-card__header">
                        <label sclass="m-kpi-card__label" value="Sales Today"/>
                        <div sclass="z-chip z-chip-primary">Today</div>
                    </div>
                    <label sclass="m-kpi-card__value" value="2,532"/>
                    <div sclass="m-kpi-card__footer">
                        <span sclass="m-kpi-trend--up">+26%</span>
                        <span sclass="m-kpi-since">Since last month</span>
                    </div>
                </div>

            </hlayout>
        </div>
