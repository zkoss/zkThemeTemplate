<div sclass="m-main">

    <div sclass="m-page-header">
        <label sclass="m-page-title" value="Editors"/>
    </div>

    <div sclass="m-card" style="margin-bottom:24px;">
        <label sclass="m-card__title" value="Quill"/>
        <label value="Modern WYSIWYG editor built for compatibility and extensibility." style="font-size:13px;color:#49454f;display:block;margin-bottom:16px;"/>
        <div style="border:1px solid var(--md-sys-color-outline-variant,#e0e0e0);border-radius:8px;overflow:hidden;">
            <div style="background:#f5f5f5;border-bottom:1px solid #e0e0e0;padding:8px 12px;display:flex;gap:8px;">
                <button iconSclass="z-icon-bold"          sclass="z-button-outlined" style="min-width:32px;padding:4px 8px;"/>
                <button iconSclass="z-icon-italic"        sclass="z-button-outlined" style="min-width:32px;padding:4px 8px;"/>
                <button iconSclass="z-icon-underline"     sclass="z-button-outlined" style="min-width:32px;padding:4px 8px;"/>
                <button iconSclass="z-icon-list"          sclass="z-button-outlined" style="min-width:32px;padding:4px 8px;"/>
                <button iconSclass="z-icon-list-ordered" sclass="z-button-outlined" style="min-width:32px;padding:4px 8px;"/>
                <button iconSclass="z-icon-link"          sclass="z-button-outlined" style="min-width:32px;padding:4px 8px;"/>
            </div>
            <textbox multiline="true" rows="8" style="width:100%;border:none;padding:12px;font-family:inherit;font-size:14px;resize:vertical;"
                value="Write something here..."/>
        </div>
    </div>

    <div sclass="m-card">
        <label sclass="m-card__title" value="Bubble"/>
        <label value="Bubble is a simple tooltip based theme for Quill." style="font-size:13px;color:#49454f;display:block;margin-bottom:16px;"/>
        <div style="border:1px solid var(--md-sys-color-outline-variant,#e0e0e0);border-radius:8px;padding:16px;min-height:120px;font-size:14px;color:#49454f;">
            <label value="Select text to see the bubble toolbar appear." style="font-style:italic;color:#9e9e9e;"/>
        </div>
    </div>

</div>
