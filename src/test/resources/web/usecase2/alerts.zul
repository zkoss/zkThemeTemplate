<?page title="Alerts | Mira ZK"?>
<?link rel="stylesheet" type="text/css" href="~./usecase2/usecase2.css"?>
<zk>
<borderlayout height="100vh">
    <west size="258px" border="none" sclass="m-sidebar">
        <include src="~./usecase2/_sidebar.zul"/>
    </west>
    <center border="none" autoscroll="true">
        <div sclass="m-main">
            <div sclass="m-page-header">
                <label sclass="m-page-title" value="Alerts"/>
            </div>

            <vlayout spacing="20px">
                <!-- Basic Alerts -->
                <div sclass="m-card">
                    <label sclass="m-card__title" value="Default Alerts"/>
                    <vlayout spacing="12px">
                        <div sclass="m-alert m-alert--info">
                            <span sclass="m-alert__icon z-icon-info-circle"/>
                            <label value="This is an info alert — check it out!"/>
                        </div>
                        <div sclass="m-alert m-alert--success">
                            <span sclass="m-alert__icon z-icon-check-circle"/>
                            <label value="This is a success alert — check it out!"/>
                        </div>
                        <div sclass="m-alert m-alert--warning">
                            <span sclass="m-alert__icon z-icon-exclamation-triangle"/>
                            <label value="This is a warning alert — check it out!"/>
                        </div>
                        <div sclass="m-alert m-alert--error">
                            <span sclass="m-alert__icon z-icon-times-circle"/>
                            <label value="This is an error alert — check it out!"/>
                        </div>
                    </vlayout>
                </div>

                <!-- Toast/Notification trigger -->
                <div sclass="m-card">
                    <label sclass="m-card__title" value="Notifications (Toasts)"/>
                    <hlayout spacing="10px">
                        <button label="Show Success" sclass="m-btn--success" onClick='Clients.showNotification("Operation completed successfully!", "info", null, "top_right", 3000)'/>
                        <button label="Show Warning" sclass="m-btn--warning" onClick='Clients.showNotification("Warning: Disk space is low.", "warning", null, "top_right", 3000)'/>
                        <button label="Show Error"   sclass="m-btn--danger"  onClick='Clients.showNotification("Error: Could not save data.", "error", null, "top_right", 3000)'/>
                    </hlayout>
                </div>
            </vlayout>
        </div>
    </center>
</borderlayout>
</zk>
