<div sclass="m-main">
            <div sclass="m-page-header">
                <label sclass="m-page-title" value="Badges"/>
            </div>

            <div sclass="z-card">
                <label sclass="z-card__title" value="Color Variants"/>
                <hlayout spacing="8px" style="flex-wrap:wrap;">
                    <div sclass="z-badge z-badge-success">Done</div>
                    <div sclass="z-badge z-badge-warning">In Progress</div>
                    <div sclass="z-badge z-badge-error">Cancelled</div>
                    <div sclass="z-badge z-badge-info">New</div>
                    <div sclass="z-badge z-badge-neutral">Archived</div>
                </hlayout>

                <separator/>

                <label sclass="z-card__title" value="Inline with text"/>
                <vlayout spacing="8px">
                    <hlayout>
                        <label value="Project Aurora  "/>
                        <div sclass="z-badge z-badge-success">Done</div>
                    </hlayout>
                    <hlayout>
                        <label value="Project Eagle   "/>
                        <div sclass="z-badge z-badge-warning">In Progress</div>
                    </hlayout>
                    <hlayout>
                        <label value="Project Omega   "/>
                        <div sclass="z-badge z-badge-error">Cancelled</div>
                    </hlayout>
                </vlayout>
            </div>
        </div>
