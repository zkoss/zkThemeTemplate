<div sclass="m-main" xmlns:ca="client/attribute">
            <div sclass="m-page-header">
                <label sclass="m-page-title" value="Badges"/>
            </div>

            <!-- Overlay badges overflow their host's corner, so the row must NOT clip.
                 z-hstack is a flex row with visible overflow; <hlayout> sets
                 overflow:hidden and would crop the badge (see skill: hlayout-vlayout). -->
            <div sclass="z-card" style="margin-bottom:16px;">
                <label sclass="z-card__title" value="Icon Badges"/>
                <div sclass="z-hstack-lg" style="padding:8px 4px;">
                    <span sclass="z-icon-mail z-badge z-badge-default" ca:data-badge="4" style="font-size:26px;color:#5f6368;"/>
                    <span sclass="z-icon-bell z-badge z-badge-error" ca:data-badge="7" style="font-size:26px;color:#5f6368;"/>
                    <span sclass="z-icon-message-square z-badge z-badge-dot z-badge-error" style="font-size:26px;color:#5f6368;"/>
                </div>
            </div>

            <div sclass="z-card" style="margin-bottom:16px;">
                <label sclass="z-card__title" value="Colored Icon Badges"/>
                <div sclass="z-hstack-lg" style="padding:8px 4px;">
                    <span sclass="z-icon-mail z-badge z-badge-primary" ca:data-badge="4" style="font-size:26px;color:#5f6368;"/>
                    <span sclass="z-icon-mail z-badge z-badge-secondary" ca:data-badge="4" style="font-size:26px;color:#5f6368;"/>
                    <span sclass="z-icon-mail z-badge z-badge-error" ca:data-badge="4" style="font-size:26px;color:#5f6368;"/>
                    <span sclass="z-icon-mail z-badge z-badge-warning" ca:data-badge="4" style="font-size:26px;color:#5f6368;"/>
                    <span sclass="z-icon-mail z-badge z-badge-success" ca:data-badge="4" style="font-size:26px;color:#5f6368;"/>
                    <span sclass="z-icon-mail z-badge z-badge-info" ca:data-badge="4" style="font-size:26px;color:#5f6368;"/>
                </div>
            </div>

            <div sclass="z-card" style="margin-bottom:16px;">
                <label sclass="z-card__title" value="Button Badges"/>
                <div sclass="z-hstack-lg" style="padding:8px 4px;">
                    <button label="Notifications" sclass="z-badge z-badge-primary" ca:data-badge="4"/>
                    <button label="Messages" sclass="z-badge z-badge-error" ca:data-badge="10"/>
                </div>
            </div>

            <div sclass="z-card">
                <label sclass="z-card__title" value="Badge Visibility"/>
                <div sclass="z-hstack-lg" style="padding:8px 4px;">
                    <vlayout spacing="8px" style="align-items:center;">
                        <span sclass="z-icon-mail z-badge z-badge-error" ca:data-badge="4" style="font-size:26px;color:#5f6368;"/>
                        <label value="Visible" style="font-size:12px;color:#5f6368;"/>
                    </vlayout>
                    <vlayout spacing="8px" style="align-items:center;">
                        <span sclass="z-icon-mail z-badge z-badge-error z-badge-invisible" ca:data-badge="4" style="font-size:26px;color:#5f6368;"/>
                        <label value="Hidden" style="font-size:12px;color:#5f6368;"/>
                    </vlayout>
                    <vlayout spacing="8px" style="align-items:center;">
                        <span sclass="z-icon-mail z-badge z-badge-error" ca:data-badge="0" style="font-size:26px;color:#5f6368;"/>
                        <label value="Zero (auto-hide)" style="font-size:12px;color:#5f6368;"/>
                    </vlayout>
                </div>
            </div>
        </div>
