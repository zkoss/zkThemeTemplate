<?link rel="stylesheet" type="text/css" href="/usecase2/usecase2.css"?>
<div sclass="m-main">
    <div sclass="m-page-header">
        <label sclass="m-page-title" value="Selects"/>
    </div>

    <!-- Row 1: Simple Select (left) + Multiple Select / Controlled (right) -->
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;align-items:start;">
        <!-- Simple Select -->
        <div sclass="m-card m-pickers-card">
            <label sclass="m-card__title" value="Simple Select"/>
            <label sclass="m-pickers-desc" value="Menus are positioned over their emitting elements such that the currently selected menu item appears on top of the emitting element."/>

            <!-- Row 1: default + with helper text -->
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:12px;align-items:start;">
                <div>
                    <combobox width="100%" placeholder="Age" readonly="true">
                        <comboitem label="10"/><comboitem label="20"/><comboitem label="30"/>
                    </combobox>
                </div>
                <div>
                    <combobox width="100%" placeholder="Age" readonly="true">
                        <comboitem label="10"/><comboitem label="20"/>
                    </combobox>
                    <label sclass="m-pickers-desc" value="Some important helper text" style="margin-top:4px;margin-bottom:0;"/>
                </div>
            </div>

            <!-- Row 2: Without label + Label + placeholder -->
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:12px;align-items:start;">
                <div>
                    <combobox width="100%" value="None" readonly="true">
                        <comboitem label="None"/><comboitem label="10"/><comboitem label="20"/>
                    </combobox>
                    <label sclass="m-pickers-desc" value="Without label" style="margin-top:4px;margin-bottom:0;"/>
                </div>
                <div>
                    <label value="Age" style="font-size:11px;color:var(--zk-color-primary,#376fd0);display:block;margin-bottom:2px;"/>
                    <combobox width="100%" value="None" readonly="true">
                        <comboitem label="None"/><comboitem label="10"/><comboitem label="20"/>
                    </combobox>
                    <label sclass="m-pickers-desc" value="Label + placeholder" style="margin-top:4px;margin-bottom:0;"/>
                </div>
            </div>

            <!-- Row 3: Disabled + Error -->
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:12px;align-items:start;">
                <div>
                    <combobox width="100%" placeholder="Age" readonly="true" disabled="true">
                        <comboitem label="10"/>
                    </combobox>
                    <label sclass="m-pickers-desc" value="Disabled" style="margin-top:4px;margin-bottom:0;"/>
                </div>
                <div>
                    <combobox width="100%" placeholder="Age" sclass="z-combobox-error" readonly="true">
                        <comboitem label="10"/>
                    </combobox>
                    <label value="Error" style="font-size:11px;color:var(--zk-color-error,#d32f2f);display:block;margin-top:4px;"/>
                </div>
            </div>

            <!-- Row 4: Read only + Auto width -->
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:12px;align-items:start;">
                <div>
                    <combobox width="100%" placeholder="Age" readonly="true">
                        <comboitem label="10"/>
                    </combobox>
                    <label sclass="m-pickers-desc" value="Read only" style="margin-top:4px;margin-bottom:0;"/>
                </div>
                <div>
                    <combobox placeholder="Age" readonly="true">
                        <comboitem label="10"/>
                    </combobox>
                    <label sclass="m-pickers-desc" value="Auto width" style="margin-top:4px;margin-bottom:0;"/>
                </div>
            </div>

            <!-- Row 5: Placeholder + Required -->
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:12px;align-items:start;">
                <div>
                    <combobox width="100%" value="Placeholder" readonly="true">
                        <comboitem label="Placeholder"/><comboitem label="10"/>
                    </combobox>
                    <label sclass="m-pickers-desc" value="Placeholder" style="margin-top:4px;margin-bottom:0;"/>
                </div>
                <div>
                    <combobox width="100%" placeholder="Age *" readonly="true">
                        <comboitem label="10"/>
                    </combobox>
                    <label sclass="m-pickers-desc" value="Required" style="margin-top:4px;margin-bottom:0;"/>
                </div>
            </div>

            <!-- Row 6: two more defaults -->
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;align-items:start;">
                <div>
                    <combobox width="100%" placeholder="Age" readonly="true">
                        <comboitem label="10"/>
                    </combobox>
                </div>
                <div>
                    <combobox width="100%" placeholder="Age" readonly="true">
                        <comboitem label="10"/>
                    </combobox>
                </div>
            </div>
        </div>

        <!-- Right column: Multiple Select + Controlled open Select -->
        <div style="display:flex;flex-direction:column;gap:16px;">
            <div sclass="m-card m-pickers-card">
                <label sclass="m-card__title" value="Multiple Select"/>
                <label sclass="m-pickers-desc" value="The Select component can handle multiple selections."/>

                <!-- Name + Tag row -->
                <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:12px;">
                    <combobox width="100%" placeholder="Name" readonly="true">
                        <comboitem label="Oliver Hansen"/><comboitem label="Van Henry"/>
                    </combobox>
                    <combobox width="100%" placeholder="Tag" readonly="true">
                        <comboitem label="Tag 1"/><comboitem label="Tag 2"/>
                    </combobox>
                </div>

                <!-- Chip row -->
                <combobox width="100%" placeholder="Chip" readonly="true">
                    <comboitem label="Option 1"/><comboitem label="Option 2"/>
                </combobox>
            </div>

            <div sclass="m-card m-pickers-card">
                <label sclass="m-card__title" value="Controlled open Select"/>
                <label sclass="m-pickers-desc" value="Open select with button."/>
                <button sclass="z-button-contained" label="Open the select" style="margin-bottom:16px;"/>
                <combobox width="100%" placeholder="Age" readonly="true">
                    <comboitem label="10"/><comboitem label="20"/><comboitem label="30"/>
                </combobox>
            </div>
        </div>
    </div>

    <!-- With a Dialog -->
    <div sclass="m-card m-pickers-card" style="margin-top:16px;">
        <label sclass="m-card__title" value="With a Dialog"/>
        <label sclass="m-pickers-desc" value="While it's discouraged by the Material Design specification, you can use a select inside a dialog."/>
        <button sclass="z-button-contained" label="Open select dialog"/>
    </div>
</div>
