<div sclass="m-main">
    <div sclass="m-page-header">
        <label sclass="m-page-title" value="Expansion Panels"/>
    </div>

    <div style="display:grid;grid-template-columns:1fr 1fr;gap:24px;">

        <div sclass="m-card">
            <label sclass="m-card__title" value="Simple Expansion Panel"/>
            <label value="A lightweight container that may either stand alone or be connected to a larger surface, such as a card." style="font-size:13px;color:#49454f;display:block;margin-bottom:16px;"/>
            <tabbox mold="accordion" sclass="m-accordion" width="100%">
                <tabs>
                    <tab label="Expansion Panel 1"/>
                    <tab label="Expansion Panel 2"/>
                    <tab label="Disabled Expansion Panel" disabled="true"/>
                </tabs>
                <tabpanels>
                    <tabpanel>
                        <label value="Lorem ipsum dolor sit amet, consectetur adipiscing elit. Suspendisse malesuada lacus ex, sit amet blandit leo lobortis eget." style="font-size:13px;color:#555;line-height:1.6;"/>
                    </tabpanel>
                    <tabpanel>
                        <label value="Lorem ipsum dolor sit amet, consectetur adipiscing elit. Suspendisse malesuada lacus ex, sit amet blandit leo lobortis eget." style="font-size:13px;color:#555;line-height:1.6;"/>
                    </tabpanel>
                    <tabpanel/>
                </tabpanels>
            </tabbox>
        </div>

        <div sclass="m-card">
            <label sclass="m-card__title" value="Controlled Expansion Panel"/>
            <label value="Extend the default panel behavior to create an accordion with the Accordion component." style="font-size:13px;color:#49454f;display:block;margin-bottom:16px;"/>
            <tabbox mold="accordion" sclass="m-accordion" width="100%">
                <tabs>
                    <tab label="General settings"/>
                    <tab label="Users"/>
                    <tab label="Advanced settings"/>
                    <tab label="Personal data"/>
                </tabs>
                <tabpanels>
                    <tabpanel>
                        <label value="Nulla facilisi. Phasellus sollicitudin nulla et quam mattis feugiat. Aliquam eget maximus est, id dignissim quam." style="font-size:13px;color:#555;line-height:1.6;"/>
                    </tabpanel>
                    <tabpanel>
                        <label value="Donec placerat, lectus sed mattis semper, neque lectus feugiat lectus, varius pulvinar diam eros in elit. Pellentesque convallis laoreet laoreet." style="font-size:13px;color:#555;line-height:1.6;"/>
                    </tabpanel>
                    <tabpanel>
                        <label value="Nunc vitae orci ultricies, auctor nunc in, volutpat nisl. Integer sit amet egestas eros, vitae egestas augue. Duis vel est augue." style="font-size:13px;color:#555;line-height:1.6;"/>
                    </tabpanel>
                    <tabpanel>
