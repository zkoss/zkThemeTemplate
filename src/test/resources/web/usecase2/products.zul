<div sclass="m-main">

    <div sclass="m-page-header">
        <label sclass="m-page-title" value="Products"/>
        <hlayout sclass="m-page-actions">
            <button label="New Product" sclass="z-button-primary"/>
        </hlayout>
    </div>

    <div sclass="m-card">
        <label sclass="m-card__title" value="Products"/>
        <listbox checkmark="true" multiple="true">
            <listhead>
                <listheader label="Item Name"/>
                <listheader label="Price"    width="120px"/>
                <listheader label="Stock"    width="80px"/>
                <listheader label="Category" width="140px"/>
                <listheader label="Rating"   hflex="min"/>
                <listheader label="Actions"  width="100px"/>
            </listhead>
            <listitem>
                <listcell label="Apple iPad Pro (Silver)"/>
                <listcell label="$1,399.00"/>
                <listcell label="48"/>
                <listcell><div sclass="m-chip">Tablets</div></listcell>
                <listcell label="4.6 of 55 Reviews"/>
                <listcell><hlayout spacing="4px"><button iconSclass="z-icon-eye" sclass="z-button-icon"/><button iconSclass="z-icon-pencil" sclass="z-button-icon"/><button iconSclass="z-icon-trash-2" sclass="z-button-icon"/></hlayout></listcell>
            </listitem>
            <listitem>
                <listcell label="Apple iPad Pro (Space Gray)"/>
                <listcell label="$1,399.00"/>
                <listcell label="48"/>
                <listcell><div sclass="m-chip">Tablets</div></listcell>
                <listcell label="4.3 of 25 Reviews"/>
                <listcell><hlayout spacing="4px"><button iconSclass="z-icon-eye" sclass="z-button-icon"/><button iconSclass="z-icon-pencil" sclass="z-button-icon"/><button iconSclass="z-icon-trash-2" sclass="z-button-icon"/></hlayout></listcell>
            </listitem>
            <listitem>
                <listcell label="Apple iPhone 15 Pro Max (Blue Titanium)"/>
                <listcell label="$1,499.00"/>
                <listcell label="38"/>
                <listcell><div sclass="m-chip m-chip--primary">Smartphones</div></listcell>
                <listcell label="4.6 of 40 Reviews"/>
                <listcell><hlayout spacing="4px"><button iconSclass="z-icon-eye" sclass="z-button-icon"/><button iconSclass="z-icon-pencil" sclass="z-button-icon"/><button iconSclass="z-icon-trash-2" sclass="z-button-icon"/></hlayout></listcell>
            </listitem>
            <listitem>
                <listcell label="Apple iPhone 15 Pro Max (Natural Titanium)"/>
                <listcell label="$1,499.00"/>
                <listcell label="30"/>
                <listcell><div sclass="m-chip m-chip--primary">Smartphones</div></listcell>
                <listcell label="4.8 of 50 Reviews"/>
                <listcell><hlayout spacing="4px"><button iconSclass="z-icon-eye" sclass="z-button-icon"/><button iconSclass="z-icon-pencil" sclass="z-button-icon"/><button iconSclass="z-icon-trash-2" sclass="z-button-icon"/></hlayout></listcell>
            </listitem>
            <listitem>
                <listcell label="Apple iPhone 15 Pro Max (White Titanium)"/>
                <listcell label="$1,499.00"/>
                <listcell label="45"/>
                <listcell><div sclass="m-chip m-chip--primary">Smartphones</div></listcell>
                <listcell label="4.9 of 60 Reviews"/>
                <listcell><hlayout spacing="4px"><button iconSclass="z-icon-eye" sclass="z-button-icon"/><button iconSclass="z-icon-pencil" sclass="z-button-icon"/><button iconSclass="z-icon-trash-2" sclass="z-button-icon"/></hlayout></listcell>
            </listitem>
            <listitem>
                <listcell label="Apple MacBook Pro 16&quot; (Silver)"/>
                <listcell label="$2,399.00"/>
                <listcell label="55"/>
                <listcell><div sclass="m-chip">Notebooks</div></listcell>
                <listcell label="4.7 of 45 Reviews"/>
                <listcell><hlayout spacing="4px"><button iconSclass="z-icon-eye" sclass="z-button-icon"/><button iconSclass="z-icon-pencil" sclass="z-button-icon"/><button iconSclass="z-icon-trash-2" sclass="z-button-icon"/></hlayout></listcell>
            </listitem>
        </listbox>
    </div>

</div>
