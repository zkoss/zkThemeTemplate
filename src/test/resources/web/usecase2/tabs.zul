<?page title="Tabs | Mira ZK"?>
<?link rel="stylesheet" type="text/css" href="~./usecase2/usecase2.css"?>
<zk>
<borderlayout height="100vh">
    <west size="258px" border="none" sclass="m-sidebar">
        <include src="~./usecase2/_sidebar.zul"/>
    </west>
    <center border="none" autoscroll="true">
        <div sclass="m-main">
            <div sclass="m-page-header">
                <label sclass="m-page-title" value="Tabs"/>
            </div>

            <div sclass="m-card" style="margin-bottom:16px;">
                <label sclass="m-card__title" value="Standard Tabs"/>
                <tabbox sclass="m-tabs" width="100%">
                    <tabs>
                        <tab label="Item One"/>
                        <tab label="Item Two"/>
                        <tab label="Item Three"/>
                        <tab label="Item Four"/>
                    </tabs>
                    <tabpanels>
                        <tabpanel><label value="Content for tab 1." style="font-size:13px;color:#555;padding:12px 0;display:block;"/></tabpanel>
                        <tabpanel><label value="Content for tab 2." style="font-size:13px;color:#555;padding:12px 0;display:block;"/></tabpanel>
                        <tabpanel><label value="Content for tab 3." style="font-size:13px;color:#555;padding:12px 0;display:block;"/></tabpanel>
                        <tabpanel><label value="Content for tab 4." style="font-size:13px;color:#555;padding:12px 0;display:block;"/></tabpanel>
                    </tabpanels>
                </tabbox>
            </div>

            <div sclass="m-card">
                <label sclass="m-card__title" value="Tabs with Icons"/>
                <tabbox sclass="m-tabs" width="100%">
                    <tabs>
                        <tab label="Phone"   iconSclass="z-icon-phone"/>
                        <tab label="Settings" iconSclass="z-icon-cog"/>
                        <tab label="Profile"  iconSclass="z-icon-user"/>
                    </tabs>
                    <tabpanels>
                        <tabpanel><label value="Phone settings content." style="font-size:13px;color:#555;padding:12px 0;display:block;"/></tabpanel>
                        <tabpanel><label value="General settings content." style="font-size:13px;color:#555;padding:12px 0;display:block;"/></tabpanel>
                        <tabpanel><label value="Profile content." style="font-size:13px;color:#555;padding:12px 0;display:block;"/></tabpanel>
                    </tabpanels>
                </tabbox>
            </div>
        </div>
    </center>
</borderlayout>
</zk>
