<div sclass="m-main">
            <div sclass="m-page-header">
                <label sclass="m-page-title" value="Lists"/>
            </div>

            <hlayout spacing="16px" style="align-items:flex-start;">

                <!-- Simple list -->
                <div sclass="z-card" style="flex:1;">
                    <label sclass="z-card__title" value="Simple List"/>
                    <div sclass="m-list">
                        <div sclass="m-list__item">Inbox</div>
                        <div sclass="m-list__item">Starred</div>
                        <div sclass="m-list__item">Send email</div>
                        <div sclass="m-list__item">Drafts</div>
                    </div>
                </div>

                <!-- List with icons -->
                <div sclass="z-card" style="flex:1;">
                    <label sclass="z-card__title" value="List with Icons"/>
                    <div sclass="m-list">
                        <div sclass="m-list__item">
                            <span sclass="z-icon-mail m-list__icon"/>
                            <span>Inbox</span>
                        </div>
                        <div sclass="m-list__item">
                            <span sclass="z-icon-star m-list__icon"/>
                            <span>Starred</span>
                        </div>
                        <div sclass="m-list__item">
                            <span sclass="z-icon-send m-list__icon"/>
                            <span>Sent</span>
                        </div>
                        <div sclass="m-list__item">
                            <span sclass="z-icon-file m-list__icon"/>
                            <span>Drafts</span>
                        </div>
                    </div>
                </div>

                <!-- Checkable list (listbox) -->
                <div sclass="z-card" style="flex:1;">
                    <label sclass="z-card__title" value="Checkable List"/>
                    <listbox checkmark="true" sclass="z-listbox-plain" multiple="true">
                        <listitem><listcell label="Buy groceries"/></listitem>
                        <listitem><listcell label="Walk the dog"/></listitem>
                        <listitem><listcell label="Read a book"/></listitem>
                        <listitem><listcell label="Call dentist"/></listitem>
                        <listitem><listcell label="Review pull requests"/></listitem>
                    </listbox>
                </div>

            </hlayout>
        </div>
