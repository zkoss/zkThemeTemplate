<div sclass="m-main" style="display:flex;align-items:center;justify-content:center;min-height:calc(100vh - 64px);">

    <div sclass="z-card" style="width:400px;">
        <label value="Reset Password" style="font-size:22px;font-weight:700;display:block;margin-bottom:8px;"/>
        <label value="Enter your email to reset your password" style="font-size:14px;color:#49454f;display:block;margin-bottom:24px;"/>

        <label value="Email Address" style="font-size:13px;font-weight:600;display:block;margin-bottom:4px;"/>
        <textbox placeholder="Email Address" style="width:100%;margin-bottom:24px;" cols="40"/>

        <button label="Reset password" sclass="z-button-primary" style="width:100%;margin-bottom:16px;"/>

        <label value="Don't have an account? " style="font-size:13px;color:#49454f;"/>
        <a href="#" label="Sign up" style="font-size:13px;color:#376fd0;"/>
    </div>

</div>
