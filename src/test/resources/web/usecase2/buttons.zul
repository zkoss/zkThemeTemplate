<div sclass="m-main">
    <div sclass="m-page-header">
        <label sclass="m-page-title" value="Buttons"/>
    </div>

    <div style="display:grid;grid-template-columns:1fr 1fr;gap:24px;align-items:start;">

        <!-- Left column -->
        <div>
            <!-- Contained Buttons -->
            <div sclass="z-card" style="margin-bottom:16px;">
                <label sclass="z-card__title" value="Contained Buttons"/>
                <label value="Contained buttons are high-emphasis, distinguished by their use of elevation and fill." style="font-size:13px;color:#49454f;display:block;margin-bottom:12px;"/>
                <div sclass="z-button-group">
                    <button label="Default"/>
                    <button label="Primary"   sclass="z-button-primary"/>
                    <button label="Secondary" sclass="z-button-secondary"/>
                    <button label="Success"   sclass="z-button-success"/>
                    <button label="Warning"   sclass="z-button-warning"/>
                    <button label="Error"     sclass="z-button-error"/>
                    <button label="Info"      sclass="z-button-info"/>
                </div>
                <div sclass="z-button-group" style="margin-top:8px;">
                    <button label="Disabled" disabled="true"/>
                </div>
            </div>

            <!-- Outlined Buttons -->
            <div sclass="z-card" style="margin-bottom:16px;">
                <label sclass="z-card__title" value="Outlined Buttons"/>
                <label value="Outlined buttons are medium-emphasis buttons which contain actions that are not that important." style="font-size:13px;color:#49454f;display:block;margin-bottom:12px;"/>
                <div sclass="z-button-group">
                    <button label="Default"   sclass="z-button-outlined"/>
                    <button label="Primary"   sclass="z-button-outlined"/>
                    <button label="Secondary" sclass="z-button-outlined-secondary"/>
                    <button label="Disabled"  sclass="z-button-outlined" disabled="true"/>
                    <button label="Link"      sclass="z-button-text"/>
                </div>
            </div>

            <!-- Text Buttons -->
            <div sclass="z-card" style="margin-bottom:16px;">
                <label sclass="z-card__title" value="Text Buttons"/>
                <label value="Text buttons are typically used for less-pronounced actions in your app." style="font-size:13px;color:#49454f;display:block;margin-bottom:12px;"/>
                <div sclass="z-button-group">
                    <button label="Default"   sclass="z-button-text"/>
                    <button label="Primary"   sclass="z-button-text"/>
                    <button label="Secondary" sclass="z-button-text-secondary"/>
                    <button label="Disabled"  sclass="z-button-text" disabled="true"/>
                    <button label="Link"      sclass="z-button-text"/>
                </div>
            </div>

            <!-- Icon Buttons -->
            <div sclass="z-card">
                <label sclass="z-card__title" value="Icon Buttons"/>
                <label value="Sometimes you might want to have icons for certain buttons to enhance the UX." style="font-size:13px;color:#49454f;display:block;margin-bottom:12px;"/>
                <div sclass="z-button-group">
                    <button label="Add"    iconSclass="z-icon-plus"        sclass="z-button-primary"/>
                    <button label="Edit"   iconSclass="z-icon-pencil"      sclass="z-button-secondary"/>
                    <button label="Upload" iconSclass="z-icon-upload"      sclass="z-button-info"/>
                    <button label="Talk"   iconSclass="z-icon-mic"  sclass="z-button-outlined"/>
                    <button label="Save"   iconSclass="z-icon-save"/>
                </div>
            </div>
        </div>

        <!-- Right column -->
        <div>
            <!-- Button Sizes -->
            <div sclass="z-card" style="margin-bottom:16px;">
                <label sclass="z-card__title" value="Button Sizes"/>
                <label value="Fancy larger or smaller buttons? Use the size modifier." style="font-size:13px;color:#49454f;display:block;margin-bottom:12px;"/>
                <div sclass="z-button-group" style="align-items:center;margin-bottom:8px;">
                    <button label="Small"  sclass="z-button-text z-button-sm"/>
                    <button label="Medium" sclass="z-button-text"/>
                    <button label="Large"  sclass="z-button-text z-button-lg"/>
                </div>
                <div sclass="z-button-group" style="align-items:center;margin-bottom:8px;">
                    <button label="Small"  sclass="z-button-outlined z-button-sm"/>
                    <button label="Medium" sclass="z-button-outlined"/>
                    <button label="Large"  sclass="z-button-outlined z-button-lg"/>
                </div>
                <div sclass="z-button-group" style="align-items:center;margin-bottom:8px;">
                    <button label="Small"  sclass="z-button-sm"/>
                    <button label="Medium"/>
                    <button label="Large"  sclass="z-button-lg"/>
                </div>
                <div sclass="z-button-group" style="align-items:center;margin-bottom:8px;">
                    <button sclass="z-button-fab"              iconSclass="z-icon-plus" tooltiptext="FAB Large"/>
                    <button sclass="z-button-fab z-button-sm"  iconSclass="z-icon-plus" tooltiptext="FAB Medium"/>
                    <button sclass="z-button-fab z-button-xs"  iconSclass="z-icon-plus" tooltiptext="FAB Small"/>
                </div>
                <div sclass="z-button-group" style="align-items:center;">
                    <button sclass="z-button-icon z-button-lg"  iconSclass="z-icon-trash" tooltiptext="Icon Large"/>
                    <button sclass="z-button-icon"              iconSclass="z-icon-trash" tooltiptext="Icon Medium"/>
                    <button sclass="z-button-icon z-button-sm"  iconSclass="z-icon-trash" tooltiptext="Icon Small"/>
                </div>
            </div>

            <!-- Floating Action Buttons -->
            <div sclass="z-card">
                <label sclass="z-card__title" value="Floating Action Buttons"/>
                <label value="A floating action button (FAB) performs the primary, or most common, action on a screen." style="font-size:13px;color:#49454f;display:block;margin-bottom:12px;"/>
                <div sclass="z-button-group" style="align-items:center;">
                    <button sclass="z-button-fab"           iconSclass="z-icon-plus"   tooltiptext="Add"/>
                    <button sclass="z-button-fab"           iconSclass="z-icon-pencil" tooltiptext="Edit"/>
                    <button sclass="z-button-fab-extended"  iconSclass="z-icon-upload" label="Extended"/>
                    <button sclass="z-button-fab"           iconSclass="z-icon-trash"  disabled="true" tooltiptext="Disabled"/>
                </div>
            </div>
        </div>

    </div>
</div>
