<div sclass="m-main">

    <div sclass="m-page-header">
        <label sclass="m-page-title" value="ApexCharts"/>
    </div>

    <div sclass="m-kpi-row" style="display:grid;grid-template-columns:1fr 1fr;gap:24px;">

        <div sclass="z-card">
            <label sclass="z-card__title" value="Line Chart"/>
            <label value="Line charts are a typical pictorial representation that depicts trends and behaviors over time." style="font-size:13px;color:#49454f;display:block;margin-bottom:16px;"/>
            <image src="~./usecase2/img/charts/total-revenue.png" sclass="m-chart-img"/>
        </div>

        <div sclass="z-card">
            <label sclass="z-card__title" value="Area Chart"/>
            <label value="Area charts are used to represent quantitative variations." style="font-size:13px;color:#49454f;display:block;margin-bottom:16px;"/>
            <image src="~./usecase2/img/charts/weekly-sales.png" sclass="m-chart-img"/>
        </div>

        <div sclass="z-card">
            <label sclass="z-card__title" value="Bar Chart"/>
            <label value="A bar chart is the best tool for displaying comparisons between categories of data." style="font-size:13px;color:#49454f;display:block;margin-bottom:16px;"/>
            <image src="~./usecase2/img/charts/mobile-desktop.png" sclass="m-chart-img"/>
        </div>

        <div sclass="z-card">
            <label sclass="z-card__title" value="Mixed Chart"/>
            <label value="Mixed charts combine different chart types in a single visualization." style="font-size:13px;color:#49454f;display:block;margin-bottom:16px;"/>
            <image src="~./usecase2/img/charts/total-revenue.png" sclass="m-chart-img"/>
        </div>

    </div>

</div>
