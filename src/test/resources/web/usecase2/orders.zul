<div sclass="m-main">

    <div sclass="m-page-header">
        <label sclass="m-page-title" value="Orders"/>
        <hlayout sclass="m-page-actions">
            <button label="New Order" sclass="z-button-primary"/>
        </hlayout>
    </div>

    <div sclass="m-card">
        <label sclass="m-card__title" value="Orders"/>
        <listbox checkmark="true" multiple="true">
            <listhead>
                <listheader label="Order ID"       hflex="min"/>
                <listheader label="Product"/>
                <listheader label="Date"           width="120px"/>
                <listheader label="Total"          width="100px"/>
                <listheader label="Status"         width="120px"/>
                <listheader label="Payment Method" width="150px"/>
                <listheader label="Actions"        width="100px"/>
            </listhead>
            <listitem>
                <listcell label="#000253"/>
                <listcell label="Salt &amp; Pepper Grinder"/>
                <listcell label="2025-01-02"/>
                <listcell label="$32.00"/>
                <listcell><div sclass="m-badge m-badge--info">Shipped</div></listcell>
                <listcell label="Visa"/>
                <listcell><hlayout spacing="4px"><button iconSclass="z-icon-eye" sclass="z-button-icon"/><button iconSclass="z-icon-pencil" sclass="z-button-icon"/><button iconSclass="z-icon-trash-2" sclass="z-button-icon"/></hlayout></listcell>
            </listitem>
            <listitem>
                <listcell label="#000254"/>
                <listcell label="Backpack"/>
                <listcell label="2025-01-04"/>
                <listcell label="$130.00"/>
                <listcell><div sclass="m-badge m-badge--info">Shipped</div></listcell>
                <listcell label="PayPal"/>
                <listcell><hlayout spacing="4px"><button iconSclass="z-icon-eye" sclass="z-button-icon"/><button iconSclass="z-icon-pencil" sclass="z-button-icon"/><button iconSclass="z-icon-trash-2" sclass="z-button-icon"/></hlayout></listcell>
            </listitem>
            <listitem>
                <listcell label="#000255"/>
                <listcell label="Pocket Speaker"/>
                <listcell label="2025-01-04"/>
                <listcell label="$80.00"/>
                <listcell><div sclass="m-badge m-badge--error">Cancelled</div></listcell>
                <listcell label="Mastercard"/>
                <listcell><hlayout spacing="4px"><button iconSclass="z-icon-eye" sclass="z-button-icon"/><button iconSclass="z-icon-pencil" sclass="z-button-icon"/><button iconSclass="z-icon-trash-2" sclass="z-button-icon"/></hlayout></listcell>
            </listitem>
            <listitem>
                <listcell label="#000256"/>
                <listcell label="Glass Teapot"/>
                <listcell label="2025-01-08"/>
                <listcell label="$45.00"/>
                <listcell><div sclass="m-badge m-badge--info">Shipped</div></listcell>
