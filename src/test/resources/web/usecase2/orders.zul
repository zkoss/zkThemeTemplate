                <listcell><hlayout spacing="4px"><button iconSclass="z-icon-eye" sclass="z-button-icon"/><button iconSclass="z-icon-pencil" sclass="z-button-icon"/><button iconSclass="z-icon-trash-2" sclass="z-button-icon"/></hlayout></listcell>
            </listitem>
            <listitem>
                <listcell label="#000257"/>
                <listcell label="Unbreakable Water Bottle"/>
                <listcell label="2025-01-09"/>
                <listcell label="$40.00"/>
                <listcell><div sclass="m-badge m-badge--info">Shipped</div></listcell>
                <listcell label="PayPal"/>
                <listcell><hlayout spacing="4px"><button iconSclass="z-icon-eye" sclass="z-button-icon"/><button iconSclass="z-icon-pencil" sclass="z-button-icon"/><button iconSclass="z-icon-trash-2" sclass="z-button-icon"/></hlayout></listcell>
            </listitem>
            <listitem>
                <listcell label="#000258"/>
