                    <div style="font-size:13px;font-weight:500;margin-bottom:8px;">Update user onboarding flow</div>
                    <div style="display:flex;justify-content:space-between;align-items:center;">
                        <span style="font-size:11px;color:#757575;">James Dalton</span>
                        <span style="font-size:11px;color:#757575;">May 5, 2025</span>
                    </div>
                </div>
                <div sclass="m-card" style="padding:16px;">
                    <div style="font-size:13px;font-weight:500;margin-bottom:8px;">Write API documentation</div>
                    <div style="display:flex;justify-content:space-between;align-items:center;">
                        <span style="font-size:11px;color:#757575;">Sallie Love</span>
