                    </div>
                </div>
                <div sclass="m-card" style="padding:16px;">
                    <div style="font-size:13px;font-weight:500;margin-bottom:8px;">Migrate database to new schema</div>
                    <div style="display:flex;justify-content:space-between;align-items:center;">
                        <span style="font-size:11px;color:#757575;">James Dalton</span>
                        <div sclass="z-badge z-badge-error" style="font-size:10px;">Blocked</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- In Progress -->
        <div>
            <div style="display:flex;align-items:center;gap:8px;margin-bottom:12px;">
                <label style="font-size:15px;font-weight:600;color:#1a1a2e;" value="In Progress"/>
                <div sclass="z-chip z-chip-warning" style="background:#fff3e0;color:#e65100;">2</div>
            </div>
            <div style="display:flex;flex-direction:column;gap:12px;">
                <div sclass="m-card" style="padding:16px;">
                    <div style="font-size:13px;font-weight:500;margin-bottom:8px;">Design new dashboard wireframes</div>
                    <div style="display:flex;justify-content:space-between;align-items:center;">
                        <span style="font-size:11px;color:#757575;">Lucy Lavender</span>
                        <span style="font-size:11px;color:#757575;">Apr 30, 2025</span>
                    </div>
                </div>
                <div sclass="m-card" style="padding:16px;">
                    <div style="font-size:13px;font-weight:500;margin-bottom:8px;">Conduct usability testing sessions</div>
                    <div style="display:flex;justify-content:space-between;align-items:center;">
                        <span style="font-size:11px;color:#757575;">Raymond Ennis</span>
                        <span style="font-size:11px;color:#757575;">May 15, 2025</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Completed -->
        <div>
            <div style="display:flex;align-items:center;gap:8px;margin-bottom:12px;">
                <label style="font-size:15px;font-weight:600;color:#1a1a2e;" value="Completed"/>
                <div sclass="z-chip z-chip-success" style="background:#e8f5e9;color:#1b5e20;">2</div>
            </div>
            <div style="display:flex;flex-direction:column;gap:12px;">
                <div sclass="m-card" style="padding:16px;">
                    <div style="font-size:13px;font-weight:500;margin-bottom:8px;">Fix login page responsiveness</div>
                    <div style="display:flex;justify-content:space-between;align-items:center;">
                        <span style="font-size:11px;color:#757575;">Tracy Mack</span>
                        <span style="font-size:11px;color:#757575;">Apr 28, 2025</span>
                    </div>
                </div>
                <div sclass="m-card" style="padding:16px;">
                    <div style="font-size:13px;font-weight:500;margin-bottom:8px;">Deploy staging environment update</div>
                    <div style="display:flex;justify-content:space-between;align-items:center;">
