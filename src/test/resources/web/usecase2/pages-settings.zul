<div sclass="m-main">

    <div sclass="m-page-header">
        <label sclass="m-page-title" value="Settings"/>
        <div sclass="m-breadcrumb">
            <span style="color:var(--zk-color-primary,#376fd0);cursor:pointer;">Dashboard</span>
            <span style="margin:0 6px;color:#9e9e9e;">/</span>
            <span style="color:var(--zk-color-primary,#376fd0);cursor:pointer;">Pages</span>
            <span style="margin:0 6px;color:#9e9e9e;">/</span>
            <span>Settings</span>
        </div>
    </div>

    <!-- Public info -->
    <div sclass="z-card" style="margin-bottom:24px;">
        <label sclass="z-card__title" value="Public info"/>
        <div style="display:grid;grid-template-columns:1fr auto;gap:32px;align-items:start;">
            <div>
                <div style="margin-bottom:16px;">
                    <label value="Username" style="font-size:12px;color:#49454f;display:block;margin-bottom:6px;"/>
                    <textbox value="lucylavender" width="100%" style="max-width:480px;"/>
                </div>
                <div style="margin-bottom:24px;">
                    <label value="Biography" style="font-size:12px;color:#49454f;display:block;margin-bottom:6px;"/>
                    <textbox multiline="true" rows="4" width="100%" style="max-width:480px;"
                        value="Lucy is a Freelance Writer and Social Media Manager who helps finance professionals and Fin-tech startups build an audience and get more paying clients online."/>
                </div>
                <button label="Save changes" sclass="z-button-primary"/>
            </div>
            <div style="text-align:center;">
                <div style="width:96px;height:96px;border-radius:50%;overflow:hidden;margin:0 auto 12px;background:#5c7bd9;display:flex;align-items:center;justify-content:center;">
                    <label value="L" style="color:#fff;font-size:36px;font-weight:600;"/>
                </div>
                <button label="Upload" sclass="z-button-primary"/>
                <div style="font-size:11px;color:#9e9e9e;margin-top:6px;">For best results, use an image at least 128px by 128px in .jpg format</div>
            </div>
        </div>
    </div>

    <!-- Private info -->
    <div sclass="z-card">
        <label sclass="z-card__title" value="Private info"/>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-bottom:16px;">
            <div>
                <label value="First name" style="font-size:12px;color:#49454f;display:block;margin-bottom:6px;"/>
                <textbox value="Lucy" width="100%"/>
            </div>
            <div>
                <label value="Last name" style="font-size:12px;color:#49454f;display:block;margin-bottom:6px;"/>
                <textbox value="Lavender" width="100%"/>
            </div>
        </div>
        <div style="margin-bottom:16px;">
            <label value="Email" style="font-size:12px;color:#49454f;display:block;margin-bottom:6px;"/>
            <textbox value="lucylavender@gmail.com" width="100%"/>
        </div>
        <div style="margin-bottom:16px;">
            <label value="Address" style="font-size:12px;color:#49454f;display:block;margin-bottom:6px;"/>
            <textbox value="Street, City, State, Zip" width="100%"/>
        </div>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-bottom:24px;">
            <div>
                <label value="Phone" style="font-size:12px;color:#49454f;display:block;margin-bottom:6px;"/>
                <textbox value="+1 234 567 8901" width="100%"/>
            </div>
            <div>
                <label value="Country" style="font-size:12px;color:#49454f;display:block;margin-bottom:6px;"/>
                <combobox width="100%">
                    <comboitem label="United States"/>
                    <comboitem label="United Kingdom"/>
                    <comboitem label="Canada"/>
                    <comboitem label="Australia"/>
                </combobox>
            </div>
        </div>
        <button label="Save changes" sclass="z-button-primary"/>
    </div>

</div>
