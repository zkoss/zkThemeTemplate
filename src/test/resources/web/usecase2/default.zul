<div sclass="m-main">

    <!-- Page header -->
    <div sclass="m-page-header">
        <div>
            <label sclass="m-page-title"    value="Default Dashboard"/>
            <label sclass="m-page-subtitle" value="Welcome back, Lucy! We've missed you."/>
        </div>
        <hlayout sclass="m-page-actions">
            <button iconSclass="z-icon-refresh-cw" sclass="z-button-outlined"/>
            <button label="Today: April 29"     sclass="z-button-primary"/>
        </hlayout>
    </div>
    <separator bar="true"/>
    <!-- KPI cards -->
    <div sclass="m-kpi-row">

        <div sclass="m-card m-kpi-card">
            <div sclass="m-kpi-card__header">
                <label sclass="m-kpi-card__label" value="Sales Today"/>
                <label sclass="m-chip m-chip--primary" value="Today"/>
            </div>
            <label sclass="m-kpi-card__value" value="2,532"/>
            <div sclass="m-kpi-card__footer">
                <span sclass="m-kpi-trend--up">+26%</span>
                <span sclass="m-kpi-since">Since last month</span>
            </div>
        </div>

        <div sclass="m-card m-kpi-card">
            <div sclass="m-kpi-card__header">
                <label sclass="m-kpi-card__label" value="Visitors"/>
                <label sclass="m-chip m-chip--primary" value="Annual"/>
            </div>
            <label sclass="m-kpi-card__value" value="170,212"/>
            <div sclass="m-kpi-card__footer">
                <span sclass="m-kpi-trend--down">-14%</span>
                <span sclass="m-kpi-since">Since last month</span>
            </div>
        </div>

        <div sclass="m-card m-kpi-card">
            <div sclass="m-kpi-card__header">
                <label sclass="m-kpi-card__label" value="Total Earnings"/>
                <label sclass="m-chip m-chip--primary" value="Monthly"/>
            </div>
            <label sclass="m-kpi-card__value" value="$ 24,300"/>
            <div sclass="m-kpi-card__footer">
                <span sclass="m-kpi-trend--up">+18%</span>
                <span sclass="m-kpi-since">Since last month</span>
            </div>
        </div>

        <div sclass="m-card m-kpi-card m-kpi-card--primary">
            <div sclass="m-kpi-card__header">
                <label sclass="m-kpi-card__label" value="Pending Orders"/>
            </div>
            <label sclass="m-kpi-card__value" value="45"/>
            <div sclass="m-kpi-card__footer">
                <span sclass="m-kpi-trend--down">-9%</span>
                <span sclass="m-kpi-since">Since last month</span>
            </div>
        </div>

    </div>

    <!-- Charts row: Total Revenue + Weekly Sales -->
    <div sclass="m-charts-row">

        <div sclass="m-card m-chart-card-main">
            <label sclass="m-card__title" value="Total revenue"/>
            <image src="~./usecase2/img/charts/total-revenue.png" sclass="m-chart-img"/>
        </div>

        <div sclass="m-card m-chart-card-side">
            <label sclass="m-card__title" value="Weekly sales"/>
            <image src="~./usecase2/img/charts/weekly-sales.png" sclass="m-chart-img"/>

            <grid sclass="m-revenue-table" mold="default">
                <columns>
                    <column label="Source"/>
                    <column label="Revenue"/>
                    <column label="Value"/>
                </columns>
                <rows>
                    <row>
                        <label value="Social"/>
                        <label value="260"/>
                        <label sclass="m-positive" value="+35%"/>
                    </row>
                    <row>
                        <label value="Search Engines"/>
                        <label value="125"/>
                        <label sclass="m-negative" value="-12%"/>
                    </row>
                    <row>
                        <label value="Direct"/>
                        <label value="54"/>
                        <label sclass="m-positive" value="+46%"/>
                    </row>
                    <row>
                        <label value="Other"/>
                        <label value="146"/>
                        <label sclass="m-positive" value="+24%"/>
                    </row>
                </rows>
            </grid>
        </div>

    </div>

    <!-- Bottom row: Mobile/Desktop + Latest Projects -->
    <div sclass="m-bottom-row">

        <div sclass="m-bottom-card-chart m-card">
            <label sclass="m-card__title" value="Mobile / Desktop"/>
            <image src="~./usecase2/img/charts/mobile-desktop.png" sclass="m-chart-img"/>
        </div>

        <div sclass="m-card m-bottom-card-projects">
            <label sclass="m-card__title" value="Latest projects"/>
            <grid sclass="m-projects-grid" mold="default">
                <columns>
                    <column label="Name"/>
                    <column label="Start Date"/>
                    <column label="End Date"/>
                    <column label="State"/>
                    <column label="Assignee"/>
                </columns>
                <rows>
                    <row>
                        <label value="Project Aurora"/>
                        <label value="01/01/2025"/>
                        <label value="31/06/2025"/>
                        <div sclass="m-badge m-badge--success">Done</div>
                        <label value="James Dalton"/>
                    </row>
                    <row>
                        <label value="Project Eagle"/>
                        <label value="01/01/2025"/>
                        <label value="31/06/2025"/>
                        <div sclass="m-badge m-badge--warning">In Progress</div>
                        <label value="Tracy Mack"/>
                    </row>
                    <row>
                        <label value="Project Fireball"/>
                        <label value="01/01/2025"/>
                        <label value="31/06/2025"/>
                        <div sclass="m-badge m-badge--success">Done</div>
                        <label value="Sallie Love"/>
                    </row>
                    <row>
                        <label value="Project Omega"/>
                        <label value="01/01/2025"/>
                        <label value="31/06/2025"/>
                        <div sclass="m-badge m-badge--error">Cancelled</div>
                        <label value="Glenda Jang"/>
                    </row>
                    <row>
                        <label value="Project Yoda"/>
                        <label value="01/01/2025"/>
                        <label value="31/06/2025"/>
                        <div sclass="m-badge m-badge--success">Done</div>
                        <label value="Raymond Ennis"/>
                    </row>
                    <row>
                        <label value="Project Zulu"/>
                        <label value="01/01/2025"/>
                        <label value="31/06/2025"/>
                        <div sclass="m-badge m-badge--success">Done</div>
                        <label value="Matthew Winters"/>
                    </row>
                </rows>
            </grid>
        </div>

    </div>

</div>
