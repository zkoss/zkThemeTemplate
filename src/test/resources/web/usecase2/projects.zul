<div sclass="m-main">

    <div sclass="m-page-header">
        <div>
            <label sclass="m-page-title" value="Projects"/>
            <div sclass="m-breadcrumb">
                <a sclass="m-breadcrumb__link" href="#default">Dashboard</a>
                <label sclass="m-breadcrumb__sep" value="/"/>
                <a sclass="m-breadcrumb__link" href="#pages">Pages</a>
                <label sclass="m-breadcrumb__sep" value="/"/>
                <label sclass="m-breadcrumb__current" value="Projects"/>
            </div>
        </div>
    </div>
    <separator bar="true"/>

    <!-- Row 1: Text cards with avatars, 4 columns -->
    <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:24px;margin-bottom:24px;">

        <div sclass="z-card z-card--project">
            <label sclass="z-card__title" value="Landing page redesign"/>
            <label sclass="z-badge z-badge-success" value="Finished"/>
            <label sclass="z-card__desc" value="Etiam rhoncus. Maecenas tempus, tellus eget condimentum rhoncus, sem quam semper libero, sit amet adipiscing sem neque sed ipsum."/>
            <div class="z-avatar-group">
                <image src="https://mira.bootlab.io/static/img/avatars/avatar-1.jpg" class="z-avatar z-avatar-sm"/>
                <image src="https://mira.bootlab.io/static/img/avatars/avatar-3.jpg" class="z-avatar z-avatar-sm"/>
                <image src="https://mira.bootlab.io/static/img/avatars/avatar-2.jpg" class="z-avatar z-avatar-sm"/>
            </div>
            <div sclass="z-card__actions">
                <a sclass="m-link" >Share</a>
                <a sclass="m-link" >Learn More</a>
            </div>
        </div>

        <div sclass="z-card z-card--project">
            <label sclass="z-card__title" value="Company posters"/>
            <label sclass="z-badge z-badge-warning" value="In progress"/>
            <label sclass="z-card__desc" value="Curabitur ligula sapien, tincidunt non, euismod vitae, posuere imperdiet, leo. Maecenas malesuada. Praesent congue erat at massa."/>
            <div class="z-avatar-group">
                <image src="https://mira.bootlab.io/static/img/avatars/avatar-1.jpg" class="z-avatar z-avatar-sm"/>
                <image src="https://mira.bootlab.io/static/img/avatars/avatar-3.jpg" class="z-avatar z-avatar-sm"/>
                <image src="https://mira.bootlab.io/static/img/avatars/avatar-2.jpg" class="z-avatar z-avatar-sm"/>
            </div>
            <div sclass="z-card__actions">
                <a sclass="m-link" >Share</a>
                <a sclass="m-link" >Learn More</a>
            </div>
        </div>

        <div sclass="z-card z-card--project">
            <label sclass="z-card__title" value="Product page design"/>
            <label sclass="z-badge z-badge-success" value="Finished"/>
            <label sclass="z-card__desc" value="Etiam rhoncus. Maecenas tempus, tellus eget condimentum rhoncus, sem quam semper libero, sit amet adipiscing sem neque sed ipsum."/>
            <div class="z-avatar-group">
                <image src="https://mira.bootlab.io/static/img/avatars/avatar-1.jpg" class="z-avatar z-avatar-sm"/>
                <image src="https://mira.bootlab.io/static/img/avatars/avatar-3.jpg" class="z-avatar z-avatar-sm"/>
                <image src="https://mira.bootlab.io/static/img/avatars/avatar-2.jpg" class="z-avatar z-avatar-sm"/>
            </div>
            <div sclass="z-card__actions">
                <a sclass="m-link" >Share</a>
                <a sclass="m-link" >Learn More</a>
            </div>
        </div>

        <div sclass="z-card z-card--project">
            <label sclass="z-card__title" value="Upgrade CRM software"/>
            <label sclass="z-badge z-badge-warning" value="In progress"/>
            <label sclass="z-card__desc" value="Nam pretium turpis et arcu. Duis arcu tortor, suscipit eget, imperdiet nec, imperdiet iaculis, ipsum. Sed aliquam ultrices mauris."/>
