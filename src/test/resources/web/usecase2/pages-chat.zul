<div sclass="m-main">

    <div sclass="m-page-header">
        <label sclass="m-page-title" value="Chat"/>
        <div sclass="m-breadcrumb">
            <span style="color:var(--md-sys-color-primary,#376fd0);cursor:pointer;">Dashboard</span>
            <span style="margin:0 6px;color:#9e9e9e;">/</span>
            <span style="color:var(--md-sys-color-primary,#376fd0);cursor:pointer;">Pages</span>
            <span style="margin:0 6px;color:#9e9e9e;">/</span>
            <span>Chat</span>
        </div>
    </div>

    <div sclass="m-card" style="padding:0;overflow:hidden;">
        <div style="display:grid;grid-template-columns:260px 1fr;height:600px;">

            <!-- Contacts panel -->
            <div style="border-right:1px solid #e0e0e0;display:flex;flex-direction:column;">
                <div style="padding:16px;">
                    <textbox placeholder="Search contacts" width="100%"/>
                </div>
                <div style="flex:1;overflow-y:auto;">

                    <!-- Contact: Lucy Lavender (active) -->
                    <div style="display:flex;align-items:center;gap:12px;padding:12px 16px;background:var(--md-sys-color-primary,#376fd0);cursor:pointer;">
                        <div style="position:relative;">
                            <div sclass="z-avatar z-avatar-sm" style="background:#5c7bd9;">
                                <label value="L" style="color:#fff;font-size:11px;font-weight:600;"/>
                            </div>
                            <div style="position:absolute;bottom:0;right:0;width:8px;height:8px;background:#4caf50;border-radius:50%;border:1px solid #fff;"/>
                        </div>
                        <div style="flex:1;min-width:0;">
                            <div style="font-size:13px;font-weight:600;color:#fff;">Lucy Lavender</div>
                            <div style="font-size:12px;color:rgba(255,255,255,0.7);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">Sent a photo</div>
                        </div>
                    </div>

                    <!-- Contact: Remy Sharp -->
                    <div style="display:flex;align-items:center;gap:12px;padding:12px 16px;cursor:pointer;border-bottom:1px solid #f0f0f0;">
                        <div style="position:relative;">
                            <div sclass="z-avatar z-avatar-sm" style="background:#795548;">
                                <label value="R" style="color:#fff;font-size:11px;font-weight:600;"/>
                            </div>
                            <div style="position:absolute;bottom:0;right:0;width:8px;height:8px;background:#4caf50;border-radius:50%;border:1px solid #fff;"/>
                        </div>
                        <div style="flex:1;">
                            <div style="font-size:13px;font-weight:600;">Remy Sharp</div>
                            <div style="font-size:12px;color:#9e9e9e;">Coffee?</div>
                        </div>
                    </div>

                    <!-- Contact: Cassandra Mixon -->
                    <div style="display:flex;align-items:center;gap:12px;padding:12px 16px;cursor:pointer;border-bottom:1px solid #f0f0f0;">
                        <div style="position:relative;">
                            <div sclass="z-avatar z-avatar-sm" style="background:#e91e63;">
                                <label value="C" style="color:#fff;font-size:11px;font-weight:600;"/>
                            </div>
                        </div>
                        <div style="flex:1;">
                            <div style="font-size:13px;font-weight:600;">Cassandra Mixon</div>
                            <div style="font-size:12px;color:#9e9e9e;">Hello! 👋</div>
                        </div>
                    </div>

                    <!-- Contact: James Dalton -->
                    <div style="display:flex;align-items:center;gap:12px;padding:12px 16px;cursor:pointer;border-bottom:1px solid #f0f0f0;">
                        <div style="position:relative;">
                            <div sclass="z-avatar z-avatar-sm" style="background:#4caf50;">
                                <label value="J" style="color:#fff;font-size:11px;font-weight:600;"/>
                            </div>
                            <div style="position:absolute;bottom:0;right:0;width:8px;height:8px;background:#4caf50;border-radius:50%;border:1px solid #fff;"/>
                        </div>
                        <div style="flex:1;">
                            <div style="font-size:13px;font-weight:600;">James Dalton</div>
                            <div style="font-size:12px;color:#9e9e9e;">The build passed!</div>
                        </div>
                    </div>

                    <!-- Contact: Tracy Mack -->
                    <div style="display:flex;align-items:center;gap:12px;padding:12px 16px;cursor:pointer;">
                        <div sclass="z-avatar z-avatar-sm" style="background:#ff9800;">
                            <label value="T" style="color:#fff;font-size:11px;font-weight:600;"/>
                        </div>
                        <div style="flex:1;">
                            <div style="font-size:13px;font-weight:600;">Tracy Mack</div>
                            <div style="font-size:12px;color:#9e9e9e;">Hey, are you available?</div>
                        </div>
                    </div>

                </div>
            </div>

            <!-- Message thread -->
            <div style="display:flex;flex-direction:column;">
                <div style="flex:1;overflow-y:auto;padding:24px;display:flex;flex-direction:column;gap:16px;">

                    <!-- Incoming message -->
                    <div style="display:flex;align-items:flex-start;gap:12px;">
                        <div sclass="z-avatar z-avatar-sm" style="background:#795548;flex-shrink:0;">
                            <label value="R" style="color:#fff;font-size:11px;font-weight:600;"/>
                        </div>
                        <div>
                            <div style="background:#f7f9fc;border-radius:0 8px 8px 8px;padding:12px 16px;max-width:480px;font-size:13px;">
                                Sit meis deleniti eu, pri vidit meliore docendi ut, an eum erat animal commodo.
                            </div>
                            <div style="font-size:11px;color:#9e9e9e;margin-top:4px;">20 minutes ago</div>
                        </div>
                    </div>

                    <!-- Outgoing message -->
                    <div style="display:flex;align-items:flex-start;gap:12px;flex-direction:row-reverse;">
                        <div sclass="z-avatar z-avatar-sm" style="background:#5c7bd9;flex-shrink:0;">
                            <label value="L" style="color:#fff;font-size:11px;font-weight:600;"/>
                        </div>
                        <div style="text-align:right;">
                            <div style="background:var(--md-sys-color-primary,#376fd0);color:#fff;border-radius:8px 0 8px 8px;padding:12px 16px;max-width:480px;font-size:13px;text-align:left;">
                                Lorem ipsum dolor sit amet, vis erat denique in, dicunt prodesset te vix.
                            </div>
                            <div style="font-size:11px;color:#9e9e9e;margin-top:4px;">12 minutes ago</div>
                        </div>
                    </div>

                    <!-- Incoming message -->
                    <div style="display:flex;align-items:flex-start;gap:12px;">
                        <div sclass="z-avatar z-avatar-sm" style="background:#795548;flex-shrink:0;">
                            <label value="R" style="color:#fff;font-size:11px;font-weight:600;"/>
                        </div>
                        <div>
                            <div style="background:#f7f9fc;border-radius:0 8px 8px 8px;padding:12px 16px;max-width:480px;font-size:13px;">
                                Cum ea graeci tractatos. 😊
                            </div>
                            <div style="font-size:11px;color:#9e9e9e;margin-top:4px;">8 minutes ago</div>
                        </div>
                    </div>

                    <!-- Outgoing message -->
                    <div style="display:flex;align-items:flex-start;gap:12px;flex-direction:row-reverse;">
                        <div sclass="z-avatar z-avatar-sm" style="background:#5c7bd9;flex-shrink:0;">
                            <label value="L" style="color:#fff;font-size:11px;font-weight:600;"/>
                        </div>
                        <div style="text-align:right;">
                            <div style="background:var(--md-sys-color-primary,#376fd0);color:#fff;border-radius:8px 0 8px 8px;padding:12px 16px;max-width:480px;font-size:13px;text-align:left;">
                                Cras pulvinar, sapien id vehicula aliquet, diam velit elementum orci. 👍
                            </div>
                            <div style="font-size:11px;color:#9e9e9e;margin-top:4px;">just now</div>
                        </div>
                    </div>

                </div>

                <!-- Message input -->
                <div style="border-top:1px solid #e0e0e0;padding:16px;display:flex;gap:12px;align-items:center;">
                    <textbox placeholder="Type your message" style="flex:1;" width="100%"/>
                    <button label="Send" sclass="z-button-primary"/>
                </div>
            </div>

        </div>
    </div>

</div>
