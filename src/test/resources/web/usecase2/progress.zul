<div sclass="m-main">
    <div sclass="m-page-header">
        <label sclass="m-page-title" value="Progress"/>
    </div>

    <div style="display:grid;grid-template-columns:1fr 1fr;gap:24px;align-items:start;">

        <!-- Left column: Circular -->
        <div>
            <!-- 1. Circular Indeterminate -->
            <div sclass="m-card" style="margin-bottom:24px;">
                <label sclass="m-card__title" value="Circular Indeterminate"/>
                <div style="display:flex;gap:16px;align-items:center;padding-top:12px;">
                    <progressmeter indeterminate="true" sclass="z-progressmeter-circular"/>
                    <progressmeter indeterminate="true" sclass="z-progressmeter-circular z-progressmeter-secondary"/>
                </div>
            </div>

            <!-- 2. Circular Determinate — FRAMEWORK GAP -->
            <div sclass="m-card" style="margin-bottom:24px;">
                <label sclass="m-card__title" value="Circular Determinate"/>
                <label value="⚠ Framework gap — requires SVG stroke-dasharray; ZK progressmeter renders no SVG." style="font-size:12px;color:#999;display:block;padding-top:12px;"/>
            </div>

            <!-- 3. Circular Static — FRAMEWORK GAP -->
            <div sclass="m-card">
                <label sclass="m-card__title" value="Circular Static"/>
                <label value="⚠ Framework gap — requires SVG stroke-dasharray; ZK progressmeter renders no SVG." style="font-size:12px;color:#999;display:block;padding-top:12px;"/>
            </div>
        </div>

        <!-- Right column: Linear -->
        <div>
            <!-- 4. Linear Indeterminate -->
            <div sclass="m-card" style="margin-bottom:24px;">
                <label sclass="m-card__title" value="Linear Indeterminate"/>
                <div style="padding-top:12px;">
                    <progressmeter indeterminate="true" sclass="z-progressmeter-linear" style="margin-bottom:10px;display:block;"/>
                    <progressmeter indeterminate="true" sclass="z-progressmeter-linear z-progressmeter-secondary" style="display:block;"/>
                </div>
            </div>

            <!-- 5. Linear Determinate -->
            <div sclass="m-card" style="margin-bottom:24px;">
                <label sclass="m-card__title" value="Linear Determinate"/>
                <div style="padding-top:12px;">
                    <progressmeter value="8" sclass="z-progressmeter-linear" style="margin-bottom:10px;display:block;"/>
                    <progressmeter value="8" sclass="z-progressmeter-linear z-progressmeter-secondary" style="display:block;"/>
                </div>
            </div>

            <!-- 6. Linear Buffer — FRAMEWORK GAP -->
            <div sclass="m-card" style="margin-bottom:24px;">
                <label sclass="m-card__title" value="Linear Buffer"/>
                <label value="⚠ Framework gap — requires dashed overlay + dual-bar DOM; ZK progressmeter has one inner span." style="font-size:12px;color:#999;display:block;padding-top:12px;"/>
            </div>

            <!-- 7. Linear Query -->
            <div sclass="m-card">
                <label sclass="m-card__title" value="Linear Query"/>
                <div style="padding-top:12px;">
                    <progressmeter indeterminate="true" sclass="z-progressmeter-linear z-progressmeter-query" style="margin-bottom:10px;display:block;"/>
                    <progressmeter indeterminate="true" sclass="z-progressmeter-linear z-progressmeter-query z-progressmeter-secondary" style="display:block;"/>
                </div>
            </div>
        </div>

    </div>
</div>