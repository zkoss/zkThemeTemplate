<div sclass="m-main">
            <div sclass="m-page-header">
                <label sclass="m-page-title" value="Pagination"/>
            </div>

            <!-- Basic Pagination: 4 rows — no-active / active / mid-active / disabled -->
            <div sclass="z-card" style="margin-bottom:16px;">
                <label sclass="z-card__title" value="Basic Pagination"/>
                <paging totalSize="100" pageSize="10" mold="os" sclass="z-paging-os"/>
                <paging totalSize="100" pageSize="10" mold="os" activePage="0" sclass="z-paging-os"/>
                <paging totalSize="100" pageSize="10" mold="os" activePage="4" sclass="z-paging-os"/>
                <paging totalSize="100" pageSize="10" mold="os" disabled="true" sclass="z-paging-os"/>
            </div>

            <!-- Outlined Pagination -->
            <div sclass="z-card" style="margin-bottom:16px;">
                <label sclass="z-card__title" value="Outlined Pagination"/>
                <paging totalSize="100" pageSize="10" mold="os" sclass="z-paging-os z-paging-outlined"/>
                <paging totalSize="100" pageSize="10" mold="os" activePage="0" sclass="z-paging-os z-paging-outlined"/>
                <paging totalSize="100" pageSize="10" mold="os" activePage="4" sclass="z-paging-os z-paging-outlined"/>
                <paging totalSize="100" pageSize="10" mold="os" disabled="true" sclass="z-paging-os z-paging-outlined"/>
            </div>

            <!-- Rounded Pagination (rectangular buttons) -->
            <div sclass="z-card" style="margin-bottom:16px;">
                <label sclass="z-card__title" value="Rounded Pagination"/>
                <paging totalSize="100" pageSize="10" mold="os" sclass="z-paging-os z-paging-rounded"/>
                <paging totalSize="100" pageSize="10" mold="os" activePage="0" sclass="z-paging-os z-paging-rounded"/>
                <paging totalSize="100" pageSize="10" mold="os" activePage="4" sclass="z-paging-os z-paging-rounded"/>
                <paging totalSize="100" pageSize="10" mold="os" disabled="true" sclass="z-paging-os z-paging-rounded"/>
            </div>
        </div>
