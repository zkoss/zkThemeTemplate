<div sclass="m-main">

    <div sclass="m-page-header">
        <label sclass="m-page-title" value="Invoices"/>
        <hlayout sclass="m-page-actions">
            <button label="New Invoice" sclass="m-btn--primary"/>
        </hlayout>
    </div>

    <div sclass="m-card">
        <label sclass="m-card__title" value="Invoices"/>
        <listbox checkmark="true" multiple="true">
            <listhead>
                <listheader label="Customer"   width="220px"/>
                <listheader label="Status"     width="100px"/>
                <listheader label="ID"         width="100px"/>
                <listheader label="Amount"     width="110px"/>
                <listheader label="Issue Date" width="130px"/>
            </listhead>
            <listitem>
                <listcell label="Anna Walley (anna@walley.com)"/>
                <listcell><div sclass="m-badge m-badge--info">Sent</div></listcell>
                <listcell label="#000112"/>
                <listcell label="$530.00"/>
                <listcell label="2025-01-02"/>
            </listitem>
            <listitem>
                <listcell label="Doris Fritz (doris@fritz.com)"/>
                <listcell><div sclass="m-badge m-badge--error">Void</div></listcell>
                <listcell label="#000114"/>
                <listcell label="$209.00"/>
                <listcell label="2025-02-13"/>
            </listitem>
            <listitem>
                <listcell label="Edward Adkins (edward@adkins.com)"/>
                <listcell><div sclass="m-badge m-badge--success">Paid</div></listcell>
                <listcell label="#000117"/>
                <listcell label="$535.00"/>
                <listcell label="2025-03-04"/>
            </listitem>
            <listitem>
                <listcell label="Edwin Baker (edwin@baker.com)"/>
                <listcell><div sclass="m-badge m-badge--success">Paid</div></listcell>
                <listcell label="#000115"/>
                <listcell label="$678.00"/>
                <listcell label="2025-02-17"/>
            </listitem>
            <listitem>
                <listcell label="Gordon Workman (gordan@workman.com)"/>
                <listcell><div sclass="m-badge m-badge--info">Sent</div></listcell>
                <listcell label="#000119"/>
                <listcell label="$314.00"/>
                <listcell label="2025-03-28"/>
            </listitem>
            <listitem>
                <listcell label="Helen Morris (helen@morris.com)"/>
                <listcell><div sclass="m-badge m-badge--warning">Pending</div></listcell>
                <listcell label="#000121"/>
                <listcell label="$892.00"/>
                <listcell label="2025-04-01"/>
            </listitem>
            <listitem>
                <listcell label="John Davis (john@davis.com)"/>
                <listcell><div sclass="m-badge m-badge--success">Paid</div></listcell>
                <listcell label="#000123"/>
                <listcell label="$1,245.00"/>
                <listcell label="2025-04-10"/>
            </listitem>
            <listitem>
                <listcell label="Karen White (karen@white.com)"/>
                <listcell><div sclass="m-badge m-badge--info">Sent</div></listcell>
                <listcell label="#000125"/>
                <listcell label="$467.00"/>
                <listcell label="2025-04-15"/>
            </listitem>
        </listbox>
    </div>

</div>
