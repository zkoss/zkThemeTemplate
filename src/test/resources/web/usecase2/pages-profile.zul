<div sclass="m-main">

    <div sclass="m-page-header">
        <label sclass="m-page-title" value="Profile"/>
        <div sclass="m-breadcrumb">
            <span style="color:var(--md-sys-color-primary,#376fd0);cursor:pointer;">Dashboard</span>
            <span style="margin:0 6px;color:#9e9e9e;">/</span>
            <span style="color:var(--md-sys-color-primary,#376fd0);cursor:pointer;">Pages</span>
            <span style="margin:0 6px;color:#9e9e9e;">/</span>
            <span>Profile</span>
        </div>
    </div>

    <div style="display:grid;grid-template-columns:1fr 2fr;gap:24px;margin-bottom:24px;">

        <!-- Profile Details -->
        <div sclass="m-card">
            <label sclass="m-card__title" value="Profile Details"/>
            <div style="text-align:center;padding:16px 0;">
                <div style="width:96px;height:96px;border-radius:50%;overflow:hidden;margin:0 auto 12px;">
                    <div sclass="m-avatar" style="width:96px;height:96px;background:#5c7bd9;font-size:36px;">
                        <label value="L" style="color:#fff;font-weight:600;"/>
                    </div>
                </div>
                <div style="font-size:16px;font-weight:600;margin-bottom:4px;">Lucy Lavender</div>
                <div style="font-size:13px;color:#49454f;margin-bottom:16px;">Lead Developer</div>
                <div style="display:flex;gap:8px;justify-content:center;">
                    <button label="Follow" sclass="m-btn--outlined"/>
                    <button label="Message" sclass="m-btn--primary"/>
                </div>
            </div>

            <separator/>

            <div style="padding:12px 0;">
                <label sclass="m-card__title" value="Skills"/>
                <div style="display:flex;flex-wrap:wrap;gap:6px;margin-top:8px;">
                    <div sclass="m-chip">HTML</div>
                    <div sclass="m-chip">JavaScript</div>
                    <div sclass="m-chip">Sass</div>
                    <div sclass="m-chip">React</div>
                    <div sclass="m-chip">Redux</div>
                    <div sclass="m-chip">Next.js</div>
                    <div sclass="m-chip">Material UI</div>
                    <div sclass="m-chip">UI</div>
                    <div sclass="m-chip">UX</div>
                </div>
            </div>

            <separator/>

            <div style="padding:12px 0;">
                <label sclass="m-card__title" value="About"/>
                <div style="display:flex;align-items:center;gap:8px;padding:8px 0;font-size:13px;color:#49454f;">
                    <span sclass="z-icon-map-pin" style="width:16px;color:#9e9e9e;"/>
                    <span>San Francisco, SA</span>
                </div>
                <div style="display:flex;align-items:center;gap:8px;padding:8px 0;font-size:13px;color:#49454f;">
                    <span sclass="z-icon-briefcase" style="width:16px;color:#9e9e9e;"/>
                    <span>Self-employed</span>
                </div>
                <div style="display:flex;align-items:center;gap:8px;padding:8px 0;font-size:13px;color:#49454f;">
                    <span sclass="z-icon-home" style="width:16px;color:#9e9e9e;"/>
                    <span>lucylavender.io</span>
                </div>
                <div style="display:flex;align-items:center;gap:8px;padding:8px 0;font-size:13px;color:#49454f;">
                    <span sclass="z-icon-x" style="width:16px;color:#9e9e9e;"/>
                    <span>@lucylavender</span>
                </div>
            </div>
        </div>

        <!-- Right column -->
        <div style="display:flex;flex-direction:column;gap:24px;">
            <!-- Sales / Revenue chart placeholder -->
            <div sclass="m-card">
                <label sclass="m-card__title" value="Sales / Revenue"/>
                <div style="height:240px;background:#f7f9fc;border-radius:8px;display:flex;align-items:center;justify-content:center;">
                    <div style="text-align:center;color:#9e9e9e;">
                        <span sclass="z-icon-bar-chart" style="font-size:48px;display:block;margin-bottom:8px;"/>
                        <div style="font-size:13px;">Sales/Revenue Chart</div>
                    </div>
                </div>
            </div>

            <!-- Stats row -->
            <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:24px;">
                <div sclass="m-card" style="text-align:center;">
                    <div style="font-size:28px;font-weight:700;color:var(--md-sys-color-primary,#376fd0);">$2,405</div>
                    <div style="font-size:13px;color:#49454f;margin-top:4px;">Total Earnings</div>
                    <div style="height:4px;border-radius:2px;background:var(--md-sys-color-primary,#376fd0);margin-top:12px;"/>
                </div>
                <div sclass="m-card" style="text-align:center;">
                    <div style="font-size:28px;font-weight:700;color:var(--md-sys-color-primary,#376fd0);">30</div>
                    <div style="font-size:13px;color:#49454f;margin-top:4px;">Orders Today</div>
                    <div style="height:4px;border-radius:2px;background:#376fd0;margin-top:12px;"/>
                </div>
                <div sclass="m-card" style="text-align:center;">
                    <div style="font-size:28px;font-weight:700;color:var(--md-sys-color-primary,#376fd0);">$1,224</div>
                    <div style="font-size:13px;color:#49454f;margin-top:4px;">Total Revenue</div>
                    <div style="height:4px;border-radius:2px;background:#376fd0;margin-top:12px;"/>
                </div>
            </div>
        </div>

    </div>

</div>
