<div sclass="m-main">

    <div sclass="m-page-header">
        <label sclass="m-page-title" value="Pricing"/>
        <div sclass="m-breadcrumb">
            <span style="color:var(--md-sys-color-primary,#376fd0);cursor:pointer;">Dashboard</span>
            <span style="margin:0 6px;color:#9e9e9e;">/</span>
            <span style="color:var(--md-sys-color-primary,#376fd0);cursor:pointer;">Pages</span>
            <span style="margin:0 6px;color:#9e9e9e;">/</span>
            <span>Pricing</span>
        </div>
    </div>

    <div sclass="m-card" style="margin-bottom:24px;">
        <div style="text-align:center;padding:24px 0 32px;">
            <div style="font-size:24px;font-weight:700;margin-bottom:8px;">We have a plan for everyone</div>
            <div style="font-size:14px;color:#49454f;">Whether you're a business or an individual, 14-day trial no credit card required.</div>
        </div>

        <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:24px;max-width:900px;margin:0 auto;">

            <!-- Free -->
            <div style="border:1px solid #e0e0e0;border-radius:8px;padding:32px 24px;text-align:center;">
                <div style="font-size:18px;font-weight:600;margin-bottom:8px;">Free</div>
                <div style="font-size:36px;font-weight:700;margin-bottom:4px;">$0<span style="font-size:16px;font-weight:400;color:#49454f;">/mo</span></div>
                <separator/>
                <div style="font-size:13px;color:#49454f;padding:8px 0;border-bottom:1px solid #f0f0f0;">10 users included</div>
                <div style="font-size:13px;color:#49454f;padding:8px 0;border-bottom:1px solid #f0f0f0;">2 GB of storage</div>
                <div style="font-size:13px;color:#49454f;padding:8px 0;border-bottom:1px solid #f0f0f0;">Help center access</div>
                <div style="font-size:13px;color:#49454f;padding:8px 0;margin-bottom:24px;">Email support</div>
                <button label="Sign up for free" sclass="z-button-outlined" style="width:100%;"/>
            </div>

            <!-- Pro (Most popular) -->
            <div style="border:2px solid var(--md-sys-color-primary,#376fd0);border-radius:8px;padding:32px 24px;text-align:center;position:relative;">
                <div style="position:absolute;top:-12px;left:50%;transform:translateX(-50%);background:var(--md-sys-color-primary,#376fd0);color:#fff;font-size:11px;font-weight:600;padding:2px 10px;border-radius:12px;">Most popular</div>
                <div style="font-size:18px;font-weight:600;margin-bottom:8px;">Free</div>
                <div style="font-size:36px;font-weight:700;margin-bottom:4px;">$15<span style="font-size:16px;font-weight:400;color:#49454f;">/mo</span></div>
                <separator/>
                <div style="font-size:13px;color:#49454f;padding:8px 0;border-bottom:1px solid #f0f0f0;">20 users included</div>
                <div style="font-size:13px;color:#49454f;padding:8px 0;border-bottom:1px solid #f0f0f0;">10 GB of storage</div>
                <div style="font-size:13px;color:#49454f;padding:8px 0;border-bottom:1px solid #f0f0f0;">Help center access</div>
                <div style="font-size:13px;color:#49454f;padding:8px 0;margin-bottom:24px;">Priority email support</div>
                <button label="Get started" sclass="z-button-primary" style="width:100%;"/>
            </div>

            <!-- Enterprise -->
            <div style="border:1px solid #e0e0e0;border-radius:8px;padding:32px 24px;text-align:center;">
                <div style="font-size:18px;font-weight:600;margin-bottom:8px;">Enterprise</div>
                <div style="font-size:36px;font-weight:700;margin-bottom:4px;">$30<span style="font-size:16px;font-weight:400;color:#49454f;">/mo</span></div>
                <separator/>
                <div style="font-size:13px;color:#49454f;padding:8px 0;border-bottom:1px solid #f0f0f0;">50 users included</div>
                <div style="font-size:13px;color:#49454f;padding:8px 0;border-bottom:1px solid #f0f0f0;">30 GB of storage</div>
                <div style="font-size:13px;color:#49454f;padding:8px 0;border-bottom:1px solid #f0f0f0;">Help center access</div>
                <div style="font-size:13px;color:#49454f;padding:8px 0;margin-bottom:24px;">Phone &amp; email support</div>
                <button label="Contact us" sclass="z-button-outlined" style="width:100%;"/>
            </div>

        </div>
    </div>

</div>
