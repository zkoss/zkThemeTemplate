<div sclass="m-main">

    <div sclass="m-page-header">
        <label sclass="m-page-title" value="Chart.js"/>
    </div>

    <div sclass="m-kpi-row" style="display:grid;grid-template-columns:1fr 1fr;gap:24px;">

        <div sclass="z-card">
            <label sclass="z-card__title" value="Line Chart"/>
            <label value="A line chart is a way of plotting data points on a line." style="font-size:13px;color:#49454f;display:block;margin-bottom:16px;"/>
            <image src="~./usecase2/img/charts/total-revenue.png" sclass="m-chart-img"/>
        </div>

        <div sclass="z-card">
            <label sclass="z-card__title" value="Bar Chart"/>
            <label value="A bar chart provides a way of showing data values represented as vertical bars." style="font-size:13px;color:#49454f;display:block;margin-bottom:16px;"/>
            <image src="~./usecase2/img/charts/weekly-sales.png" sclass="m-chart-img"/>
        </div>

        <div sclass="z-card">
            <label sclass="z-card__title" value="Doughnut Chart"/>
            <label value="Doughnut charts are excellent at showing the relational proportions between data." style="font-size:13px;color:#49454f;display:block;margin-bottom:16px;"/>
            <image src="~./usecase2/img/charts/mobile-desktop.png" sclass="m-chart-img"/>
        </div>

        <div sclass="z-card">
            <label sclass="z-card__title" value="Pie Chart"/>
            <label value="Pie charts are excellent at showing the relational proportions between data." style="font-size:13px;color:#49454f;display:block;margin-bottom:16px;"/>
            <image src="~./usecase2/img/charts/mobile-desktop.png" sclass="m-chart-img"/>
        </div>

        <div sclass="z-card">
            <label sclass="z-card__title" value="Radar Chart"/>
            <label value="A radar chart is a way of showing multiple data points and the variation between them." style="font-size:13px;color:#49454f;display:block;margin-bottom:16px;"/>
            <image src="~./usecase2/img/charts/total-revenue.png" sclass="m-chart-img"/>
        </div>

        <div sclass="z-card">
            <label sclass="z-card__title" value="Polar Area Chart"/>
            <label value="Polar area charts are similar to pie charts, but each segment has the same angle." style="font-size:13px;color:#49454f;display:block;margin-bottom:16px;"/>
            <image src="~./usecase2/img/charts/mobile-desktop.png" sclass="m-chart-img"/>
        </div>

    </div>

</div>
