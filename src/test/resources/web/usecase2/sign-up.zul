<div sclass="m-main" style="display:flex;align-items:center;justify-content:center;min-height:calc(100vh - 64px);">

    <div sclass="m-card" style="width:400px;">
        <label value="Get started" style="font-size:22px;font-weight:700;display:block;margin-bottom:8px;"/>
        <label value="Start creating the best possible user experience for your customers" style="font-size:14px;color:#49454f;display:block;margin-bottom:24px;"/>

        <div style="display:flex;gap:12px;margin-bottom:16px;">
            <div style="flex:1;">
                <label value="First name" style="font-size:13px;font-weight:600;display:block;margin-bottom:4px;"/>
                <textbox placeholder="First name" style="width:100%;" cols="20"/>
            </div>
            <div style="flex:1;">
                <label value="Last name" style="font-size:13px;font-weight:600;display:block;margin-bottom:4px;"/>
                <textbox placeholder="Last name" style="width:100%;" cols="20"/>
            </div>
        </div>

        <label value="Email address" style="font-size:13px;font-weight:600;display:block;margin-bottom:4px;"/>
        <textbox placeholder="Email address" style="width:100%;margin-bottom:16px;" cols="40"/>

        <label value="Password" style="font-size:13px;font-weight:600;display:block;margin-bottom:4px;"/>
        <textbox placeholder="Password" type="password" style="width:100%;margin-bottom:16px;" cols="40"/>

        <label value="Confirm password" style="font-size:13px;font-weight:600;display:block;margin-bottom:4px;"/>
        <textbox placeholder="Confirm password" type="password" style="width:100%;margin-bottom:24px;" cols="40"/>

        <button label="Sign up" sclass="m-btn--primary" style="width:100%;margin-bottom:16px;"/>

        <label value="Already have an account? " style="font-size:13px;color:#49454f;"/>
        <a href="#" label="Log in" style="font-size:13px;color:#376fd0;"/>
    </div>

</div>
