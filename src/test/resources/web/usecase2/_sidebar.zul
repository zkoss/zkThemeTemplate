<zk>
<vlayout sclass="m-sidebar__inner">

    <div sclass="m-sidebar__brand">
        <span sclass="m-sidebar__brand-name">ZK Material Theme</span>
    </div>

    <textbox sclass="m-sidebar__search" placeholder="Search topics..." />

    <div sclass="m-nav-section">Pages</div>
    <navbar orient="vertical" sclass="m-sidebar">
        <nav label="Dashboard" iconSclass="z-icon-layout-grid" open="true">
            <navitem label="Default"
                onClick="@command('navigate', page='~./usecase2/default.zul')"
                sclass="@load(vm.currentPage eq '~./usecase2/default.zul' ? 'm-active' : '')"/>
            <navitem label="Analytics"
                onClick="@command('navigate', page='~./usecase2/analytics.zul')"
                sclass="@load(vm.currentPage eq '~./usecase2/analytics.zul' ? 'm-active' : '')"/>
            <navitem label="SaaS"
                onClick="@command('navigate', page='~./usecase2/saas.zul')"
                sclass="@load(vm.currentPage eq '~./usecase2/saas.zul' ? 'm-active' : '')"/>
        </nav>
        <nav label="Pages" iconSclass="z-icon-file-text">
            <navitem label="Profile"
                onClick="@command('navigate', page='~./usecase2/pages-profile.zul')"
                sclass="@load(vm.currentPage eq '~./usecase2/pages-profile.zul' ? 'm-active' : '')"/>
            <navitem label="Settings"
                onClick="@command('navigate', page='~./usecase2/pages-settings.zul')"
                sclass="@load(vm.currentPage eq '~./usecase2/pages-settings.zul' ? 'm-active' : '')"/>
            <navitem label="Pricing"
                onClick="@command('navigate', page='~./usecase2/pages-pricing.zul')"
                sclass="@load(vm.currentPage eq '~./usecase2/pages-pricing.zul' ? 'm-active' : '')"/>
            <navitem label="Chat"
                onClick="@command('navigate', page='~./usecase2/pages-chat.zul')"
                sclass="@load(vm.currentPage eq '~./usecase2/pages-chat.zul' ? 'm-active' : '')"/>
            <navitem label="Blank Page"
                onClick="@command('navigate', page='~./usecase2/pages-blank.zul')"
                sclass="@load(vm.currentPage eq '~./usecase2/pages-blank.zul' ? 'm-active' : '')"/>
        </nav>
        <navitem label="Projects" iconSclass="z-icon-folder" badgeText="8"
            onClick="@command('navigate', page='~./usecase2/projects.zul')"
            sclass="@load(vm.currentPage eq '~./usecase2/projects.zul' ? 'm-active' : '')"/>
        <navitem label="Orders"   iconSclass="z-icon-shopping-cart"
            onClick="@command('navigate', page='~./usecase2/orders.zul')"
            sclass="@load(vm.currentPage eq '~./usecase2/orders.zul' ? 'm-active' : '')"/>
        <navitem label="Products" iconSclass="z-icon-package"
            onClick="@command('navigate', page='~./usecase2/products.zul')"
            sclass="@load(vm.currentPage eq '~./usecase2/products.zul' ? 'm-active' : '')"/>
        <nav label="Invoices" iconSclass="z-icon-file">
            <navitem label="Invoice List"
                onClick="@command('navigate', page='~./usecase2/invoice-list.zul')"
                sclass="@load(vm.currentPage eq '~./usecase2/invoice-list.zul' ? 'm-active' : '')"/>
            <navitem label="Invoice Detail"
                onClick="@command('navigate', page='~./usecase2/invoice-detail.zul')"
                sclass="@load(vm.currentPage eq '~./usecase2/invoice-detail.zul' ? 'm-active' : '')"/>
        </nav>
        <navitem label="Tasks"    iconSclass="z-icon-square-check" badgeText="17"
            onClick="@command('navigate', page='~./usecase2/tasks.zul')"
            sclass="@load(vm.currentPage eq '~./usecase2/tasks.zul' ? 'm-active' : '')"/>
        <nav label="Auth" iconSclass="z-icon-user">
            <navitem label="Sign In"
                onClick="@command('navigate', page='~./usecase2/sign-in.zul')"
                sclass="@load(vm.currentPage eq '~./usecase2/sign-in.zul' ? 'm-active' : '')"/>
            <navitem label="Sign Up"
                onClick="@command('navigate', page='~./usecase2/sign-up.zul')"
                sclass="@load(vm.currentPage eq '~./usecase2/sign-up.zul' ? 'm-active' : '')"/>
            <navitem label="Reset Password"
                onClick="@command('navigate', page='~./usecase2/reset-password.zul')"
                sclass="@load(vm.currentPage eq '~./usecase2/reset-password.zul' ? 'm-active' : '')"/>
        </nav>
    </navbar>

    <div sclass="m-nav-section">Elements</div>
    <navbar orient="vertical" sclass="m-sidebar">
        <nav label="Components" iconSclass="z-icon-grid-3x3">
            <navitem label="Accordion"
                onClick="@command('navigate', page='~./usecase2/accordion.zul')"
                sclass="@load(vm.currentPage eq '~./usecase2/accordion.zul' ? 'm-active' : '')"/>
            <navitem label="Alerts"
                onClick="@command('navigate', page='~./usecase2/alerts.zul')"
                sclass="@load(vm.currentPage eq '~./usecase2/alerts.zul' ? 'm-active' : '')"/>
            <navitem label="Avatars"
                onClick="@command('navigate', page='~./usecase2/avatars.zul')"
                sclass="@load(vm.currentPage eq '~./usecase2/avatars.zul' ? 'm-active' : '')"/>
            <navitem label="Badges"
                onClick="@command('navigate', page='~./usecase2/badges.zul')"
                sclass="@load(vm.currentPage eq '~./usecase2/badges.zul' ? 'm-active' : '')"/>
            <navitem label="Buttons"
                onClick="@command('navigate', page='~./usecase2/buttons.zul')"
                sclass="@load(vm.currentPage eq '~./usecase2/buttons.zul' ? 'm-active' : '')"/>
            <navitem label="Cards"
                onClick="@command('navigate', page='~./usecase2/cards.zul')"
                sclass="@load(vm.currentPage eq '~./usecase2/cards.zul' ? 'm-active' : '')"/>
            <navitem label="Chips"
                onClick="@command('navigate', page='~./usecase2/chips.zul')"
                sclass="@load(vm.currentPage eq '~./usecase2/chips.zul' ? 'm-active' : '')"/>
            <navitem label="Dialogs"
                onClick="@command('navigate', page='~./usecase2/dialogs.zul')"
                sclass="@load(vm.currentPage eq '~./usecase2/dialogs.zul' ? 'm-active' : '')"/>
            <navitem label="Lists"
                onClick="@command('navigate', page='~./usecase2/lists.zul')"
                sclass="@load(vm.currentPage eq '~./usecase2/lists.zul' ? 'm-active' : '')"/>
            <navitem label="Menus"
                onClick="@command('navigate', page='~./usecase2/menus.zul')"
                sclass="@load(vm.currentPage eq '~./usecase2/menus.zul' ? 'm-active' : '')"/>
            <navitem label="Pagination"
                onClick="@command('navigate', page='~./usecase2/pagination.zul')"
                sclass="@load(vm.currentPage eq '~./usecase2/pagination.zul' ? 'm-active' : '')"/>
            <navitem label="Progress"
                onClick="@command('navigate', page='~./usecase2/progress.zul')"
                sclass="@load(vm.currentPage eq '~./usecase2/progress.zul' ? 'm-active' : '')"/>
            <navitem label="Snackbars" disabled="true"/>
            <navitem label="Tabs"
                onClick="@command('navigate', page='~./usecase2/tabs.zul')"
                sclass="@load(vm.currentPage eq '~./usecase2/tabs.zul' ? 'm-active' : '')"/>
            <navitem label="Tooltips"
                onClick="@command('navigate', page='~./usecase2/tooltips.zul')"
                sclass="@load(vm.currentPage eq '~./usecase2/tooltips.zul' ? 'm-active' : '')"/>
        </nav>
        <nav label="Charts" iconSclass="z-icon-bar-chart">
            <navitem label="ApexCharts"
                onClick="@command('navigate', page='~./usecase2/charts-apex.zul')"
                sclass="@load(vm.currentPage eq '~./usecase2/charts-apex.zul' ? 'm-active' : '')"/>
            <navitem label="Chart.js"
                onClick="@command('navigate', page='~./usecase2/charts-chartjs.zul')"
                sclass="@load(vm.currentPage eq '~./usecase2/charts-chartjs.zul' ? 'm-active' : '')"/>
        </nav>
        <nav label="Forms" iconSclass="z-icon-square-pen">
            <navitem label="Pickers"
                onClick="@command('navigate', page='~./usecase2/forms-pickers.zul')"
                sclass="@load(vm.currentPage eq '~./usecase2/forms-pickers.zul' ? 'm-active' : '')"/>
            <navitem label="Selection Controls"
                onClick="@command('navigate', page='~./usecase2/forms-selection-controls.zul')"
                sclass="@load(vm.currentPage eq '~./usecase2/forms-selection-controls.zul' ? 'm-active' : '')"/>
            <navitem label="Selects"
                onClick="@command('navigate', page='~./usecase2/forms-selects.zul')"
                sclass="@load(vm.currentPage eq '~./usecase2/forms-selects.zul' ? 'm-active' : '')"/>
            <navitem label="Text Fields"
                onClick="@command('navigate', page='~./usecase2/forms-text-fields.zul')"
                sclass="@load(vm.currentPage eq '~./usecase2/forms-text-fields.zul' ? 'm-active' : '')"/>
            <navitem label="Editors"/>
            <navitem label="Formik"
                onClick="@command('navigate', page='~./usecase2/forms-formik.zul')"
                sclass="@load(vm.currentPage eq '~./usecase2/forms-formik.zul' ? 'm-active' : '')"/>
        </nav>
        <nav label="Tables" iconSclass="z-icon-table">
            <navitem label="Simple Table"
                onClick="@command('navigate', page='~./usecase2/tables-simple.zul')"
                sclass="@load(vm.currentPage eq '~./usecase2/tables-simple.zul' ? 'm-active' : '')"/>
            <navitem label="Advanced Table"
                onClick="@command('navigate', page='~./usecase2/tables-advanced.zul')"
                sclass="@load(vm.currentPage eq '~./usecase2/tables-advanced.zul' ? 'm-active' : '')"/>
        </nav>
        <nav label="Icons" iconSclass="z-icon-smile">
            <navitem label="Lucide Icons"
                onClick="@command('navigate', page='~./usecase2/icons-lucide.zul')"
                sclass="@load(vm.currentPage eq '~./usecase2/icons-lucide.zul' ? 'm-active' : '')"/>
        </nav>
        <navitem label="Maps" iconSclass="z-icon-map-pin"/>
    </navbar>

    <div sclass="m-nav-section">Mira Pro</div>
    <navbar orient="vertical" sclass="m-sidebar">
        <navitem label="Documentation" iconSclass="z-icon-book"/>
        <navitem label="Changelog"     iconSclass="z-icon-clipboard-list" badgeText="v6.1.0"/>
    </navbar>

    <div sclass="m-sidebar__user">
        <div sclass="z-avatar z-avatar-sm" style="background:#5c7bd9;">
            <label value="H" style="color:#fff;font-weight:600;"/>
        </div>
        <div sclass="m-sidebar__user-info">
            <div sclass="m-sidebar__user-name">Hawk</div>
            <div sclass="m-sidebar__user-role">UX Designer</div>
        </div>
    </div>
</vlayout>
</zk>
