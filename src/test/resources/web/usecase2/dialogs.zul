<div sclass="m-main">
    <div sclass="m-page-header">
        <label sclass="m-page-title" value="Dialogs"/>
    </div>

    <div style="display:grid;grid-template-columns:1fr 1fr;gap:24px;align-items:start;">

        <!-- Left column -->
        <div>
            <!-- Simple Dialogs -->
            <div sclass="m-card" style="margin-bottom:24px;">
                <label sclass="m-card__title" value="Simple Dialogs"/>
                <label value="Simple dialogs can provide additional details or actions about a list item." style="font-size:13px;color:#49454f;display:block;margin-bottom:16px;"/>
                <button label="Open simple dialog" sclass="z-button-primary" onClick="simpleDialog.doModal()"/>
            </div>

            <!-- Alerts -->
            <div sclass="m-card">
                <label sclass="m-card__title" value="Alerts"/>
                <label value="Alerts are urgent interruptions, requiring acknowledgement, that inform the user about a situation." style="font-size:13px;color:#49454f;display:block;margin-bottom:16px;"/>
                <button label="Open alert dialog" sclass="z-button-primary" onClick="alertDialog.doModal()"/>
            </div>
        </div>

        <!-- Right column -->
        <div>
            <!-- Optional Sizes -->
            <div sclass="m-card" style="margin-bottom:24px;">
                <label sclass="m-card__title" value="Optional Sizes"/>
                <label value="You can set a dialog maximum width by using the maxWidth enumerable in combination with the fullWidth boolean." style="font-size:13px;color:#49454f;display:block;margin-bottom:16px;"/>
                <button label="Open max-width dialog" sclass="z-button-outlined" onClick="sizeDialog.doModal()"/>
            </div>

            <!-- Form Dialogs -->
            <div sclass="m-card">
                <label sclass="m-card__title" value="Form Dialogs"/>
                <label value="Form dialogs allow users to fill out form fields within a dialog." style="font-size:13px;color:#49454f;display:block;margin-bottom:16px;"/>
                <button label="Open form dialog" sclass="z-button-primary" onClick="formDialog.doModal()"/>
            </div>
        </div>

    </div>

    <!-- Simple dialog — user selection list -->
    <window id="simpleDialog" title="Select an account"  mode="modal"
            sclass="m-dialog" visible="false" width="320px">
        <listbox width="100%" style="border:none;" onSelect="simpleDialog.setVisible(false)">
            <listitem>
                <listcell>
                    <div style="display:flex;align-items:center;gap:12px;padding:4px 0;">
                        <div style="width:36px;height:36px;border-radius:50%;background:#e0e0e0;display:flex;align-items:center;justify-content:center;font-size:16px;">👤</div>
                        <label value="user01@gmail.com"/>
                    </div>
                </listcell>
            </listitem>
            <listitem>
                <listcell>
                    <div style="display:flex;align-items:center;gap:12px;padding:4px 0;">
                        <div style="width:36px;height:36px;border-radius:50%;background:#e0e0e0;display:flex;align-items:center;justify-content:center;font-size:16px;">👤</div>
                        <label value="user02@gmail.com"/>
                    </div>
                </listcell>
            </listitem>
            <listitem>
                <listcell>
                    <div style="display:flex;align-items:center;gap:12px;padding:4px 0;">
                        <div style="width:36px;height:36px;border-radius:50%;background:#e8f5e9;display:flex;align-items:center;justify-content:center;font-size:16px;">➕</div>
                        <label value="Add account"/>
                    </div>
                </listcell>
            </listitem>
        </listbox>
    </window>

    <!-- Alert dialog — no close button, requires action -->
    <window id="alertDialog" title="Use Google's location service?" closable="false" mode="modal"
            sclass="m-dialog" visible="false" width="420px">
        <vlayout style="padding:16px 20px 8px;">
            <label value="Let Google help apps determine location. This means sending anonymous location data to Google, even when no apps are running." style="font-size:14px;color:#555;line-height:1.6;"/>
            <separator/>
            <hlayout style="justify-content:flex-end;" spacing="8px">
                <button label="Disagree" sclass="z-button-text" onClick="alertDialog.setVisible(false)"/>
                <button label="Agree"    sclass="z-button-text" onClick="alertDialog.setVisible(false)"/>
            </hlayout>
        </vlayout>
    </window>

    <!-- Optional sizes dialog — demonstrates wider/narrower widths -->
    <window id="sizeDialog" title="Optional Sizes"  mode="modal"
            sclass="m-dialog" visible="false" width="600px">
        <vlayout style="padding:16px 20px;">
            <label value="This dialog demonstrates the maxWidth option. The dialog will not get any wider than sm (600px) regardless of the content." style="font-size:14px;color:#555;line-height:1.6;"/>
            <separator/>
            <hlayout style="justify-content:flex-end;" spacing="8px">
                <button label="Close" sclass="z-button-outlined" onClick="sizeDialog.setVisible(false)"/>
                <button label="OK"    sclass="z-button-primary"  onClick="sizeDialog.setVisible(false)"/>
            </hlayout>
        </vlayout>
    </window>

    <!-- Form dialog -->
    <window id="formDialog" title="Subscribe" mode="modal"
            sclass="m-dialog" visible="false" width="500px">
        <vlayout style="padding:16px 20px;" spacing="12px">
            <label value="To subscribe to this website, please enter your email address here. We will send updates occasionally." style="font-size:14px;color:#555;line-height:1.6;"/>
            <vlayout>
                <label value="Email Address" style="font-size:12px;font-weight:500;margin-bottom:4px;"/>
                <textbox width="100%" placeholder="email@example.com" type="email"/>
            </vlayout>
            <separator/>
            <hlayout style="justify-content:flex-end;" spacing="8px">
                <button label="Cancel"    sclass="z-button-text"    onClick="formDialog.setVisible(false)"/>
                <button label="Subscribe" sclass="z-button-primary" onClick="formDialog.setVisible(false)"/>
            </hlayout>
        </vlayout>
    </window>

</div>
