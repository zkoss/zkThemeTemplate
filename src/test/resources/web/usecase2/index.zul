<?page title="Default Dashboard | Mira ZK"?>
<?link rel="stylesheet" type="text/css" href="~./usecase2/usecase2.css"?>
<zk>
<borderlayout height="100vh">

    <!-- ═══════════════════════════════════════════
         WEST — Sidebar
         ═══════════════════════════════════════════ -->
    <west size="258px" border="none" collapsible="false" sclass="m-sidebar">
        <vlayout sclass="m-sidebar__inner">

            <!-- Brand -->
            <div sclass="m-sidebar__brand">
                <span sclass="m-sidebar__brand-name">Mira</span>
                <div sclass="m-badge m-badge--info" style="font-size:9px;padding:1px 5px;">PRO</div>
            </div>

            <!-- Search -->
            <textbox sclass="m-sidebar__search" placeholder="Search topics..." readonly="true"/>

            <!-- ── PAGES section ── -->
            <div sclass="m-nav-section">Pages</div>
            <navbar orient="vertical" sclass="m-sidebar">
                <nav label="Dashboard" iconSclass="z-icon-th-large" open="true">
                    <navitem label="Default"   href="/usecase2/index.zul"    sclass="m-active"/>
                    <navitem label="Analytics"/>
                    <navitem label="SaaS"/>
                </nav>
                <navitem label="Pages"    iconSclass="z-icon-file-text-o"/>
                <navitem label="Projects" iconSclass="z-icon-folder-o"       badgeText="8"/>
                <navitem label="Orders"   iconSclass="z-icon-shopping-cart"/>
                <navitem label="Products" iconSclass="z-icon-cube"/>
                <nav label="Invoices"     iconSclass="z-icon-file-o">
                    <navitem label="Invoice List"/>
                    <navitem label="Invoice Detail"/>
                </nav>
                <navitem label="Tasks"    iconSclass="z-icon-check-square-o" badgeText="17"/>
                <navitem label="Calendar" iconSclass="z-icon-calendar"/>
                <nav label="Auth"         iconSclass="z-icon-user">
                    <navitem label="Sign In"/>
                    <navitem label="Sign Up"/>
                    <navitem label="Reset Password"/>
                </nav>
            </navbar>

            <!-- ── ELEMENTS section ── -->
            <div sclass="m-nav-section">Elements</div>
            <navbar orient="vertical" sclass="m-sidebar">
                <nav label="Components" iconSclass="z-icon-th">
                    <navitem label="Accordion"  href="/usecase2/accordion.zul"/>
                    <navitem label="Alerts"     href="/usecase2/alerts.zul"/>
                    <navitem label="Avatars"    href="/usecase2/avatars.zul"/>
                    <navitem label="Badges"     href="/usecase2/badges.zul"/>
                    <navitem label="Buttons"    href="/usecase2/buttons.zul"/>
                    <navitem label="Cards"      href="/usecase2/cards.zul"/>
                    <navitem label="Chips"      href="/usecase2/chips.zul"/>
                    <navitem label="Dialogs"    href="/usecase2/dialogs.zul"/>
                    <navitem label="Lists"      href="/usecase2/lists.zul"/>
                    <navitem label="Menus"      href="/usecase2/menus.zul"/>
                    <navitem label="Pagination" href="/usecase2/pagination.zul"/>
                    <navitem label="Progress"   href="/usecase2/progress.zul"/>
                    <navitem label="Tabs"       href="/usecase2/tabs.zul"/>
                    <navitem label="Tooltips"   href="/usecase2/tooltips.zul"/>
                </nav>
                <nav label="Charts"  iconSclass="z-icon-bar-chart">
                    <navitem label="ApexCharts"/>
                    <navitem label="Chart.js"/>
                </nav>
                <nav label="Forms"   iconSclass="z-icon-pencil-square-o">
                    <navitem label="Text Fields"/>
                    <navitem label="Selects"/>
                    <navitem label="Pickers"/>
                    <navitem label="Editors"/>
                    <navitem label="Selection Controls"/>
                </nav>
                <nav label="Tables"  iconSclass="z-icon-table">
                    <navitem label="Simple Table"/>
                    <navitem label="Advanced Table"/>
                    <navitem label="Data Grid"/>
                </nav>
                <nav label="Icons"   iconSclass="z-icon-heart-o">
                    <navitem label="Lucide Icons"/>
                </nav>
                <navitem label="Maps" iconSclass="z-icon-map-marker"/>
            </navbar>

            <!-- ── MIRA PRO section ── -->
            <div sclass="m-nav-section">Mira Pro</div>
            <navbar orient="vertical" sclass="m-sidebar">
                <navitem label="Documentation" iconSclass="z-icon-book"/>
                <navitem label="Changelog"     iconSclass="z-icon-list-alt" badgeText="v6.1.0"/>
            </navbar>

            <!-- User profile -->
            <div sclass="m-sidebar__user">
                <div sclass="m-avatar m-avatar--sm" style="background:#5c7bd9;">
                    <label value="L" style="color:#fff;font-weight:600;"/>
                </div>
                <div sclass="m-sidebar__user-info">
                    <div sclass="m-sidebar__user-name">Lucy Lavender</div>
                    <div sclass="m-sidebar__user-role">UX Designer</div>
                </div>
            </div>

        </vlayout>
    </west>

    <!-- ═══════════════════════════════════════════
         CENTER — Topbar + Dashboard content
         ═══════════════════════════════════════════ -->
    <center border="none" autoscroll="true">
        <vlayout>

            <!-- Topbar -->
            <hlayout sclass="m-topbar">
                <textbox placeholder="Search topics..." readonly="true"/>
                <div sclass="m-topbar-right">
                    <button iconSclass="z-icon-envelope" sclass="m-icon-btn"/>
                    <button iconSclass="z-icon-bell"     sclass="m-icon-btn"/>
                    <div sclass="m-avatar m-avatar--sm" style="background:#5c7bd9;">
                        <label value="L" style="color:#fff;font-weight:600;"/>
                    </div>
                </div>
            </hlayout>

            <!-- ── Dashboard content ── -->
            <div sclass="m-main">

                <!-- Page header -->
                <div sclass="m-page-header">
                    <div>
                        <label sclass="m-page-title"    value="Default Dashboard"/>
                        <label sclass="m-page-subtitle" value="Welcome back, Lucy! We've missed you."/>
                    </div>
                    <hlayout sclass="m-page-actions">
                        <button iconSclass="z-icon-refresh" sclass="m-btn--outlined"/>
                        <button label="Today: April 29"     sclass="m-btn--primary"/>
                    </hlayout>
                </div>

                <!-- KPI cards -->
                <hlayout sclass="m-kpi-row">

                    <div sclass="m-card m-kpi-card">
                        <div sclass="m-kpi-card__header">
                            <label sclass="m-kpi-card__label" value="Sales Today"/>
                            <div sclass="m-chip m-chip--primary">Today</div>
                        </div>
                        <label sclass="m-kpi-card__value" value="2,532"/>
                        <div sclass="m-kpi-card__footer">
                            <span sclass="m-kpi-trend--up">+26%</span>
                            <span sclass="m-kpi-since">Since last month</span>
                        </div>
                    </div>

                    <div sclass="m-card m-kpi-card">
                        <div sclass="m-kpi-card__header">
                            <label sclass="m-kpi-card__label" value="Visitors"/>
                            <div sclass="m-chip m-chip--primary">Annual</div>
                        </div>
                        <label sclass="m-kpi-card__value" value="170,212"/>
                        <div sclass="m-kpi-card__footer">
                            <span sclass="m-kpi-trend--down">-14%</span>
                            <span sclass="m-kpi-since">Since last month</span>
                        </div>
                    </div>

                    <div sclass="m-card m-kpi-card">
                        <div sclass="m-kpi-card__header">
                            <label sclass="m-kpi-card__label" value="Total Earnings"/>
                            <div sclass="m-chip m-chip--primary">Monthly</div>
                        </div>
                        <label sclass="m-kpi-card__value" value="$ 24,300"/>
                        <div sclass="m-kpi-card__footer">
                            <span sclass="m-kpi-trend--up">+18%</span>
                            <span sclass="m-kpi-since">Since last month</span>
                        </div>
                    </div>

                    <div sclass="m-card m-kpi-card">
                        <div sclass="m-kpi-card__header">
                            <label sclass="m-kpi-card__label m-kpi-card__label--primary" value="Pending Orders"/>
                        </div>
                        <label sclass="m-kpi-card__value m-kpi-card__value--primary" value="45"/>
                        <div sclass="m-kpi-card__footer">
                            <span sclass="m-kpi-trend--down">-9%</span>
                            <span sclass="m-kpi-since">Since last month</span>
                        </div>
                    </div>

                </hlayout>

                <!-- Charts row: Total Revenue + Weekly Sales -->
                <hlayout sclass="m-charts-row" spacing="0">

                    <div sclass="m-card m-chart-card-main">
                        <label sclass="m-card__title" value="Total revenue"/>
                        <image src="~./usecase2/img/charts/total-revenue.png" sclass="m-chart-img"/>
                    </div>

                    <div sclass="m-card m-chart-card-side">
                        <label sclass="m-card__title" value="Weekly sales"/>
                        <image src="~./usecase2/img/charts/weekly-sales.png" sclass="m-chart-img"/>

                        <!-- Revenue source table -->
                        <grid sclass="m-revenue-table" mold="default">
                            <columns>
                                <column label="Source"/>
                                <column label="Revenue"/>
                                <column label="Value"/>
                            </columns>
                            <rows>
                                <row>
                                    <label value="Social"/>
                                    <label value="260"/>
                                    <label sclass="m-positive" value="+35%"/>
                                </row>
                                <row>
                                    <label value="Search Engines"/>
                                    <label value="125"/>
                                    <label sclass="m-negative" value="-12%"/>
                                </row>
                                <row>
                                    <label value="Direct"/>
                                    <label value="54"/>
                                    <label sclass="m-positive" value="+46%"/>
                                </row>
                                <row>
                                    <label value="Other"/>
                                    <label value="146"/>
                                    <label sclass="m-positive" value="+24%"/>
                                </row>
                            </rows>
                        </grid>
                    </div>

                </hlayout>

                <!-- Bottom row: Mobile/Desktop + Latest Projects -->
                <hlayout sclass="m-bottom-row" spacing="0">

                    <div sclass="m-card m-bottom-card-chart">
                        <label sclass="m-card__title" value="Mobile / Desktop"/>
                        <image src="~./usecase2/img/charts/mobile-desktop.png" sclass="m-chart-img"/>
                    </div>

                    <div sclass="m-card m-bottom-card-projects">
                        <label sclass="m-card__title" value="Latest projects"/>
                        <grid sclass="m-projects-grid" mold="default">
                            <columns>
                                <column label="Name"/>
                                <column label="Start Date"/>
                                <column label="End Date"/>
                                <column label="State"/>
                                <column label="Assignee"/>
                            </columns>
                            <rows>
                                <row>
                                    <label value="Project Aurora"/>
                                    <label value="01/01/2025"/>
                                    <label value="31/06/2025"/>
                                    <div sclass="m-badge m-badge--success">Done</div>
                                    <label value="James Dalton"/>
                                </row>
                                <row>
                                    <label value="Project Eagle"/>
                                    <label value="01/01/2025"/>
                                    <label value="31/06/2025"/>
                                    <div sclass="m-badge m-badge--warning">In Progress</div>
                                    <label value="Tracy Mack"/>
                                </row>
                                <row>
                                    <label value="Project Fireball"/>
                                    <label value="01/01/2025"/>
                                    <label value="31/06/2025"/>
                                    <div sclass="m-badge m-badge--success">Done</div>
                                    <label value="Sallie Love"/>
                                </row>
                                <row>
                                    <label value="Project Omega"/>
                                    <label value="01/01/2025"/>
                                    <label value="31/06/2025"/>
                                    <div sclass="m-badge m-badge--error">Cancelled</div>
                                    <label value="Glenda Jang"/>
                                </row>
                                <row>
                                    <label value="Project Yoda"/>
                                    <label value="01/01/2025"/>
                                    <label value="31/06/2025"/>
                                    <div sclass="m-badge m-badge--success">Done</div>
                                    <label value="Raymond Ennis"/>
                                </row>
                                <row>
                                    <label value="Project Zulu"/>
                                    <label value="01/01/2025"/>
                                    <label value="31/06/2025"/>
                                    <div sclass="m-badge m-badge--success">Done</div>
                                    <label value="Matthew Winters"/>
                                </row>
                            </rows>
                        </grid>
                    </div>

                </hlayout>

            </div><!-- /m-main -->

        </vlayout>
    </center>

</borderlayout>
</zk>
