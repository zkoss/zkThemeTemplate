<div sclass="m-main">

    <div sclass="m-page-header">
        <label sclass="m-page-title" value="Invoice #000112"/>
        <hlayout sclass="m-page-actions">
            <button iconSclass="z-icon-printer" label="Print" sclass="z-button-outlined"/>
        </hlayout>
    </div>

    <div sclass="z-card" style="max-width:760px;">

        <div style="margin-bottom:24px;">
            <label value="Hello Anna Walley," style="font-size:18px;font-weight:600;display:block;margin-bottom:8px;"/>
            <label value="This is the receipt for a payment of $268.85 (USD) you made to Mira." style="font-size:14px;color:#49454f;display:block;"/>
        </div>

        <div sclass="m-kpi-row" style="margin-bottom:24px;">
            <div>
                <label value="Payment No." style="font-size:12px;color:#49454f;font-weight:600;text-transform:uppercase;display:block;margin-bottom:4px;"/>
                <label value="741037024"   style="font-size:14px;display:block;"/>
            </div>
            <div>
                <label value="Payment Date" style="font-size:12px;color:#49454f;font-weight:600;text-transform:uppercase;display:block;margin-bottom:4px;"/>
                <label value="January 2, 2025 - 03:45 pm" style="font-size:14px;display:block;"/>
            </div>
        </div>

        <div sclass="m-charts-row" style="margin-bottom:24px;">
            <div sclass="z-card" style="flex:1;">
                <label sclass="z-card__title" value="Client"/>
                <label value="Anna Walley"    style="font-size:14px;font-weight:600;display:block;"/>
                <label value="4183 Forest Avenue" style="font-size:13px;color:#49454f;display:block;"/>
                <label value="New York City, 10011" style="font-size:13px;color:#49454f;display:block;"/>
                <label value="USA"            style="font-size:13px;color:#49454f;display:block;"/>
                <label value="anna@walley.com" style="font-size:13px;color:#376fd0;display:block;"/>
            </div>
            <div sclass="z-card" style="flex:1;">
                <label sclass="z-card__title" value="Payment To"/>
                <label value="Mira LLC"       style="font-size:14px;font-weight:600;display:block;"/>
                <label value="354 Roy Alley"  style="font-size:13px;color:#49454f;display:block;"/>
                <label value="Denver, 80202"  style="font-size:13px;color:#49454f;display:block;"/>
                <label value="USA"            style="font-size:13px;color:#49454f;display:block;"/>
                <label value="info@mira.com"  style="font-size:13px;color:#376fd0;display:block;"/>
            </div>
        </div>

        <grid sclass="m-projects-grid" mold="default" style="margin-bottom:16px;">
            <columns>
                <column label="Description"/>
                <column label="Quantity" width="100px"/>
                <column label="Amount"   width="120px"/>
            </columns>
            <rows>
                <row>
                    <label value="Mira Theme Customization"/>
                    <label value="2"/>
                    <label value="$150.00"/>
                </row>
                <row>
                    <label value="Monthly Subscription"/>
                    <label value="3"/>
                    <label value="$25.00"/>
                </row>
                <row>
                    <label value="Additional Service"/>
                    <label value="2"/>
                    <label value="$100.00"/>
                </row>
            </rows>
        </grid>

        <div style="text-align:right;padding:12px 0;border-top:1px solid #e0e0e0;">
            <label value="Subtotal: $275.00" style="font-size:13px;display:block;color:#49454f;"/>
            <label value="Shipping: $8.00"   style="font-size:13px;display:block;color:#49454f;"/>
            <label value="Discount: 5%"      style="font-size:13px;display:block;color:#49454f;"/>
            <label value="Total: $268.85"    style="font-size:16px;font-weight:700;display:block;color:#1a1a2e;margin-top:8px;"/>
        </div>

        <label value="Extra note: Please send all items at the same time to the shipping address. Thanks in advance." style="font-size:13px;color:#49454f;display:block;margin-top:16px;font-style:italic;"/>

    </div>

</div>
