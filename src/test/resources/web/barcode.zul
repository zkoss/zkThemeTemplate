<?page title="Barcode" contentType="text/html;charset=UTF-8"?>
<zk xmlns:h="native">
<div sclass="z-p-8">
    <div sclass="z-border-bottom z-mb-8 z-pb-3"><label sclass="z-text-2xl z-fw-medium z-text-on-surface" value="Barcode"/></div>
    <div sclass="z-mb-6">
        <div sclass="z-text-uppercase z-border-bottom z-pb-2 z-mb-4"><label sclass="z-text-xs z-fw-semibold z-text-secondary" value="1D Barcodes"/></div>
        <div sclass="z-d-flex z-items-start z-flex-wrap z-gap-6 z-py-3">
            <div sclass="z-d-flex z-flex-col z-items-start z-gap-2">
                <div><label sclass="z-text-xs z-text-secondary" value="Code128 — &quot;test&quot;"/></div>
                <barcode value="test" barWidth="3" height="50px"/>
            </div>
            <div sclass="z-d-flex z-flex-col z-items-start z-gap-2">
                <div><label sclass="z-text-xs z-text-secondary" value="EAN13"/></div>
                <barcode type="EAN13" value="7610700948859"/>
            </div>
            <div sclass="z-d-flex z-flex-col z-items-start z-gap-2">
                <div><label sclass="z-text-xs z-text-secondary" value="EAN13 with value label"/></div>
                <barcode type="EAN13" value="7610700948859" displayValue="true" fontSize="15" height="75px"/>
            </div>
        </div>
    </div>
    <div sclass="z-mb-6">
        <div sclass="z-text-uppercase z-border-bottom z-pb-2 z-mb-4"><label sclass="z-text-xs z-fw-semibold z-text-secondary" value="2D Barcodes"/></div>
        <div sclass="z-d-flex z-items-start z-flex-wrap z-gap-6 z-py-3">
            <div sclass="z-d-flex z-flex-col z-items-start z-gap-2">
                <div><label sclass="z-text-xs z-text-secondary" value="QR — zkoss.org"/></div>
                <barcode type="QR" value="https://www.zkoss.org/" height="100px" width="100px"/>
            </div>
        </div>
    </div>
</div>
</zk>
