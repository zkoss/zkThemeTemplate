<?page title="Combobutton" contentType="text/html;charset=UTF-8"?>
<zk xmlns:h="native">
<div sclass="z-p-8">
    <div sclass="z-border-bottom z-text-xl z-fw-medium z-text-on-surface z-mb-8 z-pb-3">Combobutton</div>

    <div sclass="z-mb-6 z-d-grid z-grid-cols-auto z-overflow-x-auto z-col-gap-6 z-row-gap-2 z-align-start" style="--zk-cols:2; --zk-col-min:min-content">
        <div sclass="z-grid-col-full z-text-xs z-fw-semibold z-text-uppercase z-text-secondary z-border-bottom z-pb-2 z-mb-4">States</div>
        <div sclass="z-d-contents">
            <div/>
            <div sclass="z-text-xs z-fw-semibold z-text-secondary">Default</div>
            <div sclass="z-text-xs z-fw-semibold z-text-secondary">Disabled</div>
        </div>
        <div sclass="z-d-contents">
            <div sclass="z-text-sm z-text-secondary">Default</div>
            <div>
                <combobutton label="Options">
                    <menupopup>
                        <menuitem label="Edit"/>
                        <menuitem label="Delete"/>
                    </menupopup>
                </combobutton>
            </div>
            <div>
                <combobutton label="Options" disabled="true">
                    <menupopup><menuitem label="Edit"/></menupopup>
                </combobutton>
            </div>
        </div>
        <div sclass="z-d-contents">
            <div sclass="z-text-sm z-text-secondary">Toolbar mold</div>
            <div>
                <combobutton label="Options" mold="toolbar">
                    <menupopup>
                        <menuitem label="Edit"/>
                        <menuitem label="Delete"/>
                    </menupopup>
                </combobutton>
            </div>
            <div>
                <combobutton label="Options" mold="toolbar" disabled="true">
                    <menupopup><menuitem label="Edit"/></menupopup>
                </combobutton>
            </div>
        </div>
    </div>

    <div sclass="z-mb-6">
        <div sclass="z-text-xs z-fw-semibold z-text-uppercase z-text-secondary z-border-bottom z-pb-2 z-mb-4">Popup Child + Image + Reverse</div>
        <div sclass="z-d-flex z-align-start z-flex-wrap z-gap-6 z-py-3">
            <div sclass="z-d-flex z-flex-col z-align-start z-gap-2">
                <div sclass="z-text-xs z-text-secondary">Popup child + image</div>
                <combobutton label="Actions" image="~./img/Centigrade-Widget-Icons/BookBlue-16x16.png">
                    <popup width="200px">
                        <vbox>
                            <label value="Custom popup body"/>
                            <button label="Inner"/>
                        </vbox>
                    </popup>
                </combobutton>
            </div>
            <div sclass="z-d-flex z-flex-col z-align-start z-gap-2">
                <div sclass="z-text-xs z-text-secondary">dir="reverse" (label first, image after)</div>
                <combobutton label="Actions" image="~./img/Centigrade-Widget-Icons/BookBlue-16x16.png" dir="reverse">
                    <menupopup>
                        <menuitem label="One"/>
                    </menupopup>
                </combobutton>
            </div>
        </div>
    </div>
</div>
</zk>
