<?page title="Component Theming API" contentType="text/html;charset=UTF-8"?>
<zk xmlns:h="native">
<div sclass="z-p-8">
    <div sclass="z-border-bottom z-text-xl z-fw-medium z-text-on-surface z-mb-8 z-pb-3">Component Theming API</div>

    <div sclass="z-text-sm z-text-secondary z-mb-8" style="max-width:60ch">
        Adopters restyle one component by setting its --zk-&lt;comp&gt;-* custom properties,
        either at :root (whole app) or on any container element (one region — descendants inherit it).
        Each pair below shows a stock "Default" and a scoped override box; the defaults reproduce
        stock Marble exactly. Pilot components: button, input, window, grid.
        See doc/spec/component-theming-api.md.
    </div>

    <!-- Default: no override — proves zero regression -->
    <div sclass="z-text-xs z-fw-semibold z-text-uppercase z-text-secondary z-mb-3">Default (no override)</div>
    <div sclass="z-hstack z-mb-8">
        <button label="Default Primary"/>
        <button label="Default Icon" iconSclass="z-icon-settings"/>
        <button label="Default Disabled" disabled="true"/>
    </div>

    <!-- Regional override: pill radius + purple fill, scoped to THIS container only.
         The buttons above are unaffected (override lives on this box, inherited only by its subtree). -->
    <div sclass="z-text-xs z-fw-semibold z-text-uppercase z-text-secondary z-mb-3">Regional override (scoped to this box)</div>
    <div sclass="z-hstack z-mb-8 z-p-4 z-bg-surface-variant z-rounded"
         style="--zk-button-bg:#6750a4; --zk-button-fg:#ffffff; --zk-button-overlay-color:#ffffff; --zk-button-radius:9999px">
        <button label="Scoped Primary"/>
        <button label="Scoped Icon" iconSclass="z-icon-settings"/>
        <button label="Scoped Disabled" disabled="true"/>
    </div>

    <!-- Input: per-state border-color + surface knobs -->
    <div sclass="z-text-xs z-fw-semibold z-text-uppercase z-text-secondary z-mb-3">Input (default)</div>
    <div sclass="z-hstack z-mb-6">
        <textbox value="Default field"/>
    </div>
    <div sclass="z-text-xs z-fw-semibold z-text-uppercase z-text-secondary z-mb-3">Input (regional override)</div>
    <div sclass="z-hstack z-mb-8 z-p-4 z-bg-surface-variant z-rounded"
         style="--zk-input-radius:12px; --zk-input-border-color:#6750a4; --zk-input-border-color-hover:#6750a4">
        <textbox value="Scoped field"/>
    </div>

    <!-- Window: surface + chrome knobs (elevation stays mode-driven) -->
    <div sclass="z-text-xs z-fw-semibold z-text-uppercase z-text-secondary z-mb-3">Window (default)</div>
    <div sclass="z-mb-6">
        <window title="Default Window" border="normal" width="260px">
            <div sclass="z-p-4">Body content</div>
        </window>
    </div>
    <div sclass="z-text-xs z-fw-semibold z-text-uppercase z-text-secondary z-mb-3">Window (regional override)</div>
    <div sclass="z-mb-8 z-p-4 z-bg-surface-variant z-rounded"
         style="--zk-window-radius:16px; --zk-window-bg:#eef2ff; --zk-window-border-color:#6750a4">
        <window title="Scoped Window" border="normal" width="260px">
            <div sclass="z-p-4">Body content</div>
        </window>
    </div>

    <!-- Grid: outlined-table lines + fills -->
    <div sclass="z-text-xs z-fw-semibold z-text-uppercase z-text-secondary z-mb-3">Grid (default)</div>
    <div sclass="z-mb-6">
        <grid width="320px">
            <columns>
                <column label="Name"/>
                <column label="Value"/>
            </columns>
            <rows>
                <row><label value="Alpha"/><label value="1"/></row>
                <row><label value="Beta"/><label value="2"/></row>
                <row><label value="Gamma"/><label value="3"/></row>
            </rows>
        </grid>
    </div>
    <div sclass="z-text-xs z-fw-semibold z-text-uppercase z-text-secondary z-mb-3">Grid (regional override)</div>
    <div sclass="z-mb-8 z-p-4 z-bg-surface-variant z-rounded"
         style="--zk-grid-radius:0px; --zk-grid-border-color:#6750a4; --zk-grid-stripe-bg:#efe6ff">
        <grid width="320px">
            <columns>
                <column label="Name"/>
                <column label="Value"/>
            </columns>
            <rows>
                <row><label value="Alpha"/><label value="1"/></row>
                <row><label value="Beta"/><label value="2"/></row>
                <row><label value="Gamma"/><label value="3"/></row>
            </rows>
        </grid>
    </div>

    <!-- Listbox: data table + row selection knobs -->
    <div sclass="z-text-xs z-fw-semibold z-text-uppercase z-text-secondary z-mb-3">Listbox (default)</div>
    <div sclass="z-mb-6">
        <listbox width="320px">
            <listhead>
                <listheader label="Name"/>
                <listheader label="Value"/>
            </listhead>
            <listitem selected="true"><listcell label="Alpha"/><listcell label="1"/></listitem>
            <listitem><listcell label="Beta"/><listcell label="2"/></listitem>
            <listitem><listcell label="Gamma"/><listcell label="3"/></listitem>
        </listbox>
    </div>
    <div sclass="z-text-xs z-fw-semibold z-text-uppercase z-text-secondary z-mb-3">Listbox (regional override)</div>
    <div sclass="z-mb-8 z-p-4 z-bg-surface-variant z-rounded"
         style="--zk-listbox-radius:0px; --zk-listbox-border-color:#6750a4; --zk-listbox-selected-bg:#6750a4; --zk-listbox-selected-fg:#ffffff">
        <listbox width="320px">
            <listhead>
                <listheader label="Name"/>
                <listheader label="Value"/>
            </listhead>
            <listitem selected="true"><listcell label="Alpha"/><listcell label="1"/></listitem>
            <listitem><listcell label="Beta"/><listcell label="2"/></listitem>
            <listitem><listcell label="Gamma"/><listcell label="3"/></listitem>
        </listbox>
    </div>

    <!-- Tree: tree table + row selection knobs -->
    <div sclass="z-text-xs z-fw-semibold z-text-uppercase z-text-secondary z-mb-3">Tree (default)</div>
    <div sclass="z-mb-6">
        <tree width="320px">
            <treecols>
                <treecol label="Name"/>
                <treecol label="Type"/>
            </treecols>
            <treechildren>
                <treeitem selected="true">
                    <treerow><treecell label="Root"/><treecell label="folder"/></treerow>
                </treeitem>
                <treeitem>
                    <treerow><treecell label="Leaf"/><treecell label="file"/></treerow>
                </treeitem>
            </treechildren>
        </tree>
    </div>
    <div sclass="z-text-xs z-fw-semibold z-text-uppercase z-text-secondary z-mb-3">Tree (regional override)</div>
    <div sclass="z-mb-8 z-p-4 z-bg-surface-variant z-rounded"
         style="--zk-tree-radius:0px; --zk-tree-border-color:#6750a4; --zk-tree-selected-bg:#6750a4; --zk-tree-selected-fg:#ffffff">
        <tree width="320px">
            <treecols>
                <treecol label="Name"/>
                <treecol label="Type"/>
            </treecols>
            <treechildren>
                <treeitem selected="true">
                    <treerow><treecell label="Root"/><treecell label="folder"/></treerow>
                </treeitem>
                <treeitem>
                    <treerow><treecell label="Leaf"/><treecell label="file"/></treerow>
                </treeitem>
            </treechildren>
        </tree>
    </div>

    <!-- Panel: card surface + header (window-like, with elevation) -->
    <div sclass="z-text-xs z-fw-semibold z-text-uppercase z-text-secondary z-mb-3">Panel (default)</div>
    <div sclass="z-mb-6">
        <panel border="rounded" width="260px">
            <caption label="Default Panel"/>
            <panelchildren><div sclass="z-p-2">Body content</div></panelchildren>
        </panel>
    </div>
    <div sclass="z-text-xs z-fw-semibold z-text-uppercase z-text-secondary z-mb-3">Panel (regional override)</div>
    <div sclass="z-mb-8 z-p-4 z-bg-surface-variant z-rounded"
         style="--zk-panel-radius:0px; --zk-panel-border-color:#6750a4; --zk-panel-bg:#eef2ff">
        <panel border="rounded" width="260px">
            <caption label="Scoped Panel"/>
            <panelchildren><div sclass="z-p-2">Body content</div></panelchildren>
        </panel>
    </div>

    <!-- Groupbox: bordered container + header -->
    <div sclass="z-text-xs z-fw-semibold z-text-uppercase z-text-secondary z-mb-3">Groupbox (default)</div>
    <div sclass="z-mb-6">
        <groupbox width="260px">
            <caption label="Default Group"/>
            <div sclass="z-p-2">Body content</div>
        </groupbox>
    </div>
    <div sclass="z-text-xs z-fw-semibold z-text-uppercase z-text-secondary z-mb-3">Groupbox (regional override)</div>
    <div sclass="z-mb-8 z-p-4 z-bg-surface-variant z-rounded"
         style="--zk-groupbox-radius:0px; --zk-groupbox-border-color:#6750a4">
        <groupbox width="260px">
            <caption label="Scoped Group"/>
            <div sclass="z-p-2">Body content</div>
        </groupbox>
    </div>

    <!-- Combobox: outlined field + dropdown popup + option selection -->
    <div sclass="z-text-xs z-fw-semibold z-text-uppercase z-text-secondary z-mb-3">Combobox (default)</div>
    <div sclass="z-hstack z-mb-6">
        <combobox width="200px">
            <comboitem label="Alpha"/>
            <comboitem label="Beta"/>
            <comboitem label="Gamma"/>
        </combobox>
    </div>
    <div sclass="z-text-xs z-fw-semibold z-text-uppercase z-text-secondary z-mb-3">Combobox (regional override)</div>
    <div sclass="z-hstack z-mb-8 z-p-4 z-bg-surface-variant z-rounded"
         style="--zk-combobox-radius:0px; --zk-combobox-border-color:#6750a4; --zk-combobox-selected-bg:#6750a4; --zk-combobox-selected-fg:#ffffff">
        <combobox width="200px">
            <comboitem label="Alpha"/>
            <comboitem label="Beta"/>
            <comboitem label="Gamma"/>
        </combobox>
    </div>

    <!-- Tab (tabbox): nav chrome + active accent -->
    <div sclass="z-text-xs z-fw-semibold z-text-uppercase z-text-secondary z-mb-3">Tabbox (default)</div>
    <div sclass="z-mb-6">
        <tabbox width="320px">
            <tabs><tab label="One"/><tab label="Two"/><tab label="Three"/></tabs>
            <tabpanels><tabpanel>One</tabpanel><tabpanel>Two</tabpanel><tabpanel>Three</tabpanel></tabpanels>
        </tabbox>
    </div>
    <div sclass="z-text-xs z-fw-semibold z-text-uppercase z-text-secondary z-mb-3">Tabbox (regional override)</div>
    <div sclass="z-mb-8 z-p-4 z-bg-surface-variant z-rounded"
         style="--zk-tab-border-color:#6750a4; --zk-tab-accent:#6750a4">
        <tabbox width="320px">
            <tabs><tab label="One"/><tab label="Two"/><tab label="Three"/></tabs>
            <tabpanels><tabpanel>One</tabpanel><tabpanel>Two</tabpanel><tabpanel>Three</tabpanel></tabpanels>
        </tabbox>
    </div>

    <!-- Menu: menubar surface + dropdown popup + selected item -->
    <div sclass="z-text-xs z-fw-semibold z-text-uppercase z-text-secondary z-mb-3">Menubar (default)</div>
    <div sclass="z-mb-6">
        <menubar width="320px">
            <menu label="File"><menupopup><menuitem label="New"/><menuitem label="Open"/></menupopup></menu>
            <menu label="Edit"><menupopup><menuitem label="Cut"/></menupopup></menu>
        </menubar>
    </div>
    <div sclass="z-text-xs z-fw-semibold z-text-uppercase z-text-secondary z-mb-3">Menubar (regional override)</div>
    <div sclass="z-mb-8 z-p-4 z-bg-surface-variant z-rounded" style="--zk-menubar-bg:#6750a4">
        <menubar width="320px">
            <menu label="File"><menupopup><menuitem label="New"/><menuitem label="Open"/></menupopup></menu>
            <menu label="Edit"><menupopup><menuitem label="Cut"/></menupopup></menu>
        </menubar>
    </div>
</div>
</zk>
