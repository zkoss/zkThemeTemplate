<?page title="Borderlayout — Misc" contentType="text/html;charset=UTF-8"?>
<zk xmlns:h="native">
<h:link rel="stylesheet" href="pv.css"/>
<div sclass="z-p-8">
    <div sclass="z-border-bottom z-fs-title-lg z-fw-medium z-text-on-surface z-mb-8 z-pb-3">Borderlayout — Misc</div>

    <div sclass="z-mb-6">
        <div sclass="z-fs-label-sm z-fw-semibold z-text-uppercase z-text-secondary z-border-bottom z-pb-2 z-mb-4">With Region Titles</div>
        <div sclass="z-py-3">
            <window title="Simple Title" border="normal" width="300px" height="300px">
                <borderlayout>
                    <center title="Center">Center Content</center>
                    <north size="20%" title="North">North Content</north>
                    <south size="20%" title="South">South Content</south>
                    <east size="20%" title="East">East Content</east>
                    <west size="20%" title="West">West Content</west>
                </borderlayout>
            </window>
        </div>
    </div>

    <div sclass="z-mb-6">
        <div sclass="z-fs-label-sm z-fw-semibold z-text-uppercase z-text-secondary z-border-bottom z-pb-2 z-mb-4">No Region Borders</div>
        <div sclass="z-py-3">
            <window title="No Border" border="normal" width="300px" height="300px">
                <borderlayout>
                    <center border="none">Center Content</center>
                    <north size="20%" border="none">North Content</north>
                    <south size="20%" border="none">South Content</south>
                    <east size="20%" border="none">East Content</east>
                    <west size="20%" border="none">West Content</west>
                </borderlayout>
            </window>
        </div>
    </div>

    <div sclass="z-mb-6">
        <div sclass="z-fs-label-sm z-fw-semibold z-text-uppercase z-text-secondary z-border-bottom z-pb-2 z-mb-4">Auto Scroll and Margins</div>
        <div sclass="z-d-flex z-align-end z-flex-wrap z-gap-6 z-py-3">
            <div sclass="z-d-flex z-flex-col z-align-start z-gap-2">
                <window title="Auto Scroll" border="normal" width="300px" height="300px">
                    <borderlayout xmlns:ca="client/attribute">
                        <center autoscroll="true" ca:data-embedscrollbar="true">
                            <vbox id="box">
                                <label value="Center" />
                                <label value="Content" />
                                <label value="is" />
                                <label value="very" />
                                <label value="very" />
                                <label value="very" />
                                <label value="very" />
                                <label value="very" />
                                <label value="long" />
                                <label value="long" />
                                <label value="long" />
                            </vbox>
                        </center>
                        <north size="20%">North Content</north>
                        <south size="20%">South Content</south>
                        <east size="20%">East Content</east>
                        <west size="20%">West Content</west>
                    </borderlayout>
                </window>
                <div sclass="z-fs-label-sm z-text-secondary">autoscroll="true"</div>
            </div>
            <div sclass="z-d-flex z-flex-col z-align-start z-gap-2">
                <window title="Margins: 10px" border="normal" width="300px" height="300px">
                    <borderlayout>
                        <center margins="10,10,10,10">Center Content</center>
                        <north size="20%">North Content</north>
                        <south size="20%">South Content</south>
                        <east size="20%">East Content</east>
                        <west size="20%">West Content</west>
                    </borderlayout>
                </window>
                <div sclass="z-fs-label-sm z-text-secondary">center margins="10,10,10,10"</div>
            </div>
            <div sclass="z-d-flex z-flex-col z-align-start z-gap-2">
                <window title="Cmargins: 10px" border="normal" width="300px" height="300px">
                    <borderlayout>
                        <center>Center Content</center>
                        <north size="20%">North Content</north>
                        <south size="20%">South Content</south>
                        <east title="East" size="20%" collapsible="true" cmargins="10,10,10,10">East Content</east>
                        <west title="West" size="20%" collapsible="true" cmargins="10,10,10,10">West Content</west>
                    </borderlayout>
                </window>
                <div sclass="z-fs-label-sm z-text-secondary">east/west cmargins="10,10,10,10"</div>
            </div>
        </div>
    </div>

</div>
</zk>
