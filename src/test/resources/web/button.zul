<?page title="Button" contentType="text/html;charset=UTF-8"?>
<zk xmlns:h="native">
<div sclass="z-p-8">
    <div sclass="z-border-bottom z-mb-8 z-pb-3"><label sclass="z-text-2xl z-fw-medium z-text-on-surface" value="Button"/></div>

    <div sclass="z-mb-6 z-d-grid z-grid-cols-auto z-overflow-x-auto z-gap-x-6 z-gap-y-2 z-items-start" style="--zk-cols:2; --zk-col-min:min-content">
        <div sclass="z-grid-col-full z-text-uppercase z-border-bottom z-pb-2 z-mb-4"><label sclass="z-text-xs z-fw-semibold z-text-secondary" value="States"/></div>
        <div sclass="z-d-contents">
            <div/>
            <div><label sclass="z-text-xs z-fw-semibold z-text-secondary" value="Default"/></div>
            <div><label sclass="z-text-xs z-fw-semibold z-text-secondary" value="Disabled"/></div>
        </div>
        <div sclass="z-d-contents">
            <div><label sclass="z-text-sm z-text-secondary" value="Text only"/></div>
            <div><button label="Button"/></div>
            <div><button label="Button" disabled="true"/></div>
        </div>
        <div sclass="z-d-contents">
            <div><label sclass="z-text-sm z-text-secondary" value="With icon"/></div>
            <div><button label="Button" iconSclass="z-icon-volume-2"/></div>
            <div><button label="Button" iconSclass="z-icon-volume-2" disabled="true"/></div>
        </div>
        <div sclass="z-d-contents">
            <div><label sclass="z-text-sm z-text-secondary" value="Icon only"/></div>
            <div><button iconSclass="z-icon-settings"/></div>
            <div><button iconSclass="z-icon-settings" disabled="true"/></div>
        </div>
        <div sclass="z-d-contents">
            <div><label sclass="z-text-sm z-text-secondary" value="Vertical"/></div>
            <div><button label="Button" orient="vertical" iconSclass="z-icon-settings"/></div>
            <div><button label="Button" orient="vertical" iconSclass="z-icon-settings" disabled="true"/></div>
        </div>
        <div sclass="z-d-contents">
            <div><label sclass="z-text-sm z-text-secondary" value="Long label"/></div>
            <div><button label="Long Long Button"/></div>
            <div><button label="Long Long Button" disabled="true"/></div>
        </div>
        <div sclass="z-d-contents">
            <div><label sclass="z-text-sm z-text-secondary" value="Outlined"/></div>
            <div><button label="Button" sclass="z-button-outlined"/></div>
            <div><button label="Button" sclass="z-button-outlined" disabled="true"/></div>
        </div>
        <div sclass="z-d-contents">
            <div><label sclass="z-text-sm z-text-secondary" value="Text"/></div>
            <div><button label="Button" sclass="z-button-text"/></div>
            <div><button label="Button" sclass="z-button-text" disabled="true"/></div>
        </div>
    </div>

    <div sclass="z-mb-6 z-d-grid z-grid-cols-auto z-overflow-x-auto z-gap-x-6 z-gap-y-2 z-items-start" style="--zk-cols:2; --zk-col-min:min-content">
        <div sclass="z-grid-col-full z-text-uppercase z-border-bottom z-pb-2 z-mb-4"><label sclass="z-text-xs z-fw-semibold z-text-secondary" value="Colors"/></div>
        <div sclass="z-d-contents">
            <div/>
            <div><label sclass="z-text-xs z-fw-semibold z-text-secondary" value="Default"/></div>
            <div><label sclass="z-text-xs z-fw-semibold z-text-secondary" value="Disabled"/></div>
        </div>
        <div style="grid-column:1/-1" sclass="z-mt-1 z-mb-1"><label sclass="z-text-xs z-text-secondary" value="Contained"/></div>
        <div sclass="z-d-contents">
            <div><label sclass="z-text-sm z-text-secondary" value="Secondary"/></div>
            <div><button label="Button" sclass="z-button-secondary"/></div>
            <div><button label="Button" sclass="z-button-secondary" disabled="true"/></div>
        </div>
        <div sclass="z-d-contents">
            <div><label sclass="z-text-sm z-text-secondary" value="Success"/></div>
            <div><button label="Button" sclass="z-button-success"/></div>
            <div><button label="Button" sclass="z-button-success" disabled="true"/></div>
        </div>
        <div sclass="z-d-contents">
            <div><label sclass="z-text-sm z-text-secondary" value="Warning"/></div>
            <div><button label="Button" sclass="z-button-warning"/></div>
            <div><button label="Button" sclass="z-button-warning" disabled="true"/></div>
        </div>
        <div sclass="z-d-contents">
            <div><label sclass="z-text-sm z-text-secondary" value="Error"/></div>
            <div><button label="Button" sclass="z-button-error"/></div>
            <div><button label="Button" sclass="z-button-error" disabled="true"/></div>
        </div>
        <div sclass="z-d-contents">
            <div><label sclass="z-text-sm z-text-secondary" value="Info"/></div>
            <div><button label="Button" sclass="z-button-info"/></div>
            <div><button label="Button" sclass="z-button-info" disabled="true"/></div>
        </div>
        <div style="grid-column:1/-1" sclass="z-mt-3 z-mb-1"><label sclass="z-text-xs z-text-secondary" value="Outlined"/></div>
        <div sclass="z-d-contents">
            <div><label sclass="z-text-sm z-text-secondary" value="Secondary"/></div>
            <div><button label="Button" sclass="z-button-outlined-secondary"/></div>
            <div><button label="Button" sclass="z-button-outlined-secondary" disabled="true"/></div>
        </div>
        <div sclass="z-d-contents">
            <div><label sclass="z-text-sm z-text-secondary" value="Success"/></div>
            <div><button label="Button" sclass="z-button-outlined-success"/></div>
            <div><button label="Button" sclass="z-button-outlined-success" disabled="true"/></div>
        </div>
        <div sclass="z-d-contents">
            <div><label sclass="z-text-sm z-text-secondary" value="Warning"/></div>
            <div><button label="Button" sclass="z-button-outlined-warning"/></div>
            <div><button label="Button" sclass="z-button-outlined-warning" disabled="true"/></div>
        </div>
        <div sclass="z-d-contents">
            <div><label sclass="z-text-sm z-text-secondary" value="Error"/></div>
            <div><button label="Button" sclass="z-button-outlined-error"/></div>
            <div><button label="Button" sclass="z-button-outlined-error" disabled="true"/></div>
        </div>
        <div sclass="z-d-contents">
            <div><label sclass="z-text-sm z-text-secondary" value="Info"/></div>
            <div><button label="Button" sclass="z-button-outlined-info"/></div>
            <div><button label="Button" sclass="z-button-outlined-info" disabled="true"/></div>
        </div>
        <div style="grid-column:1/-1" sclass="z-mt-3 z-mb-1"><label sclass="z-text-xs z-text-secondary" value="Text"/></div>
        <div sclass="z-d-contents">
            <div><label sclass="z-text-sm z-text-secondary" value="Secondary"/></div>
            <div><button label="Button" sclass="z-button-text-secondary"/></div>
            <div><button label="Button" sclass="z-button-text-secondary" disabled="true"/></div>
        </div>
        <div sclass="z-d-contents">
            <div><label sclass="z-text-sm z-text-secondary" value="Success"/></div>
            <div><button label="Button" sclass="z-button-text-success"/></div>
            <div><button label="Button" sclass="z-button-text-success" disabled="true"/></div>
        </div>
        <div sclass="z-d-contents">
            <div><label sclass="z-text-sm z-text-secondary" value="Warning"/></div>
            <div><button label="Button" sclass="z-button-text-warning"/></div>
            <div><button label="Button" sclass="z-button-text-warning" disabled="true"/></div>
        </div>
        <div sclass="z-d-contents">
            <div><label sclass="z-text-sm z-text-secondary" value="Error"/></div>
            <div><button label="Button" sclass="z-button-text-error"/></div>
            <div><button label="Button" sclass="z-button-text-error" disabled="true"/></div>
        </div>
        <div sclass="z-d-contents">
            <div><label sclass="z-text-sm z-text-secondary" value="Info"/></div>
            <div><button label="Button" sclass="z-button-text-info"/></div>
            <div><button label="Button" sclass="z-button-text-info" disabled="true"/></div>
        </div>
    </div>

    <div sclass="z-mb-6">
        <div sclass="z-text-uppercase z-border-bottom z-pb-2 z-mb-4"><label sclass="z-text-xs z-fw-semibold z-text-secondary" value="Image + Reverse Direction"/></div>
        <div sclass="z-d-flex z-items-start z-flex-wrap z-gap-6 z-py-3">
            <div sclass="z-d-flex z-flex-col z-items-start z-gap-2">
                <div><label sclass="z-text-xs z-text-secondary" value="Image (icon before label)"/></div>
                <button label="Save" image="~./img/Centigrade-Widget-Icons/DisketteBlack-16x16.png"/>
            </div>
            <div sclass="z-d-flex z-flex-col z-items-start z-gap-2">
                <div><label sclass="z-text-xs z-text-secondary" value="dir=&quot;reverse&quot; (label first, image after)"/></div>
                <button label="Save" image="~./img/Centigrade-Widget-Icons/DisketteBlack-16x16.png" dir="reverse"/>
            </div>
        </div>
    </div>

    <div sclass="z-mb-6">
        <div sclass="z-text-uppercase z-border-bottom z-pb-2 z-mb-4"><label sclass="z-text-xs z-fw-semibold z-text-secondary" value="Sizes"/></div>
        <div sclass="z-d-flex z-items-start z-flex-wrap z-gap-6 z-py-3">
            <div sclass="z-d-flex z-flex-col z-items-start z-gap-2">
                <div><label sclass="z-text-xs z-text-secondary" value="Small"/></div>
                <button label="Button" sclass="z-button-sm"/>
            </div>
            <div sclass="z-d-flex z-flex-col z-items-start z-gap-2">
                <div><label sclass="z-text-xs z-text-secondary" value="Default"/></div>
                <button label="Button"/>
            </div>
            <div sclass="z-d-flex z-flex-col z-items-start z-gap-2">
                <div><label sclass="z-text-xs z-text-secondary" value="Large"/></div>
                <button label="Button" sclass="z-button-lg"/>
            </div>
        </div>
    </div>
</div>
</zk>
