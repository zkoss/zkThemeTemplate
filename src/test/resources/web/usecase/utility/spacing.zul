<?page title="Spacing Utilities"?>
<zk>
<style src="~./usecase/usecase.css"/>
<style>
.u-demo-box {
    background: var(--zk-color-primary-container);
    border-radius: 4px;
    font-size: 11px;
    font-weight: 500;
    color: var(--zk-color-on-primary-container);
    white-space: nowrap;
    min-width: 8px;
    min-height: 8px;
}
.u-demo-outer {
    background: var(--zk-color-secondary-container, #e8eaf6);
    border-radius: 4px;
    display: inline-block;
}
</style>
<vlayout hflex="1" sclass="page-content">

    <toolbar>
        <label value="Spacing Utilities" sclass="z-h2"/>
    </toolbar>

    <!-- Scale reference -->
    <div sclass="section-card">
        <label value="Spacing Scale" sclass="section-title"/>
        <label value="All spacing utilities use the 4 dp baseline grid." sclass="z-text-secondary z-fs-body-sm z-mb-3"/>
        <div style="display:grid;grid-template-columns:repeat(8,1fr);gap:12px;text-align:center">
            <div>
                <div class="u-demo-outer"><div sclass="u-demo-box z-p-0" style="min-width:32px;min-height:32px"/></div>
                <div sclass="z-text-muted z-fs-label-sm z-mt-1">
                    <label value="z-*-0" sclass="z-d-block"/>
                    <label value="0px" sclass="z-d-block"/>
                </div>
            </div>
            <div>
                <div class="u-demo-outer"><div sclass="u-demo-box z-p-1"/></div>
                <div sclass="z-text-muted z-fs-label-sm z-mt-1">
                    <label value="z-*-1" sclass="z-d-block"/>
                    <label value="4px" sclass="z-d-block"/>
                </div>
            </div>
            <div>
                <div class="u-demo-outer"><div sclass="u-demo-box z-p-2"/></div>
                <div sclass="z-text-muted z-fs-label-sm z-mt-1">
                    <label value="z-*-2" sclass="z-d-block"/>
                    <label value="8px" sclass="z-d-block"/>
                </div>
            </div>
            <div>
                <div class="u-demo-outer"><div sclass="u-demo-box z-p-3"/></div>
                <div sclass="z-text-muted z-fs-label-sm z-mt-1">
                    <label value="z-*-3" sclass="z-d-block"/>
                    <label value="12px" sclass="z-d-block"/>
                </div>
            </div>
            <div>
                <div class="u-demo-outer"><div sclass="u-demo-box z-p-4"/></div>
                <div sclass="z-text-muted z-fs-label-sm z-mt-1">
                    <label value="z-*-4" sclass="z-d-block"/>
                    <label value="16px" sclass="z-d-block"/>
                </div>
            </div>
            <div>
                <div class="u-demo-outer"><div sclass="u-demo-box z-p-5"/></div>
                <div sclass="z-text-muted z-fs-label-sm z-mt-1">
                    <label value="z-*-5" sclass="z-d-block"/>
                    <label value="20px" sclass="z-d-block"/>
                </div>
            </div>
            <div>
                <div class="u-demo-outer"><div sclass="u-demo-box z-p-6"/></div>
                <div sclass="z-text-muted z-fs-label-sm z-mt-1">
                    <label value="z-*-6" sclass="z-d-block"/>
                    <label value="24px" sclass="z-d-block"/>
                </div>
            </div>
            <div>
                <div class="u-demo-outer"><div sclass="u-demo-box z-p-8"/></div>
                <div sclass="z-text-muted z-fs-label-sm z-mt-1">
                    <label value="z-*-8" sclass="z-d-block"/>
                    <label value="32px" sclass="z-d-block"/>
                </div>
            </div>
        </div>
    </div>

    <!-- Padding -->
    <div sclass="section-card">
        <label value="Padding  (.z-p-* / .z-px-* / .z-py-* / .z-pt-* / .z-pb-* / .z-ps-* / .z-pe-*)" sclass="section-title"/>
        <div sclass="z-d-flex z-gap-4 z-flex-wrap">
            <div style="text-align:center">
                <div class="u-demo-outer"><div sclass="u-demo-box z-p-4"><label value="z-p-4"/></div></div>
                <label value="all sides" sclass="z-text-muted z-fs-label-sm z-d-block z-mt-1"/>
            </div>
            <div style="text-align:center">
                <div class="u-demo-outer"><div sclass="u-demo-box z-px-6 z-py-1"><label value="z-px-6 z-py-1"/></div></div>
                <label value="horizontal / vertical" sclass="z-text-muted z-fs-label-sm z-d-block z-mt-1"/>
            </div>
            <div style="text-align:center">
                <div class="u-demo-outer"><div sclass="u-demo-box z-pt-6 z-pb-1 z-px-3"><label value="z-pt-6 z-pb-1"/></div></div>
                <label value="top / bottom" sclass="z-text-muted z-fs-label-sm z-d-block z-mt-1"/>
            </div>
            <div style="text-align:center">
                <div class="u-demo-outer"><div sclass="u-demo-box z-ps-6 z-pe-2 z-py-2"><label value="z-ps-6 z-pe-2"/></div></div>
                <label value="inline-start / end" sclass="z-text-muted z-fs-label-sm z-d-block z-mt-1"/>
            </div>
        </div>
    </div>

    <!-- Margin -->
    <div sclass="section-card">
        <label value="Margin  (.z-m-* / .z-mx-* / .z-my-* / .z-mt-* / .z-mb-* / .z-ms-* / .z-me-*)" sclass="section-title"/>
        <label value="Each box below has the utility class applied — the gap between boxes shows the margin." sclass="z-text-secondary z-fs-body-sm z-mb-3"/>
        <div sclass="z-bg-surface-variant z-p-2 z-rounded-md" style="display:inline-block">
            <div sclass="u-demo-box" style="display:inline-block;padding:8px 12px"><label value="z-mt-0"/></div>
            <div sclass="u-demo-box z-mt-4" style="display:inline-block;padding:8px 12px"><label value="z-mt-4"/></div>
            <div sclass="u-demo-box z-mt-8" style="display:inline-block;padding:8px 12px"><label value="z-mt-8"/></div>
        </div>
        <div sclass="z-mt-4 z-bg-surface-variant z-p-2 z-rounded-md z-d-flex">
            <div sclass="u-demo-box z-me-0" style="padding:8px 12px"><label value="z-me-0"/></div>
            <div sclass="u-demo-box z-ms-4" style="padding:8px 12px"><label value="z-ms-4"/></div>
            <div sclass="u-demo-box z-ms-8" style="padding:8px 12px"><label value="z-ms-8"/></div>
        </div>
        <div sclass="z-mt-4">
            <div sclass="u-demo-box z-mx-auto" style="padding:8px 12px;display:block;width:fit-content"><label value="z-mx-auto (centered)"/></div>
        </div>
    </div>

    <!-- Class reference table -->
    <div sclass="section-card">
        <label value="Padding Class Reference" sclass="section-title"/>
        <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(140px,1fr));gap:4px 16px">
            <label value=".z-p-0 — 0" sclass="z-fs-label-md z-text-secondary"/>
            <label value=".z-px-0 — 0" sclass="z-fs-label-md z-text-secondary"/>
            <label value=".z-p-1 — 4px" sclass="z-fs-label-md z-text-secondary"/>
            <label value=".z-px-1 — 4px" sclass="z-fs-label-md z-text-secondary"/>
            <label value=".z-p-2 — 8px" sclass="z-fs-label-md z-text-secondary"/>
            <label value=".z-px-2 — 8px" sclass="z-fs-label-md z-text-secondary"/>
            <label value=".z-p-3 — 12px" sclass="z-fs-label-md z-text-secondary"/>
            <label value=".z-px-3 — 12px" sclass="z-fs-label-md z-text-secondary"/>
            <label value=".z-p-4 — 16px" sclass="z-fs-label-md z-text-secondary"/>
            <label value=".z-px-4 — 16px" sclass="z-fs-label-md z-text-secondary"/>
            <label value=".z-p-5 — 20px" sclass="z-fs-label-md z-text-secondary"/>
            <label value=".z-px-5 — 20px" sclass="z-fs-label-md z-text-secondary"/>
            <label value=".z-p-6 — 24px" sclass="z-fs-label-md z-text-secondary"/>
            <label value=".z-px-6 — 24px" sclass="z-fs-label-md z-text-secondary"/>
            <label value=".z-p-8 — 32px" sclass="z-fs-label-md z-text-secondary"/>
            <label value=".z-px-8 — 32px" sclass="z-fs-label-md z-text-secondary"/>
        </div>
    </div>

</vlayout>
</zk>
