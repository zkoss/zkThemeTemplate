<?page title="Typography Utilities"?>
<zk>
<style src="~./usecase/usecase.css"/>
<vlayout hflex="1" sclass="page-content">

    <toolbar>
        <label value="Typography Utilities" sclass="z-h2"/>
    </toolbar>

    <!-- Heading Utilities -->
    <div sclass="section-card">
        <label value="Heading Utilities  (.z-h1 — .z-h7)" sclass="section-title"/>
        <vlayout>
            <div sclass="z-d-flex z-align-baseline z-gap-3">
                <label value="Heading 1 — Display Large" sclass="z-h1"/>
                <label value=".z-h1  2rem / 700" sclass="z-text-muted z-fs-label-md"/>
            </div>
            <div sclass="z-d-flex z-align-baseline z-gap-3">
                <label value="Heading 2 — Display Medium" sclass="z-h2"/>
                <label value=".z-h2  1.75rem / 700" sclass="z-text-muted z-fs-label-md"/>
            </div>
            <div sclass="z-d-flex z-align-baseline z-gap-3">
                <label value="Heading 3 — Headline Large" sclass="z-h3"/>
                <label value=".z-h3  1.5rem / 600" sclass="z-text-muted z-fs-label-md"/>
            </div>
            <div sclass="z-d-flex z-align-baseline z-gap-3">
                <label value="Heading 4 — Headline Small" sclass="z-h4"/>
                <label value=".z-h4  1.25rem / 600" sclass="z-text-muted z-fs-label-md"/>
            </div>
            <div sclass="z-d-flex z-align-baseline z-gap-3">
                <label value="Heading 5 — Title Large" sclass="z-h5"/>
                <label value=".z-h5  1.125rem / 600" sclass="z-text-muted z-fs-label-md"/>
            </div>
            <div sclass="z-d-flex z-align-baseline z-gap-3">
                <label value="Heading 6 — Title Small" sclass="z-h6"/>
                <label value=".z-h6  0.875rem / 600" sclass="z-text-muted z-fs-label-md"/>
            </div>
            <div sclass="z-d-flex z-align-baseline z-gap-3">
                <label value="Heading 7 — Label Large" sclass="z-h7"/>
                <label value=".z-h7  0.75rem / 500" sclass="z-text-muted z-fs-label-md"/>
            </div>
        </vlayout>
    </div>

    <!-- MD3 Type Scale -->
    <div sclass="section-card">
        <label value="MD3 Font Size Scale  (.z-fs-*)" sclass="section-title"/>
        <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:8px 24px">
            <div sclass="z-d-flex z-align-baseline z-gap-2"><label value="Aa" sclass="z-fs-display-lg"/><label value=".z-fs-display-lg" sclass="z-text-muted z-fs-label-sm"/></div>
            <div sclass="z-d-flex z-align-baseline z-gap-2"><label value="Aa" sclass="z-fs-display-md"/><label value=".z-fs-display-md" sclass="z-text-muted z-fs-label-sm"/></div>
            <div sclass="z-d-flex z-align-baseline z-gap-2"><label value="Aa" sclass="z-fs-display-sm"/><label value=".z-fs-display-sm" sclass="z-text-muted z-fs-label-sm"/></div>
            <div sclass="z-d-flex z-align-baseline z-gap-2"><label value="Aa" sclass="z-fs-headline-lg"/><label value=".z-fs-headline-lg" sclass="z-text-muted z-fs-label-sm"/></div>
            <div sclass="z-d-flex z-align-baseline z-gap-2"><label value="Aa" sclass="z-fs-headline-md"/><label value=".z-fs-headline-md" sclass="z-text-muted z-fs-label-sm"/></div>
            <div sclass="z-d-flex z-align-baseline z-gap-2"><label value="Aa" sclass="z-fs-headline-sm"/><label value=".z-fs-headline-sm" sclass="z-text-muted z-fs-label-sm"/></div>
            <div sclass="z-d-flex z-align-baseline z-gap-2"><label value="Aa" sclass="z-fs-title-lg"/><label value=".z-fs-title-lg" sclass="z-text-muted z-fs-label-sm"/></div>
            <div sclass="z-d-flex z-align-baseline z-gap-2"><label value="Aa" sclass="z-fs-title-md"/><label value=".z-fs-title-md" sclass="z-text-muted z-fs-label-sm"/></div>
            <div sclass="z-d-flex z-align-baseline z-gap-2"><label value="Aa" sclass="z-fs-title-sm"/><label value=".z-fs-title-sm" sclass="z-text-muted z-fs-label-sm"/></div>
            <div sclass="z-d-flex z-align-baseline z-gap-2"><label value="Aa" sclass="z-fs-body-lg"/><label value=".z-fs-body-lg" sclass="z-text-muted z-fs-label-sm"/></div>
            <div sclass="z-d-flex z-align-baseline z-gap-2"><label value="Aa" sclass="z-fs-body-md"/><label value=".z-fs-body-md" sclass="z-text-muted z-fs-label-sm"/></div>
            <div sclass="z-d-flex z-align-baseline z-gap-2"><label value="Aa" sclass="z-fs-body-sm"/><label value=".z-fs-body-sm" sclass="z-text-muted z-fs-label-sm"/></div>
            <div sclass="z-d-flex z-align-baseline z-gap-2"><label value="Aa" sclass="z-fs-label-lg"/><label value=".z-fs-label-lg" sclass="z-text-muted z-fs-label-sm"/></div>
            <div sclass="z-d-flex z-align-baseline z-gap-2"><label value="Aa" sclass="z-fs-label-md"/><label value=".z-fs-label-md" sclass="z-text-muted z-fs-label-sm"/></div>
            <div sclass="z-d-flex z-align-baseline z-gap-2"><label value="Aa" sclass="z-fs-label-sm"/><label value=".z-fs-label-sm" sclass="z-text-muted z-fs-label-sm"/></div>
        </div>
    </div>

    <!-- Font Weight -->
    <div sclass="section-card">
        <label value="Font Weight  (.z-fw-*)" sclass="section-title"/>
        <div sclass="z-d-flex z-gap-6 z-flex-wrap">
            <div>
                <label value="Light 300" sclass="z-fw-light z-fs-title-lg z-text-on-surface z-d-block"/>
                <label value=".z-fw-light" sclass="z-text-muted z-fs-label-sm"/>
            </div>
            <div>
                <label value="Regular 400" sclass="z-fw-regular z-fs-title-lg z-text-on-surface z-d-block"/>
                <label value=".z-fw-regular" sclass="z-text-muted z-fs-label-sm"/>
            </div>
            <div>
                <label value="Medium 500" sclass="z-fw-medium z-fs-title-lg z-text-on-surface z-d-block"/>
                <label value=".z-fw-medium" sclass="z-text-muted z-fs-label-sm"/>
            </div>
            <div>
                <label value="Semibold 600" sclass="z-fw-semibold z-fs-title-lg z-text-on-surface z-d-block"/>
                <label value=".z-fw-semibold" sclass="z-text-muted z-fs-label-sm"/>
            </div>
            <div>
                <label value="Bold 700" sclass="z-fw-bold z-fs-title-lg z-text-on-surface z-d-block"/>
                <label value=".z-fw-bold" sclass="z-text-muted z-fs-label-sm"/>
            </div>
        </div>
    </div>

    <!-- Text Alignment -->
    <div sclass="section-card">
        <label value="Text Alignment  (.z-text-start / center / end)" sclass="section-title"/>
        <vlayout>
            <div sclass="z-border z-rounded-md z-p-3 z-text-start"><label value="Start aligned — .z-text-start"/></div>
            <div sclass="z-border z-rounded-md z-p-3 z-text-center"><label value="Center aligned — .z-text-center"/></div>
            <div sclass="z-border z-rounded-md z-p-3 z-text-end"><label value="End aligned — .z-text-end"/></div>
        </vlayout>
    </div>

    <!-- Text Transform -->
    <div sclass="section-card">
        <label value="Text Transform  (.z-text-uppercase / lowercase / capitalize / none)" sclass="section-title"/>
        <div sclass="z-d-flex z-gap-6 z-flex-wrap">
            <div>
                <label value="uppercase text" sclass="z-text-uppercase z-fw-medium z-d-block"/>
                <label value=".z-text-uppercase" sclass="z-text-muted z-fs-label-sm"/>
            </div>
            <div>
                <label value="LOWERCASE TEXT" sclass="z-text-lowercase z-fw-medium z-d-block"/>
                <label value=".z-text-lowercase" sclass="z-text-muted z-fs-label-sm"/>
            </div>
            <div>
                <label value="capitalize each word" sclass="z-text-capitalize z-fw-medium z-d-block"/>
                <label value=".z-text-capitalize" sclass="z-text-muted z-fs-label-sm"/>
            </div>
        </div>
    </div>

    <!-- Font Style & Line Height -->
    <div sclass="section-card">
        <label value="Font Style &amp; Line Height" sclass="section-title"/>
        <div sclass="z-d-flex z-gap-6 z-flex-wrap">
            <div>
                <label value="Italic text sample" sclass="z-fst-italic z-fs-body-lg z-d-block"/>
                <label value=".z-fst-italic" sclass="z-text-muted z-fs-label-sm"/>
            </div>
            <div style="max-width:260px">
                <label value="Line height 1 — tight spacing in multiline text blocks used for headlines" sclass="z-lh-1 z-d-block z-bg-surface-variant z-p-2 z-rounded"/>
                <label value=".z-lh-1" sclass="z-text-muted z-fs-label-sm"/>
            </div>
            <div style="max-width:260px">
                <label value="Line height base — comfortable reading for body text in paragraphs" sclass="z-lh-base z-d-block z-bg-surface-variant z-p-2 z-rounded"/>
                <label value=".z-lh-base" sclass="z-text-muted z-fs-label-sm"/>
            </div>
            <div style="max-width:260px">
                <label value="Line height large — open and spacious for relaxed reading or UI prose" sclass="z-lh-lg z-d-block z-bg-surface-variant z-p-2 z-rounded"/>
                <label value=".z-lh-lg" sclass="z-text-muted z-fs-label-sm"/>
            </div>
        </div>
    </div>

    <!-- Truncation -->
    <div sclass="section-card">
        <label value="Text Truncation  (.z-text-truncate)" sclass="section-title"/>
        <div sclass="z-text-truncate z-border z-rounded-md z-p-3" style="max-width:320px">
            <label value="This is a very long text that will be truncated with an ellipsis at the end of the line when it overflows the container width"/>
        </div>
        <label value=".z-text-truncate — overflow:hidden; text-overflow:ellipsis; white-space:nowrap" sclass="z-text-muted z-fs-label-sm z-mt-2"/>
    </div>

</vlayout>
</zk>
