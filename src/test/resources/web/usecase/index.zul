<?page title="Iceblue 11 Component Browser"?>
<?link rel="stylesheet" type="text/css" href="~./usecase/usecase.css"?><zk>
<!--
    Component browser for the preview corpus: one sidebar, one content pane, hash deep links.

    Ported from the Marble worktree's usecase/index.zul. What changed and why:
      - the eight `usecase/*.zul` scenario pages do not exist in this tree, so that nav group
        is gone and the default page is the theme Overview;
      - the corpus here has five pages Marble's sidebar never listed — overview,
        component-theming, breadcrumb, carousel — which are now placed, plus preview.zul, which
        is deliberately NOT listed: it renders every other page inline and is the app homepage;
      - no commit stamp and no "Report this page" button — neither the stamping script nor the
        issue tracker they depend on exists on this branch.

    The density switch drives the theme's own knob through IceblueDensity.apply(...), so what a
    reviewer sees here is the shipped mechanism (tasks/l4-density-mechanism.md D3), not a
    demo-only class. It is the whole-app form, which is why it sits with the brand rather than
    inside the content pane.
-->
<borderlayout height="100vh" viewModel="@id('vm') @init('zk.example.UseCaseVM')"
    onBookmarkChange="@command('handleBookmarkChange', bookmark=event.bookmark)">

    <west size="258px" border="none" collapsible="false">
        <div sclass="z-p-2">
            <div sclass="sidebar-brand z-d-flex z-align-baseline z-gap-2">
                <label value="Iceblue 11"/>
            </div>
            <div sclass="z-d-flex z-align-center z-gap-2 z-px-2 z-py-2 z-mb-2 z-border-bottom">
                <label value="Compact density" sclass="z-text-sm z-flex-1"/>
                <checkbox mold="switch" checked="@load(vm.compactMode)"
                          onCheck="@command('toggleCompactMode', on=self.checked)"/>
            </div>
            <navbar orient="vertical">
                <nav label="Overview" open="@load(vm.openNavLabel eq 'Overview')">
                    <navitem label="Overview"             selected="@load(vm.currentPage eq '~./overview.zul')" onClick="@command('navigate', page='~./overview.zul')"/>
                    <navitem label="Component Theming"    selected="@load(vm.currentPage eq '~./component-theming.zul')" onClick="@command('navigate', page='~./component-theming.zul')"/>
                </nav>
                <nav label="Inputs" open="@load(vm.openNavLabel eq 'Inputs')">
