                    <navitem label="Colorbox"             selected="@load(vm.currentPage eq '~./colorbox.zul')" onClick="@command('navigate', page='~./colorbox.zul')"/>
                    <navitem label="Combobox"             selected="@load(vm.currentPage eq '~./combobox.zul')" onClick="@command('navigate', page='~./combobox.zul')"/>
                    <navitem label="Combobutton"          selected="@load(vm.currentPage eq '~./combobutton.zul')" onClick="@command('navigate', page='~./combobutton.zul')"/>
                    <navitem label="Datebox"              selected="@load(vm.currentPage eq '~./datebox.zul')" onClick="@command('navigate', page='~./datebox.zul')"/>
