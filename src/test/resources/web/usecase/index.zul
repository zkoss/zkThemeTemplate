<?page title="zk-material Use Cases"?>
<?link rel="stylesheet" type="text/css" href="~./usecase/usecase.css"?>
<zk>
<script src="http://localhost:50000/zk-live-reload.js" defer="true"/>
<borderlayout height="100vh" viewModel="@id('vm') @init('zk.example.UseCaseVM')"
    onBookmarkChange="@command('handleBookmarkChange', bookmark=event.bookmark)">

    <west size="258px" border="none" collapsible="false">
        <div>
            <div sclass="sidebar-brand">zk-material</div>
            <navbar orient="vertical">
                <nav label="Use Cases" open="true">
                    <navitem label="KPI Dashboard"        onClick="@command('navigate', page='~./usecase/dashboard.zul')"/>
                    <navitem label="Enterprise App Shell" onClick="@command('navigate', page='~./usecase/app-shell.zul')"/>
                    <navitem label="Sales Order Entry"    onClick="@command('navigate', page='~./usecase/order-entry.zul')"/>
                    <navitem label="Employee Data Grid"   onClick="@command('navigate', page='~./usecase/employee-grid.zul')"/>
                    <navitem label="User Profile"         onClick="@command('navigate', page='~./usecase/user-profile.zul')"/>
                    <navitem label="Product Browser"      onClick="@command('navigate', page='~./usecase/product-browser.zul')"/>
                    <navitem label="Report Viewer"        onClick="@command('navigate', page='~./usecase/report-viewer.zul')"/>
                    <navitem label="Media Manager"        onClick="@command('navigate', page='~./usecase/media-manager.zul')"/>
                </nav>
                <nav label="Form Controls">
                    <navitem label="Button"       onClick="@command('navigate', page='~./button.zul')"/>
                    <navitem label="Combobutton"  onClick="@command('navigate', page='~./combobutton.zul')"/>
                    <navitem label="Checkbox"     onClick="@command('navigate', page='~./checkbox.zul')"/>
                    <navitem label="Radiogroup"   onClick="@command('navigate', page='~./radiogroup.zul')"/>
                    <navitem label="Textbox"      onClick="@command('navigate', page='~./textbox.zul')"/>
                    <navitem label="Combobox"     onClick="@command('navigate', page='~./combobox.zul')"/>
                    <navitem label="Selectbox"    onClick="@command('navigate', page='~./selectbox.zul')"/>
                    <navitem label="Datebox"      onClick="@command('navigate', page='~./datebox.zul')"/>
                    <navitem label="Timebox"      onClick="@command('navigate', page='~./timebox.zul')"/>
                    <navitem label="Spinner"      onClick="@command('navigate', page='~./spinner.zul')"/>
                    <navitem label="Slider"       onClick="@command('navigate', page='~./slider.zul')"/>
                    <navitem label="Rating"       onClick="@command('navigate', page='~./rating.zul')"/>
                    <navitem label="Inputgroup"   onClick="@command('navigate', page='~./inputgroup.zul')"/>
                    <navitem label="Bandbox"      onClick="@command('navigate', page='~./bandbox.zul')"/>
                </nav>
                <nav label="Data">
                    <navitem label="Grid"               onClick="@command('navigate', page='~./grid.zul')"/>
                    <navitem label="Grid (Header)"      onClick="@command('navigate', page='~./grid-header.zul')"/>
                    <navitem label="Grid (Grouping)"    onClick="@command('navigate', page='~./grid-grouping.zul')"/>
                    <navitem label="Grid (Detail)"      onClick="@command('navigate', page='~./grid-detail.zul')"/>
                    <navitem label="Listbox"            onClick="@command('navigate', page='~./listbox.zul')"/>
                    <navitem label="Listbox (Header)"   onClick="@command('navigate', page='~./listbox-header.zul')"/>
                    <navitem label="Listbox (Grouping)" onClick="@command('navigate', page='~./listbox-grouping.zul')"/>
                    <navitem label="Tree"               onClick="@command('navigate', page='~./tree.zul')"/>
                    <navitem label="Tree (Header)"      onClick="@command('navigate', page='~./tree-header.zul')"/>
                    <navitem label="Paging"             onClick="@command('navigate', page='~./paging.zul')"/>
                    <navitem label="Biglistbox"         onClick="@command('navigate', page='~./biglistbox.zul')"/>
                </nav>
                <nav label="Navigation">
                    <navitem label="Menubar"            onClick="@command('navigate', page='~./menubar.zul')"/>
                    <navitem label="Toolbar"            onClick="@command('navigate', page='~./toolbar.zul')"/>
                    <navitem label="Tabbox"             onClick="@command('navigate', page='~./tabbox.zul')"/>
                    <navitem label="Tabbox (Accordion)" onClick="@command('navigate', page='~./tabbox-accordion.zul')"/>
                </nav>
                <nav label="Containers">
                    <navitem label="Window"   onClick="@command('navigate', page='~./window.zul')"/>
                    <navitem label="Panel"    onClick="@command('navigate', page='~./panel.zul')"/>
                    <navitem label="Groupbox" onClick="@command('navigate', page='~./groupbox.zul')"/>
                    <navitem label="Popup"    onClick="@command('navigate', page='~./popup.zul')"/>
                    <navitem label="Caption"  onClick="@command('navigate', page='~./caption.zul')"/>
                </nav>
                <nav label="Layout">
                    <navitem label="Borderlayout"      onClick="@command('navigate', page='~./borderlayout.zul')"/>
                    <navitem label="Hlayout / Vlayout" onClick="@command('navigate', page='~./hlayout.zul')"/>
                    <navitem label="Splitter"          onClick="@command('navigate', page='~./splitter.zul')"/>
                    <navitem label="Anchorlayout"      onClick="@command('navigate', page='~./anchorlayout.zul')"/>
                    <navitem label="Absolutelayout"    onClick="@command('navigate', page='~./absolutelayout.zul')"/>
                </nav>
                <nav label="Feedback">
                    <navitem label="Progressmeter" onClick="@command('navigate', page='~./progressmeter.zul')"/>
                    <navitem label="Notification"  onClick="@command('navigate', page='~./notification.zul')"/>
                    <navitem label="Toast"         onClick="@command('navigate', page='~./toast.zul')"/>
                    <navitem label="Messagebox"    onClick="@command('navigate', page='~./usecase/messagebox.zul')"/>
                    <navitem label="Calendar"      onClick="@command('navigate', page='~./calendar.zul')"/>
                </nav>
            </navbar>
        </div>
    </west>

    <center border="none" autoscroll="true">
        <div>
            <apply templateURI="@load(vm.currentPage)"/>
        </div>
    </center>

</borderlayout>
</zk>
