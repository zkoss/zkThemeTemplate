<?page title="Order Entry Form"?>
<?link rel="stylesheet" type="text/css" href="~./usecase/usecase.css"?>
<zk>

<vlayout hflex="1" sclass="page-content">

    <!-- Page header toolbar -->
    <toolbar>
        <label value="New Sales Order" sclass="z-h2"/>
    </toolbar>

    <tabbox hflex="1">
        <tabs>
            <tab label="General"/>
            <tab label="Line Items"/>
            <tab label="Shipping"/>
            <tab label="Attachments"/>
        </tabs>
        <tabpanels>

            <!-- General Tab -->
            <tabpanel>
                <hlayout width="100%" style="gap: var(--zk-spacing-4);">
                    <!-- Customer Info — was groupbox -->
                    <div hflex="1" sclass="section-card">
                        <label value="Customer Info" sclass="section-title"/>
                        <grid>
                            <rows>
                                <row>
                                    <label value="Customer Name:"/>
                                    <textbox value="Acme Corp" width="200px"/>
                                </row>
                                <row>
                                    <label value="Customer ID:"/>
                                    <inputgroup>
                                        <label value="ID:" style="padding: 0 var(--zk-spacing-2);"/>
                                        <intbox value="10042" width="140px"/>
                                    </inputgroup>
                                </row>
                                <row>
                                    <label value="Account Type:"/>
                                    <combobox value="Corporate" width="160px">
                                        <comboitem label="Corporate"/>
                                        <comboitem label="Government"/>
                                        <comboitem label="SMB"/>
                                        <comboitem label="Individual"/>
                                    </combobox>
                                </row>
                                <row>
                                    <label value="Order Date:"/>
                                    <datebox width="160px"/>
                                </row>
                                <row>
                                    <label value="Order Time:"/>
                                    <timebox width="120px"/>
                                </row>
                            </rows>
                        </grid>
                    </div>

                    <!-- Order Details — was groupbox -->
                    <div hflex="1" sclass="section-card">
                        <label value="Order Details" sclass="section-title"/>
                        <grid>
                            <rows>
                                <row>
                                    <label value="Priority:"/>
                                    <combobox value="Normal" width="140px" readonly="true">
                                        <comboitem label="Normal"/>
                                        <comboitem label="High"/>
                                        <comboitem label="Critical"/>
                                    </combobox>
                                </row>
                                <row>
                                    <label value="Shipping Method:"/>
                                    <radiogroup>
                                        <radio label="Standard"/>
                                        <radio label="Express"/>
                                        <radio label="Overnight" checked="true"/>
                                    </radiogroup>
                                </row>
                                <row>
                                    <label value="Taxable:"/>
                                    <checkbox checked="true"/>
                                </row>
                                <row>
                                    <label value="Discount %:"/>
                                    <decimalbox value="5.00" format="##0.00" width="100px"/>
                                </row>
                                <row>
                                    <label value="Tax Rate:"/>
                                    <doublebox value="8.25" width="100px"/>
                                </row>
                                <row>
                                    <label value="PO Number:"/>
                                    <longbox value="2026031500001" width="160px"/>
                                </row>
                                <row>
                                    <label value="Weight (kg):"/>
                                    <doublespinner value="2.5" step="0.5" width="100px"/>
                                </row>
                                <row>
                                    <label value="Quantity:"/>
                                    <spinner value="10" step="1" width="80px"/>
                                </row>
                            </rows>
                        </grid>
                    </div>
                </hlayout>
            </tabpanel>

            <!-- Line Items Tab — keep as-is (listbox, no groupboxes) -->
            <tabpanel>
                <vlayout>
                    <listbox width="100%">
                        <listhead>
                            <listheader label="SKU" width="100px"/>
                            <listheader label="Description" hflex="1"/>
                            <listheader label="Qty" width="70px"/>
                            <listheader label="Unit Price" width="100px"/>
                            <listheader label="Total" width="100px"/>
                        </listhead>
                        <listgroup label="Hardware"/>
                        <listitem>
                            <listcell label="SKU-1001"/>
                            <listcell label="Laptop 15-inch Pro"/>
                            <listcell label="3"/>
                            <listcell label="$1,299.00"/>
                            <listcell label="$3,897.00"/>
                        </listitem>
                        <listitem>
                            <listcell label="SKU-1002"/>
                            <listcell label="Wireless Mouse"/>
                            <listcell label="10"/>
                            <listcell label="$29.99"/>
                            <listcell label="$299.90"/>
                        </listitem>
                        <listgroupfoot>
                            <listcell/>
                            <listcell label="Hardware Subtotal"/>
                            <listcell/>
                            <listcell/>
                            <listcell label="$4,196.90"/>
                        </listgroupfoot>
                        <listgroup label="Software"/>
                        <listitem>
                            <listcell label="SKU-2001"/>
                            <listcell label="Office Suite License"/>
                            <listcell label="5"/>
                            <listcell label="$199.00"/>
                            <listcell label="$995.00"/>
                        </listitem>
                        <listgroupfoot>
                            <listcell/>
                            <listcell label="Software Subtotal"/>
                            <listcell/>
                            <listcell/>
                            <listcell label="$995.00"/>
                        </listgroupfoot>
                        <listfoot>
                            <listfooter label=""/>
                            <listfooter label=""/>
                            <listfooter label=""/>
                            <listfooter label=""/>
                            <listfooter label="Grand Total: $5,191.90"/>
                        </listfoot>
                    </listbox>
                    <hlayout>
                        <button label="Add Line Item" iconSclass="z-icon-plus"/>
                    </hlayout>
                </vlayout>
            </tabpanel>

            <!-- Shipping Tab — keep as-is (no groupboxes) -->
            <tabpanel>
                <vlayout>
                    <label value="Shipping Address" sclass="z-h4"/>
                    <grid>
                        <rows>
                            <row>
                                <label value="Address:"/>
                                <textbox value="123 Business Park" width="240px"/>
                            </row>
                            <row>
                                <label value="City:"/>
                                <textbox value="Springfield" width="160px"/>
                            </row>
                            <row>
                                <label value="State:"/>
                                <textbox value="IL" width="80px"/>
                            </row>
                            <row>
                                <label value="ZIP:"/>
                                <textbox value="62701" width="100px"/>
                            </row>
                            <row>
                                <label value="Country:"/>
                                <combobox value="United States" width="200px">
                                    <comboitem label="United States"/>
                                    <comboitem label="Canada"/>
                                    <comboitem label="United Kingdom"/>
                                    <comboitem label="Australia"/>
                                </combobox>
                            </row>
                        </rows>
                    </grid>
                </vlayout>
            </tabpanel>

            <!-- Attachments Tab — keep as-is -->
            <tabpanel>
                <vlayout>
                    <label value="Upload supporting documents:" sclass="z-h4"/>
                    <fileupload label="Upload Files"/>
                    <progressmeter value="65" width="300px"/>
                    <label value="Uploaded Files:"/>
                    <listbox width="500px">
                        <listhead>
                            <listheader label="File Name" hflex="1"/>
                            <listheader label="Size" width="80px"/>
                            <listheader label="Status" width="100px"/>
                        </listhead>
                        <listitem>
                            <listcell label="purchase-order.pdf"/>
                            <listcell label="245 KB"/>
                            <listcell label="Uploaded"/>
                        </listitem>
                        <listitem>
                            <listcell label="invoice-draft.xlsx"/>
                            <listcell label="78 KB"/>
                            <listcell label="Uploading..."/>
                        </listitem>
                    </listbox>
                </vlayout>
            </tabpanel>

        </tabpanels>
    </tabbox>

    <!-- Footer actions -->
    <separator/>
    <hlayout width="100%" sclass="md-text-right">
        <combobutton label="Save">
            <menupopup>
                <menuitem label="Save as Draft"/>
                <menuitem label="Save and Submit"/>
            </menupopup>
        </combobutton>
        <button label="Cancel"/>
    </hlayout>

</vlayout>
</zk>
