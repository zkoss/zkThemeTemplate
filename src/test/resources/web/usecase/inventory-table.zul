<?page title="Inventory Table"?>
<zk>
<style src="~./usecase/usecase.css"/>
<vlayout hflex="1" sclass="page-content">

    <!-- Page header -->
    <div sclass="md-hbox z-align-center">
        <label value="Inventory" sclass="z-h2"/>
        <button label="Add Item" iconSclass="z-icon-plus" sclass="md-push-right"/>
    </div>

    <!-- Filter toolbar -->
    <div sclass="z-card">
        <div sclass="md-hbox z-align-center">
            <textbox placeholder="Search SKU or product…" hflex="1" sclass="md-flex-1"/>
            <combobox placeholder="Category" readonly="true">
                <comboitem label="All Categories"/>
                <comboitem label="Fasteners"/>
                <comboitem label="Tools"/>
                <comboitem label="Safety Gear"/>
                <comboitem label="Packaging"/>
            </combobox>
            <combobox placeholder="Status" readonly="true">
                <comboitem label="All"/>
                <comboitem label="In Stock"/>
                <comboitem label="Low"/>
                <comboitem label="Out"/>
            </combobox>
        </div>
    </div>

    <!-- Stock grid -->
    <div sclass="z-card">
        <grid hflex="1">
            <columns>
                <column label="SKU" width="110px"/>
                <column label="Product"/>
                <column label="Category" width="130px"/>
                <column label="Qty" width="70px" align="right"/>
                <column label="Location" width="110px"/>
                <column label="Status" width="110px"/>
                <column label="Stock Level" width="160px"/>
                <column label="" width="56px"/>
            </columns>
            <rows>
                <row>
                    <label value="FST-0481"/>
                    <label value="M6 Hex Bolt (100pk)"/>
                    <label value="Fasteners"/>
                    <label value="1,240"/>
                    <label value="A-12"/>
                    <label value="In Stock" sclass="z-badge z-badge-success"/>
                    <progressmeter value="82" width="140px"/>
                    <button iconSclass="z-icon-ellipsis-vertical" sclass="z-button-icon"/>
                </row>
                <row>
                    <label value="TLS-2207"/>
                    <label value="Cordless Drill 18V"/>
                    <label value="Tools"/>
                    <label value="38"/>
                    <label value="C-04"/>
                    <label value="Low" sclass="z-badge z-badge-warning"/>
                    <progressmeter value="24" width="140px"/>
                    <button iconSclass="z-icon-ellipsis-vertical" sclass="z-button-icon"/>
                </row>
                <row>
                    <label value="SAF-1190"/>
                    <label value="Safety Goggles"/>
                    <label value="Safety Gear"/>
                    <label value="0"/>
                    <label value="B-08"/>
                    <label value="Out" sclass="z-badge z-badge-error"/>
                    <progressmeter value="0" width="140px"/>
                    <button iconSclass="z-icon-ellipsis-vertical" sclass="z-button-icon"/>
                </row>
                <row>
                    <label value="PKG-3320"/>
                    <label value="Shipping Box (Large)"/>
                    <label value="Packaging"/>
                    <label value="640"/>
                    <label value="D-21"/>
                    <label value="In Stock" sclass="z-badge z-badge-success"/>
                    <progressmeter value="68" width="140px"/>
                    <button iconSclass="z-icon-ellipsis-vertical" sclass="z-button-icon"/>
                </row>
                <row>
                    <label value="FST-0512"/>
                    <label value="Washer Assortment"/>
                    <label value="Fasteners"/>
                    <label value="95"/>
                    <label value="A-15"/>
                    <label value="Low" sclass="z-badge z-badge-warning"/>
                    <progressmeter value="31" width="140px"/>
                    <button iconSclass="z-icon-ellipsis-vertical" sclass="z-button-icon"/>
                </row>
            </rows>
        </grid>
        <paging totalSize="128" pageSize="5" sclass="z-mt-3"/>
    </div>

</vlayout>
</zk>
