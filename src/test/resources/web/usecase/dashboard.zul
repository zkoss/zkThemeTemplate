<?page title="KPI Dashboard"?>
<zk>
<style src="~./usecase/usecase.css"/>
    <!-- Auto-refresh timer (30 seconds) -->
    <timer delay="30000" running="true" id="refreshTimer"/>

    <vlayout hflex="1" sclass="page-content">

        <!-- Page toolbar -->
        <toolbar>
            <label value="Operations Dashboard" sclass="z-h2"/>
            <separator/>
            <toolbarbutton label="Refresh" iconSclass="z-icon-refresh-cw"/>
            <toolbarbutton label="Settings" iconSclass="z-icon-cog" sclass="md-push-right"/>
        </toolbar>

        <!-- KPI Cards row -->
        <div sclass="md-hbox">
            <!-- KPI 1: Orders Today -->
            <div sclass="kpi-card md-flex-1 section-card">
                <label value="Orders Today" sclass="section-title"/>
                <vlayout>
                    <div sclass="z-h1">248</div>
                    <div sclass="kpi-label z-h6">Daily target: 300</div>
                    <progressmeter value="83" width="160px"/>
                    <label value="83% of target"/>
                </vlayout>
            </div>

            <!-- KPI 2: Customer Satisfaction -->
            <div sclass="kpi-card md-flex-1 section-card">
                <label value="Customer Satisfaction" sclass="section-title"/>
                <vlayout>
                    <rating max="5" rating="4" readonly="true"/>
                    <div sclass="z-h1">4.2</div>
                    <div sclass="kpi-label z-h6">out of 5.0 (342 reviews)</div>
                </vlayout>
            </div>

            <!-- KPI 3: Server Load -->
            <div sclass="kpi-card md-flex-1 section-card">
                <label value="Server Load" sclass="section-title"/>
                <vlayout>
                    <div sclass="z-h1">67%</div>
                    <div sclass="kpi-label z-h6">CPU utilization</div>
                    <progressmeter value="67"/>
                    <label value="Normal range: 0-80%"/>
                </vlayout>
            </div>

            <!-- KPI 4: Revenue -->
            <div sclass="kpi-card md-flex-1 section-card">
                <label value="Revenue" sclass="section-title"/>
                <vlayout>
                    <div sclass="z-h1">$84.2K</div>
                    <div sclass="kpi-label z-h6">Month to date</div>
                    <label value="Target: $120K"/>
                </vlayout>
            </div>
        </div>

        <!-- Secondary panels -->
        <div sclass="md-hbox">

            <!-- Recent Alerts -->
            <div sclass="md-flex-1 section-card">
                <label value="Recent Alerts" sclass="section-title"/>
                <listbox hflex="1" rows="6">
                    <listitem>
                        <listcell>
                            <span sclass="badge-err">ERROR</span>
                            <span>Database connection pool at 95% capacity</span>
                        </listcell>
                    </listitem>
                    <listitem>
                        <listcell>
                            <span sclass="badge-ok">INFO</span>
                            <span>Nightly backup completed successfully</span>
                        </listcell>
                    </listitem>
                    <listitem>
                        <listcell>
                            <span sclass="badge-warn">WARN</span>
                            <span>Disk usage on /var/log exceeds 80%</span>
                        </listcell>
                    </listitem>
                    <listitem>
                        <listcell>
                            <span sclass="badge-ok">INFO</span>
                            <span>5 new orders received since midnight</span>
                        </listcell>
                    </listitem>
                    <listitem>
                        <listcell>
                            <span sclass="badge-ok">INFO</span>
                            <span>Scheduled maintenance window: 02:00-04:00</span>
                        </listcell>
                    </listitem>
                </listbox>
            </div>

            <!-- System Status -->
            <div sclass="section-card" width="300px">
                <label value="System Status" sclass="section-title"/>
                <grid>
                    <columns>
                        <column label="Service" hflex="1"/>
                        <column label="Status" width="80px"/>
                    </columns>
                    <rows>
                        <row>
                            <label value="Web Server"/>
                            <label sclass="badge-ok" value="Up"/>
                        </row>
                        <row>
                            <label value="Database"/>
                            <label sclass="badge-ok" value="Up"/>
                        </row>
                        <row>
                            <label value="Cache"/>
                            <label sclass="badge-ok" value="Up"/>
                        </row>
                        <row>
                            <label value="Queue"/>
                            <label sclass="badge-err" value="Down"/>
                        </row>
                        <row>
                            <label value="Email Service"/>
                            <label sclass="badge-ok" value="Up"/>
                        </row>
                    </rows>
                </grid>
            </div>

        </div>
    </vlayout>
</zk>
