<?page title="User Profile and Settings"?>
<?link rel="stylesheet" type="text/css" href="~./usecase/usecase.css"?>
<zk>

<vlayout hflex="1" sclass="page-content">
    <label value="Account Settings" sclass="z-h1 md-py-3"/>
    <separator bar="true"/>

    <anchorlayout hflex="1">

        <!-- Left column: Profile photo + About (40%) -->
        <anchorchildren anchor="40%">
            <vlayout>
                <div sclass="section-card">
                    <label value="Profile Photo" sclass="section-title"/>
                    <vlayout sclass="md-text-center">
                        <image src="~./img/avatar-placeholder.svg"
                               sclass="avatar" width="80px" height="80px" style="margin: auto"/>
                        <space height="8px"/>
                        <fileupload label="Upload New Photo"/>
                        <div sclass="section-hint z-h6">JPEG or PNG, max 2MB</div>
                    </vlayout>
                </div>

                <space height="12px"/>

                <div sclass="section-card">
                    <label value="About" sclass="section-title"/>
                    <vlayout>
                        <label value="Bio:"/>
                        <textbox multiline="true" rows="4" hflex="1"
                                 value="Senior software engineer with 8 years experience in enterprise Java development."/>
                        <space height="8px"/>
                        <label value="Rate Your Experience:"/>
                        <rating max="5"/>
                    </vlayout>
                </div>
            </vlayout>
        </anchorchildren>

        <!-- Right column: Details + Preferences + Security (55%) -->
        <anchorchildren anchor="55%">
            <vlayout>

                <!-- Personal Information -->
                <div sclass="section-card">
                    <label value="Personal Information" sclass="section-title"/>
                    <grid>
                        <rows>
                            <row>
                                <label value="Name:"/>
                                <hlayout>
                                    <textbox value="Jane" placeholder="First name" width="120px"/>
                                    <space width="8px"/>
                                    <textbox value="Doe" placeholder="Last name" width="120px"/>
                                </hlayout>
                            </row>
                            <row>
                                <label value="Email:"/>
                                <textbox value="jane.doe@example.com" hflex="1"/>
                            </row>
                            <row>
                                <label value="Date of Birth:"/>
                                <datebox width="160px"/>
                            </row>
                            <row>
                                <label value="Country:"/>
                                <combobox value="United States" width="200px">
                                    <comboitem label="United States"/>
                                    <comboitem label="Canada"/>
                                    <comboitem label="United Kingdom"/>
                                    <comboitem label="Germany"/>
                                    <comboitem label="Australia"/>
                                </combobox>
                            </row>
                            <row>
                                <label value="Phone:"/>
                                <inputgroup>
                                    <intbox value="1" width="50px" placeholder="+1"/>
                                    <textbox value="555-0123" width="130px" placeholder="Number"/>
                                </inputgroup>
                            </row>
                        </rows>
                    </grid>
                </div>

                <space height="8px"/>

                <!-- Preferences -->
                <div sclass="section-card">
                    <label value="Preferences" sclass="section-title"/>
                    <grid>
                        <rows>
                            <row>
                                <label value="Theme:"/>
                                <radiogroup>
                                    <radio label="Light" checked="true"/>
                                    <radio label="Dark"/>
                                    <radio label="Auto"/>
                                </radiogroup>
                            </row>
                            <row>
                                <label value="Notifications:"/>
                                <vlayout>
                                    <checkbox label="Email Notifications" checked="true"/>
                                    <checkbox label="SMS Alerts"/>
                                </vlayout>
                            </row>
                            <row>
                                <label value="Session Timeout:"/>
                                <hlayout>
                                    <slider curpos="30" minpos="5" maxpos="60" width="160px"/>
                                    <label value="30 min"/>
                                </hlayout>
                            </row>
                            <row>
                                <label value="Font Size:"/>
                                <doublespinner value="14.0" step="0.5" width="90px"/>
                            </row>
                            <row>
                                <label value="Items Per Page:"/>
                                <spinner value="20" step="5" width="80px"/>
                            </row>
                        </rows>
                    </grid>
                </div>

                <space height="8px"/>

                <!-- Security -->
                <div sclass="section-card">
                    <label value="Security" sclass="section-title"/>
                    <grid width="380px">
                        <rows>
                            <row>
                                <label value="Current Password:"/>
                                <textbox type="password" width="200px"/>
                            </row>
                            <row>
                                <label value="New Password:"/>
                                <textbox type="password" width="200px"/>
                            </row>
                            <row>
                                <label value="Confirm Password:"/>
                                <textbox type="password" width="200px"/>
                            </row>
                            <row>
                                <label value="CAPTCHA:"/>
                                <vlayout width="200px">
                                    <captcha/>
                                    <textbox placeholder="Enter CAPTCHA" width="200px"/>
                                </vlayout>
                            </row>
                        </rows>
                    </grid>
                </div>

            </vlayout>
        </anchorchildren>

    </anchorlayout>

    <separator bar="true"/>

    <hlayout>
        <button label="Save Changes" iconSclass="z-icon-check"/>
        <space width="8px"/>
        <button label="Cancel"/>
        <separator orient="vertical"/>
        <a label="Delete Account" href="#"/>
    </hlayout>

</vlayout>
</zk>
