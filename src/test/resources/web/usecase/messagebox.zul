<zk>
<vlayout sclass="page-content" spacing="16px">

    <toolbar>
        <label value="Messagebox" sclass="z-h2"/>
    </toolbar>

    <div sclass="md-hbox" style="align-items:start;gap:16px;">

        <!-- Left column -->
        <vlayout spacing="16px" style="flex:1;">

            <panel title="Basic Types" border="normal">
                <panelchildren>
                    <vlayout spacing="8px">
                        <label value="Four built-in message types, each with a distinct icon." style="font-size:13px;color:#49454f;"/>
                        <hlayout spacing="8px" style="flex-wrap:wrap;">
                            <button label="Information" sclass="z-button-primary">
                                <attribute name="onClick">
                                    Messagebox.show("This is an informational message.", "Information", Messagebox.OK, Messagebox.INFORMATION);
                                </attribute>
                            </button>
                            <button label="Warning" sclass="z-button-warning">
                                <attribute name="onClick">
                                    Messagebox.show("This is a warning message. Please review before proceeding.", "Warning", Messagebox.OK, Messagebox.EXCLAMATION);
                                </attribute>
                            </button>
                            <button label="Error" sclass="z-button-error">
                                <attribute name="onClick">
                                    Messagebox.show("An error has occurred. Unable to complete the operation.", "Error", Messagebox.OK, Messagebox.ERROR);
                                </attribute>
                            </button>
                            <button label="Question" sclass="z-button-outlined">
                                <attribute name="onClick">
                                    Messagebox.show("Are you sure you want to continue?", "Question", Messagebox.OK | Messagebox.CANCEL, Messagebox.QUESTION);
                                </attribute>
                            </button>
                        </hlayout>
                    </vlayout>
                </panelchildren>
            </panel>

            <panel title="Button Combinations" border="normal">
                <panelchildren>
                    <vlayout spacing="8px">
                        <label value="Messageboxes can be configured with different button sets." style="font-size:13px;color:#49454f;"/>
                        <hlayout spacing="8px" style="flex-wrap:wrap;">
                            <button label="OK only" sclass="z-button-outlined">
                                <attribute name="onClick">
                                    Messagebox.show("Operation completed.", "Done", Messagebox.OK, Messagebox.INFORMATION);
                                </attribute>
                            </button>
                            <button label="OK + Cancel" sclass="z-button-outlined">
                                <attribute name="onClick">
                                    Messagebox.show("Proceed with this action?", "Confirm", Messagebox.OK | Messagebox.CANCEL, Messagebox.QUESTION);
                                </attribute>
                            </button>
                            <button label="Yes + No" sclass="z-button-outlined">
                                <attribute name="onClick">
                                    Messagebox.show("Do you want to save changes before closing?", "Save Changes", Messagebox.YES | Messagebox.NO, Messagebox.QUESTION);
                                </attribute>
                            </button>
                            <button label="Yes + No + Cancel" sclass="z-button-outlined">
                                <attribute name="onClick">
                                    Messagebox.show("Save changes to this document?", "Unsaved Changes", Messagebox.YES | Messagebox.NO | Messagebox.CANCEL, Messagebox.QUESTION);
                                </attribute>
                            </button>
                        </hlayout>
                    </vlayout>
                </panelchildren>
            </panel>

        </vlayout>

        <!-- Right column -->
        <vlayout spacing="16px" style="flex:1;">

            <panel title="With Callback" border="normal">
                <panelchildren>
                    <vlayout spacing="8px">
                        <label value="Handle the user's button choice to perform conditional actions." style="font-size:13px;color:#49454f;"/>
                        <label id="callbackResult" value="(no action yet)" style="font-size:13px;color:#888;font-style:italic;"/>
                        <button label="Confirm Delete" sclass="z-button-error">
                            <attribute name="onClick">
                                Messagebox.show("Permanently delete this record? This cannot be undone.",
                                    "Delete Record",
                                    Messagebox.YES | Messagebox.NO,
                                    Messagebox.ERROR,
                                    new org.zkoss.zul.event.EventListener() {
                                        public void onEvent(org.zkoss.zk.ui.event.Event e) {
                                            if (Messagebox.ON_YES.equals(e.getName())) {
                                                callbackResult.setValue("You chose: Delete confirmed.");
                                            } else {
                                                callbackResult.setValue("You chose: Delete cancelled.");
                                            }
                                        }
                                    });
                            </attribute>
                        </button>
                    </vlayout>
                </panelchildren>
            </panel>

            <panel title="Long Message" border="normal">
                <panelchildren>
                    <vlayout spacing="8px">
                        <label value="The messagebox scrolls when content exceeds the visible area." style="font-size:13px;color:#49454f;"/>
                        <button label="Show long message" sclass="z-button-outlined">
                            <attribute name="onClick">
                                Messagebox.show(
                                    "Line 1: The system has detected an anomaly in the transaction log.\n" +
                                    "Line 2: Please review the following entries for discrepancies.\n" +
                                    "Line 3: Transaction IDs: TXN-001, TXN-042, TXN-089.\n" +
                                    "Line 4: Affected accounts: ACC-10021, ACC-10055.\n" +
                                    "Line 5: Timestamp range: 2026-05-01 00:00 – 2026-05-07 23:59.\n" +
                                    "Line 6: Contact the administrator if the issue persists.",
                                    "System Alert", Messagebox.OK, Messagebox.EXCLAMATION);
                            </attribute>
                        </button>
                    </vlayout>
                </panelchildren>
            </panel>

        </vlayout>
    </div>

</vlayout>
</zk>
