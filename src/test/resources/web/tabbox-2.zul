<?page title="Tabbox 2" contentType="text/html;charset=UTF-8"?>
<zk xmlns:h="native">
<h:link rel="stylesheet" href="pv.css"/>
<div sclass="z-p-8">
    <div sclass="z-border-bottom z-fs-title-lg z-fw-medium z-text-on-surface z-mb-8 z-pb-3">Tabbox — tabscroll=false</div>

    <div sclass="z-mb-6">
        <div sclass="z-fs-label-sm z-fw-semibold z-text-uppercase z-text-secondary z-border-bottom z-pb-2 z-mb-4">tabscroll=false</div>
        <div sclass="z-d-flex z-align-start z-flex-wrap z-gap-6 z-py-3">
            <div sclass="z-d-flex z-flex-col z-align-start z-gap-2">
                <tabbox tabscroll="false" height="200px" width="400px">
                    <tabs>
                        <tab label="Tab 1" />
                        <tab label="Tab 2" />
                        <tab label="Tab 3" />
                    </tabs>
                    <tabpanels>
                        <tabpanel>Tabpanel 1 Content</tabpanel>
                        <tabpanel>Tabpanel 2 Content</tabpanel>
                        <tabpanel>Tabpanel 3 Content</tabpanel>
                    </tabpanels>
                </tabbox>
                <div sclass="z-fs-label-sm z-text-secondary">Horizontal, tabscroll=false</div>
            </div>
            <div sclass="z-d-flex z-flex-col z-align-start z-gap-2">
                <tabbox tabscroll="false" orient="vertical" height="200px" width="400px">
                    <tabs width="100px">
                        <tab label="Tab 1" />
                        <tab label="Tab 2" />
                        <tab label="Tab 3" />
                    </tabs>
                    <tabpanels>
                        <tabpanel>Tabpanel 1 Content</tabpanel>
                        <tabpanel>Tabpanel 2 Content</tabpanel>
                        <tabpanel>Tabpanel 3 Content</tabpanel>
                    </tabpanels>
                </tabbox>
                <div sclass="z-fs-label-sm z-text-secondary">Vertical, tabscroll=false</div>
            </div>
        </div>
    </div>

</div>
</zk>
