<?page title="Breadcrumb" contentType="text/html;charset=UTF-8"?>
<zk xmlns:h="native">
<div sclass="z-p-8">
    <div sclass="z-border-bottom z-mb-8 z-pb-3"><label sclass="z-text-2xl z-fw-medium z-text-on-surface" value="Breadcrumb"/></div>

    <div sclass="z-mb-6">
        <div sclass="z-text-uppercase z-border-bottom z-pb-2 z-mb-4"><label sclass="z-text-xs z-fw-semibold z-text-secondary" value="Default (links + current page)"/></div>
        <div sclass="z-d-flex z-flex-col z-gap-2 z-py-3">
            <div><label sclass="z-text-sm z-text-secondary" value="Trail with 3 link items and a terminal current-page item"/></div>
            <breadcrumb id="pv-breadcrumb-default">
                <breadcrumbitem label="Home" href="#"/>
                <breadcrumbitem label="Products" href="#"/>
                <breadcrumbitem label="Category" href="#"/>
                <breadcrumbitem label="Current Item"/>
            </breadcrumb>
        </div>
    </div>

    <div sclass="z-mb-6">
        <div sclass="z-text-uppercase z-border-bottom z-pb-2 z-mb-4"><label sclass="z-text-xs z-fw-semibold z-text-secondary" value="Disabled item"/></div>
        <div sclass="z-d-flex z-flex-col z-gap-2 z-py-3">
            <div><label sclass="z-text-sm z-text-secondary" value="Middle item disabled (dimmed, non-interactive even though it has an href)"/></div>
            <breadcrumb id="pv-breadcrumb-disabled">
                <breadcrumbitem label="Home" href="#"/>
                <breadcrumbitem label="Archived" href="#" disabled="true"/>
                <breadcrumbitem label="Current Item"/>
            </breadcrumb>
        </div>
    </div>

    <div sclass="z-mb-6">
        <div sclass="z-text-uppercase z-border-bottom z-pb-2 z-mb-4"><label sclass="z-text-xs z-fw-semibold z-text-secondary" value="Icon separator"/></div>
        <div sclass="z-d-flex z-flex-col z-gap-2 z-py-3">
            <div><label sclass="z-text-sm z-text-secondary" value="separator=&quot;icon:z-icon-chevron-right&quot; instead of the plain-text default"/></div>
            <breadcrumb id="pv-breadcrumb-icon-separator" separator="icon:z-icon-chevron-right">
                <breadcrumbitem label="Home" href="#"/>
                <breadcrumbitem label="Products" href="#"/>
                <breadcrumbitem label="Category" href="#"/>
                <breadcrumbitem label="Current Item"/>
            </breadcrumb>
        </div>
    </div>

    <div sclass="z-mb-6">
        <div sclass="z-text-uppercase z-border-bottom z-pb-2 z-mb-4"><label sclass="z-text-xs z-fw-semibold z-text-secondary" value="Collapsed (maxItems)"/></div>
        <div sclass="z-d-flex z-flex-col z-gap-2 z-py-3">
            <div><label sclass="z-text-sm z-text-secondary" value="maxItems=3 with 6 items — client-side JS collapses the middle into an ellipsis button"/></div>
            <breadcrumb id="pv-breadcrumb-collapsed" maxItems="3">
                <breadcrumbitem label="Home" href="#"/>
                <breadcrumbitem label="Level 1" href="#"/>
                <breadcrumbitem label="Level 2" href="#"/>
                <breadcrumbitem label="Level 3" href="#"/>
                <breadcrumbitem label="Level 4" href="#"/>
                <breadcrumbitem label="Current Item"/>
            </breadcrumb>
        </div>
    </div>
</div>
</zk>
