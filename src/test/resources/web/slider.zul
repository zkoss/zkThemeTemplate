<?page title="Slider" contentType="text/html;charset=UTF-8"?>
<zk xmlns:h="native">
<h:link rel="stylesheet" href="pv.css"/>
<div sclass="z-p-8">
    <div sclass="z-border-bottom z-fs-title-lg z-fw-medium z-text-on-surface z-mb-8 z-pb-3">Slider</div>

    <div sclass="z-mb-6">
        <div sclass="z-fs-label-sm z-fw-semibold z-text-uppercase z-text-secondary z-border-bottom z-pb-2 z-mb-4">Horizontal</div>
        <div sclass="z-d-flex z-flex-col z-align-start z-gap-4 z-py-3">
            <div sclass="z-d-flex z-flex-col z-align-start z-gap-2">
                <slider width="200px"/>
                <div sclass="z-fs-label-sm z-text-secondary">Default</div>
            </div>
            <div sclass="z-d-flex z-flex-col z-align-start z-gap-2">
                <slider width="200px" mold="sphere"/>
                <div sclass="z-fs-label-sm z-text-secondary">Sphere</div>
            </div>
            <div sclass="z-d-flex z-flex-col z-align-start z-gap-2">
                <slider width="200px" mold="scale"/>
                <div sclass="z-fs-label-sm z-text-secondary">Scale</div>
            </div>
        </div>
    </div>

    <div sclass="z-mb-6">
        <div sclass="z-fs-label-sm z-fw-semibold z-text-uppercase z-text-secondary z-border-bottom z-pb-2 z-mb-4">Vertical</div>
        <div sclass="z-d-flex z-align-end z-flex-wrap z-gap-6 z-py-3">
            <div sclass="z-d-flex z-flex-col z-align-center z-gap-2">
                <slider orient="vertical" height="120px"/>
                <div sclass="z-fs-label-sm z-text-secondary">Default</div>
            </div>
            <div sclass="z-d-flex z-flex-col z-align-center z-gap-2">
                <slider orient="vertical" mold="sphere" height="120px"/>
                <div sclass="z-fs-label-sm z-text-secondary">Sphere</div>
            </div>
        </div>
    </div>
</div>
</zk>
