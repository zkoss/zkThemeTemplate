<?page title="Barcode Scanner" contentType="text/html;charset=UTF-8"?>
<zk xmlns:h="native">
<div sclass="z-p-8">
    <div sclass="z-border-bottom z-mb-8 z-pb-3"><label sclass="z-text-2xl z-fw-medium z-text-on-surface" value="Barcode Scanner"/></div>
    <div sclass="z-mb-6">
        <div sclass="z-text-uppercase z-border-bottom z-pb-2 z-mb-4"><label sclass="z-text-xs z-fw-semibold z-text-secondary" value="QR Code Scanner"/></div>
        <div sclass="z-py-3 z-d-flex z-flex-col z-gap-4">
            <barcodescanner type="QR" width="400px" height="400px" continuous="false"
                            onDetect="result.value = event.result"/>
            <div sclass="z-d-flex z-items-center z-gap-3">
                <div><label sclass="z-text-sm z-text-secondary" value="Scan result:"/></div>
                <label id="result"/>
            </div>
        </div>
    </div>
</div>
</zk>
