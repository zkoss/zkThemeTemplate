<?page title="Bandbox" contentType="text/html;charset=UTF-8"?>
<zk xmlns:h="native">
<h:link rel="stylesheet" href="pv.css"/>
<div sclass="z-p-8">
    <div sclass="z-border-bottom z-fs-title-lg z-fw-medium z-text-on-surface z-mb-8 z-pb-3">Bandbox</div>

    <div sclass="z-mb-6 pv-cols-4">
        <div sclass="z-fs-label-sm z-fw-semibold z-text-uppercase z-text-secondary z-border-bottom z-pb-2 z-mb-4">States</div>
        <div sclass="pv-col-header-row z-pb-1">
            <div/>
            <div sclass="z-fs-label-sm z-fw-semibold z-text-secondary">Default</div>
            <div sclass="z-fs-label-sm z-fw-semibold z-text-secondary">Disabled</div>
            <div sclass="z-fs-label-sm z-fw-semibold z-text-secondary">Readonly</div>
            <div sclass="z-fs-label-sm z-fw-semibold z-text-secondary">Inplace</div>
        </div>
        <div sclass="pv-row z-py-2 z-border-bottom">
            <div sclass="z-fs-label-md z-text-secondary">Default</div>
            <div><bandbox><bandpopup>Content</bandpopup></bandbox></div>
            <div><bandbox disabled="true"><bandpopup>Content</bandpopup></bandbox></div>
            <div><bandbox readonly="true"><bandpopup>Content</bandpopup></bandbox></div>
            <div><bandbox inplace="true"><bandpopup>Content</bandpopup></bandbox></div>
        </div>
        <div sclass="pv-row z-py-2 z-border-bottom">
            <div sclass="z-fs-label-md z-text-secondary">No button</div>
            <div><bandbox buttonVisible="false"><bandpopup>Content</bandpopup></bandbox></div>
            <div><bandbox buttonVisible="false" disabled="true"><bandpopup>Content</bandpopup></bandbox></div>
            <div><bandbox buttonVisible="false" readonly="true"><bandpopup>Content</bandpopup></bandbox></div>
            <div>—</div>
        </div>
    </div>
</div>
</zk>
