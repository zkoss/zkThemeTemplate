<?page title="Multislider" contentType="text/html;charset=UTF-8"?>
<zk xmlns:h="native">
<h:link rel="stylesheet" href="pv.css"/>
<div sclass="z-p-8">
    <div sclass="z-border-bottom z-fs-title-lg z-fw-medium z-text-on-surface z-mb-8 z-pb-3">Multislider</div>

    <div sclass="z-mb-6">
        <div sclass="z-fs-label-sm z-fw-semibold z-text-uppercase z-text-secondary z-border-bottom z-pb-2 z-mb-4">Horizontal</div>
        <div sclass="z-d-flex z-flex-col z-align-start z-gap-4 z-py-3">
            <div sclass="z-d-flex z-flex-col z-align-start z-gap-2">
                <multislider width="500px">
                    <sliderbuttons startValue="10" endValue="70"/>
                    <sliderbuttons startValue="20" endValue="50"/>
                    <sliderbuttons startValue="30" endValue="40"/>
                </multislider>
                <div sclass="z-fs-label-sm z-text-secondary">3 ranges</div>
            </div>
        </div>
    </div>

    <div sclass="z-mb-6">
        <div sclass="z-fs-label-sm z-fw-semibold z-text-uppercase z-text-secondary z-border-bottom z-pb-2 z-mb-4">Vertical</div>
        <div sclass="z-d-flex z-align-end z-flex-wrap z-gap-6 z-py-3">
            <div sclass="z-d-flex z-flex-col z-align-center z-gap-2">
                <multislider min="5" max="120" orient="vertical" height="500px">
                    <sliderbuttons startValue="5" endValue="100"/>
                    <sliderbuttons startValue="20" endValue="50"/>
                </multislider>
                <div sclass="z-fs-label-sm z-text-secondary">2 ranges</div>
            </div>
        </div>
    </div>
</div>
</zk>
