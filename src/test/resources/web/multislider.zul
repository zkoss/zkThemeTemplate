<?page title="Multislider" contentType="text/html;charset=UTF-8"?>
<zk xmlns:h="native">
<zscript><![CDATA[
    java.util.LinkedHashMap marks = new java.util.LinkedHashMap();
    marks.put(0, "Min");
    marks.put(25, "Low");
    marks.put(50, "Mid");
    marks.put(75, "High");
    marks.put(100, "Max");
]]></zscript>
<div sclass="z-p-8">
    <div sclass="z-border-bottom z-text-xl z-fw-medium z-text-on-surface z-mb-8 z-pb-3">Multislider</div>

    <div sclass="z-mb-6">
        <div sclass="z-text-xs z-fw-semibold z-text-uppercase z-text-secondary z-border-bottom z-pb-2 z-mb-4">Horizontal</div>
        <div sclass="z-d-flex z-flex-col z-align-start z-gap-4 z-py-3">
            <div sclass="z-d-flex z-flex-col z-align-start z-gap-2">
                <div sclass="z-text-xs z-text-secondary">3 ranges</div>
                <multislider width="500px">
                    <sliderbuttons startValue="10" endValue="70"/>
                    <sliderbuttons startValue="20" endValue="50"/>
                    <sliderbuttons startValue="30" endValue="40"/>
                </multislider>
            </div>
        </div>
    </div>

    <div sclass="z-mb-6">
        <div sclass="z-text-xs z-fw-semibold z-text-uppercase z-text-secondary z-border-bottom z-pb-2 z-mb-4">Vertical</div>
        <div sclass="z-d-flex z-align-start z-flex-wrap z-gap-6 z-py-3">
            <div sclass="z-d-flex z-flex-col z-align-center z-gap-2">
                <div sclass="z-text-xs z-text-secondary">2 ranges</div>
                <multislider min="5" max="120" orient="vertical" height="500px">
                    <sliderbuttons startValue="5" endValue="100"/>
                    <sliderbuttons startValue="20" endValue="50"/>
                </multislider>
            </div>
        </div>
    </div>

    <div sclass="z-mb-6">
        <div sclass="z-text-xs z-fw-semibold z-text-uppercase z-text-secondary z-border-bottom z-pb-2 z-mb-4">Marks / Disabled / Tooltip Visible</div>
        <div sclass="z-d-flex z-flex-col z-align-start z-gap-8 z-py-3">
            <div sclass="z-d-flex z-flex-col z-align-start z-gap-2">
                <div sclass="z-text-xs z-text-secondary">Numeric tick labels every 10 (markScale)</div>
                <multislider width="500px" markScale="10">
                    <sliderbuttons startValue="20" endValue="60"/>
                </multislider>
            </div>
            <div sclass="z-d-flex z-flex-col z-align-start z-gap-2">
                <div sclass="z-text-xs z-text-secondary">Custom text marks (Min/Low/Mid/High/Max)</div>
                <multislider width="500px" marks="${marks}">
                    <sliderbuttons startValue="25" endValue="75"/>
                </multislider>
            </div>
            <div sclass="z-d-flex z-flex-col z-align-start z-gap-2">
                <div sclass="z-text-xs z-text-secondary">Disabled</div>
                <multislider width="500px" disabled="true">
                    <sliderbuttons startValue="20" endValue="60"/>
                </multislider>
            </div>
            <div sclass="z-d-flex z-flex-col z-align-start z-gap-8">
                <div sclass="z-text-xs z-text-secondary">Always-visible tooltips</div>
                <multislider width="500px" tooltipVisible="true">
                    <sliderbuttons startValue="30" endValue="70"/>
                </multislider>
            </div>
        </div>
    </div>
</div>
</zk>
