<?page title="Tablelayout" contentType="text/html;charset=UTF-8"?>
<zk xmlns:h="native">
<div sclass="z-p-8">
    <div sclass="z-border-bottom z-text-xl z-fw-medium z-text-on-surface z-mb-8 z-pb-3">Tablelayout</div>

    <div sclass="z-mb-6">
        <div sclass="z-text-xs z-fw-semibold z-text-uppercase z-text-secondary z-border-bottom z-pb-2 z-mb-4">2-Column Table Layout</div>
        <div sclass="z-py-3">
            <tablelayout columns="2">
                <tablechildren>
                    <panel title="Table 1" border="normal" maximizable="true"
                        collapsible="true" width="200px" height="200px">
                        <panelchildren>Panel Content</panelchildren>
                    </panel>
                </tablechildren>
                <tablechildren>
                    <panel title="Table 2" border="normal" maximizable="true"
                        collapsible="true" width="200px" height="200px">
                        <panelchildren>Panel Content</panelchildren>
                    </panel>
                </tablechildren>
                <tablechildren>
                    <panel title="Table 3" border="normal" maximizable="true"
                        collapsible="true" width="200px" height="200px">
                        <panelchildren>Panel Content</panelchildren>
                    </panel>
                </tablechildren>
                <tablechildren>
                    <panel title="Table 4" border="normal" maximizable="true"
                        collapsible="true" width="200px" height="200px">
                        <panelchildren>Panel Content</panelchildren>
                    </panel>
                </tablechildren>
            </tablelayout>
        </div>
    </div>

</div>
</zk>
