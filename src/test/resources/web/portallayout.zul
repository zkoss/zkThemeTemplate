<?page title="Portallayout" contentType="text/html;charset=UTF-8"?>
<zk xmlns:h="native">
<h:link rel="stylesheet" href="pv.css"/>
<div sclass="z-p-8">
    <div sclass="z-border-bottom z-fs-title-lg z-fw-medium z-text-on-surface z-mb-8 z-pb-3">Portallayout</div>

    <div sclass="z-mb-6">
        <div sclass="z-fs-label-sm z-fw-semibold z-text-uppercase z-text-secondary z-border-bottom z-pb-2 z-mb-4">Draggable Portal Panels</div>
        <div sclass="z-py-3">
            <portallayout height="500px">
                <portalchildren width="50%">
                    <panel height="220px" title="Calendar" border="normal">
                        <panelchildren>
                            <calendar/>
                        </panelchildren>
                    </panel>
                    <panel height="220px" title="Colorbox" border="normal">
                        <panelchildren>
                            <colorbox/>
                        </panelchildren>
                    </panel>
                </portalchildren>
                <portalchildren width="50%">
                    <panel height="100%" title="Editor" border="normal">
                        <panelchildren>
                            <tbeditor/>
                        </panelchildren>
                    </panel>
                </portalchildren>
            </portallayout>
        </div>
    </div>

</div>
</zk>
