<?page title="Iframe" contentType="text/html;charset=UTF-8"?>
<zk xmlns:h="native">
<div sclass="z-p-8">
    <div sclass="z-border-bottom z-mb-8 z-pb-3"><label sclass="z-text-2xl z-fw-medium z-text-on-surface" value="Iframe"/></div>
    <div sclass="z-mb-6">
        <div sclass="z-text-uppercase z-border-bottom z-pb-2 z-mb-4"><label sclass="z-text-xs z-fw-semibold z-text-secondary" value="Embedded Frame"/></div>
        <div sclass="z-py-3 z-d-flex z-flex-col z-gap-4">
            <div><label sclass="z-text-xs z-text-secondary" value="Embedding html.zul in an iframe:"/></div>
            <iframe style="width:100%; height:300px;" src="~./html.zul"/>
        </div>
    </div>
</div>
</zk>
