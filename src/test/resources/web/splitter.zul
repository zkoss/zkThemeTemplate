<?page title="Splitter" contentType="text/html;charset=UTF-8"?>
<zk xmlns:h="native">
<div sclass="z-p-8">
    <div sclass="z-border-bottom z-text-xl z-fw-medium z-text-on-surface z-mb-8 z-pb-3">Splitter</div>

    <div sclass="z-mb-6">
        <div sclass="z-text-xs z-fw-semibold z-text-uppercase z-text-secondary z-border-bottom z-pb-2 z-mb-4">Default Mold</div>
        <div sclass="z-py-3">
            <hbox spacing="0" height="300px" style="border: 1px solid rgba(0, 0, 0, 0.15)">
                <vbox spacing="0" width="100%" height="100%">
                    Vbox Top
                    <splitter collapse="before"/>
                    Vbox Bottom
                </vbox>
                <splitter collapse="before"/>
                Hbox Right
            </hbox>
        </div>
    </div>

    <div sclass="z-mb-6">
        <div sclass="z-text-xs z-fw-semibold z-text-uppercase z-text-secondary z-border-bottom z-pb-2 z-mb-4">OS Mold — Collapse None</div>
        <div sclass="z-py-3">
            <hbox spacing="0" height="300px" style="border: 1px solid rgba(0, 0, 0, 0.15)">
                <vbox spacing="0" width="100%" height="100%">
                    Vbox Top
                    <splitter mold="os" collapse="none"/>
                    Vbox Bottom
                </vbox>
                <splitter mold="os" collapse="none"/>
                Hbox Right
            </hbox>
        </div>
    </div>

    <div sclass="z-mb-6">
        <div sclass="z-text-xs z-fw-semibold z-text-uppercase z-text-secondary z-border-bottom z-pb-2 z-mb-4">OS Mold — Collapse Before</div>
        <div sclass="z-py-3">
            <hbox spacing="0" height="300px" style="border: 1px solid rgba(0, 0, 0, 0.15)">
                <vbox spacing="0" width="100%" height="100%">
                    Vbox Top
                    <splitter mold="os" collapse="before"/>
                    Vbox Bottom
                </vbox>
                <splitter mold="os" collapse="before"/>
                Hbox Right
            </hbox>
        </div>
    </div>

</div>
</zk>
