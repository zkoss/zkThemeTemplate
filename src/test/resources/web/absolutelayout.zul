<?page title="Absolutelayout" contentType="text/html;charset=UTF-8"?>
<?component name="window" extends="window" border="normal" width="200px" height="120px"?>
<zk xmlns:h="native">
<div sclass="z-p-8">
    <div sclass="z-border-bottom z-mb-8 z-pb-3"><label sclass="z-text-2xl z-fw-medium z-text-on-surface" value="Absolutelayout"/></div>

    <div sclass="z-mb-6">
        <div sclass="z-text-uppercase z-border-bottom z-pb-2 z-mb-4"><label sclass="z-text-xs z-fw-semibold z-text-secondary" value="Absolute Positioning"/></div>
        <div sclass="z-py-3">
            <absolutelayout height="400px">
                <absolutechildren id="w1" x="20" y="20">
                    <window title="X=20, Y=20">
                        Window 1
                    </window>
                </absolutechildren>
                <absolutechildren id="w2" x="160" y="100">
                    <window title="X=160, Y=100">
                        Window 2
                    </window>
                </absolutechildren>
                <absolutechildren id="w3" x="300" y="200">
                    <window title="X=300, Y=200">
                        Window 3
                    </window>
                </absolutechildren>
            </absolutelayout>
        </div>
    </div>

</div>
</zk>
