<?page title="Progressmeter" contentType="text/html;charset=UTF-8"?>
<zk xmlns:h="native" xmlns:w="http://www.zkoss.org/2005/zk/client">
<div sclass="z-p-8">
    <div sclass="z-border-bottom z-text-xl z-fw-medium z-text-on-surface z-mb-8 z-pb-3">Progressmeter</div>
    <div sclass="z-mb-6">
        <div sclass="z-text-xs z-fw-semibold z-text-uppercase z-text-secondary z-border-bottom z-pb-2 z-mb-4">Values</div>
        <div sclass="z-d-flex z-align-start z-flex-wrap z-gap-6 z-py-3">
            <div sclass="z-d-flex z-flex-col z-align-start z-gap-2">
                <div sclass="z-text-xs z-text-secondary">0%</div>
                <progressmeter value="0" width="200px"/>
            </div>
            <div sclass="z-d-flex z-flex-col z-align-start z-gap-2">
                <div sclass="z-text-xs z-text-secondary">25%</div>
                <progressmeter value="25" width="200px"/>
            </div>
            <div sclass="z-d-flex z-flex-col z-align-start z-gap-2">
                <div sclass="z-text-xs z-text-secondary">50%</div>
                <progressmeter value="50" width="200px"/>
            </div>
            <div sclass="z-d-flex z-flex-col z-align-start z-gap-2">
                <div sclass="z-text-xs z-text-secondary">75%</div>
                <progressmeter value="75" width="200px"/>
            </div>
            <div sclass="z-d-flex z-flex-col z-align-start z-gap-2">
                <div sclass="z-text-xs z-text-secondary">100%</div>
                <progressmeter value="100" width="200px"/>
            </div>
        </div>
    </div>
    <div sclass="z-mb-6">
        <div sclass="z-text-xs z-fw-semibold z-text-uppercase z-text-secondary z-border-bottom z-pb-2 z-mb-4">Colors</div>
        <div sclass="z-d-flex z-align-start z-flex-wrap z-gap-6 z-py-3">
            <div sclass="z-d-flex z-flex-col z-align-start z-gap-2">
                <div sclass="z-text-xs z-text-secondary">Secondary</div>
                <progressmeter value="60" width="200px" sclass="z-progressmeter-secondary"/>
            </div>
            <div sclass="z-d-flex z-flex-col z-align-start z-gap-2">
                <div sclass="z-text-xs z-text-secondary">Success</div>
                <progressmeter value="60" width="200px" sclass="z-progressmeter-success"/>
            </div>
            <div sclass="z-d-flex z-flex-col z-align-start z-gap-2">
                <div sclass="z-text-xs z-text-secondary">Warning</div>
                <progressmeter value="60" width="200px" sclass="z-progressmeter-warning"/>
            </div>
            <div sclass="z-d-flex z-flex-col z-align-start z-gap-2">
                <div sclass="z-text-xs z-text-secondary">Error</div>
                <progressmeter value="60" width="200px" sclass="z-progressmeter-error"/>
            </div>
        </div>
    </div>

    <div sclass="z-mb-6">
        <div sclass="z-text-xs z-fw-semibold z-text-uppercase z-text-secondary z-border-bottom z-pb-2 z-mb-4">Interactive</div>
        <div sclass="z-d-flex z-flex-col z-gap-3 z-py-3">
            <div sclass="z-d-flex z-align-center z-gap-3">
                <progressmeter id="pm" value="50" width="200px"/>
                <label id="lb" value="50"/><span sclass="z-text-xs z-text-secondary">/100</span>
            </div>
            <slider curpos="50" width="200px">
                <attribute w:name="onScroll"><![CDATA[
                    var pos = this.getCurpos();
                    this.$f("pm").setValue(pos);
                    this.$f("lb").setValue(pos);
                ]]></attribute>
            </slider>
            <div sclass="z-text-xs z-text-secondary">Drag slider to change value</div>
        </div>
    </div>

    <div sclass="z-mb-6">
        <div sclass="z-text-xs z-fw-semibold z-text-uppercase z-text-secondary z-border-bottom z-pb-2 z-mb-4">Indeterminate</div>
        <div sclass="z-d-flex z-align-start z-flex-wrap z-gap-6 z-py-3">
            <div sclass="z-d-flex z-flex-col z-align-start z-gap-2">
                <div sclass="z-text-xs z-text-secondary">indeterminate="true" (animated)</div>
                <progressmeter indeterminate="true" width="200px"/>
            </div>
        </div>
    </div>
</div>
</zk>
