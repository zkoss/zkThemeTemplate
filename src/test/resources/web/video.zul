<?page title="Video" contentType="text/html;charset=UTF-8"?>
<zk xmlns:h="native">
<div sclass="z-p-8">
    <div sclass="z-border-bottom z-mb-8 z-pb-3"><label sclass="z-text-2xl z-fw-medium z-text-on-surface" value="Video"/></div>
    <div sclass="z-mb-6">
        <div sclass="z-text-uppercase z-border-bottom z-pb-2 z-mb-4"><label sclass="z-text-xs z-fw-semibold z-text-secondary" value="Player"/></div>
        <div sclass="z-py-3 z-d-flex z-flex-col z-gap-4">
            <div><label sclass="z-text-xs z-text-secondary" value="Note: provide a valid video URL via src attribute (e.g. an .mp4 file)."/></div>
            <video id="video" width="480px" src="~./media/video.mp4" poster="~./img/ZK-Logo.gif" controls="true"/>
        </div>
    </div>
    <div sclass="z-mb-6">
        <div sclass="z-text-uppercase z-border-bottom z-pb-2 z-mb-4"><label sclass="z-text-xs z-fw-semibold z-text-secondary" value="Controls"/></div>
        <div sclass="z-py-3 z-d-flex z-gap-4 z-flex-wrap">
            <button label="Play" onClick="video.play()"/>
            <button label="Pause" onClick="video.pause()"/>
            <button label="Stop" onClick="video.stop()"/>
        </div>
    </div>
</div>
</zk>
