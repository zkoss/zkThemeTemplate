<?page title="Scrollbar" contentType="text/html;charset=UTF-8"?>
<zk xmlns:h="native" xmlns:ca="client/attribute">
<zscript><![CDATA[
    Object[] rows = new Object[50];
]]></zscript>
<div sclass="z-p-8">
    <div sclass="z-border-bottom z-text-xl z-fw-medium z-text-on-surface z-mb-8 z-pb-3">Scrollbar</div>

    <div sclass="z-mb-8">
        <div sclass="z-text-md z-fw-bold z-text-uppercase z-text-secondary z-border-bottom z-pb-2 z-mb-3">Scrollbar — State Gallery</div>

        <!-- This gallery mirrors the live zul.Scrollbar DOM, which emits the FA-style
             caret-up/down/left/right icon classes (aliased to chevrons via FA_TO_LUCIDE)
             — keep them verbatim so the mockup matches the real widget; do NOT rename to chevron. -->
        <div sclass="z-d-flex z-flex-wrap z-gap-6 z-align-start z-py-4 z-mb-2">
            <div sclass="z-d-flex z-flex-col z-align-center z-gap-2">
                <div sclass="z-text-xs z-fw-semibold z-text-uppercase z-text-center z-text-secondary">Vertical</div>
                <h:div style="position:relative;width:16px;height:120px;background:var(--zk-color-surface-container-low);border-radius:4px;">
                    <h:div class="z-scrollbar z-scrollbar-vertical" style="display:block;right:0;">
                        <h:div class="z-scrollbar-up"><h:i class="z-icon-caret-up"/></h:div>
                        <h:div class="z-scrollbar-wrapper" style="top:12px;bottom:12px;">
                            <h:div class="z-scrollbar-rail"/>
                            <h:div class="z-scrollbar-indicator" style="height:40px;top:10px;"/>
                        </h:div>
                        <h:div class="z-scrollbar-down"><h:i class="z-icon-caret-down"/></h:div>
                    </h:div>
                </h:div>
            </div>
            <div sclass="z-d-flex z-flex-col z-align-center z-gap-2">
                <div sclass="z-text-xs z-fw-semibold z-text-uppercase z-text-center z-text-secondary">Horizontal</div>
                <h:div style="position:relative;width:120px;height:16px;background:var(--zk-color-surface-container-low);border-radius:4px;">
                    <h:div class="z-scrollbar z-scrollbar-horizontal" style="display:block;bottom:0;">
                        <h:div class="z-scrollbar-left"><h:i class="z-icon-caret-left"/></h:div>
                        <h:div class="z-scrollbar-wrapper" style="left:12px;right:12px;width:auto;">
                            <h:div class="z-scrollbar-rail"/>
                            <h:div class="z-scrollbar-indicator" style="width:40px;left:10px;"/>
                        </h:div>
                        <h:div class="z-scrollbar-right"><h:i class="z-icon-caret-right"/></h:div>
                    </h:div>
                </h:div>
            </div>
        </div>
    </div>

    <div sclass="z-mb-6">
        <div sclass="z-text-xs z-fw-semibold z-text-uppercase z-text-secondary z-border-bottom z-pb-2 z-mb-4">Default (Mouse Over)</div>
        <div sclass="z-d-flex z-align-start z-gap-8 z-py-4 z-border-bottom">
            <div sclass="z-flex-grow-0">
                <grid width="240px" height="200px" ca:data-embedscrollbar="false">
                    <custom-attributes org.zkoss.zul.nativebar="false"/>
                    <columns>
                        <column label="Column 1" width="120px"/>
                        <column label="Column 2" width="120px"/>
                        <column label="Column 3" width="120px"/>
                        <column label="Column 4" width="120px"/>
                    </columns>
                    <rows>
                        <row forEach="${rows}">
                            <label value="Item ${forEachStatus.index}"/>
                            <label value="Value ${forEachStatus.index}"/>
                            <label value="Detail ${forEachStatus.index}"/>
                            <label value="Note ${forEachStatus.index}"/>
                        </row>
                    </rows>
                </grid>
            </div>
            <div sclass="z-flex-1 z-d-flex z-flex-col z-gap-2">
                <div sclass="z-text-sm z-fw-medium z-text-on-surface">Overlay scrollbar</div>
                <div sclass="z-text-sm z-text-secondary">Simulated overlay bar (nativebar=false, data-embedscrollbar=false). Hidden at rest — a slim bar fades in only while the pointer is over the grid body, floats on top of the content, and reserves no layout space. It fades out again on mouse-leave.</div>
            </div>
        </div>
        <div sclass="z-d-flex z-align-start z-gap-8 z-py-4 z-border-bottom">
            <div sclass="z-flex-grow-0">
                <grid width="240px" height="200px" ca:data-embedscrollbar="true">
                    <custom-attributes org.zkoss.zul.nativebar="false"/>
                    <columns>
                        <column label="Column 1" width="120px"/>
                        <column label="Column 2" width="120px"/>
                        <column label="Column 3" width="120px"/>
                        <column label="Column 4" width="120px"/>
                    </columns>
                    <rows>
                        <row forEach="${rows}">
                            <label value="Item ${forEachStatus.index}"/>
                            <label value="Value ${forEachStatus.index}"/>
                            <label value="Detail ${forEachStatus.index}"/>
                            <label value="Note ${forEachStatus.index}"/>
                        </row>
                    </rows>
                </grid>
            </div>
            <div sclass="z-flex-1 z-d-flex z-flex-col z-gap-2">
                <div sclass="z-text-sm z-fw-medium z-text-on-surface">Embedded scrollbar</div>
                <div sclass="z-text-sm z-text-secondary">Simulated embedded bar (nativebar=false, data-embedscrollbar=true). A thin rail stays visible at all times inside a reserved gutter; hovering the grid body thickens it into the full draggable indicator. The gutter permanently narrows the content area.</div>
            </div>
        </div>
        <div sclass="z-d-flex z-align-start z-gap-8 z-py-4">
            <div sclass="z-flex-grow-0">
                <grid width="240px" height="200px">
                    <custom-attributes org.zkoss.zul.nativebar="true"/>
                    <columns>
                        <column label="Column 1" width="120px"/>
                        <column label="Column 2" width="120px"/>
                        <column label="Column 3" width="120px"/>
                        <column label="Column 4" width="120px"/>
                    </columns>
                    <rows>
                        <row forEach="${rows}">
                            <label value="Item ${forEachStatus.index}"/>
                            <label value="Value ${forEachStatus.index}"/>
                            <label value="Detail ${forEachStatus.index}"/>
                            <label value="Note ${forEachStatus.index}"/>
                        </row>
                    </rows>
                </grid>
            </div>
            <div sclass="z-flex-1 z-d-flex z-flex-col z-gap-2">
                <div sclass="z-text-sm z-fw-medium z-text-on-surface">Native scrollbar</div>
                <div sclass="z-text-sm z-text-secondary">Browser / OS native bar (nativebar=true). ZK draws no scrollbar widget, so the look follows the platform default and always occupies layout space. The theme can only restyle it through CSS ::-webkit-scrollbar.</div>
            </div>
        </div>
    </div>
</div>
</zk>
