<?page title="Scrollbar" contentType="text/html;charset=UTF-8"?>
<zk xmlns:h="native" xmlns:ca="client/attribute">
<h:link rel="stylesheet" href="pv.css"/>
<zscript><![CDATA[
    Object[] rows = new Object[50];
]]></zscript>
<div sclass="z-p-8">
    <div sclass="z-border-bottom z-fs-title-lg z-fw-medium z-text-on-surface z-mb-8 z-pb-3">Scrollbar</div>
    <div sclass="z-mb-6">
        <div sclass="z-fs-label-sm z-fw-semibold z-text-uppercase z-text-secondary z-border-bottom z-pb-2 z-mb-4">Default (Mouse Over)</div>
        <div sclass="z-d-flex z-align-end z-flex-wrap z-gap-6 z-py-3">
            <div sclass="z-d-flex z-flex-col z-align-start z-gap-2">
                <grid width="240px" height="200px" ca:data-embedscrollbar="false">
                    <custom-attributes org.zkoss.zul.nativebar="false"/>
                    <columns>
                        <column label="Column 1" width="120px"/>
                        <column label="Column 2" width="120px"/>
                    </columns>
                    <rows>
                        <row forEach="${rows}">
                            <label value="Item ${forEachStatus.index}"/>
                            <label value="Value ${forEachStatus.index}"/>
                        </row>
                    </rows>
                </grid>
                <div sclass="z-fs-label-sm z-text-secondary">ZK scrollbar</div>
            </div>
            <div sclass="z-d-flex z-flex-col z-align-start z-gap-2">
                <grid width="240px" height="200px" ca:data-embedscrollbar="true">
                    <custom-attributes org.zkoss.zul.nativebar="false"/>
                    <columns>
                        <column label="Column 1" width="120px"/>
                        <column label="Column 2" width="120px"/>
                    </columns>
                    <rows>
                        <row forEach="${rows}">
                            <label value="Item ${forEachStatus.index}"/>
                            <label value="Value ${forEachStatus.index}"/>
                        </row>
                    </rows>
                </grid>
                <div sclass="z-fs-label-sm z-text-secondary">Embedded scrollbar</div>
            </div>
            <div sclass="z-d-flex z-flex-col z-align-start z-gap-2">
                <grid width="240px" height="200px">
                    <custom-attributes org.zkoss.zul.nativebar="true"/>
                    <columns>
                        <column label="Column 1" width="120px"/>
                        <column label="Column 2" width="120px"/>
                    </columns>
                    <rows>
                        <row forEach="${rows}">
                            <label value="Item ${forEachStatus.index}"/>
                            <label value="Value ${forEachStatus.index}"/>
                        </row>
                    </rows>
                </grid>
                <div sclass="z-fs-label-sm z-text-secondary">Native scrollbar</div>
            </div>
        </div>
    </div>
</div>
</zk>
