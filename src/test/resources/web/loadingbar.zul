<?page title="Loadingbar" contentType="text/html;charset=UTF-8"?>
<zk xmlns:h="native">
<h:link rel="stylesheet" href="pv.css"/>
<div sclass="z-p-8">
    <div sclass="z-border-bottom z-fs-title-lg z-fw-medium z-text-on-surface z-mb-8 z-pb-3">Loadingbar</div>

    <div sclass="pv-section">
        <div sclass="pv-section-title">Loadingbar — State Gallery</div>

        <div sclass="pv-state-gallery pv-variant-default">
            <div sclass="pv-state-col">
                <div sclass="pv-state-label">30%</div>
                <h:div class="z-loadingbar" style="width:240px;">
                    <h:div class="z-loadingbar-colorbar" style="width:30%"/>
                </h:div>
            </div>
            <div sclass="pv-state-col">
                <div sclass="pv-state-label">70%</div>
                <h:div class="z-loadingbar" style="width:240px;">
                    <h:div class="z-loadingbar-colorbar" style="width:70%"/>
                </h:div>
            </div>
            <div sclass="pv-state-col">
                <div sclass="pv-state-label">100%</div>
                <h:div class="z-loadingbar" style="width:240px;">
                    <h:div class="z-loadingbar-colorbar" style="width:100%"/>
                </h:div>
            </div>
            <div sclass="pv-state-col">
                <div sclass="pv-state-label">Indeterminate</div>
                <h:div class="z-loadingbar" style="width:240px;overflow:hidden;">
                    <h:div class="z-loadingbar-indeterminate">
                        <h:div class="z-loadingbar-image"/>
                        <h:div class="z-loadingbar-effectbar"/>
                    </h:div>
                </h:div>
            </div>
        </div>
    </div>

    <div sclass="z-mb-6">
        <div sclass="z-fs-label-sm z-fw-semibold z-text-uppercase z-text-secondary z-border-bottom z-pb-2 z-mb-4">Top Position</div>
        <div sclass="z-py-3">
            <div sclass="z-d-flex z-align-start z-gap-2 z-flex-col">
                <div sclass="z-fs-label-md z-text-secondary">Simulated top loading bar (position:relative for demo):</div>
                <h:div style="position:relative;width:100%;height:20px;">
                    <h:div class="z-loadingbar-position z-loadingbar-position-top" style="position:relative;width:100%;">
                        <h:div class="z-loadingbar">
                            <h:div class="z-loadingbar-colorbar" style="width:60%"/>
                        </h:div>
                    </h:div>
                </h:div>
            </div>
        </div>
    </div>
</div>
</zk>
