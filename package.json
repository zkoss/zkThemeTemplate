{
  "name": "zk-theme-template",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "zklessc": "zklessc -s src/main/resources/web -o target/classes/web/iceblue_css",
    "zklessc-dev": "zklessc -s src/main/resources/web -o target/classes/web/iceblue_css -w",
    "build:css": "node scripts/build-css.js -s src/main/resources/web -o target/classes/web/iceblue_css",
    "baseline": "node scripts/baseline.js",
    "gen:baseline-manifest": "node scripts/baseline-ab.js manifest",
    "check:baseline": "node scripts/baseline-ab.js check",
    "ab": "node scripts/baseline-ab.js status",
    "gen:var-table": "node scripts/gen-var-table.js",
    "check:var-table": "node scripts/gen-var-table.js --check",
    "check:less-conventions": "node scripts/check-less-conventions.js",
    "check:build-css": "node scripts/check-build-css.js",
    "check:bytes": "node scripts/check-bytes.js",
    "less2css": "node scripts/less2css.js",
    "gen:fa-css": "node scripts/gen-fa-css.js",
    "check:fa-css": "node scripts/gen-fa-css.js --check",
    "build:tree": "zklessc -s src/main/resources/web -o target/classes/web/iceblue_css --compress && npm run build:css",
    "check:gate": "npm run check:less-conventions && npm run check:fa-css && npm run build:tree && npm run check:p4a",
    "check:cssdiff": "npm run check:less-conventions && npm run check:fa-css && npm run build:tree && node scripts/cssdiff.js baseline/ target/classes/web/iceblue_css",
    "p4a:strip": "node scripts/p4a-strip-prefixes.js",
    "p4a:delta": "node scripts/p4a-delta.js",
    "check:p4a": "node scripts/check-p4a-delta.js --expect 728",
    "gen:mixin-table": "node scripts/gen-mixin-table.js",
    "check:mixin-table": "node scripts/gen-mixin-table.js --check",
    "visual:selftest": "node scripts/ab-visual.js selftest",
    "visual:capture": "node scripts/ab-visual.js capture",
    "visual:diff": "node scripts/ab-visual.js diff",
    "visual:coverage": "node scripts/ab-coverage.js"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "clean-css": "^5.3.3",
    "zkless-engine": "^1.1.9"
  },
  "overrides": {
    "zkless-engine": {
      "less": "4.8.1"
    }
  }
}
