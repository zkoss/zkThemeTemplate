{
  "name": "zk-theme-template",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build:css": "node scripts/build-css.js -s src/main/resources/web -o target/classes/web/iceblue11",
    "baseline": "node scripts/baseline.js",
    "gen:baseline-manifest": "node scripts/baseline-ab.js manifest",
    "check:baseline": "node scripts/baseline-ab.js check",
    "ab": "node scripts/baseline-ab.js status",
    "gen:var-table": "node scripts/gen-var-table.js",
    "check:less-conventions": "node scripts/check-less-conventions.js",
    "check:build-css": "node scripts/check-build-css.js",
    "check:doc-refs": "node scripts/check-doc-refs.js",
    "check:bytes": "node scripts/check-bytes.js",
    "less2css": "node scripts/less2css.js",
    "gen:fa-css": "node scripts/gen-fa-css.js",
    "check:fa-css": "node scripts/gen-fa-css.js --check",
    "gen:density-css": "node scripts/gen-density-css.js",
    "check:density-css": "node scripts/gen-density-css.js --check",
    "build:tree": "npm run build:css",
    "check:gate": "npm run check:baseline && npm run check:fa-css && npm run check:density-css && npm run build:tree && npm run check:p4a && npm run check:p4b",
    "check:cssdiff": "npm run check:fa-css && npm run build:tree && node scripts/cssdiff.js baseline/ target/classes/web/iceblue11",
    "p4a:strip": "node scripts/p4a-strip-prefixes.js",
    "p4a:delta": "node scripts/p4a-delta.js",
    "p4b:delta": "node scripts/p4b-delta.js",
    "check:p4a": "node scripts/check-p4a-delta.js --expect 731",
    "check:p4b": "node scripts/check-p4b-delta.js",
    "gen:mixin-table": "node scripts/gen-mixin-table.js",
    "visual:selftest": "node scripts/ab-visual.js selftest",
    "visual:capture": "node scripts/ab-visual.js capture",
    "visual:diff": "node scripts/ab-visual.js diff",
    "visual:coverage": "node scripts/ab-coverage.js",
    "check:density-property": "node scripts/check-density-property.js",
    "check:tablet-density": "node scripts/check-tablet-density.js",
    "tablet:delta": "node scripts/tablet-delta.js"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "clean-css": "^5.3.3",
    "less": "4.8.1"
  }
}
