{
  "name": "zk-material-theme",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build:css": "node scripts/build-css.js",
    "build:css:dev": "node scripts/build-css.js --dev",
    "watch": "chokidar 'src/main/resources/web/css/**/*.css' -c 'npm run build:css:dev'",
    "minify": "cleancss -o target/classes/web/zk-material/css/zk-material.min.css target/classes/web/zk-material/css/zk-material.css"
  },
  "devDependencies": {
    "chokidar-cli": "^3.0.0",
    "clean-css-cli": "^5.6.0"
  }
}
