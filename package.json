{
  "name": "marble-theme",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build:css": "node scripts/build-css.js",
    "build:css:dev": "node scripts/build-css.js --dev",
    "check:css-dsp": "node scripts/check-css-dsp.js",
    "check:forced-colors": "node scripts/check-forced-colors.js",
    "test:forced-colors": "playwright test --config src/test/playwright/playwright.config.ts --project=forced-colors",
    "capture:forced-colors": "playwright test --config src/test/playwright/playwright.config.ts --project=forced-colors-gallery",
    "review:forced-colors": "node scripts/build-forced-colors-review.js",
    "watch": "node scripts/watch-css.js",
    "minify": "cleancss -o target/classes/web/marble/css/marble.min.css target/classes/web/marble/css/marble.css",
    "lint:css": "stylelint \"src/main/resources/web/**/*.css\"",
    "audit:css": "bash .claude/skills/css-theme-audit/scripts/audit-css.sh",
    "screenshot:test": "playwright test --config src/test/playwright/playwright.config.ts",
    "screenshot:update": "playwright test --config src/test/playwright/playwright.config.ts --update-snapshots"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@playwright/test": "^1.59.1",
    "chokidar": "^3.5.3",
    "clean-css": "^5.3.3",
    "clean-css-cli": "^5.6.0",
    "lucide-static": "^1.11.0",
    "stylelint": "^16.26.1",
    "stylelint-config-standard": "^36.0.1"
  }
}
