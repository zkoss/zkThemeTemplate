{
  "name": "zk-theme-template",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "zklessc": "zklessc -s src/main/resources/web -o target/classes/web/___THEME_NAME___",
    "zklessc-dev": "zklessc -s src/main/resources/web -o target/classes/web/___THEME_NAME___ -w",
    "build:css": "node scripts/build-css.js -s src/main/resources/web -o target/classes/web/iceblue",
    "baseline": "node scripts/baseline.js",
    "gen:baseline-manifest": "node scripts/baseline-ab.js manifest",
    "check:baseline": "node scripts/baseline-ab.js check",
    "ab": "node scripts/baseline-ab.js status",
    "gen:var-table": "node scripts/gen-var-table.js",
    "check:var-table": "node scripts/gen-var-table.js --check",
    "check:less-conventions": "node scripts/check-less-conventions.js",
    "check:build-css": "node scripts/check-build-css.js",
    "check:bytes": "node scripts/check-bytes.js",
    "less2css": "node scripts/less2css.js",
    "gen:fa-css": "node scripts/gen-fa-css.js",
    "check:fa-css": "node scripts/gen-fa-css.js --check",
    "check:cssdiff": "npm run check:less-conventions && npm run check:fa-css && zklessc -s src/main/resources/web -o target/classes/web/iceblue --compress && npm run build:css && node scripts/cssdiff.js baseline/ target/classes/web/iceblue",
    "gen:mixin-table": "node scripts/gen-mixin-table.js",
    "check:mixin-table": "node scripts/gen-mixin-table.js --check"
  },
  "devDependencies": {
    "clean-css": "^5.3.3",
    "zkless-engine": "^1.1.9"
  },
  "overrides": {
    "zkless-engine": {
      "less": "4.8.1"
    }
  }
}
