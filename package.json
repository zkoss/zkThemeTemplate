{
  "name": "zk-theme-template",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "zklessc": "zklessc -s src/main/resources/web -o target/classes/web/___THEME_NAME___",
    "zklessc-dev": "zklessc -s src/main/resources/web -o target/classes/web/___THEME_NAME___ -w",
    "baseline": "node scripts/baseline.js",
    "check:cssdiff": "zklessc -s src/main/resources/web -o target/classes/web/iceblue --compress && node scripts/cssdiff.js baseline/ target/classes/web/iceblue"
  },
  "devDependencies": {
    "zkless-engine": "^1.1.9"
  }
}
