<%@ taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c" %><%@ taglib uri="http://www.zkoss.org/dsp/zk/core" prefix="z" %><%@ taglib uri="http://www.zkoss.org/dsp/web/theme" prefix="t" %>.z-daterangebox-status{position:absolute;width:1px;height:1px;margin:-1px;padding:0;border:0;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}.z-daterangebox{display:inline-flex;align-items:center;border:1px solid var(--zk-input-border-color);border-radius:var(--zk-input-border-radius);background:var(--zk-input-background-color);padding:0;box-sizing:border-box;vertical-align:middle;min-height:32px}.z-daterangebox-input{border:0;outline:0;background:transparent;padding:var(--zk-input-padding);flex:1 1 0;min-width:0;font-family:var(--zk-base-content-font-family);font-size:var(--zk-font-size-medium);color:var(--zk-input-color);text-align:center}.z-daterangebox-separator{display:flex;align-items:center;justify-content:center;padding:0 4px;color:var(--zk-input-color);opacity:.6;flex:0 0 auto;align-self:stretch}.z-daterangebox-button{cursor:pointer;padding:0 8px;display:inline-flex;align-items:center;color:var(--zk-input-color);flex:0 0 auto}.z-daterangebox-button:hover{color:var(--zk-color-primary)}.z-daterangebox-focused{border-color:var(--zk-color-primary);box-shadow:0 0 0 2px var(--zk-color-primary-lighter)}.z-daterangebox-invalid{border-color:var(--zk-errorbox-border-color)}.z-daterangebox-disabled{background:var(--zk-disabled-background-color) !important;cursor:not-allowed}.z-daterangebox-disabled .z-daterangebox-input,.z-daterangebox-disabled .z-daterangebox-separator,.z-daterangebox-disabled .z-daterangebox-button{color:var(--zk-disabled-color);cursor:not-allowed}.z-daterangebox-disabled .z-daterangebox-input{background:transparent}.z-daterangebox-popup{position:absolute;background:var(--zk-popup-background-color);border:1px solid var(--zk-popup-border-color);border-radius:4px;box-shadow:0 4px 16px rgba(0,0,0,0.15);z-index:90000;display:flex;flex-direction:column;font-size:var(--zk-font-size-medium)}.z-daterangebox-popup .z-calendar-cell.z-calendar-selected:not(.z-cell-range-begin):not(.z-cell-range-end):not(.z-cell-range-mid){background:transparent;color:var(--zk-calendar-cell-color)}.z-daterangebox-popup .z-calendar-cell.z-calendar-selected.z-cell-range-mid{color:var(--zk-calendar-cell-color)}.z-daterangebox-popup .z-calendar-cell.z-calendar-outside{visibility:hidden}.z-daterangebox-popup-panels{display:grid;grid-template-columns:repeat(var(--panels, 2), auto);gap:12px;padding:12px 12px 0}.z-daterangebox-popup-times{display:grid;grid-template-columns:repeat(var(--panels, 2), auto);gap:12px;padding:12px 12px 0;justify-items:center}.z-daterangebox-popup-times .z-timebox{width:75%;font-size:var(--zk-font-size-small)}.z-daterangebox-popup-footer{display:flex;align-items:center;justify-content:space-between;padding:12px;margin-top:12px;border-top:1px solid var(--zk-base-border-color)}.z-daterangebox-popup .z-calendar-today{display:none}.z-daterangebox-popup-linked .z-daterangebox-popup-panels .z-calendar:not(:first-child) .z-calendar-left{visibility:hidden}.z-daterangebox-popup-linked .z-daterangebox-popup-panels .z-calendar:not(:last-child) .z-calendar-right{visibility:hidden}.z-daterangebox-popup-clear,.z-daterangebox-popup-today,.z-daterangebox-popup-cancel{cursor:pointer;padding:2px 10px;font-family:var(--zk-base-content-font-family);font-size:var(--zk-font-size-small);line-height:1.4;border:1px solid var(--zk-button-border-color);border-radius:3px;background:var(--zk-button-background-color);color:var(--zk-button-color)}.z-daterangebox-popup-clear:hover,.z-daterangebox-popup-today:hover,.z-daterangebox-popup-cancel:hover{background:var(--zk-button-hover-background-color);border-color:var(--zk-button-hover-border-color);color:var(--zk-button-hover-color)}.z-daterangebox-popup-today{background:var(--zk-color-primary);border-color:var(--zk-color-primary);color:var(--zk-calendar-selected-color)}.z-daterangebox-popup-today:hover{background:var(--zk-color-primary-dark);border-color:var(--zk-color-primary-dark);color:var(--zk-calendar-selected-color)}@media (max-width:576px){.z-daterangebox-popup{position:fixed !important;top:0 !important;left:0 !important;right:0;bottom:0;width:100vw;height:100vh;max-width:100vw;max-height:100vh;border-radius:0;box-shadow:none;display:flex;flex-direction:column;overflow:hidden}.z-daterangebox-popup-panels{grid-template-columns:1fr;overflow-y:auto;flex:1 1 auto}.z-daterangebox-popup-times{grid-template-columns:1fr}.z-daterangebox-popup-linked .z-daterangebox-popup-panels .z-calendar:not(:first-child) .z-calendar-left,.z-daterangebox-popup-linked .z-daterangebox-popup-panels .z-calendar:not(:last-child) .z-calendar-right{visibility:visible}.z-daterangebox-popup-footer{margin-top:0;flex:0 0 auto}}