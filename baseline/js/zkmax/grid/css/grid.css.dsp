<%@ taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c" %><%@ taglib uri="http://www.zkoss.org/dsp/zk/core" prefix="z" %><%@ taglib uri="http://www.zkoss.org/dsp/web/theme" prefix="t" %>.z-grid.z-sticky-header{overflow:visible}.z-grid.z-sticky-header .z-grid-header{position:sticky;top:0;z-index:1}.z-column.z-frozen-sticky,.z-row .z-row-inner.z-frozen-sticky,.z-row .z-cell.z-frozen-sticky,.z-group-inner.z-frozen-sticky,.z-detail-outer.z-frozen-sticky{position:sticky;z-index:1}.z-grid--stacking{overflow-y:auto;overflow-x:hidden}.z-grid--stacking>.z-grid-header,.z-grid--stacking .z-frozen{display:none}.z-grid--stacking>.z-grid-body,.z-grid--stacking>.z-grid-footer{overflow-x:hidden;max-width:100%}.z-grid--stacking>.z-grid-body>table,.z-grid--stacking>.z-grid-footer>table{width:100% !important;min-width:0;table-layout:auto}.z-grid--stacking .z-grid-body>table,.z-grid--stacking .z-grid-body>table>thead{display:block}.z-grid--stacking .z-grid-body>table>thead>tr{display:none}.z-grid--stacking .z-grid-body>table>tbody:not(.z-grid-emptybody){display:grid;grid-template-columns:repeat(var(--zk-resp-cols, 1), 1fr);gap:8px;padding:8px;box-sizing:border-box}.z-grid--stacking .z-grid-body>table>tbody:not(.z-grid-emptybody)>tr{display:flex;flex-direction:column;border:1px solid var(--zk-base-border-color);border-radius:4px;background:var(--zk-mesh-background-color);overflow:hidden}.z-grid--stacking .z-grid-body>table>tbody:not(.z-grid-emptybody)>tr>td{display:block;padding:var(--zk-mesh-body-padding);border-top:none;border-bottom:none}.z-grid--stacking .z-grid-body>table>tbody:not(.z-grid-emptybody)>tr>td:not(.z-cell-hide-stacking)~td:not(.z-cell-hide-stacking){border-top:1px solid var(--zk-mesh-content-border-color)}.z-grid--stacking .z-grid-body>table>tbody:not(.z-grid-emptybody)>tr>td[data-label]:not([data-label=""])::before{content:attr(data-label);display:block;margin-bottom:2px;font-family:var(--zk-base-content-font-family);font-size:var(--zk-font-size-small);font-weight:600;font-style:normal;color:var(--zk-text-color-light)}.z-grid--stacking .z-grid-body>table>tbody:not(.z-grid-emptybody)>tr>td.z-cell-hide-stacking{display:none}.z-grid--stacking .z-grid-body>table>tbody:not(.z-grid-emptybody)>tr.z-groupfoot>td.z-cell-hide-stacking{display:none}.z-grid--stacking .z-grid-body>table>tbody:not(.z-grid-emptybody)>tr.z-group,.z-grid--stacking .z-grid-body>table>tbody:not(.z-grid-emptybody)>tr.z-groupfoot{grid-column-start:1;grid-column-end:-1}.z-grid--stacking .z-grid-body>table>tbody:not(.z-grid-emptybody)>tr.z-group>td::before{content:none}.z-grid--stacking .z-grid-body>table>tbody:not(.z-grid-emptybody)>tr.z-groupfoot{background:var(--zk-mesh-group-footer-background-color)}.z-grid--stacking .z-grid-body>table>tbody:not(.z-grid-emptybody)>tr.z-grid-odd{background:var(--zk-mesh-stripe-background-color)}.z-grid--stacking .z-grid-body>table>tbody.z-grid-emptybody,.z-grid--stacking .z-grid-body>table>tbody.z-grid-emptybody>tr,.z-grid--stacking .z-grid-body>table>tbody.z-grid-emptybody>tr>td{display:block;width:100%}.z-grid--stacking .z-grid-body .z-row:has(.z-row:hover)>.z-cell,.z-grid--stacking .z-grid-body .z-row:has(.z-row:hover)>.z-row-inner{background:inherit}.z-grid--stacking>.z-grid-footer>table,.z-grid--stacking>.z-grid-footer>table>tbody:not(.z-grid-emptybody){display:block}.z-grid--stacking>.z-grid-footer>table>tbody:not(.z-grid-emptybody)>tr{display:flex;flex-direction:column;margin:0 8px 8px;border:1px solid var(--zk-base-border-color);border-radius:4px;background:var(--zk-mesh-foot-background-color);overflow:hidden}.z-grid--stacking>.z-grid-footer>table>tbody:not(.z-grid-emptybody)>tr>td{display:block;padding:var(--zk-mesh-body-padding);border-bottom:none}.z-grid--stacking>.z-grid-footer>table>tbody:not(.z-grid-emptybody)>tr>td:not(.z-cell-hide-stacking):not(:empty)~td:not(.z-cell-hide-stacking):not(:empty){border-top:1px solid var(--zk-mesh-content-border-color)}.z-grid--stacking>.z-grid-footer>table>tbody:not(.z-grid-emptybody)>tr>td:empty,.z-grid--stacking>.z-grid-footer>table>tbody:not(.z-grid-emptybody)>tr>td.z-cell-hide-stacking{display:none}.z-grid--stacking>.z-grid-footer>table>tbody:not(.z-grid-emptybody)>tr>td[data-label]:not([data-label=""])::before{content:attr(data-label);display:block;margin-bottom:2px;font-family:var(--zk-base-content-font-family);font-size:var(--zk-font-size-small);font-weight:600;font-style:normal;color:var(--zk-text-color-light)}