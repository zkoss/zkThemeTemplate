<%@ taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c" %><%@ taglib uri="http://www.zkoss.org/dsp/zk/core" prefix="z" %><%@ taglib uri="http://www.zkoss.org/dsp/web/theme" prefix="t" %>.z-breadcrumb{display:inline-block;font-family:var(--zk-base-content-font-family);font-size:var(--zk-font-size-medium)}.z-breadcrumb-list{list-style:none;margin:0;padding:0;display:flex;align-items:center;flex-wrap:wrap}.z-breadcrumb-separator{margin:0 8px;color:var(--zk-color-grey-dark);user-select:none}.z-breadcrumb [data-zk-bc-hidden="true"]{display:none !important}.z-breadcrumb-ellipsis{margin:0 4px;color:var(--zk-color-grey-dark);user-select:none}.z-breadcrumb-ellipsis>button{background:none;border:0;padding:0;color:inherit;font:inherit;cursor:pointer}.z-breadcrumb-ellipsis>button:focus-visible{outline:2px solid var(--zk-color-grey-dark);outline-offset:2px}.z-breadcrumbitem{display:inline-flex;align-items:center}.z-breadcrumbitem>a{color:var(--zk-color-primary);text-decoration:none}.z-breadcrumbitem>a:hover{text-decoration:underline}.z-breadcrumbitem>a:focus-visible{outline:2px solid var(--zk-color-primary);outline-offset:2px;border-radius:2px}.z-breadcrumbitem>span{color:var(--zk-text-color-default)}.z-breadcrumbitem-disabled{opacity:.5;pointer-events:none}