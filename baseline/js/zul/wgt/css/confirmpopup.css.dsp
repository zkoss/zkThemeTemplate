<%@ taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c" %><%@ taglib uri="http://www.zkoss.org/dsp/zk/core" prefix="z" %><%@ taglib uri="http://www.zkoss.org/dsp/web/theme" prefix="t" %>.z-confirmpopup{position:relative;background:#fff;border:1px solid var(--zk-base-border-color);border-radius:var(--zk-base-border-radius);box-shadow:0 6px 16px rgba(0,0,0,0.12);min-width:240px;max-width:360px;font-family:var(--zk-base-content-font-family);font-size:var(--zk-font-size-medium);color:var(--zk-text-color-default)}.z-confirmpopup-header{padding:12px 16px;border-bottom:1px solid var(--zk-base-border-color);font-weight:600;font-size:var(--zk-font-size-medium);color:var(--zk-text-color-default)}.z-confirmpopup-body{display:flex;gap:10px;align-items:flex-start;padding:12px 16px}.z-confirmpopup-icon{font-size:18px;line-height:1.5;flex:0 0 auto}.z-confirmpopup-message{flex:1;line-height:1.5;color:var(--zk-text-color-default)}.z-confirmpopup-footer{display:flex;justify-content:flex-end;gap:8px;padding:8px 16px;border-top:1px solid var(--zk-base-border-color);background:rgba(0,0,0,0.02);border-radius:0 0 var(--zk-base-border-radius) var(--zk-base-border-radius)}.z-confirmpopup-cancel,.z-confirmpopup-ok{padding:4px 12px;font-family:inherit;font-size:var(--zk-font-size-medium);line-height:1.5;border-radius:var(--zk-base-border-radius);border:1px solid var(--zk-base-border-color);background:#fff;color:var(--zk-text-color-default);cursor:pointer}.z-confirmpopup-ok{background:var(--zk-color-primary);color:#fff;border-color:var(--zk-color-primary)}.z-confirmpopup-cancel:focus-visible,.z-confirmpopup-ok:focus-visible{outline:2px solid var(--zk-color-primary);outline-offset:2px}.z-confirmpopup-info>.z-confirmpopup-body>.z-confirmpopup-icon{color:var(--zk-severity-info-color)}.z-confirmpopup-success>.z-confirmpopup-body>.z-confirmpopup-icon{color:var(--zk-severity-success-color)}.z-confirmpopup-warning>.z-confirmpopup-body>.z-confirmpopup-icon{color:var(--zk-severity-warning-color)}.z-confirmpopup-danger>.z-confirmpopup-body>.z-confirmpopup-icon{color:var(--zk-severity-danger-color)}.z-confirmpopup-secondary>.z-confirmpopup-body>.z-confirmpopup-icon{color:var(--zk-severity-secondary-color)}.z-confirmpopup-arrow{position:absolute;width:16px;height:8px;pointer-events:none}.z-confirmpopup-arrow::before,.z-confirmpopup-arrow::after{content:"";position:absolute;width:0;height:0;border-style:solid}.z-confirmpopup-placement-top{margin-top:-8px}.z-confirmpopup-placement-bottom{margin-top:8px}.z-confirmpopup-placement-left{margin-left:-8px}.z-confirmpopup-placement-right{margin-left:8px}.z-confirmpopup-placement-top>.z-confirmpopup-arrow{bottom:-8px;left:50%;transform:translateX(-50%)}.z-confirmpopup-placement-top>.z-confirmpopup-arrow::before{border-width:8px 8px 0;border-color:var(--zk-base-border-color) transparent transparent}.z-confirmpopup-placement-top>.z-confirmpopup-arrow::after{top:-1px;left:0;border-width:8px 8px 0;border-color:#fff transparent transparent}.z-confirmpopup-placement-bottom>.z-confirmpopup-arrow{top:-8px;left:50%;transform:translateX(-50%)}.z-confirmpopup-placement-bottom>.z-confirmpopup-arrow::before{border-width:0 8px 8px;border-color:transparent transparent var(--zk-base-border-color)}.z-confirmpopup-placement-bottom>.z-confirmpopup-arrow::after{top:1px;left:0;border-width:0 8px 8px;border-color:transparent transparent #fff}.z-confirmpopup-placement-left>.z-confirmpopup-arrow{right:-8px;top:50%;width:8px;height:16px;transform:translateY(-50%)}.z-confirmpopup-placement-left>.z-confirmpopup-arrow::before{border-width:8px 0 8px 8px;border-color:transparent transparent transparent var(--zk-base-border-color)}.z-confirmpopup-placement-left>.z-confirmpopup-arrow::after{left:-1px;top:0;border-width:8px 0 8px 8px;border-color:transparent transparent transparent #fff}.z-confirmpopup-placement-right>.z-confirmpopup-arrow{left:-8px;top:50%;width:8px;height:16px;transform:translateY(-50%)}.z-confirmpopup-placement-right>.z-confirmpopup-arrow::before{border-width:8px 8px 8px 0;border-color:transparent var(--zk-base-border-color) transparent transparent}.z-confirmpopup-placement-right>.z-confirmpopup-arrow::after{left:1px;top:0;border-width:8px 8px 8px 0;border-color:transparent #fff transparent transparent}