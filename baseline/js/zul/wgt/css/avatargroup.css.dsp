<%@ taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c" %><%@ taglib uri="http://www.zkoss.org/dsp/zk/core" prefix="z" %><%@ taglib uri="http://www.zkoss.org/dsp/web/theme" prefix="t" %>.z-avatargroup{display:inline-flex;align-items:center;--zk-avatargroup-overlap:-8px}.z-avatargroup>.z-avatar{margin-left:var(--zk-avatargroup-overlap);border:2px solid #fff;box-sizing:content-box}.z-avatargroup>.z-avatar:first-child{margin-left:0}.z-avatargroup-small{--zk-avatargroup-overlap:-6px}.z-avatargroup-small>.z-avatar{--zk-avatar-size:24px;--zk-avatar-font-size:10px}.z-avatargroup-medium{--zk-avatargroup-overlap:-8px}.z-avatargroup-medium>.z-avatar{--zk-avatar-size:36px;--zk-avatar-font-size:14px}.z-avatargroup-large{--zk-avatargroup-overlap:-12px}.z-avatargroup-large>.z-avatar{--zk-avatar-size:48px;--zk-avatar-font-size:18px}.z-avatargroup-circle>.z-avatar{border-radius:50%}.z-avatargroup-square>.z-avatar{border-radius:var(--zk-base-border-radius)}.z-avatargroup [data-ag-hidden]{display:none !important}.z-avatargroup-overflow{background:#f0f0f0;color:#595959;cursor:default}