<%@ taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c" %><%@ taglib uri="http://www.zkoss.org/dsp/zk/core" prefix="z" %><%@ taglib uri="http://www.zkoss.org/dsp/web/theme" prefix="t" %>.z-carousel{position:relative;overflow:hidden;display:inline-block}.z-carousel-track{display:flex;transition:transform .4s ease;height:100%;width:100%;touch-action:pan-y}.z-carousel-vertical>.z-carousel-track{flex-direction:column;touch-action:pan-x}.z-carousel-effect-fade>.z-carousel-track{position:relative;transition:none;transform:none !important}.z-carousel-effect-fade>.z-carousel-track>.z-carouselitem{position:absolute;inset:0;opacity:0;transition:opacity .4s ease}.z-carousel-effect-fade>.z-carousel-track>.z-carouselitem-active{opacity:1;z-index:1}.z-carousel-effect-none>.z-carousel-track{transition:none}.z-carousel-arrow{position:absolute;top:50%;transform:translateY(-50%);width:36px;height:36px;border-radius:50%;background:rgba(0,0,0,0.4);color:#fff;border:0;font-family:var(--zk-base-title-font-family);font-size:0;cursor:pointer;display:flex;align-items:center;justify-content:center;z-index:2}.z-carousel-arrow::before{content:'';display:block;width:8px;height:8px;box-sizing:border-box}.z-carousel-arrow-prev::before{border-left:2px solid currentColor;border-bottom:2px solid currentColor;transform:rotate(45deg);margin-left:2px}.z-carousel-arrow-next::before{border-right:2px solid currentColor;border-top:2px solid currentColor;transform:rotate(45deg);margin-right:2px}.z-carousel-arrow:hover{background:rgba(0,0,0,0.6)}.z-carousel-arrow:focus-visible{outline:2px solid var(--zk-color-primary);outline-offset:2px}.z-carousel-arrow-prev{left:10px}.z-carousel-arrow-next{right:10px}.z-carousel-indicators{position:absolute;bottom:10px;left:50%;transform:translateX(-50%);display:flex;gap:6px;z-index:2}.z-carousel-indicator{width:24px;height:24px;padding:0;border:0;background:transparent;cursor:pointer;display:flex;align-items:center;justify-content:center}.z-carousel-indicator::before{content:"";width:8px;height:8px;border-radius:50%;background:rgba(0,0,0,0.5);border:1px solid rgba(255,255,255,0.8)}.z-carousel-indicator-active::before{background:#fff;border-color:rgba(0,0,0,0.5)}.z-carousel-indicator:focus-visible{outline:2px solid var(--zk-color-primary);outline-offset:2px}.z-carousel-status{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0, 0, 0, 0);white-space:nowrap;border:0}@media (prefers-reduced-motion:reduce){.z-carousel-track{transition:none}.z-carousel-effect-fade>.z-carousel-track>.z-carouselitem{transition:none}}.z-carousel-clone{flex:0 0 100%;min-width:100%;height:100%;position:relative;box-sizing:border-box;pointer-events:none}.z-carouselitem{flex:0 0 100%;min-width:100%;height:100%;position:relative;box-sizing:border-box}.z-carouselitem-label{position:absolute;bottom:16px;left:16px;background:rgba(0,0,0,0.5);color:#fff;padding:4px 10px;border-radius:4px}.z-carouselitem>img{width:100%;height:100%;object-fit:cover;display:block}