<%@ taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c" %><%@ taglib uri="http://www.zkoss.org/dsp/zk/core" prefix="z" %><%@ taglib uri="http://www.zkoss.org/dsp/web/theme" prefix="t" %>.z-chip{display:inline-flex;align-items:center;gap:4px;padding:0 7px;border:1px solid var(--zk-chip-border, var(--zk-severity-info-border));border-radius:4px;font-family:var(--zk-base-title-font-family);font-size:12px;line-height:20px;background:var(--zk-chip-bg, var(--zk-severity-info-bg));color:var(--zk-chip-color, var(--zk-severity-info-text));box-sizing:border-box}.z-chip-rounded{border-radius:999px}.z-chip-small{padding:0 5px;font-size:11px;line-height:16px}.z-chip-disabled{opacity:.5;pointer-events:none;cursor:not-allowed}.z-chip-info{--zk-chip-bg:var(--zk-severity-info-bg);--zk-chip-border:var(--zk-severity-info-border);--zk-chip-color:var(--zk-severity-info-text)}.z-chip-success{--zk-chip-bg:var(--zk-severity-success-bg);--zk-chip-border:var(--zk-severity-success-border);--zk-chip-color:var(--zk-severity-success-text)}.z-chip-warning{--zk-chip-bg:var(--zk-severity-warning-bg);--zk-chip-border:var(--zk-severity-warning-border);--zk-chip-color:var(--zk-severity-warning-text)}.z-chip-danger{--zk-chip-bg:var(--zk-severity-danger-bg);--zk-chip-border:var(--zk-severity-danger-border);--zk-chip-color:var(--zk-severity-danger-text)}.z-chip-secondary{--zk-chip-bg:var(--zk-severity-secondary-bg);--zk-chip-border:var(--zk-severity-secondary-border);--zk-chip-color:var(--zk-severity-secondary-text)}.z-chip-close{background:none;border:0;padding:0;color:inherit;cursor:pointer;font-size:10px;line-height:1;opacity:.55;margin-left:3px}.z-chip-close:hover{opacity:1}.z-chip-close:focus-visible{outline:2px solid var(--zk-color-grey-dark);outline-offset:1px;opacity:1}.z-chip-close:disabled{cursor:default;opacity:.3}